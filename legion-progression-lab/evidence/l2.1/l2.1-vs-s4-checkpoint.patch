+const args = process.argv.slice(2);
+const manifestRel = args[0];
+const outIdx = args.indexOf('--out');
+const wIdx = args.indexOf('--workers');
+if (!manifestRel || outIdx < 0) throw new Error('usage: l2-run.ts <manifest> --out <file> [--workers <n>]');
