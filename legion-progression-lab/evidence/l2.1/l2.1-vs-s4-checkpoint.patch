+}
+sample();
+const environment = {
+  experimentId: m.experimentId,
+  manifestSha256: sha,
+  formulaVersion: L2_FORMULA_VERSION,
+  node: process.version,
+  platform: platform(),
+  release: release(),
+  cpus: cpus().length,
+  workers: m.kind === 'partition' ? workers : 0,
