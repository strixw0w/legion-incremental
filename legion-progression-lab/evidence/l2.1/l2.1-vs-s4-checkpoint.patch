index 0000000..9b082fb
--- /dev/null
+++ b/legion-progression-lab/src/l2/differential.ts
@@ -0,0 +1,474 @@
+/**
+ * L2.1 randomized differential against the L1 full-history reference (owner "Independent L2 Review and L2.1
+ * Authorisation" §3, §9; planning/L2_1_CONTRACT.md). One generator drives the same deliveries through the synthetic
+ * account with the COMPACT store (L2.1) and with the FULL store (L1):
+ *  - requests: new, skipped (permanently missing), late, out of order, retried (recent and old), conflicting, far
+ *    ahead, invalid; every payload kind, including backwards and ahead settlements and overlapping or invalid batches;
+ *  - kill credits on two streams, each with its own numbers: new, held back and delivered late, abandoned, duplicated,
+ *    far ahead; work operations on batch producers (in order, out of order, duplicated, invalid, on closed and retired
+ *    producers); producers closed and retired automatically; time jumps of hours (receipt expiry);
+ *  - checkpoint save and restore mid-run (the restored account must continue identically), branches (a child's
+ *    deliveries must leave the parent unchanged, and a child's message delivered to the parent must be refused).
+ * After every delivery the outcome codes and receipts agree, except the declared differences (contract §2.6), each of
+ * which must pass its reason check (the compact state shows why it refused) or it is a mismatch; a refused delivery
+ * still advances the reference's clock, so the two stay comparable. The economies are compared after every delivery,
+ * exactly. Invariants and the declared bounds are checked throughout.
+ */
+import { canonicalJson } from '../core/hash/canonicalJson.ts';
+import { advanceTo, deliver, ECONOMY_V1, fork, newAccount, reservationProblems, type Account, type Delivery, type Economy, type Payload } from './account.ts';
+import { makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from './checkpoint.ts';
+import { compactStore, type CompactIds } from './compactIds.ts';
+import type { IdentityStore } from './ids.ts';
+import { fullReceiptCount, fullStore, type FullIds } from './l1Reference.ts';
+import type { Limits } from './limits.ts';
+import type { ProducerState, WorkOp } from './producers.ts';
+import { payloadHash } from './requests.ts';
+
+/** Deterministic test-case generator (never used by the engine). */
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function seedOf(text: string): number {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i += 1) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
+  return h >>> 0;
+}
+
+/** The economy part of an account (everything but the identity evidence and the request counter), serialized. */
+export function economyView(a: Account<unknown>): string {
+  const { ids: _ids, counters, ...rest } = a;
+  void _ids;
+  const { requests: _r, ...c } = counters;
+  void _r;
+  return canonicalJson({ ...rest, counters: c } as never);
+}
+
+/**
+ * Exact structural equality of two values, with a memo for pairs of deeply frozen objects already found equal: a deeply
+ * frozen value cannot change, so a pair once equal stays equal (no hashing, no sampling).
+ */
+export function structuralEqual(x: unknown, y: unknown, memo: WeakMap<object, object>): boolean {
+  return eq(x, y, memo).equal;
+}
+
+function eq(x: unknown, y: unknown, memo: WeakMap<object, object>): { equal: boolean; frozen: boolean } {
+  if (x === y) return { equal: true, frozen: typeof x !== 'object' || x === null || Object.isFrozen(x) };
+  if (typeof x !== 'object' || typeof y !== 'object' || x === null || y === null) return { equal: false, frozen: false };
+  if (memo.get(x) === y) return { equal: true, frozen: true };
+  if (Array.isArray(x) !== Array.isArray(y)) return { equal: false, frozen: false };
+  const kx = Object.keys(x);
+  const ky = Object.keys(y);
+  if (kx.length !== ky.length) return { equal: false, frozen: false };
+  let frozen = Object.isFrozen(x) && Object.isFrozen(y);
+  for (const k of kx) {
+    if (!Object.hasOwn(y, k)) return { equal: false, frozen: false };
+    const r = eq((x as Record<string, unknown>)[k], (y as Record<string, unknown>)[k], memo);
+    if (!r.equal) return { equal: false, frozen: false };
+    frozen &&= r.frozen;
+  }
+  if (frozen) memo.set(x, y);
+  return { equal: true, frozen };
+}
+
+/** Structural comparison of the economy parts (the same fields as economyView). */
+export function economyEqual(a: Account<unknown>, b: Account<unknown>, memo: WeakMap<object, object>): boolean {
+  for (const k of Object.keys(a) as (keyof Account<unknown>)[]) {
+    if (k === 'ids') continue;
+    if (k === 'counters') {
+      const ca = a.counters;
+      const cb = b.counters;
+      if (ca.ore !== cb.ore || ca.gold !== cb.gold || ca.kills !== cb.kills || ca.bars !== cb.bars) return false;
+      continue;
+    }
+    if (!structuralEqual(a[k], b[k], memo)) return false;
+  }
+  return Object.keys(a).length === Object.keys(b).length;
+}
+
+export interface DifferentialConfig {
+  readonly seed: string;
+  readonly operations: number;
+  readonly limits: Limits;
+  readonly checkpointEvery: number;
+  readonly branchEvery: number;
+  readonly economy?: Economy;
+  /** 'structural' (default), 'serialized' (the L2 harness's comparison), or 'both' (counts any disagreement). */
+  readonly compare?: 'structural' | 'serialized' | 'both';
+  /** Called every 1,000 deliveries by the CLI (deadline and memory budget); true stops the run, reported as stopped. */
+  readonly shouldStop?: (deliveries: number) => boolean;
+  /** Tests only: wraps the compact store with a planted fault, to show the harness reports it (its power). */
+  readonly wrapCompact?: (s: IdentityStore<CompactIds>) => IdentityStore<CompactIds>;
+}
+
+export interface DeclaredDifferences {
+  /** REQUEST_CLOSED where the full reference replays the original receipt. */
+  readonly closedReplay: number;
+  /** REQUEST_CLOSED where the full reference reports CONFLICTING_PAYLOAD. */
+  readonly closedConflict: number;
+  /** REQUEST_CLOSED where the full reference would execute a never-seen request. */
+  readonly closedUnseen: number;
+  /** REQUEST_AHEAD where the full reference would execute. */
+  readonly requestAhead: number;
+  /** CREDIT_AHEAD where the full reference would pay the credit. */
+  readonly creditAhead: number;
+  /** STREAM_LIMIT or CREDIT_STREAM_LIMIT where the full reference would proceed. */
+  readonly streamLimit: number;
+}
+
+export interface DifferentialResult {
+  readonly seed: string;
+  readonly operations: number;
+  readonly executed: number;
+  readonly stopped: boolean;
+  readonly byType: Record<string, number>;
+  readonly outcomes: Record<string, number>;
+  readonly declaredDifferences: DeclaredDifferences;
+  readonly mismatches: number;
+  readonly firstMismatches: readonly string[];
+  readonly comparisonDisagreements: number;
+  readonly invariantViolations: number;
+  readonly boundViolations: number;
+  readonly checkpoints: number;
+  readonly restoredIdentically: number;
+  readonly branches: number;
+  readonly branchIsolationBreaks: number;
+  readonly wrongBranchAdmitted: number;
+  readonly retiredProducers: number;
+  readonly l2Max: { readonly receiptsPerStream: number; readonly creditRuns: number; readonly producerRuns: number; readonly openProducers: number; readonly reservedPerProducer: number };
+  readonly l1ReceiptsAtEnd: number;
+  readonly finalSimulatedMs: number;
+}
+
+const STREAMS = ['client.a', 'client.b', 'client.c'] as const;
+const CREDIT_STREAMS = ['squad', 'worker:rec:2'] as const;
+const L2_ONLY = new Set(['REQUEST_CLOSED', 'REQUEST_AHEAD', 'CREDIT_AHEAD', 'STREAM_LIMIT', 'CREDIT_STREAM_LIMIT']);
+
+export function runDifferential(cfg: DifferentialConfig): DifferentialResult {
+  const econ = cfg.economy ?? ECONOMY_V1;
+  const L = cfg.limits;
+  const compact = cfg.wrapCompact ? cfg.wrapCompact(compactStore(L)) : compactStore(L);
+  const full = fullStore(L);
+  const compare = cfg.compare ?? 'structural';
+  const memo = new WeakMap<object, object>();
+  const rnd = mulberry32(seedOf(cfg.seed));
+  const int = (lo: number, hi: number) => lo + Math.floor(rnd() * (hi - lo + 1));
+  const pick = <T>(xs: readonly T[]): T => xs[Math.floor(rnd() * xs.length)] as T;
+  const seedState = [seedOf(`${cfg.seed}:a`) || 1, seedOf(`${cfg.seed}:b`), seedOf(`${cfg.seed}:c`), seedOf(`${cfg.seed}:d`)] as const;
+  let l2: Account<CompactIds> = newAccount(compact, econ, seedState, 2);
+  let l1: Account<FullIds> = newAccount(full, econ, seedState, 2);
+  let t = 0;
+  // Generator memory: what was sent per request stream, skipped sequence numbers, credit numbers, producers.
+  const sent = new Map<string, { seq: number; payload: Payload }[]>(STREAMS.map((s) => [s, []]));
+  const nextSeq = new Map<string, number>(STREAMS.map((s) => [s, 1]));
+  const skipped = new Map<string, number[]>(STREAMS.map((s) => [s, []]));
+  const nextCredit = new Map<string, number>(CREDIT_STREAMS.map((s) => [s, 1]));
+  const held = new Map<string, number[]>(CREDIT_STREAMS.map((s) => [s, []]));
+  const creditsSent = new Map<string, number[]>(CREDIT_STREAMS.map((s) => [s, []]));
+  const batches: { producer: number; nextUnit: number }[] = [];
+  const formerBatches: number[] = [];
+  let lastJob = 0;
+  const byType: Record<string, number> = {};
+  const outcomes: Record<string, number> = {};
+  const dd = { closedReplay: 0, closedConflict: 0, closedUnseen: 0, requestAhead: 0, creditAhead: 0, streamLimit: 0 };
+  let mismatches = 0;
+  const first: string[] = [];
+  let disagreements = 0;
+  let invariantViolations = 0;
+  let boundViolations = 0;
+  let checkpoints = 0;
+  let restoredIdentically = 0;
+  let branches = 0;
+  let branchIsolationBreaks = 0;
+  let wrongBranchAdmitted = 0;
+  let retired = 0;
+  const max = { receiptsPerStream: 0, creditRuns: 0, producerRuns: 0, openProducers: 0, reservedPerProducer: 0 };
+  let executed = 0;
+  let stopped = false;
+  const bad = (what: string) => {
+    mismatches += 1;
+    if (first.length < 10) first.push(what);
+  };
+  const same = (a: Account<CompactIds>, b: Account<FullIds>): boolean => {
+    if (compare === 'serialized') return economyView(a) === economyView(b);
+    if (compare === 'structural') return economyEqual(a, b, memo);
+    const s = economyView(a) === economyView(b);
+    if (s !== economyEqual(a, b, memo)) disagreements += 1;
+    return s;
+  };
+
+  const randomPayload = (): Payload => {
+    const r = rnd();
+    if (r < 0.12) return { kind: 'settle', untilMs: rnd() < 0.7 ? t : rnd() < 0.5 ? Math.max(0, t - int(1, 3_600_000)) : t + int(1, 3_600_000) };
+    if (r < 0.24) return { kind: 'monument', levels: 1 };
+    if (r < 0.30) return { kind: 'recruit' };
+    if (r < 0.38) return { kind: 'craft' };
+    if (r < 0.46) return { kind: 'enhance', item: `item:${int(1, 6)}`, level: int(1, 4) };
+    if (r < 0.55) return { kind: 'createJob', quantity: int(1, 6) };
+    if (r < 0.61) return { kind: 'cancelJob', job: lastJob > 0 && rnd() < 0.8 ? lastJob : int(1, 5) };
+    if (r < 0.70) return { kind: 'openBatch' };
+    if (r < 0.77) return { kind: 'closeBatch', producer: batches.length > 0 && rnd() < 0.85 ? pick(batches).producer : formerBatches.length > 0 && rnd() < 0.7 ? pick(formerBatches) : int(1, 80) };
+    const b = batches.length > 0 ? pick(batches) : { producer: int(1, 3), nextUnit: 3 };
+    const from = int(1, Math.max(1, b.nextUnit));
+    return { kind: 'settleBatch', producer: b.producer, fromUnit: from, toUnit: from + (rnd() < 0.02 ? L.maxOutstanding + int(0, 3) : int(0, 3)) };
+  };
+
+  for (let op = 0; op < cfg.operations; op += 1) {
+    if (cfg.shouldStop && op % 1000 === 0 && op > 0 && cfg.shouldStop(op)) {
+      stopped = true;
+      break;
+    }
+    executed += 1;
+    // Time moves forward: usually seconds, sometimes hours (receipt expiry).
+    t += rnd() < 0.02 ? int(3_600_000, 30 * 3_600_000) : int(0, 90_000);
+    const r = rnd();
+    let d: Delivery;
+    let type: string;
+    const stream = pick(STREAMS);
+    const list = sent.get(stream) as { seq: number; payload: Payload }[];
+    if (r < 0.40 || list.length === 0) {
+      type = 'request.new';
+      let seq = nextSeq.get(stream) as number;
+      // Sometimes skip a sequence number: a permanently missing message, or one that arrives much later.
+      if (rnd() < 0.05) {
+        (skipped.get(stream) as number[]).push(seq);
+        seq += 1;
+      }
+      nextSeq.set(stream, seq + 1);
+      const payload = randomPayload();
+      list.push({ seq, payload });
+      if (list.length > 4000) list.splice(0, list.length - 4000);
+      d = { type: 'request', branch: 'main', atMs: t, stream, seq, payload };
+    } else if (r < 0.50) {
+      type = 'request.retry';
+      const old = rnd() < 0.5 ? (list[list.length - 1 - int(0, Math.min(20, list.length - 1))] as { seq: number; payload: Payload }) : pick(list);
+      d = { type: 'request', branch: 'main', atMs: t, stream, seq: old.seq, payload: old.payload };
+    } else if (r < 0.53) {
+      type = 'request.conflict';
+      const old = pick(list);
+      d = { type: 'request', branch: 'main', atMs: t, stream, seq: old.seq, payload: { kind: 'settle', untilMs: t + int(1, 1000) } };
+    } else if (r < 0.55) {
+      type = 'request.late';
+      const sk = skipped.get(stream) as number[];
+      const seq = sk.length > 0 && rnd() < 0.5 ? (sk.splice(int(0, sk.length - 1), 1)[0] as number) : int(1, nextSeq.get(stream) as number);
+      d = { type: 'request', branch: 'main', atMs: t, stream, seq, payload: randomPayload() };
+    } else if (r < 0.555) {
+      type = 'request.ahead';
+      const seq = rnd() < 0.9 ? (nextSeq.get(stream) as number) + L.maxAhead + int(1, 1_000_000) : rnd() < 0.5 ? Number.MAX_SAFE_INTEGER : 2 ** 53;
+      d = { type: 'request', branch: 'main', atMs: t, stream, seq, payload: randomPayload() };
+    } else if (r < 0.72) {
+      // Kill credits: each stream numbers its own encounters. Mostly new; some held back and delivered later (out of
+      // order) or abandoned (the encounter was cancelled); some duplicated; a few far ahead of the window.
+      const cs = rnd() < 0.8 ? 'squad' : 'worker:rec:2';
+      const h = held.get(cs) as number[];
+      const sentList = creditsSent.get(cs) as number[];
+      const next = nextCredit.get(cs) as number;
+      const q = rnd();
+      const overdue = h.length > 0 && next - (h[0] as number) > L.creditWindow / 2;
+      if (overdue || (q >= 0.7 && q < 0.82 && h.length > 0)) {
+        const n = overdue ? (h.shift() as number) : (h.splice(int(0, h.length - 1), 1)[0] as number);
+        if (rnd() < 0.3) {
+          type = 'credit.abandon';
+          d = { type: 'creditAbandon', branch: 'main', atMs: t, stream: cs, n };
+        } else {
+          type = 'credit.late';
+          d = { type: 'credit', branch: 'main', atMs: t, stream: cs, n, gold: int(0, 40) };
+        }
+      } else if (q < 0.7) {
+        let n = next;
+        if (rnd() < 0.1) {
+          h.push(n);
+          n += 1;
+        }
+        nextCredit.set(cs, n + 1);
+        type = 'credit.new';
+        d = { type: 'credit', branch: 'main', atMs: t, stream: cs, n, gold: int(0, 40) };
+      } else if (q < 0.995) {
+        type = 'credit.duplicate';
+        d = { type: rnd() < 0.8 ? 'credit' : 'creditAbandon', branch: 'main', atMs: t, stream: cs, n: sentList.length > 0 ? pick(sentList) : 1, gold: int(0, 40) } as Delivery;
+      } else {
+        type = 'credit.ahead';
+        d = { type: 'credit', branch: 'main', atMs: t, stream: cs, n: next + L.creditWindow + int(1, 1_000_000), gold: int(0, 40) };
+      }
+      if (d.type !== 'request' && d.type !== 'work') {
+        sentList.push(d.n);
+        if (sentList.length > 4000) sentList.splice(0, 2000);
+      }
+    } else {
+      type = 'work';
+      const b = batches.length > 0 && rnd() < 0.93 ? pick(batches) : { producer: formerBatches.length > 0 && rnd() < 0.6 ? pick(formerBatches) : int(1, batches.length + 3), nextUnit: 1 };
+      const op: WorkOp = pick(['reserve', 'reserve', 'reserve', 'complete', 'complete', 'release', 'abandon'] as const);
+      const unit = (op === 'reserve' || op === 'abandon') && rnd() < 0.75 ? b.nextUnit : int(1, b.nextUnit + 1);
+      d = { type: 'work', branch: 'main', atMs: t, producer: b.producer, unit, op, qty: int(1, 4) };
+    }
+    byType[type] = (byType[type] ?? 0) + 1;
+
+    const o2 = deliver(l2, d, econ, compact);
+    const code = o2.outcome.code;
+    outcomes[code] = (outcomes[code] ?? 0) + 1;
+    if (L2_ONLY.has(code)) {
+      // A declared difference: L2.1 refuses where the full reference would proceed or replay. Its reason must show in
+      // the compact state, or it is a mismatch. The reference's clock still advances (the refusal advanced L2.1's).
+      const after = o2.account.ids;
+      let l1Kind = '';
+      if (d.type === 'request') {
+        const s = after.requests[d.stream];
+        const l1c = full.classify(l1.ids, d.stream, d.seq, payloadHash(d.payload));
+        l1Kind = l1c.kind;
+        if (code === 'REQUEST_CLOSED') {
+          if (!s || d.seq > s.horizon || s.receipts.some((x) => x.seq === d.seq)) bad(`op ${op} ${type}: REQUEST_CLOSED without seq ${d.seq} at or below the horizon`);
+          else if (l1c.kind === 'REPLAY') dd.closedReplay += 1;
+          else if (l1c.kind === 'CONFLICTING_PAYLOAD') dd.closedConflict += 1;
+          else if (l1c.kind === 'NEW') dd.closedUnseen += 1;
+          else bad(`op ${op} ${type}: REQUEST_CLOSED where L1 says ${l1c.kind}`);
+        } else if (code === 'REQUEST_AHEAD') {
+          if (!(d.seq - (s?.top ?? 0) > L.maxAhead) || l1c.kind !== 'NEW') bad(`op ${op} ${type}: REQUEST_AHEAD for seq ${d.seq} (top ${s?.top ?? 0}) where L1 says ${l1c.kind}`);
+          else dd.requestAhead += 1;
+        } else if (code === 'STREAM_LIMIT') {
+          if (s || Object.keys(after.requests).length < L.maxStreams || l1c.kind !== 'NEW') bad(`op ${op} ${type}: STREAM_LIMIT without a full stream table`);
+          else dd.streamLimit += 1;
+        } else bad(`op ${op} ${type}: ${code} on a request`);
+      } else if (d.type === 'credit' || d.type === 'creditAbandon') {
+        const set = after.credits[d.stream];
+        l1Kind = full.creditState(l1.ids, d.stream, d.n);
+        if (code === 'CREDIT_AHEAD') {
+          if (!(d.n - (set?.p ?? 0) > L.creditWindow) || l1Kind !== 'NEW') bad(`op ${op} ${type}: CREDIT_AHEAD for ${d.n} (prefix ${set?.p ?? 0}) where L1 says ${l1Kind}`);
+          else dd.creditAhead += 1;
+        } else if (code === 'CREDIT_STREAM_LIMIT') {
+          if (set || Object.keys(after.credits).length < L.maxCreditStreams || l1Kind !== 'NEW') bad(`op ${op} ${type}: CREDIT_STREAM_LIMIT without a full stream table`);
+          else dd.streamLimit += 1;
+        } else bad(`op ${op} ${type}: ${code} on a credit`);
+      } else bad(`op ${op} ${type}: ${code} on work`);
+      if (l1Kind === 'REPLAY' || l1Kind === 'CONFLICTING_PAYLOAD') {
+        const o1 = deliver(l1, d, econ, full);
+        if (o1.outcome.code !== (l1Kind === 'REPLAY' ? 'REPLAY' : 'CONFLICTING_PAYLOAD')) bad(`op ${op} ${type}: L1 delivered ${o1.outcome.code}, classified ${l1Kind}`);
+        l1 = o1.account;
+      } else l1 = advanceTo(l1, d.atMs, econ, full);
+      l2 = o2.account;
+    } else {
+      const o1 = deliver(l1, d, econ, full);
+      if (code !== o1.outcome.code) bad(`op ${op} ${type}: L2 ${code} vs L1 ${o1.outcome.code}`);
+      else if (canonicalJson(o2.outcome.receipt as never) !== canonicalJson(o1.outcome.receipt as never)) bad(`op ${op} ${type}: receipts differ`);
+      l2 = o2.account;
+      l1 = o1.account;
+    }
+    if (!same(l2, l1)) {
+      bad(`op ${op} ${type}: economies differ after ${code}`);
+      break;
+    }
+    // Generator memory from outcomes.
+    const rc = o2.outcome.receipt;
+    if (rc && code === 'APPLIED' && rc['code'] === 'OK') {
+      if (typeof rc['producer'] === 'number' && d.type === 'request' && d.payload.kind === 'openBatch') batches.push({ producer: rc['producer'], nextUnit: 1 });
+      if (typeof rc['job'] === 'number') lastJob = rc['job'];
+      if (d.type === 'request' && d.payload.kind === 'closeBatch') {
+        const p = d.payload.producer;
+        const i = batches.findIndex((b) => b.producer === p);
+        if (i >= 0) batches.splice(i, 1);
+        formerBatches.push(p);
+        if (formerBatches.length > 40) formerBatches.shift();
+      }
+    }
+    if (d.type === 'work' && code === 'APPLIED' && (d.op === 'reserve' || d.op === 'abandon')) {
+      const b = batches.find((x) => x.producer === d.producer);
+      if (b && d.unit === b.nextUnit) b.nextUnit += 1;
+    }
+    if (d.type === 'work' && code === 'PRODUCER_FULL') {
+      // Rotation: a full producer is closed (its remaining work settles, then it retires) and a new one is opened.
+      const i = batches.findIndex((b) => b.producer === d.producer);
+      if (i >= 0) batches.splice(i, 1);
+    }
+    if (batches.length > 40) batches.splice(0, batches.length - 40);
+    // Invariants and declared bounds (L2.1).
+    if (op % 97 === 0) {
+      const inv = reservationProblems(l2, compact);
+      if (inv.length > 0) {
+        invariantViolations += 1;
+        if (first.length < 10) first.push(`op ${op}: ${inv[0]}`);
+      }
+      for (const s of Object.values(l2.ids.requests)) {
+        max.receiptsPerStream = Math.max(max.receiptsPerStream, s.receipts.length);
+        if (s.receipts.length > L.maxRecent) boundViolations += 1;
+      }
+      for (const c of Object.values(l2.ids.credits)) {
+        max.creditRuns = Math.max(max.creditRuns, c.runs.length);
+        if (c.runs.length > L.creditWindow) boundViolations += 1;
+      }
+      for (const k of Object.values(l2.ids.producers)) {
+        const open = Object.values(k.open) as ProducerState[];
+        max.openProducers = Math.max(max.openProducers, open.length);
+        if (open.length > L.maxOpenProducers) boundViolations += 1;
+        max.producerRuns = Math.max(max.producerRuns, k.retired.runs.length);
+        for (const p of open) {
+          const runs = Math.max(p.settled.runs.length, p.released.runs.length, p.abandoned.runs.length);
+          max.producerRuns = Math.max(max.producerRuns, runs);
+          max.reservedPerProducer = Math.max(max.reservedPerProducer, p.reserved.length);
+          if (p.reserved.length > L.maxOutstanding || p.maxUnit > L.maxUnits) boundViolations += 1;
+        }
+      }
+    }
+    // Checkpoint, restore and continue: identical by construction or a mismatch.
+    if (cfg.checkpointEvery > 0 && op % cfg.checkpointEvery === cfg.checkpointEvery - 1) {
+      checkpoints += 1;
+      const text = serializeCheckpoint(makeCheckpoint(l2, econ, L, checkpoints));
+      const back = restoreCheckpoint(text, econ, L, 'main').account;
+      if (canonicalJson(back as never) === canonicalJson(l2 as never)) restoredIdentically += 1;
+      else bad(`op ${op}: the restored checkpoint differs`);
+      l2 = back;
+    }
+    // Branches: a child's deliveries leave the parent unchanged; a child's message is refused by the parent.
+    if (cfg.branchEvery > 0 && op % cfg.branchEvery === cfg.branchEvery - 1) {
+      branches += 1;
+      const parent2 = canonicalJson(l2 as never);
+      const parent1 = economyView(l1);
+      const parentReceipts1 = fullReceiptCount(l1.ids);
+      const name = `b${branches}`;
+      let b2 = fork(l2, name, compact);
+      let b1 = fork(l1, name, full);
+      for (let k = 0; k < 5; k += 1) {
+        const bd: Delivery = { type: 'request', branch: b2.branch, atMs: t + k * 60_000, stream: 'branch', seq: k + 1, payload: randomPayload() };
+        b2 = deliver(b2, bd, econ, compact).account;
+        b1 = deliver(b1, bd, econ, full).account;
+        // The same child message delivered to the parent: refused, nothing changes.
+        const w2 = deliver(l2, bd, econ, compact);
+        const w1 = deliver(l1, bd, econ, full);
+        if (w2.outcome.code !== 'BRANCH_MISMATCH' || w2.account !== l2 || w1.outcome.code !== 'BRANCH_MISMATCH' || w1.account !== l1) wrongBranchAdmitted += 1;
+      }
+      if (canonicalJson(l2 as never) !== parent2 || economyView(l1) !== parent1 || fullReceiptCount(l1.ids) !== parentReceipts1) branchIsolationBreaks += 1;
+      if (economyView(b2) !== economyView(b1)) bad(`op ${op}: branch economies differ`);
+    }
+  }
+  for (const k of Object.values(l2.ids.producers)) {
+    for (const [a, b] of k.retired.p > 0 ? [[1, k.retired.p] as const, ...k.retired.runs] : k.retired.runs) retired += b - a + 1;
+  }
+  return {
+    seed: cfg.seed,
+    operations: cfg.operations,
+    executed,
+    stopped,
+    byType,
+    outcomes,
+    declaredDifferences: dd,
+    mismatches,
+    firstMismatches: first,
+    comparisonDisagreements: disagreements,
+    invariantViolations,
+    boundViolations,
+    checkpoints,
+    restoredIdentically,
+    branches,
+    branchIsolationBreaks,
+    wrongBranchAdmitted,
+    retiredProducers: retired,
+    l2Max: max,
+    l1ReceiptsAtEnd: fullReceiptCount(l1.ids),
+    finalSimulatedMs: t,
+  };
+}
diff --git a/legion-progression-lab/src/l2/ids.ts b/legion-progression-lab/src/l2/ids.ts
new file mode 100644
index 0000000..284ef39
--- /dev/null
+++ b/legion-progression-lab/src/l2/ids.ts
@@ -0,0 +1,68 @@
+/**
+ * Identity stores (planning/L2_1_CONTRACT.md §2–§5). The account (src/l2/account.ts) keeps its exactly-once evidence in
+ * an identity store with one interface and two implementations:
+ *  - COMPACT (L2.1): request streams with a bounded recent window, credit streams with an admission window, and
+ *    producers with range-set units and retired ranges (src/l2/requests.ts, ranges.ts, producers.ts, compactIds.ts);
+ *  - FULL (the L1 reference, src/l2/l1Reference.ts): every receipt and credit kept for ever, plain maps and sets, no
+ *    horizon and no admission window.
+ * The producer lifecycle rules (in-order units, outstanding and unit limits, closing, automatic retirement) are part
+ * of the protocol and are applied by the account through this interface, so both stores apply them identically. The
+ * window rules (REQUEST_CLOSED, REQUEST_AHEAD, CREDIT_AHEAD, stream limits) are the compact store's and are the
+ * declared observable differences from the full-history reference (contract §2.6).
+ */
+import type { Limits } from './limits.ts';
+import type { Classification, Receipt } from './requests.ts';
+import type { QtyLine, WorkOp, WorkRefusal } from './producers.ts';
+
+export type UnitView = { readonly state: 'none' | 'reserved'; readonly lines: readonly QtyLine[] } | { readonly state: 'settled'; readonly how: Exclude<WorkOp, 'reserve'> };
+export type CreditState = 'NEW' | 'CREDIT_REPLAYED' | 'CREDIT_AHEAD' | 'CREDIT_STREAM_LIMIT' | 'INVALID_REQUEST';
+export interface ProducerInfo {
+  readonly maxUnit: number;
+  readonly reserved: number;
+  readonly closed: boolean;
+}
+
+export interface IdentityStore<I> {
+  readonly name: 'compact' | 'full';
+  readonly limits: Limits;
+  empty(): I;
+  /** The identity evidence of a new branch (compact: shared, it is immutable; full: a deep copy). */
+  fork(ids: I): I;
+  /** Expires receipts at the trusted time `nowMs` (compact); the full store keeps everything. */
+  maintain(ids: I, nowMs: number): I;
+  classify(ids: I, stream: string, seq: number, payloadHash: string): Classification;
+  record(ids: I, stream: string, seq: number, payloadHash: string, receipt: Receipt, nowMs: number): I;
+  creditState(ids: I, stream: string, n: number): CreditState;
+  /** Settles credit number n of a stream (credited or abandoned: never paid twice). */
+  creditAdd(ids: I, stream: string, n: number): I;
+  allocate(ids: I, kind: string): { ids: I; number: number };
+  openCount(ids: I, kind: string): number;
+  /** null when the producer is open; otherwise why it cannot be used. */
+  producerRefusal(ids: I, kind: string, n: number): 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN' | null;
+  producer(ids: I, kind: string, n: number): ProducerInfo;
+  unit(ids: I, kind: string, n: number, u: number): UnitView;
+  reserve(ids: I, kind: string, n: number, u: number, lines: readonly QtyLine[]): I;
+  settle(ids: I, kind: string, n: number, u: number, how: Exclude<WorkOp, 'reserve'>): I;
+  close(ids: I, kind: string, n: number): I;
+  /** Retires a closed producer with no reserved unit (an invalid state otherwise). */
+  retire(ids: I, kind: string, n: number): I;
+  /** Every reserved unit of every open producer (for the reserved-balance invariant). */
+  reservedLines(ids: I): readonly QtyLine[];
+}
+
+/** The work transition of spec §3 on a unit view (shared by both stores, so both refuse identically). */
+export function workRefusal(v: UnitView, op: WorkOp): WorkRefusal | null {
+  switch (op) {
+    case 'reserve':
+      return v.state === 'none' ? null : v.state === 'reserved' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'complete':
+    case 'release':
+      if (v.state === 'reserved') return null;
+      if (v.state !== 'settled') return 'WORK_NOT_RESERVED';
+      return v.how === op ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'abandon':
+      if (v.state === 'none') return null;
+      if (v.state !== 'settled') return 'WORK_INELIGIBLE';
+      return v.how === 'abandon' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+  }
+}
diff --git a/legion-progression-lab/src/l2/l1Reference.ts b/legion-progression-lab/src/l2/l1Reference.ts
new file mode 100644
index 0000000..b4bd452
--- /dev/null
+++ b/legion-progression-lab/src/l2/l1Reference.ts
@@ -0,0 +1,162 @@
+/**
+ * The FULL identity store: the L1 full-history correctness reference for the L2.1 differential (planning/L2_1_CONTRACT.md
+ * §2.6; spec/formulas/l2.1-replay.md v2 §2 "full-history reference"). Written independently of the range-set and window
+ * code: every receipt and credit is kept for ever, units are plain maps, there is no horizon, no admission window and
+ * no receipt expiry. It applies the same producer lifecycle (closing, automatic retirement through the account).
+ *
+ * For speed over a million operations it is mutable: it is used only by the differential harness, which never relies
+ * on an old full-store value after a later delivery (and forks it with a deep copy).
+ */
+import { fail } from '../core/errors.ts';
+import type { CreditState, IdentityStore, ProducerInfo, UnitView } from './ids.ts';
+import { assertLimits, type Limits } from './limits.ts';
+import type { QtyLine } from './producers.ts';
+import type { Receipt } from './requests.ts';
+
+type UnitRec = { state: 'reserved'; lines: readonly QtyLine[] } | { state: 'settled'; how: 'complete' | 'release' | 'abandon' };
+
+export interface FullIds {
+  readonly receipts: Map<string, Map<number, { hash: string; receipt: Receipt }>>;
+  readonly credits: Map<string, Set<number>>;
+  readonly allocated: Map<string, number>;
+  readonly retired: Map<string, Set<number>>;
+  readonly units: Map<string, Map<number, UnitRec>>;
+  readonly closed: Set<string>;
+  /** Per open producer: highest unit started and reserved count (kept as plain counters). */
+  readonly meta: Map<string, { maxUnit: number; reserved: number }>;
+}
+
+const key = (kind: string, n: number) => `${kind}#${n}`;
+
+export function cloneFull(ids: FullIds): FullIds {
+  return {
+    receipts: new Map([...ids.receipts].map(([k, m]) => [k, new Map(m)])),
+    credits: new Map([...ids.credits].map(([k, s]) => [k, new Set(s)])),
+    allocated: new Map(ids.allocated),
+    retired: new Map([...ids.retired].map(([k, s]) => [k, new Set(s)])),
+    units: new Map([...ids.units].map(([k, m]) => [k, new Map(m)])),
+    closed: new Set(ids.closed),
+    meta: new Map([...ids.meta].map(([k, m]) => [k, { ...m }])),
+  };
+}
+
+/** Total receipts kept (for the retention comparison: the full store grows with history). */
+export const fullReceiptCount = (ids: FullIds): number => [...ids.receipts.values()].reduce((a, m) => a + m.size, 0);
+
+const isOpen = (ids: FullIds, kind: string, n: number) => Number.isSafeInteger(n) && n >= 1 && n <= (ids.allocated.get(kind) ?? 0) && !ids.retired.get(kind)?.has(n);
+
+function unitsOf(ids: FullIds, kind: string, n: number): Map<number, UnitRec> {
+  if (!isOpen(ids, kind, n)) fail('INVALID_STATE', `L1: work on an unusable producer ${kind}:${n}`);
+  return ids.units.get(key(kind, n)) as Map<number, UnitRec>;
+}
+
+export function fullStore(limits: Limits): IdentityStore<FullIds> {
+  assertLimits(limits);
+  const store: IdentityStore<FullIds> = {
+    name: 'full',
+    limits,
+    empty: () => ({ receipts: new Map(), credits: new Map(), allocated: new Map(), retired: new Map(), units: new Map(), closed: new Set(), meta: new Map() }),
+    fork: cloneFull,
+    maintain: (ids) => ids,
+    classify: (ids, stream, seq, hash) => {
+      if (!Number.isSafeInteger(seq) || seq < 1) return { kind: 'INVALID_REQUEST' };
+      const r = ids.receipts.get(stream)?.get(seq);
+      if (!r) return { kind: 'NEW' };
+      return r.hash === hash ? { kind: 'REPLAY', receipt: r.receipt } : { kind: 'CONFLICTING_PAYLOAD' };
+    },
+    record: (ids, stream, seq, hash, receipt) => {
+      let m = ids.receipts.get(stream);
+      if (!m) ids.receipts.set(stream, (m = new Map()));
+      if (m.has(seq)) fail('INVALID_STATE', 'L1: request recorded twice');
+      m.set(seq, { hash, receipt });
+      return ids;
+    },
+    creditState: (ids, stream, n): CreditState => {
+      if (!Number.isSafeInteger(n) || n < 1) return 'INVALID_REQUEST';
+      return ids.credits.get(stream)?.has(n) === true ? 'CREDIT_REPLAYED' : 'NEW';
+    },
+    creditAdd: (ids, stream, n) => {
+      let s = ids.credits.get(stream);
+      if (!s) ids.credits.set(stream, (s = new Set()));
+      if (s.has(n)) fail('INVALID_STATE', 'L1: credit settled twice');
+      s.add(n);
+      return ids;
+    },
+    allocate: (ids, kind) => {
+      const number = (ids.allocated.get(kind) ?? 0) + 1;
+      ids.allocated.set(kind, number);
+      ids.units.set(key(kind, number), new Map());
+      ids.meta.set(key(kind, number), { maxUnit: 0, reserved: 0 });
+      return { ids, number };
+    },
+    openCount: (ids, kind) => (ids.allocated.get(kind) ?? 0) - (ids.retired.get(kind)?.size ?? 0),
+    producerRefusal: (ids, kind, n) => {
+      if (!Number.isSafeInteger(n) || n < 1 || n > (ids.allocated.get(kind) ?? 0)) return 'PRODUCER_UNKNOWN';
+      if (ids.retired.get(kind)?.has(n)) return 'PRODUCER_RETIRED';
+      return null;
+    },
+    producer: (ids, kind, n): ProducerInfo => {
+      unitsOf(ids, kind, n);
+      const m = ids.meta.get(key(kind, n)) as { maxUnit: number; reserved: number };
+      return { maxUnit: m.maxUnit, reserved: m.reserved, closed: ids.closed.has(key(kind, n)) };
+    },
+    unit: (ids, kind, n, u): UnitView => {
+      const r = unitsOf(ids, kind, n).get(u);
+      if (!r) return { state: 'none', lines: [] };
+      return r.state === 'reserved' ? { state: 'reserved', lines: r.lines } : { state: 'settled', how: r.how };
+    },
+    reserve: (ids, kind, n, u, lines) => {
+      const units = unitsOf(ids, kind, n);
+      if (units.has(u)) fail('INVALID_STATE', `L1: unit ${u} of ${kind}:${n} reserved twice`);
+      units.set(u, { state: 'reserved', lines: lines.map((l) => ({ ...l })) });
+      const m = ids.meta.get(key(kind, n)) as { maxUnit: number; reserved: number };
+      m.maxUnit = Math.max(m.maxUnit, u);
+      m.reserved += 1;
+      return ids;
+    },
+    settle: (ids, kind, n, u, how) => {
+      const units = unitsOf(ids, kind, n);
+      const was = units.get(u);
+      if (was?.state === 'settled') fail('INVALID_STATE', `L1: unit ${u} of ${kind}:${n} settled twice`);
+      units.set(u, { state: 'settled', how });
+      const m = ids.meta.get(key(kind, n)) as { maxUnit: number; reserved: number };
+      m.maxUnit = Math.max(m.maxUnit, u);
+      if (was?.state === 'reserved') m.reserved -= 1;
+      return ids;
+    },
+    close: (ids, kind, n) => {
+      unitsOf(ids, kind, n);
+      ids.closed.add(key(kind, n));
+      return ids;
+    },
+    retire: (ids, kind, n) => {
+      const units = unitsOf(ids, kind, n);
+      if (!ids.closed.has(key(kind, n))) fail('INVALID_STATE', `L1: retiring producer ${kind}:${n} that is not closed`);
+      if ([...units.values()].some((r) => r.state === 'reserved')) fail('INVALID_STATE', `L1: retiring producer ${kind}:${n} with reserved units`);
+      let s = ids.retired.get(kind);
+      if (!s) ids.retired.set(kind, (s = new Set()));
+      s.add(n);
+      ids.units.delete(key(kind, n));
+      ids.closed.delete(key(kind, n));
+      ids.meta.delete(key(kind, n));
+      return ids;
+    },
+    reservedLines: (ids) => {
+      const out: QtyLine[] = [];
+      const keys = [...ids.units.keys()].sort((a, b) => {
+        const [ka, na] = a.split('#');
+        const [kb, nb] = b.split('#');
+        return ka !== kb ? ((ka as string) < (kb as string) ? -1 : 1) : Number(na) - Number(nb);
+      });
+      for (const k of keys) {
+        const units = ids.units.get(k) as Map<number, UnitRec>;
+        for (const u of [...units.keys()].sort((a, b) => a - b)) {
+          const r = units.get(u) as UnitRec;
+          if (r.state === 'reserved') out.push(...r.lines);
+        }
+      }
+      return out;
+    },
+  };
+  return store;
+}
diff --git a/legion-progression-lab/src/l2/limits.ts b/legion-progression-lab/src/l2/limits.ts
new file mode 100644
index 0000000..e64f801
--- /dev/null
+++ b/legion-progression-lab/src/l2/limits.ts
@@ -0,0 +1,67 @@
+/**
+ * L2.1 declared limits (planning/L2_1_CONTRACT.md §3–§5; spec/formulas/l2.1-replay.md v2 §0). Every bounded structure
+ * of the compact identity store has a declared limit, so the retained state is bounded by these numbers and never by
+ * the length of the processed history. The values are candidate test values for the synthetic account.
+ */
+import { fail } from '../core/errors.ts';
+
+export interface Limits {
+  /** Retained receipts per request stream. */
+  readonly maxRecent: number;
+  /** A receipt accepted at time a is live while now − a < maxAgeMs, and expired from a + maxAgeMs on. */
+  readonly maxAgeMs: number;
+  /** A request more than maxAhead above the stream's highest executed sequence number is refused (REQUEST_AHEAD). */
+  readonly maxAhead: number;
+  /** Request streams per account. */
+  readonly maxStreams: number;
+  /** A credit number more than creditWindow above its stream's settled prefix is refused (CREDIT_AHEAD). */
+  readonly creditWindow: number;
+  /** Credit streams per account. */
+  readonly maxCreditStreams: number;
+  /** Open (not retired) producers per kind. */
+  readonly maxOpenProducers: number;
+  /** Units per producer (a long-lived activity rotates to a new producer). */
+  readonly maxUnits: number;
+  /** Reserved (outstanding) units per producer. */
+  readonly maxOutstanding: number;
+}
+
+export const LIMIT_KEYS = ['maxRecent', 'maxAgeMs', 'maxAhead', 'maxStreams', 'creditWindow', 'maxCreditStreams', 'maxOpenProducers', 'maxUnits', 'maxOutstanding'] as const;
+
+/** Candidate limits (L2.1 contract §6): 256 receipts or 24 hours per stream; the other bounds as listed. */
+export const DEFAULT_LIMITS: Limits = Object.freeze({
+  maxRecent: 256,
+  maxAgeMs: 86_400_000,
+  maxAhead: 1024,
+  maxStreams: 8,
+  creditWindow: 4096,
+  maxCreditStreams: 8,
+  maxOpenProducers: 64,
+  maxUnits: 4096,
+  maxOutstanding: 64,
+});
+
+/** Largest supported time (ms): the largest JavaScript date; every time plus a duration stays a safe integer. */
+export const MAX_TIME_MS = 8_640_000_000_000_000;
+/** Largest gold in one credit (a domain bound on external input). */
+export const MAX_CREDIT_GOLD = 1_000_000_000;
+
+export function limitProblems(x: unknown): string[] {
+  if (typeof x !== 'object' || x === null || Array.isArray(x)) return ['limits: not an object'];
+  const o = x as Record<string, unknown>;
+  const out: string[] = [];
+  if (Object.keys(o).length !== LIMIT_KEYS.length || !LIMIT_KEYS.every((k) => Object.hasOwn(o, k))) out.push(`limits: not exactly the fields ${LIMIT_KEYS.join(', ')}`);
+  for (const k of LIMIT_KEYS) {
+    const v = o[k];
+    if (typeof v !== 'number' || !Number.isSafeInteger(v) || v < 1) out.push(`limits: ${k} is not a positive safe integer`);
+  }
+  return out;
+}
+
+export function assertLimits(l: Limits): Limits {
+  const p = limitProblems(l);
+  if (p.length > 0) fail('INVALID_NUMBER', p[0] as string, { problems: p });
+  return l;
+}
+
+export const sameLimits = (a: Limits, b: Limits): boolean => LIMIT_KEYS.every((k) => a[k] === b[k]);
diff --git a/legion-progression-lab/src/l2/partition.ts b/legion-progression-lab/src/l2/partition.ts
new file mode 100644
index 0000000..695e00c
--- /dev/null
+++ b/legion-progression-lab/src/l2/partition.ts
@@ -0,0 +1,146 @@
+/**
+ * L2.1 batch partition conformance (planning/L2_1_CONTRACT.md §1): identical productive intervals give identical
+ * results whatever their partition into storage batches. Each case draws an economy (Feat thresholds, an
+ * offline-efficiency window, action length), a schedule of gameplay deliveries (Monument purchases, recruits, queue
+ * creation and cancellation, kill credits) and a horizon; it settles the schedule once as a single batch and again with
+ * random extra settlement points, some followed by a checkpoint save and restore. The economies must be identical.
+ * The owner's worked example is checked exactly (250 ore either way).
+ *
+ * L2.1: every case draws from its own random stream (seed + case number), so cases are independent and can be run in
+ * any grouping or in parallel with identical results (`runPartitionCases` + `mergePartition`).
+ */
+import { deliver, ECONOMY_V1, newAccount, type Account, type Delivery, type Economy, type Payload } from './account.ts';
+import { makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from './checkpoint.ts';
+import { compactStore, type CompactIds } from './compactIds.ts';
+import { economyView, mulberry32, seedOf } from './differential.ts';
+import { DEFAULT_LIMITS, type Limits } from './limits.ts';
+
+/** The owner's example: 100 ore per hour; a Feat grants +50% production after 100 ore (spec §4). */
+export const OWNER_EXAMPLE: Economy = Object.freeze({ ...ECONOMY_V1, id: 'l2-econ-owner-example', y1Milli: 0, expPerAction: 0, featTiers: Object.freeze([{ threshold: 100, bp: 5000 }]) });
+
+/** Settles `schedule` (deliveries in time order) with settlement points inserted before the deliveries they precede. */
+export function settleWithPoints(econ: Economy, limits: Limits, gatherers: number, schedule: readonly Delivery[], untilMs: number, points: readonly number[], checkpointAt: ReadonlySet<number>): Account<CompactIds> {
+  const store = compactStore(limits);
+  let a = newAccount(store, econ, [1, 2, 3, 4], gatherers);
+  let seq = 0;
+  let cp = 0;
+  const settle = (at: number) => {
+    seq += 1;
+    a = deliver(a, { type: 'request', branch: 'main', atMs: at, stream: 'storage', seq, payload: { kind: 'settle', untilMs: at } }, econ, store).account;
+    if (checkpointAt.has(at)) {
+      cp += 1;
+      a = restoreCheckpoint(serializeCheckpoint(makeCheckpoint(a, econ, limits, cp)), econ, limits, 'main').account;
+    }
+  };
+  const pts = [...points].filter((p) => p <= untilMs).sort((x, y) => x - y);
+  let i = 0;
+  for (const d of schedule) {
+    while (i < pts.length && (pts[i] as number) <= d.atMs) settle(pts[i++] as number);
+    a = deliver(a, d, econ, store).account;
+  }
+  while (i < pts.length) settle(pts[i++] as number);
+  settle(untilMs);
+  return a;
+}
+
+export interface PartitionResult {
+  readonly seed: string;
+  readonly cases: number;
+  readonly partitionsChecked: number;
+  readonly withCheckpoints: number;
+  readonly mismatches: number;
+  readonly firstMismatches: readonly string[];
+  readonly ownerExample: { readonly oneBatch: number; readonly twoBatches: number; readonly manyBatches: number };
+  readonly boundaryEvents: { readonly featGrants: number; readonly levelUps: number; readonly windowEdges: number };
+}
+
+export interface CaseResult {
+  readonly c: number;
+  readonly partitions: number;
+  readonly withCheckpoints: number;
+  readonly mismatches: readonly string[];
+  readonly featGrants: number;
+  readonly levelUps: number;
+  readonly windowEdges: number;
+}
+
+export function ownerExample(points: readonly number[]): number {
+  const a = settleWithPoints(OWNER_EXAMPLE, DEFAULT_LIMITS, 1, [], 7_200_000, points, new Set());
+  return a.counters.ore;
+}
+
+/** One case, from its own random stream (independent of every other case). */
+export function runPartitionCase(seed: string, c: number, partitionsPerCase: number, limits: Limits = DEFAULT_LIMITS): CaseResult {
+  const rnd = mulberry32(seedOf(`${seed}:case:${c}`));
+  const int = (lo: number, hi: number) => lo + Math.floor(rnd() * (hi - lo + 1));
+  const horizon = int(1, 72) * 3_600_000;
+  const actionMs = int(5, 60) * 1000;
+  const offlineFrom = int(0, horizon);
+  const econ: Economy = Object.freeze({
+    ...ECONOMY_V1,
+    id: `l2-econ-case-${c}`,
+    actionMs,
+    expBase: int(20, 200),
+    featTiers: Object.freeze([{ threshold: int(5, 200), bp: int(500, 6000) }, { threshold: int(201, 3000), bp: int(500, 4000) }]),
+    efficiency: Object.freeze([{ fromMs: 0, bp: 0 }, { fromMs: offlineFrom, bp: -int(0, 5000) }, { fromMs: offlineFrom + int(1, 12) * 3_600_000, bp: -int(5000, 8000) }]),
+  });
+  const schedule: Delivery[] = [];
+  let n = 0;
+  let credit = 0;
+  for (let k = 0; k < int(0, 25); k += 1) {
+    const at = int(0, horizon);
+    const r = rnd();
+    const payload: Payload | null = r < 0.25 ? { kind: 'monument', levels: 1 } : r < 0.4 ? { kind: 'recruit' } : r < 0.6 ? { kind: 'createJob', quantity: int(1, 20) } : r < 0.7 ? { kind: 'cancelJob', job: int(1, 3) } : null;
+    if (payload) {
+      n += 1;
+      schedule.push({ type: 'request', branch: 'main', atMs: at, stream: 'play', seq: n, payload });
+    } else {
+      credit += 1;
+      schedule.push({ type: 'credit', branch: 'main', atMs: at, stream: 'squad', n: credit, gold: int(10, 400) });
+    }
+  }
+  schedule.sort((x, y) => x.atMs - y.atMs);
+  const gatherers = int(1, 4);
+  const single = settleWithPoints(econ, limits, gatherers, schedule, horizon, [], new Set());
+  const ref = economyView(single);
+  const mismatches: string[] = [];
+  let withCp = 0;
+  for (let p = 0; p < partitionsPerCase; p += 1) {
+    const points = Array.from({ length: int(1, 30) }, () => int(0, horizon));
+    // Points exactly on action ends and on the window edges are the interesting ones.
+    if (rnd() < 0.5) points.push(actionMs * int(1, Math.max(1, Math.floor(horizon / actionMs))), offlineFrom);
+    const cps = new Set(points.filter(() => rnd() < 0.3));
+    if (cps.size > 0) withCp += 1;
+    const other = settleWithPoints(econ, limits, gatherers, schedule, horizon, points, cps);
+    if (economyView(other) !== ref) mismatches.push(`case ${c} partition ${p}: economies differ (points ${points.slice(0, 5).join(',')})`);
+  }
+  return { c, partitions: partitionsPerCase, withCheckpoints: withCp, mismatches, featGrants: single.feats.length, levelUps: single.gatherers.reduce((s, g) => s + g.level - 1, 0), windowEdges: 2 };
+}
+
+/** Cases [from, to) in order. */
+export function runPartitionCases(seed: string, from: number, to: number, partitionsPerCase: number, limits: Limits = DEFAULT_LIMITS): CaseResult[] {
+  const out: CaseResult[] = [];
+  for (let c = from; c < to; c += 1) out.push(runPartitionCase(seed, c, partitionsPerCase, limits));
+  return out;
+}
+
+/** Merges case results (any grouping, any order) into the experiment result: identical for any worker count. */
+export function mergePartition(seed: string, cases: number, results: readonly CaseResult[]): PartitionResult {
+  const sorted = [...results].sort((a, b) => a.c - b.c);
+  if (sorted.length !== cases || sorted.some((r, i) => r.c !== i)) throw new Error(`partition: expected cases 0..${cases - 1}, got ${sorted.length}`);
+  const first = sorted.flatMap((r) => r.mismatches).slice(0, 10);
+  return {
+    seed,
+    cases,
+    partitionsChecked: sorted.reduce((s, r) => s + r.partitions, 0),
+    withCheckpoints: sorted.reduce((s, r) => s + r.withCheckpoints, 0),
+    mismatches: sorted.reduce((s, r) => s + r.mismatches.length, 0),
+    firstMismatches: first,
+    ownerExample: { oneBatch: ownerExample([]), twoBatches: ownerExample([3_600_000]), manyBatches: ownerExample([600_000, 1_234_567, 3_599_999, 3_600_000, 3_600_001, 5_000_000]) },
+    boundaryEvents: { featGrants: sorted.reduce((s, r) => s + r.featGrants, 0), levelUps: sorted.reduce((s, r) => s + r.levelUps, 0), windowEdges: sorted.reduce((s, r) => s + r.windowEdges, 0) },
+  };
+}
+
+export function runPartition(seed: string, cases: number, partitionsPerCase: number, limits: Limits = DEFAULT_LIMITS): PartitionResult {
+  return mergePartition(seed, cases, runPartitionCases(seed, 0, cases, partitionsPerCase, limits));
+}
diff --git a/legion-progression-lab/src/l2/producers.ts b/legion-progression-lab/src/l2/producers.ts
new file mode 100644
index 0000000..0671bd1
--- /dev/null
+++ b/legion-progression-lab/src/l2/producers.ts
@@ -0,0 +1,212 @@
+/**
+ * L2 producers and work operations (spec/formulas/l2.1-replay.md v2 §3; planning/L2_1_CONTRACT.md §4). Producer numbers
+ * are allocated monotonically per kind and never reused. Each unit moves none -> reserved -> completed | released, or
+ * none -> abandoned; completed, released and abandoned units form the producer's settled range set, reserved units a
+ * finite list with their ledger lines. Retirement drops a producer's tables and adds its number to the kind's retired
+ * range set, so retired history stays bounded.
+ *
+ * L2.1 adds the lifecycle bounds: a producer is closed when no new unit may start (a finished or cancelled job, a closed
+ * batch); new units start in order (the next unit is maxUnit + 1), at most maxUnits per producer and at most
+ * maxOutstanding reserved at once; a closed producer with no reserved unit retires at once (the account does this
+ * deterministically, in the same delivery). With units in order, the settled set's gaps are exactly the reserved units,
+ * so every producer's state is bounded by maxUnits and maxOutstanding. The transition table (`checkOp`) is unchanged
+ * from L2. Pure functions on immutable values.
+ */
+import type { Limits } from './limits.ts';
+import { addOne, count, disjoint, EMPTY_RANGE, gaps, has, isSubset, maxOf, rangeProblems, type RangeSet } from './ranges.ts';
+
+export interface QtyLine {
+  readonly resourceId: string;
+  readonly qty: number;
+}
+
+export interface ProducerState {
+  /** Every settled unit (completed, released or abandoned): the gap check and exactly-once membership. */
+  readonly settled: RangeSet;
+  /** The settled units that were released or abandoned (permanently ineligible); completed = settled minus these. */
+  readonly released: RangeSet;
+  readonly abandoned: RangeSet;
+  /** Units currently reserved, by unit number, with the lines they hold (sorted by unit). */
+  readonly reserved: readonly { readonly unit: number; readonly lines: readonly QtyLine[] }[];
+  /** Highest unit number ever started (the producer's own allocation high-water mark). */
+  readonly maxUnit: number;
+  /** L2.1: no new unit may start (finished or cancelled job, closed batch). */
+  readonly closed: boolean;
+}
+
+export interface ProducerKind {
+  readonly allocated: number;
+  readonly retired: RangeSet;
+  readonly open: Readonly<Record<string, ProducerState>>;
+}
+
+export type WorkOp = 'reserve' | 'complete' | 'release' | 'abandon';
+export type WorkRefusal = 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN' | 'WORK_REPLAYED' | 'WORK_INELIGIBLE' | 'WORK_NOT_RESERVED' | 'INVALID_REQUEST';
+export type AdmissionRefusal = 'PRODUCER_CLOSED' | 'WORK_OUT_OF_ORDER' | 'PRODUCER_FULL' | 'WORK_LIMIT';
+
+export const EMPTY_KIND: ProducerKind = Object.freeze({ allocated: 0, retired: EMPTY_RANGE, open: Object.freeze({}) });
+export const EMPTY_PRODUCER: ProducerState = Object.freeze({ settled: EMPTY_RANGE, released: EMPTY_RANGE, abandoned: EMPTY_RANGE, reserved: Object.freeze([]), maxUnit: 0, closed: false });
+
+/** Allocates the next producer number of a kind (never reused). */
+export function allocate(k: ProducerKind): { kind: ProducerKind; number: number } {
+  const number = k.allocated + 1;
+  if (!Number.isSafeInteger(number)) throw new Error('producer numbers exhausted');
+  return { kind: Object.freeze({ ...k, allocated: number, open: Object.freeze({ ...k.open, [String(number)]: EMPTY_PRODUCER }) }), number };
+}
+
+export function producerOf(k: ProducerKind, n: number): ProducerState | WorkRefusal {
+  if (!Number.isSafeInteger(n) || n < 1 || n > k.allocated) return 'PRODUCER_UNKNOWN';
+  if (has(k.retired, n)) return 'PRODUCER_RETIRED';
+  return k.open[String(n)] ?? 'PRODUCER_UNKNOWN';
+}
+
+export type UnitState = 'none' | 'reserved' | 'settled';
+
+export function unitState(p: ProducerState, u: number): UnitState {
+  if (has(p.settled, u)) return 'settled';
+  return p.reserved.some((r) => r.unit === u) ? 'reserved' : 'none';
+}
+
+/** How a settled unit was settled. */
+export function settledAs(p: ProducerState, u: number): WorkOp {
+  return has(p.released, u) ? 'release' : has(p.abandoned, u) ? 'abandon' : 'complete';
+}
+
+/** The transition of spec §3 for one unit, validated only (the account applies the ledger part). Unchanged from L2. */
+export function checkOp(p: ProducerState, u: number, op: WorkOp): WorkRefusal | null {
+  if (!Number.isSafeInteger(u) || u < 1) return 'INVALID_REQUEST';
+  const st = unitState(p, u);
+  const how = st === 'settled' ? settledAs(p, u) : null;
+  switch (op) {
+    case 'reserve':
+      return st === 'none' ? null : st === 'reserved' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'complete':
+    case 'release':
+      if (st === 'reserved') return null;
+      if (st === 'none') return 'WORK_NOT_RESERVED';
+      return how === op ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'abandon':
+      if (st === 'none') return null;
+      return how === 'abandon' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+  }
+}
+
+/** L2.1 admission of a new unit (reserve or abandon from `none`), after the transition table allowed it (spec §3.2). */
+export function admitNewUnit(info: { readonly maxUnit: number; readonly reserved: number; readonly closed: boolean }, u: number, op: 'reserve' | 'abandon', limits: Limits): AdmissionRefusal | null {
+  if (info.closed) return 'PRODUCER_CLOSED';
+  if (u !== info.maxUnit + 1) return 'WORK_OUT_OF_ORDER';
+  if (u > limits.maxUnits) return 'PRODUCER_FULL';
+  if (op === 'reserve' && info.reserved >= limits.maxOutstanding) return 'WORK_LIMIT';
+  return null;
+}
+
+export function withReserve(p: ProducerState, u: number, lines: readonly QtyLine[]): ProducerState {
+  const reserved = [...p.reserved, Object.freeze({ unit: u, lines: Object.freeze(lines.map((l) => Object.freeze({ resourceId: l.resourceId, qty: l.qty }))) })].sort((a, b) => a.unit - b.unit);
+  return Object.freeze({ ...p, reserved: Object.freeze(reserved), maxUnit: Math.max(p.maxUnit, u) });
+}
+
+/** Settles a unit (complete, release or abandon): it leaves the reserved map and joins the settled range set. */
+export function withSettled(p: ProducerState, u: number, how: Exclude<WorkOp, 'reserve'>): ProducerState {
+  return Object.freeze({
+    settled: addOne(p.settled, u),
+    released: how === 'release' ? addOne(p.released, u) : p.released,
+    abandoned: how === 'abandon' ? addOne(p.abandoned, u) : p.abandoned,
+    reserved: Object.freeze(p.reserved.filter((r) => r.unit !== u)),
+    maxUnit: Math.max(p.maxUnit, u),
+    closed: p.closed,
+  });
+}
+
+export const withClosed = (p: ProducerState): ProducerState => (p.closed ? p : Object.freeze({ ...p, closed: true }));
+
+export function reservedLines(p: ProducerState, u: number): readonly QtyLine[] {
+  return p.reserved.find((r) => r.unit === u)?.lines ?? [];
+}
+
+export type RetireRefusal = 'RETIRE_OPEN_WORK' | 'RETIRE_GAP' | 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN';
+
+/** Spec §3 retire: no reserved unit and a settled set without gaps; then the number joins the retired set. */
+export function retire(k: ProducerKind, n: number): ProducerKind | RetireRefusal {
+  const p = producerOf(k, n);
+  if (typeof p === 'string') return p === 'PRODUCER_RETIRED' ? 'PRODUCER_RETIRED' : 'PRODUCER_UNKNOWN';
+  if (p.reserved.length > 0) return 'RETIRE_OPEN_WORK';
+  if (gaps(p.settled).length > 0 || p.settled.runs.length > 0) return 'RETIRE_GAP';
+  const open = { ...k.open };
+  delete open[String(n)];
+  return Object.freeze({ allocated: k.allocated, retired: addOne(k.retired, n), open: Object.freeze(open) });
+}
+
+// ---------------------------------------------------------------- L2.1 validation (exact, interval arithmetic)
+const isInt = (v: unknown, min = 0): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v >= min;
+const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
+const CANONICAL_NUMBER = /^[1-9][0-9]*$/;
+
+/**
+ * Problems of one decoded producer (spec §5.3). Never throws; complexity is linear in the retained structure (runs and
+ * reserved units), never in the units' numeric range.
+ */
+export function producerProblems(x: unknown, what: string, limits: Limits, resources: readonly string[]): string[] {
+  if (!isObj(x)) return [`${what}: not an object`];
+  const K = ['settled', 'released', 'abandoned', 'reserved', 'maxUnit', 'closed'];
+  if (Object.keys(x).length !== K.length || !K.every((k) => Object.hasOwn(x, k))) return [`${what}: not exactly the fields ${K.join(', ')}`];
+  const out: string[] = [];
+  for (const k of ['settled', 'released', 'abandoned']) out.push(...rangeProblems(x[k], `${what} ${k}`));
+  if (!isInt(x['maxUnit'])) out.push(`${what}: maxUnit is not a non-negative safe integer`);
+  if (typeof x['closed'] !== 'boolean') out.push(`${what}: closed is not a boolean`);
+  if (!Array.isArray(x['reserved'])) out.push(`${what}: reserved is not a list`);
+  if (out.length > 0) return out;
+  const p = x as unknown as ProducerState;
+  if (p.maxUnit > limits.maxUnits) out.push(`${what}: maxUnit ${p.maxUnit} exceeds maxUnits ${limits.maxUnits}`);
+  if (!isSubset(p.released, p.settled)) out.push(`${what}: a released unit is not settled`);
+  if (!isSubset(p.abandoned, p.settled)) out.push(`${what}: an abandoned unit is not settled`);
+  if (!disjoint(p.released, p.abandoned)) out.push(`${what}: a unit is both released and abandoned`);
+  if (maxOf(p.settled) > p.maxUnit) out.push(`${what}: a settled unit above maxUnit ${p.maxUnit}`);
+  if (p.reserved.length > limits.maxOutstanding) out.push(`${what}: ${p.reserved.length} reserved units exceed maxOutstanding ${limits.maxOutstanding}`);
+  let prev = 0;
+  for (const r0 of p.reserved as unknown[]) {
+    if (!isObj(r0) || Object.keys(r0).length !== 2 || !isInt(r0['unit'], 1) || !Array.isArray(r0['lines'])) {
+      out.push(`${what}: a reserved unit is malformed`);
+      continue;
+    }
+    const u = r0['unit'] as number;
+    if (u <= prev) out.push(`${what}: reserved units are not strictly ascending at ${u}`);
+    prev = u;
+    if (u > p.maxUnit) out.push(`${what}: reserved unit ${u} above maxUnit ${p.maxUnit}`);
+    if (has(p.settled, u)) out.push(`${what}: unit ${u} is both settled and reserved`);
+    const lines = r0['lines'] as unknown[];
+    if (lines.length === 0 || !lines.every((l) => isObj(l) && Object.keys(l).length === 2 && typeof l['resourceId'] === 'string' && resources.includes(l['resourceId']) && isInt(l['qty'], 1))) out.push(`${what}: reserved unit ${u} lines are malformed`);
+  }
+  if (out.length > 0) return out;
+  // With units started in order, settled ∪ reserved is exactly 1..maxUnit: the complement of the settled set below
+  // maxUnit has exactly as many units as are reserved, and every reserved unit lies in it (checked above).
+  if (p.maxUnit - count(p.settled) !== p.reserved.length) out.push(`${what}: units 1..${p.maxUnit} are not exactly the settled and reserved units (a unit was skipped)`);
+  if (p.closed && p.reserved.length === 0) out.push(`${what}: closed with no reserved unit but not retired (automatic retirement)`);
+  return out;
+}
+
+/** Problems of one decoded producer kind (spec §5.3): open and retired numbers partition 1..allocated exactly. */
+export function kindProblems(x: unknown, what: string, limits: Limits, resources: readonly string[]): string[] {
+  if (!isObj(x) || Object.keys(x).length !== 3 || !['allocated', 'retired', 'open'].every((k) => Object.hasOwn(x, k))) return [`${what}: not exactly the fields allocated, retired, open`];
+  const out: string[] = [];
+  if (!isInt(x['allocated'])) out.push(`${what}: allocated is not a non-negative safe integer`);
+  out.push(...rangeProblems(x['retired'], `${what} retired`));
+  if (!isObj(x['open'])) out.push(`${what}: open is not an object`);
+  if (out.length > 0) return out;
+  const k = x as unknown as ProducerKind;
+  const keys = Object.keys(k.open);
+  if (keys.length > limits.maxOpenProducers) out.push(`${what}: ${keys.length} open producers exceed maxOpenProducers ${limits.maxOpenProducers}`);
+  if (maxOf(k.retired) > k.allocated) out.push(`${what}: a retired number above allocated ${k.allocated}`);
+  for (const key of keys) {
+    if (!CANONICAL_NUMBER.test(key) || !isInt(Number(key), 1)) {
+      out.push(`${what}: open key ${JSON.stringify(key)} is not a canonical producer number`);
+      continue;
+    }
+    const n = Number(key);
+    if (n > k.allocated) out.push(`${what}: open producer ${n} above allocated ${k.allocated}`);
+    if (has(k.retired, n)) out.push(`${what}: producer ${n} is both open and retired`);
+    out.push(...producerProblems(k.open[key], `${what}:${n}`, limits, resources));
+  }
+  // Disjoint, both inside 1..allocated, and together exactly allocated numbers: they cover 1..allocated.
+  if (out.length === 0 && count(k.retired) + keys.length !== k.allocated) out.push(`${what}: open and retired producers do not cover 1..${k.allocated} exactly`);
+  return out;
+}
