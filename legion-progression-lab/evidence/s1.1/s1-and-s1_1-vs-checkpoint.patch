index 0000000..2b6fd1c
--- /dev/null
+++ b/legion-progression-lab/repro/s1.1/defects.mjs
@@ -0,0 +1,295 @@
+/**
+ * S1.1 defect reproductions (owner review "Independent S1 Review and S1.1 Authorisation", sections 2-7).
+ *
+ * Runs the same scenarios against any lab implementation and prints one JSON object:
+ *   node repro/s1.1/defects.mjs <lab directory>
+ * <lab directory> is either the original S1 implementation (the extracted S1 review package, ZIP SHA-256
+ * b255d94ba35c6649d70d838f44f39bda5fde6c7f2b12332adbecb9b1ef6d7fd3) or the corrected working tree.
+ *
+ * It uses only interfaces that exist in both: the Simulation class, its log observers, content compilation,
+ * makePolicy, MetricsRecorder and estimateZone. The duplicate kill credit (D1) is injected through the engine's
+ * internal scheduler, exactly as an adversarial test would do; nothing in the engine generates it.
+ * Plain JavaScript (no type annotations) so that it is not tied to either implementation's types.
+ */
+import { resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const lab = resolve(process.argv[2] ?? '.');
+const imp = (p) => import(pathToFileURL(resolve(lab, p)).href);
+const { readS1Pack } = await imp('src/cli/s1-content.ts');
+const { compileContentS1 } = await imp('src/model/content.ts');
+const { Simulation } = await imp('src/engine/simulation.ts');
+const { MetricsRecorder } = await imp('src/experiments/metrics.ts');
+const { makePolicy } = await imp('src/experiments/jobs.ts');
+const { estimateZone } = await imp('src/engine/estimator.ts');
+const { balance } = await imp('src/core/ledger/ledger.ts');
+
+const CREDIT_PHASE = 2;
+
+function compile(edit = () => {}) {
+  const { pack, table } = readS1Pack();
+  const p = JSON.parse(JSON.stringify(pack));
+  edit(p);
+  return compileContentS1(p, table);
+}
+const force = (labelled, value) => {
+  labelled.value = value;
+  delete labelled.range;
+};
+const slime = (p) => p.enemies.find((e) => e.id === 'enemy.w1.green_slime');
+const triggersOf = (obs) => (Array.isArray(obs.triggers) ? [...obs.triggers] : [obs.trigger]);
+const busy = (obs) => !obs.sessionOpen || ['dead', 'travelling', 'boss'].includes(obs.hero.status);
+const AUTO = {
+  id: 'REPRO-AUTOFARM',
+  kind: 'realistic',
+  decide: (obs) => (busy(obs) || obs.hero.autoFarm ? [] : [{ type: 'SetAutoFarm', on: true, zoneId: obs.hero.zoneId }]),
+};
+const cumulativeExp = (content, hero) => {
+  let total = hero.expIntoLevel;
+  for (let l = 1; l < hero.level; l += 1) total += content.table[l - 1];
+  return total;
+};
+const has = (id) => {
+  try {
+    makePolicy(id);
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+// ------------------------------------------------------------ D1 (owner section 2): duplicate KillCredited
+function d1(inject, seedRoot) {
+  try {
+    return d1Run(inject, seedRoot);
+  } catch (err) {
+    return { seedRoot, runAborted: true, error: String(err.message ?? err) };
+  }
+}
+function d1Run(inject, seedRoot) {
+  const content = compile((p) => force(p.hero.critChanceBp, 0));
+  const sim = new Simulation({ content, seedRoot, sessions: [{ startMs: 0, endMs: 60_000 }], policy: AUTO, keepLog: 100_000 });
+  let first = null;
+  sim.addObserver((e, s) => {
+    if (inject && first === null && e.kind === 'EnemyKilled' && e.detail.boss === false) {
+      first = { t: e.t, encounterId: e.detail.encounterId, instanceId: e.detail.instanceId };
+      // A second KillCredited for the same encounter and enemy instance, at the same moment (CREDIT phase).
+      s.schedule(e.t, CREDIT_PHASE, 'account', 'KillCredited', {
+        data: { encounterId: e.detail.encounterId, instanceId: e.detail.instanceId, zoneOrder: e.detail.zoneOrder, boss: false },
+      });
+    }
+  });
+  sim.run(12_000); // the first kill is at 10,400 ms; the second would be at 14,300 ms
+  const st = sim.state;
+  return {
+    seedRoot,
+    runAborted: false,
+    injectedDuplicateOf: first,
+    gold: balance(st.ledger, 'res.gold'),
+    cumulativeExp: cumulativeExp(content, st.hero),
+    zone1Kills: st.zones[0].kills,
+    duplicateCreditsCounter: sim.counters.duplicateCredits,
+    rejectedCredits: sim.counters.rejectedCredits ?? null,
+    lootRngState: Array.from(st.rng.loot),
+    creditLogEntries: sim.keptLog.filter((e) => e.kind === 'KillCredited').length,
+    rejectionLogEntries: sim.keptLog.filter((e) => e.kind === 'KillCreditRejected').map((e) => e.detail),
+  };
+}
+
+// ------------------------------------------------------------ D2 (owner section 3): repeated deaths, fixed zone 3
+function d2(policyId) {
+  const content = compile();
+  const sim = new Simulation({
+    content,
+    seedRoot: 'repro-d2#rep-0',
+    sessions: [{ startMs: 0, endMs: 3_600_000 }],
+    policy: makePolicy(policyId),
+    diagnostic: { startLevel: 1, freezeLevel: true, startZoneOrder: 3, unlockAllZones: true },
+    keepLog: 0,
+  });
+  const stops = [];
+  const enables = [];
+  const reports = [];
+  let deaths = 0;
+  let kills = 0;
+  sim.addObserver((e) => {
+    if (e.kind === 'AutoFarmStopped') stops.push(e.t);
+    if (e.kind === 'CommandAccepted' && e.detail.command === 'SetAutoFarm' && e.detail.target !== null) enables.push(e.t);
+    if (e.kind === 'HeroDied') deaths += 1;
+    if (e.kind === 'KillCredited') kills += 1;
+    if (e.kind === 'PolicyReport') reports.push({ t: e.t, ...e.detail });
+  });
+  sim.run(3_600_000);
+  return {
+    policy: policyId,
+    firstAutoFarmStopMs: stops[0] ?? null,
+    firstReEnableAfterStopMs: enables.find((t) => stops.length > 0 && t > stops[0]) ?? null,
+    deathsIn60Min: deaths,
+    autoFarmStopsIn60Min: stops.length,
+    killsIn60Min: kills,
+    finalZone: sim.state.hero.zoneOrder,
+    policyReports: reports.slice(0, 3),
+  };
+}
+
+// ------------------------------------------------------------ D3 (owner section 4): triggers lost at gate completion
+function d3(policyId) {
+  const content = compile();
+  const inner = makePolicy(policyId);
+  const decisions = [];
+  const policy = {
+    id: `REPRO-RECORD(${policyId})`,
+    kind: inner.kind,
+    decide(obs, oracle) {
+      decisions.push({ t: obs.tMs, triggers: triggersOf(obs) });
+      return inner.decide(obs, oracle);
+    },
+  };
+  const sim = new Simulation({ content, seedRoot: 's1-e01#rep-0', sessions: [{ startMs: 0, endMs: 3_600_000 }], policy, keepLog: 0 });
+  const gates = [];
+  sim.addObserver((e) => {
+    if (e.kind === 'GateCompleted') gates.push({ t: e.t, gateId: e.detail.gateId });
+  });
+  sim.run(1_200_000);
+  return {
+    policy: policyId,
+    gateCompletions: gates.map((g) => ({ ...g, triggersSeenByPolicyAtThatMoment: decisions.filter((d) => d.t === g.t).map((d) => d.triggers) })),
+  };
+}
+
+// ------------------------------------------------------------ D4 (owner section 5): estimator on impossible farming
+function d4() {
+  const content = compile();
+  const withThreshold = (thr) => ({ ...content, zones: content.zones.map((z, i) => (i === 0 ? { ...z, heroHitThreshold: thr } : z)) });
+  const pick = (e) => ({
+    killsPerHour: e.killsPerHour,
+    ttkS: e.ttkS,
+    deathsPerHour: e.deathsPerHour,
+    killsPerLife: e.killsPerLife,
+    limitingFactor: e.limitingFactor,
+    reliability: e.reliability ?? null,
+    reasons: e.reasons ?? null,
+  });
+  return {
+    zeroHitChance: pick(estimateZone(withThreshold(0), 1, 1)),
+    oneIn4BillionHitChance: pick(estimateZone(withThreshold(1), 1, 1)),
+    level1Zone3DiesBeforeKill: pick(estimateZone(content, 1, 3)),
+  };
+}
+
+// ------------------------------------------------------------ D5 (owner section 6): drop quantities vs drop events
+function d5(drops) {
+  const content = compile((p) => {
+    slime(p).drops = drops.map((d) => ({ resourceId: d.resourceId, chanceBp: { value: d.chanceBp, label: 'candidate' }, qty: { value: d.qty, label: 'candidate' } }));
+  });
+  const sim = new Simulation({ content, seedRoot: 'repro-d5', sessions: [{ startMs: 0, endMs: 62_000 }], policy: AUTO, keepLog: 0 });
+  const rec = new MetricsRecorder(sim);
+  sim.run(62_000);
+  const m = rec.finish(sim, 62_000);
+  return {
+    drops,
+    kills: m.totalKills,
+    ledgerGel: balance(sim.state.ledger, 'res.mat.slime_gel'),
+    metricsDropsGel: m.drops['res.mat.slime_gel'] ?? 0,
+    metricsMaterialsGel: m.materials ? (m.materials['res.mat.slime_gel'] ?? 0) : null,
+  };
+}
+
+// ------------------------------------------------------------ D6 (owner section 7): auto-farm off after the first kill
+function d6() {
+  const content = compile((p) => force(p.hero.critChanceBp, 0));
+  const policy = {
+    id: 'REPRO-AUTO-THEN-OFF',
+    kind: 'realistic',
+    decide(obs) {
+      if (busy(obs)) return [];
+      if (obs.zones[0].kills === 0 && !obs.hero.autoFarm) return [{ type: 'SetAutoFarm', on: true, zoneId: obs.hero.zoneId }];
+      if (obs.zones[0].kills >= 1 && obs.hero.autoFarm) return [{ type: 'SetAutoFarm', on: false }];
+      return [];
+    },
+  };
+  const sim = new Simulation({ content, seedRoot: 'repro-d6', sessions: [{ startMs: 0, endMs: 60_000 }], policy, keepLog: 100_000 });
+  sim.run(60_000);
+  const log = sim.keptLog;
+  return {
+    autoFarmOffAtMs: log.find((e) => e.kind === 'CommandAccepted' && e.detail.command === 'SetAutoFarm' && e.detail.target === null)?.t ?? null,
+    killsIn60s: log.filter((e) => e.kind === 'KillCredited').length,
+    killTimesMs: log.filter((e) => e.kind === 'KillCredited').map((e) => e.t),
+    engagementsStarted: log.filter((e) => e.kind === 'EngageStarted').map((e) => ({ t: e.t, origin: e.detail.origin ?? null })),
+  };
+}
+
+// ------------------------------------------------------------ D7 (section 7 audit): regeneration after a manual kill
+function d7() {
+  const content = compile((p) => force(p.hero.critChanceBp, 0));
+  const policy = { id: 'REPRO-ENGAGE-ONCE', kind: 'realistic', decide: (obs) => (triggersOf(obs).includes('session-start') ? [{ type: 'Engage' }] : []) };
+  const sim = new Simulation({ content, seedRoot: 'repro-d7', sessions: [{ startMs: 0, endMs: 60_000 }], policy, keepLog: 100_000 });
+  sim.run(60_000);
+  const log = sim.keptLog;
+  return {
+    killAtMs: log.find((e) => e.kind === 'KillCredited')?.t ?? null,
+    hpAfterFight: log.filter((e) => e.kind === 'EnemyHit').map((e) => e.detail.heroHp).pop() ?? null,
+    regenTicksWhileIdle: log.filter((e) => e.kind === 'Regen').length,
+    hpAtSessionEnd: sim.state.hero.hp,
+    maxHp: sim.state.hero.maxHp,
+  };
+}
+
+// ------------------------------------------------------------ D8 (section 7 audit): a manual engage survives the session end
+function d8() {
+  const content = compile((p) => {
+    force(p.hero.critChanceBp, 0);
+    force(p.zones[0].spawnSlots, 1);
+    force(p.zones[0].respawnMs, 60_000);
+  });
+  const policy = {
+    id: 'REPRO-ENGAGE-TWICE',
+    kind: 'realistic',
+    decide(obs) {
+      if (busy(obs) || obs.tMs >= 30_000) return [];
+      if (obs.zones[0].kills === 0 && triggersOf(obs).includes('session-start')) return [{ type: 'Engage' }];
+      if (obs.zones[0].kills === 1 && triggersOf(obs).includes('kill')) return [{ type: 'Engage' }]; // no enemy alive: waits
+      return [];
+    },
+  };
+  const sim = new Simulation({
+    content,
+    seedRoot: 'repro-d8',
+    sessions: [
+      { startMs: 0, endMs: 30_000 },
+      { startMs: 60_000, endMs: 120_000 },
+    ],
+    policy,
+    keepLog: 100_000,
+  });
+  sim.run(120_000);
+  const log = sim.keptLog;
+  return {
+    killsInSession1: log.filter((e) => e.kind === 'KillCredited' && e.t < 30_000).length,
+    commandsInSession2: log.filter((e) => e.kind === 'CommandAccepted' && e.t >= 60_000).length,
+    killsInSession2: log.filter((e) => e.kind === 'KillCredited' && e.t >= 60_000).length,
+    engagementsInSession2: log.filter((e) => e.kind === 'EngageStarted' && e.t >= 60_000).map((e) => e.t),
+  };
+}
+
+const out = {
+  lab: process.argv[2] ? 'as given' : '.',
+  implementation: has('CTL-STAY-S1') ? 'corrected (S1.1)' : 'original (S1)',
+  // Seeds a-f: with the original code the duplicate either doubles EXP and kills (when its fresh loot roll happens to
+  // equal the first one, so the ledger treats it as a replay) or aborts the run with TX_CONFLICT (when it differs).
+  D1_duplicateKillCredit: ['a', 'b', 'c', 'd', 'e', 'f'].map((s) => ({ withoutInjection: d1(false, `repro-d1-${s}`), withInjectedDuplicate: d1(true, `repro-d1-${s}`) })),
+  D2_repeatedDeaths: ['POL-FIXED-3', 'CTL-FIXED-3-S1'].filter(has).map(d2),
+  D3_policyTriggers: ['POL-STAY', 'CTL-STAY-S1'].filter(has).map(d3),
+  D4_estimator: d4(),
+  D5_dropQuantities: {
+    threePerKill: d5([{ resourceId: 'res.mat.slime_gel', chanceBp: 10_000, qty: 3 }]),
+    repeatedResource: d5([
+      { resourceId: 'res.mat.slime_gel', chanceBp: 10_000, qty: 2 },
+      { resourceId: 'res.mat.slime_gel', chanceBp: 10_000, qty: 1 },
+    ]),
+  },
+  D6_autoFarmOff: d6(),
+  D7_regenAfterManualKill: d7(),
+  D8_manualEngageAcrossSessions: d8(),
+};
+process.stdout.write(`${JSON.stringify(out, null, 2)}\n`);
diff --git a/legion-progression-lab/src/cli/bench-ledger.ts b/legion-progression-lab/src/cli/bench-ledger.ts
new file mode 100644
index 0000000..0c65e98
--- /dev/null
+++ b/legion-progression-lab/src/cli/bench-ledger.ts
@@ -0,0 +1,298 @@
+/**
+ * S1 ledger benchmark (planning/S1_LEDGER_BENCHMARK_PROPOSAL.md; budgets pre-registered in
+ * manifests/s1/PREREGISTRATION.md section 6).   node --expose-gc src/cli/bench-ledger.ts [--quick]
+ *
+ * Staged: each workload runs once; within budget it repeats up to 5 runs or 5 x 120 s of stage time; a run over
+ * budget (120 s wall-clock or 2 GiB heap) is stopped and reported as timed out at N transactions, and every larger
+ * workload is reported as not run. Nothing projected is reported as measured.
+ * Timings are environment measurements (this machine); they are not part of any semantic fingerprint.
+ */
+import { resolve } from 'node:path';
+import { arch, cpus, platform, release } from 'node:os';
+import { isLabError } from '../core/errors.ts';
+import { canonicalJson } from '../core/hash/canonicalJson.ts';
+import { applyTx, emptyLedger, type Ledger, type Tx, type TxLine, type TxResult } from '../core/ledger/ledger.ts';
+import { uniformInt } from '../core/rng/sample.ts';
+import { deriveRngState } from '../core/rng/streamId.ts';
+import type { RngState } from '../core/rng/xoshiro128ss.ts';
+import { Simulation } from '../engine/simulation.ts';
+import { POL_FRONTIER } from '../policy/realistic.ts';
+import { protoApply, protoEmpty, type ProtoLedger } from './bench/hamtLedger.ts';
+import { LAB_ROOT, prettyJson, writeText } from './paths.ts';
+import { loadS1Content } from './s1-content.ts';
+
+const QUICK = process.argv.includes('--quick');
+const BUDGET_MS = 120_000;
+const BUDGET_HEAP = 2 * 1024 ** 3;
+const STAGE_MS = 5 * BUDGET_MS;
+const MAX_RUNS = 5;
+const gc = (globalThis as { gc?: () => void }).gc ?? (() => {});
+
+const WORKLOADS = [
+  { id: 'W-small', workers: 1, hours: 24, tx: 2_880 },
+  { id: 'W-day', workers: 10, hours: 24, tx: 28_800 },
+  { id: 'W-week', workers: 10, hours: 168, tx: 201_600 },
+  { id: 'W-legion', workers: 50, hours: 168, tx: 1_008_000 },
+  { id: 'W-month', workers: 50, hours: 720, tx: 4_320_000 },
+];
+
+// ------------------------------------------------------------ deterministic workload (seeded)
+const MATS = ['res.mat.slime_gel', 'res.mat.wolf_fang', 'res.mat.goblin_scrap'];
+class WorkloadGen {
+  private s: RngState;
+  private gold = 0;
+  private readonly mats = [0, 0, 0];
+  private readonly recent: Tx[] = [];
+  private i = 0;
+  constructor(seed: string) {
+    this.s = deriveRngState({ root: seed, purpose: 'bench.ledger', entity: 'workload', counter: 0 });
+  }
+  private roll(lo: number, hi: number): number {
+    const r = uniformInt(this.s, lo, hi);
+    this.s = r.state;
+    return r.value;
+  }
+  next(): Tx {
+    const i = this.i++;
+    const r = this.roll(0, 9999);
+    if (r < 10 && this.recent.length > 0) {
+      const old = this.recent[this.roll(0, this.recent.length - 1)] as Tx;
+      return { ...old, lines: old.lines.map((l, k) => (k === 0 ? { ...l, delta: l.delta + 1 } : l)) }; // conflict
+    }
+    if (r < 110 && this.recent.length > 0) return this.recent[this.roll(0, this.recent.length - 1)] as Tx; // replay
+    let tx: Tx;
+    const m = this.roll(0, 2);
+    if (r < 310 && this.gold >= 5 && (this.mats[m] as number) >= 1) {
+      tx = {
+        txId: `w:${i}`,
+        purpose: 'craft',
+        lines: [
+          { resourceId: 'res.gold', bucket: 'available', delta: -5 },
+          { resourceId: MATS[m] as string, bucket: 'available', delta: -1 },
+          { resourceId: 'res.mat.crafted', bucket: 'available', delta: 1 },
+          { resourceId: 'res.gold', bucket: 'available', delta: 1 },
+        ],
+      };
+      this.gold -= 4;
+      this.mats[m] = (this.mats[m] as number) - 1;
+    } else {
+      const lines: TxLine[] = [{ resourceId: 'res.gold', bucket: 'available', delta: this.roll(1, 6) }];
+      this.gold += lines[0]?.delta as number;
+      for (let k = 0; k < 2; k += 1) {
+        if (this.roll(0, 3) === 0) {
+          const mm = this.roll(0, 2);
+          lines.push({ resourceId: MATS[mm] as string, bucket: 'available', delta: 1 });
+          this.mats[mm] = (this.mats[mm] as number) + 1;
+        }
+      }
+      tx = { txId: `w:${i}`, purpose: 'kill.reward', lines };
+    }
+    this.recent.push(tx);
+    if (this.recent.length > 1000) this.recent.shift();
+    return tx;
+  }
+  pickRecent(): Tx {
+    return this.recent[this.roll(0, this.recent.length - 1)] as Tx;
+  }
+}
+
+// ------------------------------------------------------------ one run
+interface Impl<L> {
+  readonly id: string;
+  empty(): L;
+  apply(l: L, tx: Tx): { ledger: L; result: TxResult };
+}
+const PRODUCTION: Impl<Ledger> = { id: 'production (copy-on-commit)', empty: emptyLedger, apply: applyTx };
+const PROTOTYPE: Impl<ProtoLedger> = { id: 'prototype (persistent hash trie, benchmark-only)', empty: protoEmpty, apply: protoApply };
+
+function pct(sorted: Float64Array, q: number): number {
+  return sorted.length ? (sorted[Math.min(sorted.length - 1, Math.max(0, Math.ceil(q * sorted.length) - 1))] as number) : 0;
+}
+
+function runOnce<L>(impl: Impl<L>, total: number, seed: string) {
+  gc();
+  const gen = new WorkloadGen(seed);
+  let ledger = impl.empty();
+  const lat = new Float64Array(total);
+  const slices: { atTx: number; medianUs: number; p99Us: number; heapMB: number }[] = [];
+  const marks = new Set([Math.ceil(total * 0.1), Math.ceil(total * 0.5), total]);
+  let conflicts = 0;
+  let replays = 0;
+  let done = 0;
+  let stop: string | null = null;
+  const t0 = performance.now();
+  for (; done < total; ) {
+    const tx = gen.next();
+    const a = performance.now();
+    try {
+      const out = impl.apply(ledger, tx);
+      ledger = out.ledger;
+      if (out.result.replayed) replays += 1;
+    } catch (e) {
+      if (!isLabError(e) || e.code !== 'TX_CONFLICT') throw e;
+      conflicts += 1;
+    }
+    lat[done] = (performance.now() - a) * 1000;
+    done += 1;
+    if (marks.has(done)) {
+      const from = Math.max(0, done - Math.ceil(total * 0.1));
+      const window = Float64Array.from(lat.subarray(from, done)).sort();
+      gc();
+      slices.push({ atTx: done, medianUs: pct(window, 0.5), p99Us: pct(window, 0.99), heapMB: process.memoryUsage().heapUsed / 2 ** 20 });
+    }
+    if (done % 500 === 0) {
+      if (performance.now() - t0 > BUDGET_MS) stop = `wall-clock budget (${BUDGET_MS / 1000} s)`;
+      else if (process.memoryUsage().heapUsed > BUDGET_HEAP) stop = 'heap budget (2 GiB)';
+      if (stop) break;
+    }
+  }
+  const elapsed = performance.now() - t0;
+  // Replay cost at the end: median of 1,000 replays of recent transactions.
+  const rl = new Float64Array(1000);
+  for (let k = 0; k < 1000; k += 1) {
+    const tx = gen.pickRecent();
+    const a = performance.now();
+    try {
+      impl.apply(ledger, tx);
+    } catch {
+      /* a conflicting copy may be picked; timing still counts */
+    }
+    rl[k] = (performance.now() - a) * 1000;
+  }
+  rl.sort();
+  let stateBytes: number | null = null;
+  if (impl === (PRODUCTION as unknown as Impl<L>)) {
+    const l = ledger as unknown as Ledger;
+    stateBytes = Buffer.byteLength(canonicalJson({ balances: [...l.balances.entries()].map(([k, v]) => [k, v.available, v.reserved]), committed: [...l.committed.entries()].map(([k, v]) => [k, v.payloadHash]) }));
+  }
+  return {
+    transactions: done,
+    completed: stop === null,
+    stoppedBy: stop,
+    elapsedMs: elapsed,
+    txPerSecond: (done / elapsed) * 1000,
+    slices,
+    replayMedianUs: pct(rl, 0.5),
+    replays,
+    conflicts,
+    stateBytes,
+  };
+}
+
+function stage<L>(impl: Impl<L>) {
+  const rows: unknown[] = [];
+  let exceeded: string | null = null;
+  for (const w of QUICK ? WORKLOADS.slice(0, 2) : WORKLOADS) {
+    if (exceeded) {
+      rows.push({ workload: w.id, transactions: w.tx, status: `not run: ${exceeded} already exceeded the budget` });
+      continue;
+    }
+    const runs: ReturnType<typeof runOnce>[] = [];
+    const s0 = performance.now();
+    do {
+      const r = runOnce(impl, w.tx, `bench-${w.id}`);
+      runs.push(r);
+      console.log(`${impl.id} ${w.id} run ${runs.length}: ${r.transactions}/${w.tx} tx in ${(r.elapsedMs / 1000).toFixed(1)} s${r.completed ? '' : ` (stopped: ${r.stoppedBy})`}`);
+      if (!r.completed) break;
+    } while (runs.length < MAX_RUNS && performance.now() - s0 < STAGE_MS);
+    const completed = runs.filter((r) => r.completed);
+    const med = (xs: number[]) => [...xs].sort((a, b) => a - b)[Math.ceil(xs.length / 2) - 1] as number;
+    rows.push({
+      workload: w.id,
+      legionWorkers: w.workers,
+      simulatedHours: w.hours,
+      transactions: w.tx,
+      status: completed.length === runs.length ? 'measured' : `timed out at ${runs[runs.length - 1]?.transactions} transactions`,
+      runs: runs.length,
+      medianElapsedMs: completed.length ? med(completed.map((r) => r.elapsedMs)) : null,
+      minMaxElapsedMs: completed.length ? [Math.min(...completed.map((r) => r.elapsedMs)), Math.max(...completed.map((r) => r.elapsedMs))] : null,
+      medianTxPerSecond: completed.length ? med(completed.map((r) => r.txPerSecond)) : null,
+      firstRun: runs[0],
+    });
+    if (completed.length < runs.length) exceeded = w.id;
+  }
+  return rows;
+}
+
+// ------------------------------------------------------------ equivalence check (correctness, not timing)
+function equivalence(total: number) {
+  const gen = new WorkloadGen('bench-equivalence');
+  let a = PRODUCTION.empty();
+  let b = PROTOTYPE.empty();
+  let mismatches = 0;
+  for (let i = 0; i < total; i += 1) {
+    const tx = gen.next();
+    const ra = (() => {
+      try {
+        const o = PRODUCTION.apply(a, tx);
+        a = o.ledger;
+        return JSON.stringify(o.result);
+      } catch (e) {
+        return isLabError(e) ? e.code : 'ERR';
+      }
+    })();
+    const rb = (() => {
+      try {
+        const o = PROTOTYPE.apply(b, tx);
+        b = o.ledger;
+        return JSON.stringify(o.result);
+      } catch (e) {
+        return isLabError(e) ? e.code : 'ERR';
+      }
+    })();
+    if (ra !== rb) mismatches += 1;
+  }
+  const balances = (m: ReadonlyMap<string, { available: number; reserved: number }>) => JSON.stringify([...m.entries()].sort());
+  return { transactions: total, resultMismatches: mismatches, finalBalancesEqual: balances(a.balances) === balances(b.balances), committedCountEqual: a.committed.size === b.committed.size };
+}
+
+// ------------------------------------------------------------ realistic S1 runtime impact
+function s1Impact(sessionMin: number) {
+  const content = loadS1Content();
+  const reps: { simMs: number; ledgerMs: number; tx: number }[] = [];
+  for (let k = 0; k < 3; k += 1) {
+    const txs: Tx[] = [];
+    const sim = new Simulation({ content, seedRoot: 'S1-E01#rep-0', sessions: [{ startMs: 0, endMs: sessionMin * 60_000 }], policy: POL_FRONTIER, hashLog: false });
+    sim.addObserver((e) => {
+      if (e.kind !== 'KillCredited') return;
+      const lines: TxLine[] = [];
+      if ((e.detail['gold'] as number) > 0) lines.push({ resourceId: 'res.gold', bucket: 'available', delta: e.detail['gold'] as number });
+      const drops = String(e.detail['drops']);
+      if (drops) for (const r of drops.split(',')) lines.push({ resourceId: r, bucket: 'available', delta: 1 });
+      if (lines.length) txs.push({ txId: String(e.detail['txId']), purpose: 'kill.reward', lines });
+    });
+    gc();
+    const a = performance.now();
+    sim.run(sessionMin * 60_000);
+    const simMs = performance.now() - a;
+    gc();
+    let l = emptyLedger();
+    const b = performance.now();
+    for (const tx of txs) l = applyTx(l, tx).ledger;
+    reps.push({ simMs, ledgerMs: performance.now() - b, tx: txs.length });
+  }
+  const sorted = [...reps].sort((x, y) => x.simMs - y.simMs);
+  const mid = sorted[1] as (typeof reps)[number];
+  return { sessionMin, policy: 'POL-FRONTIER', seed: 'S1-E01#rep-0', killTransactions: mid.tx, medianSimulationMs: mid.simMs, ledgerReplayMs: mid.ledgerMs, ledgerShareOfRun: mid.ledgerMs / mid.simMs, repetitions: reps };
+}
+
+const started = new Date();
+console.log('equivalence check...');
+const equivalent = equivalence(28_800);
+console.log(JSON.stringify(equivalent));
+console.log('S1 runtime impact...');
+const impact = [s1Impact(60), ...(QUICK ? [] : [s1Impact(600)])];
+console.log(JSON.stringify(impact.map((i) => ({ sessionMin: i.sessionMin, tx: i.killTransactions, simMs: Math.round(i.medianSimulationMs), ledgerMs: Math.round(i.ledgerReplayMs) }))));
+const production = stage(PRODUCTION);
+const prototype = stage(PROTOTYPE);
+const out = {
+  note: 'Environment measurements on this machine (not a semantic fingerprint). Budgets and procedure pre-registered in manifests/s1/PREREGISTRATION.md section 6.',
+  environment: { node: process.version, platform: platform(), release: release(), arch: arch(), cpus: cpus().length, cpuModel: cpus()[0]?.model ?? 'unknown', exposeGc: typeof (globalThis as { gc?: unknown }).gc === 'function', startedAt: started.toISOString(), quick: QUICK },
+  budgets: { wallClockMsPerRun: BUDGET_MS, heapBytes: BUDGET_HEAP, maxRunsPerWorkload: MAX_RUNS, stageMs: STAGE_MS },
+  equivalence: equivalent,
+  s1RuntimeImpact: impact,
+  production,
+  prototype,
+};
+writeText(resolve(LAB_ROOT, 'results/s1/ledger-benchmark/benchmark.json'), prettyJson(out));
+console.log('wrote results/s1/ledger-benchmark/benchmark.json');
