index 0000000..19fbaa7
--- /dev/null
+++ b/legion-progression-lab/src/engine/commands.ts
@@ -0,0 +1,78 @@
+/**
+ * Command validation (gates.md v1.1 section 4). Rules are checked in the documented order and the first failure is
+ * returned. Validation never changes state; a rejected command has no effect.
+ */
+import type { CompiledContent } from '../model/content.ts';
+import { POLICY_REPORT_CODES, type Command, type ReasonCode, type SimState, type Validation } from '../model/types.ts';
+
+const ok: Validation = { ok: true };
+const no = (code: ReasonCode): Validation => ({ ok: false, code });
+
+function common(state: SimState): Validation | null {
+  if (!state.session.open) return no('NOT_IN_SESSION');
+  if (state.hero.status === 'dead') return no('DEAD');
+  if (state.hero.status === 'travelling' || state.hero.status === 'boss') return no('BUSY');
+  return null;
+}
+
+export function validateCommand(state: SimState, content: CompiledContent, cmd: Command): Validation {
+  const hero = state.hero;
+  switch (cmd.type) {
+    case 'SetAutoFarm': {
+      if (!cmd.on) return state.session.open ? ok : no('NOT_IN_SESSION');
+      const c = common(state);
+      if (c) return c;
+      const order = content.zoneOrderById.get(cmd.zoneId);
+      if (order === undefined) return no('ZONE_UNKNOWN');
+      if (order !== hero.zoneOrder) return no('NOT_IN_ZONE');
+      return ok;
+    }
+    case 'Engage': {
+      const c = common(state);
+      if (c) return c;
+      if (hero.status !== 'idle') return no('ALREADY_ENGAGED');
+      return ok;
+    }
+    case 'Travel': {
+      const c = common(state);
+      if (c) return c;
+      const order = content.zoneOrderById.get(cmd.zoneId);
+      if (order === undefined) return no('ZONE_UNKNOWN');
+      if (!(state.zones[order - 1]?.accessUnlocked ?? false)) return no('ZONE_NOT_ACCESSIBLE');
+      if (order === hero.zoneOrder) return no('ALREADY_THERE');
+      if (Math.abs(order - hero.zoneOrder) !== 1) return no('ZONE_NOT_ADJACENT');
+      return ok;
+    }
+    case 'Teleport': {
+      const c = common(state);
+      if (c) return c;
+      const order = content.checkpointZoneOrder.get(cmd.checkpointId);
+      if (order === undefined) return no('CHECKPOINT_UNKNOWN');
+      if (!(state.zones[order - 1]?.checkpointDiscovered ?? false)) return no('CHECKPOINT_UNKNOWN');
+      if (order === hero.zoneOrder) return no('ALREADY_THERE');
+      return ok;
+    }
+    case 'Rest': {
+      const c = common(state);
+      return c ?? ok;
+    }
+    case 'StartBoss': {
+      const c = common(state);
+      if (c) return c;
+      if (!content.gateIds.has(cmd.gateId) || cmd.gateId !== content.boss.gateId) return no('GATE_UNKNOWN');
+      if (!state.boss.opened) return no('GATE_LOCKED');
+      if (state.boss.completed) return no('GATE_ALREADY_COMPLETED');
+      if (hero.zoneOrder !== content.boss.zoneOrder) return no('NOT_IN_ZONE');
+      if (hero.autoFarm) return no('GATE_ACTIVE_ONLY');
+      if (hero.status !== 'idle' && hero.status !== 'resting') return no('ALREADY_ENGAGED');
+      return ok;
+    }
+    case 'EndSession':
+      return state.session.open ? ok : no('NOT_IN_SESSION');
+    case 'Report':
+      if (!state.session.open) return no('NOT_IN_SESSION');
+      return (POLICY_REPORT_CODES as readonly string[]).includes(cmd.code) ? ok : no('REPORT_UNKNOWN');
+    default:
+      return no('BUSY');
+  }
+}
diff --git a/legion-progression-lab/src/engine/credit.ts b/legion-progression-lab/src/engine/credit.ts
new file mode 100644
index 0000000..c59ee90
--- /dev/null
+++ b/legion-progression-lab/src/engine/credit.ts
@@ -0,0 +1,74 @@
+/**
+ * Encounter-credit identity (s1-combat-loop.md v1.1 section 10; owner S1 review section 2).
+ *
+ * A kill is credited at most once, as one complete operation, whatever reaches the CREDIT phase:
+ * - When an enemy dies, the engine registers an authoritative PENDING credit (encounter, enemy instance, zone, boss
+ *   flag). This is the only source of a valid credit.
+ * - A `KillCredited` event is honoured only if it matches a pending credit exactly. The pending entry is consumed and
+ *   its identity is COMMITTED before anything else happens.
+ * - Anything else is rejected before any random draw, ledger line, EXP, kill count or unlock:
+ *     CREDIT_REPLAYED  the same claim was already committed (an exact duplicate);
+ *     CREDIT_CONFLICT  same credit ID, different claim (for example another zone or the boss flag);
+ *     CREDIT_UNKNOWN   no kill with this ID was ever registered.
+ * The registry does not depend on ledger transactions, so an encounter that grants no resources (EXP only, or nothing
+ * at all) is protected in exactly the same way.
+ *
+ * The registry is an immutable value inside the simulation state. `committed` is a persistent list: committing
+ * prepends one node and never changes existing nodes, so forked branches share history safely and a branch never
+ * sees another branch's credits. Normal credits are O(1); the list is only searched to classify a rejected claim.
+ *
+ * Extension point: every future per-kill progression effect (Bestiary, class mastery, boss completion, unlocks) must
+ * be applied inside the simulation's credit operation, after `classifyClaim` has accepted the claim.
+ */
+import type { CommittedCredit, CreditClaim, CreditRegistry } from '../model/types.ts';
+import { killTxId } from './rewards.ts';
+
+export type { CommittedCredit, CreditClaim, CreditRegistry };
+
+export type CreditRejection = 'CREDIT_REPLAYED' | 'CREDIT_CONFLICT' | 'CREDIT_UNKNOWN';
+
+export const EMPTY_CREDITS: CreditRegistry = Object.freeze({ pending: Object.freeze([]), committed: null, committedCount: 0 });
+
+export function creditIdOf(claim: Pick<CreditClaim, 'encounterId' | 'instanceId'>): string {
+  return killTxId(claim.encounterId, claim.instanceId);
+}
+
+/** The canonical text of a claim: two claims are the same credit if and only if these strings are equal. */
+export function claimText(c: CreditClaim): string {
+  return `${c.encounterId}|${c.instanceId}|${c.zoneOrder}|${c.boss ? 'boss' : 'ordinary'}`;
+}
+
+/**
+ * Registers the authoritative claim for a kill that has just happened. Encounter IDs come from a run-wide counter, so
+ * an ID can never be registered twice; only the pending list is checked (O(1) in S1), never the whole history.
+ */
+export function registerPending(reg: CreditRegistry, claim: CreditClaim): CreditRegistry {
+  const id = creditIdOf(claim);
+  if (reg.pending.some((p) => creditIdOf(p) === id)) throw new Error(`credit ${id} registered twice`);
+  return Object.freeze({ ...reg, pending: Object.freeze([...reg.pending, Object.freeze({ ...claim })]) });
+}
+
+export function findCommitted(reg: CreditRegistry, creditId: string): CommittedCredit | null {
+  for (let n = reg.committed; n !== null; n = n.prev) if (n.creditId === creditId) return n;
+  return null;
+}
+
+/** Decides whether a claim may be credited, without changing anything. */
+export function classifyClaim(reg: CreditRegistry, claim: CreditClaim): { ok: true; index: number } | { ok: false; code: CreditRejection } {
+  const id = creditIdOf(claim);
+  const index = reg.pending.findIndex((p) => creditIdOf(p) === id);
+  if (index >= 0) return claimText(reg.pending[index] as CreditClaim) === claimText(claim) ? { ok: true, index } : { ok: false, code: 'CREDIT_CONFLICT' };
+  const done = findCommitted(reg, id);
+  if (done === null) return { ok: false, code: 'CREDIT_UNKNOWN' };
+  return { ok: false, code: done.claim === claimText(claim) ? 'CREDIT_REPLAYED' : 'CREDIT_CONFLICT' };
+}
+
+/** Moves the accepted pending claim at `index` to the committed history. */
+export function commitClaim(reg: CreditRegistry, index: number): CreditRegistry {
+  const claim = reg.pending[index] as CreditClaim;
+  return Object.freeze({
+    pending: Object.freeze(reg.pending.filter((_, i) => i !== index)),
+    committed: Object.freeze({ creditId: creditIdOf(claim), claim: claimText(claim), prev: reg.committed }),
+    committedCount: reg.committedCount + 1,
+  });
+}
diff --git a/legion-progression-lab/src/engine/estimator-s1.ts b/legion-progression-lab/src/engine/estimator-s1.ts
new file mode 100644
index 0000000..07e62d8
--- /dev/null
+++ b/legion-progression-lab/src/engine/estimator-s1.ts
@@ -0,0 +1,126 @@
+/**
+ * DIAGNOSTIC CONTROL ONLY: the S1 rate estimator, kept unchanged so that S1.1 experiments can separate the effect of
+ * the estimator correction from engine and policy changes (owner S1 review section 10, "identify whether the cause
+ * was a bug fix, policy change or measurement correction"). It is selected only by `estimator: "s1"` in an S1.1
+ * manifest. Its known defects are documented in S1_1_EVIDENCE.md: zero or tiny hit chances look highly efficient,
+ * truncated distributions are not detected, and survival uses the renewal approximation.
+ *
+ * The arithmetic below is byte-for-byte the S1 `estimateZone` (S1 review package). The only additions are the
+ * v1.1 display fields: reliability is derived from the S1 limiting factor and tagged "S1_ESTIMATOR".
+ */
+import { damagePerHit, mitigationRatio } from '../core/formulas/combat.ts';
+import type { CompiledContent } from '../model/content.ts';
+import type { DisplayedEstimate } from '../model/types.ts';
+import type { ZoneEstimate } from './estimator.ts';
+
+const TWO_POW_32 = 4_294_967_296;
+const TAIL = 1e-12;
+const MAX_SWINGS = 100_000;
+
+function swingDistributionS1(enemyHp: number, damageNormal: number, damageCrit: number, pHit: number, pCrit: number): number[] {
+  let alive = new Map<number, number>([[enemyHp, 1]]);
+  const out: number[] = [];
+  for (let n = 1; n <= MAX_SWINGS; n += 1) {
+    const next = new Map<number, number>();
+    let killed = 0;
+    for (const [hp, mass] of alive) {
+      const miss = mass * (1 - pHit);
+      if (miss > 0) next.set(hp, (next.get(hp) ?? 0) + miss);
+      for (const [dmg, p] of [
+        [damageNormal, pHit * (1 - pCrit)],
+        [damageCrit, pHit * pCrit],
+      ] as const) {
+        if (p <= 0) continue;
+        const left = hp - dmg;
+        if (left <= 0) killed += mass * p;
+        else next.set(left, (next.get(left) ?? 0) + mass * p);
+      }
+    }
+    out.push(killed);
+    alive = next;
+    let rest = 0;
+    for (const m of alive.values()) rest += m;
+    if (rest < TAIL) break;
+  }
+  return out;
+}
+
+export function estimateZoneS1(content: CompiledContent, level: number, zoneOrder: number): ZoneEstimate {
+  const zone = content.zones[zoneOrder - 1];
+  if (!zone) throw new Error(`unknown zone order ${zoneOrder}`);
+  const stats = content.heroStats(level);
+  const enemy = zone.enemy;
+  const K = content.combat.mitigationK;
+  const minDamage = content.combat.minDamagePerHit;
+  const mitigation = mitigationRatio(enemy.defence, K);
+  const critMultBp = content.hero.critMultBp;
+  const damageNormal = damagePerHit({ rawMilli: stats.attackRawMilli, crit: false, critMultBp, mitigation, minDamage });
+  const damageCrit = damagePerHit({ rawMilli: stats.attackRawMilli, crit: true, critMultBp, mitigation, minDamage });
+  const enemyDamage = damagePerHit({ rawMilli: enemy.attackMilli, crit: false, critMultBp: 10_000, mitigation: mitigationRatio(stats.defence, K), minDamage });
+  const pHit = zone.heroHitThreshold / TWO_POW_32;
+  const pCrit = Math.min(content.hero.critChanceBp, 10_000) / 10_000;
+
+  const dist = swingDistributionS1(enemy.hp, damageNormal, damageCrit, pHit, pCrit);
+  const interval = content.hero.attackIntervalMs;
+  const overhead = content.travel.engageOverheadMs;
+  const firstSwingDelay = Math.max(0, interval - overhead);
+  let expectedSwings = 0;
+  let expectedTtk = 0;
+  let expectedEnemyHits = 0;
+  dist.forEach((p, i) => {
+    const n = i + 1;
+    const ttk = firstSwingDelay + (n - 1) * interval;
+    const hits = ttk >= enemy.firstAttackDelayMs ? Math.floor((ttk - enemy.firstAttackDelayMs) / enemy.attackIntervalMs) + 1 : 0;
+    expectedSwings += p * n;
+    expectedTtk += p * ttk;
+    expectedEnemyHits += p * hits;
+  });
+
+  const attackCycle = overhead + expectedTtk;
+  const spawnCycle = (zone.respawnMs + overhead + expectedTtk) / zone.spawnSlots;
+  const attackBoundPerHour = 3_600_000 / attackCycle;
+  const spawnBoundPerHour = 3_600_000 / spawnCycle;
+  const baseMsPerKill = Math.max(attackCycle, spawnCycle);
+
+  const damageTakenPerKill = expectedEnemyHits * enemyDamage;
+  const killsPerLife = damageTakenPerKill > 0 ? stats.maxHp / damageTakenPerKill : null;
+  const downtimePerDeath = content.hero.respawnDelayMs + Math.max(0, content.travel.zoneEntryWalkMs - overhead) + expectedTtk / 2;
+  const msPerKill = baseMsPerKill + (killsPerLife === null ? 0 : downtimePerDeath / killsPerLife);
+  const killsPerHour = 3_600_000 / msPerKill;
+  const deathsPerHour = killsPerLife === null ? 0 : killsPerHour / killsPerLife;
+  const downtimeShare = killsPerLife === null ? 0 : downtimePerDeath / killsPerLife / msPerKill;
+  const deathsPerFiveMin = deathsPerHour / 12;
+
+  let limitingFactor: DisplayedEstimate['limitingFactor'] = spawnCycle > attackCycle ? 'spawn' : 'attack';
+  if (downtimeShare >= 0.1 || deathsPerFiveMin >= content.autoFarm.stopAfterDeaths) limitingFactor = 'survival';
+
+  const materialsPerHour: Record<string, number> = {};
+  for (const d of enemy.drops) materialsPerHour[d.resourceId] = (materialsPerHour[d.resourceId] ?? 0) + (killsPerHour * d.chanceBp * d.qty) / 10_000;
+
+  return {
+    estimator: 's1',
+    zoneOrder,
+    level,
+    damageNormal,
+    damageCrit,
+    enemyDamage,
+    expectedSwings,
+    swingDistribution: dist,
+    unresolvedMass: null,
+    expectedTtkMs: expectedTtk,
+    attackBoundPerHour,
+    spawnBoundPerHour,
+    damageTakenPerKill,
+    killsPerLife,
+    winChanceFromFullHp: null,
+    ttkS: expectedTtk / 1000,
+    killsPerHour,
+    expPerHour: killsPerHour * enemy.exp,
+    goldPerHour: killsPerHour * enemy.gold,
+    deathsPerHour,
+    limitingFactor,
+    reliability: limitingFactor === 'survival' ? 'approximate' : 'reliable',
+    reasons: ['S1_ESTIMATOR'],
+    materialsPerHour,
+  };
+}
diff --git a/legion-progression-lab/src/engine/estimator.ts b/legion-progression-lab/src/engine/estimator.ts
new file mode 100644
index 0000000..46bc26a
--- /dev/null
+++ b/legion-progression-lab/src/engine/estimator.ts
@@ -0,0 +1,301 @@
+/**
+ * Analytic rate estimator, v1.1 (architecture v1.1 section 4: the third, separate component; owner S1 review
+ * section 5). It predicts steady farming rates for one zone at one hero level, the way a Command Centre would display
+ * them (R07.16). It never produces "actual" results; reports show estimate and simulation side by side.
+ *
+ * Model (all candidate; spec: spec/formulas/estimator.md v1.1):
+ * 1. Swings to kill: exact distribution by dynamic programming over remaining enemy HP (hit chance p_h, crit chance
+ *    p_c), within an explicit budget (ESTIMATOR_BUDGET). Probability mass still unresolved at the end is NEVER
+ *    treated as a kill:
+ *    - p_h = 0                          -> unreachable, reason NO_HIT_CHANCE;
+ *    - unresolved mass > 1e-9 at the swing or work budget -> unreachable, reason SWING_BUDGET / WORK_BUDGET.
+ * 2. Time to kill for n swings: firstSwingDelay + (n - 1) * interval, firstSwingDelay = max(0, interval - overhead).
+ *    Enemy attacks land at firstAttackDelay + j * enemyInterval (j = 0, 1, ...) while that time <= the kill time;
+ *    an attack at exactly the kill time lands too (both blows count, s1-combat-loop.md section 4).
+ * 3. Survival: an exact Markov chain over "enemy hits the hero can still take" r (HP carries over between fights; no
+ *    regeneration while farming because the re-engage overhead is shorter than the out-of-combat delay, S1-R11).
+ *    From r, a fight needing n swings takes h_n hits: if h_n < r the hero wins and continues from r - h_n; otherwise
+ *    the hero dies at its r-th hit, and the kill still counts only if that hit lands at the kill moment. This gives
+ *    the expected kills per life K and the expected time per life (respawn delay, entry walk, fights, overheads).
+ *    Kills per hour = K / time per life, capped by the spawn bound. The chain is limited by a work budget; beyond it
+ *    the S1 renewal approximation is used and the estimate is at best "approximate" (reason SURVIVAL_BUDGET).
+ * 4. Reliability (see EstimateReliability): unreachable (K = 0 or no kill possible) / unsafe (K < 1, or expected deaths
+ *    per death window reach the auto-farm stop threshold) / approximate (deaths take >= 10% of the time, the spawn
+ *    bound binds while the hero can be hurt, or a modelling assumption does not hold) / reliable.
+ * The auto-farm stop rule (D-03) itself is not modelled; the estimate assumes continuous farming.
+ */
+import { damagePerHit, mitigationRatio } from '../core/formulas/combat.ts';
+import type { CompiledContent } from '../model/content.ts';
+import type { DisplayedEstimate, EstimateReliability } from '../model/types.ts';
+
+const TWO_POW_32 = 4_294_967_296;
+
+/** Explicit computation budgets (candidate values; documented in estimator.md v1.1). */
+export const ESTIMATOR_BUDGET = Object.freeze({
+  /** Longest fight considered, in swings. */
+  maxSwings: 100_000,
+  /** Total (remaining-HP state x swing) updates allowed for the swing distribution. */
+  maxWork: 5_000_000,
+  /** Stop when the surviving mass falls below this. */
+  tail: 1e-12,
+  /** More unresolved mass than this at the end means the distribution is incomplete. */
+  unresolvedTolerance: 1e-9,
+  /** (hits-left states x fight outcomes) allowed for the survival chain. */
+  maxSurvivalWork: 5_000_000,
+});
+
+export interface ZoneEstimate extends DisplayedEstimate {
+  readonly estimator: 's1' | 's1.1';
+  readonly zoneOrder: number;
+  readonly level: number;
+  readonly damageNormal: number;
+  readonly damageCrit: number;
+  readonly enemyDamage: number;
+  /** null when the distribution is incomplete. */
+  readonly expectedSwings: number | null;
+  /** P(swings to kill = n) for n = 1.. (index n - 1), as far as it was computed. */
+  readonly swingDistribution: readonly number[];
+  /** Probability mass left unresolved (no kill within the budget); null for the S1 control estimator. */
+  readonly unresolvedMass: number | null;
+  readonly expectedTtkMs: number | null;
+  readonly attackBoundPerHour: number;
+  readonly spawnBoundPerHour: number;
+  readonly damageTakenPerKill: number | null;
+  /** P(the first fight from full HP ends in a credited kill); null for the S1 control estimator. */
+  readonly winChanceFromFullHp: number | null;
+  readonly materialsPerHour: Readonly<Record<string, number>>;
+}
+
+export interface SwingDistribution {
+  readonly probabilities: readonly number[];
+  readonly unresolved: number;
+  readonly stop: 'complete' | 'no-hit' | 'swing-budget' | 'work-budget';
+  readonly work: number;
+}
+
+export function swingDistributionDetailed(
+  enemyHp: number,
+  damageNormal: number,
+  damageCrit: number,
+  pHit: number,
+  pCrit: number,
+  budget: Pick<typeof ESTIMATOR_BUDGET, 'maxSwings' | 'maxWork' | 'tail'> = ESTIMATOR_BUDGET,
+): SwingDistribution {
+  if (!(pHit > 0)) return { probabilities: [], unresolved: 1, stop: 'no-hit', work: 0 };
+  let alive = new Map<number, number>([[enemyHp, 1]]);
+  const out: number[] = [];
+  let work = 0;
+  let rest = 1;
+  for (let n = 1; n <= budget.maxSwings; n += 1) {
+    work += alive.size;
+    if (work > budget.maxWork) return { probabilities: out, unresolved: rest, stop: 'work-budget', work };
+    const next = new Map<number, number>();
+    let killed = 0;
+    for (const [hp, mass] of alive) {
+      const miss = mass * (1 - pHit);
+      if (miss > 0) next.set(hp, (next.get(hp) ?? 0) + miss);
+      for (const [dmg, p] of [
+        [damageNormal, pHit * (1 - pCrit)],
+        [damageCrit, pHit * pCrit],
+      ] as const) {
+        if (p <= 0) continue;
+        const left = hp - dmg;
+        if (left <= 0) killed += mass * p;
+        else next.set(left, (next.get(left) ?? 0) + mass * p);
+      }
+    }
+    out.push(killed);
+    alive = next;
+    rest = 0;
+    for (const m of alive.values()) rest += m;
+    if (rest < budget.tail) return { probabilities: out, unresolved: rest, stop: 'complete', work };
+  }
+  return { probabilities: out, unresolved: rest, stop: 'swing-budget', work };
+}
+
+/** P(swings to kill = n), n = 1.. (compatibility helper; see swingDistributionDetailed for completeness). */
+export function swingDistribution(enemyHp: number, damageNormal: number, damageCrit: number, pHit: number, pCrit: number): number[] {
+  return [...swingDistributionDetailed(enemyHp, damageNormal, damageCrit, pHit, pCrit).probabilities];
+}
+
+interface FightOutcome {
+  readonly p: number;
+  readonly ttk: number;
+  readonly hits: number;
+  /** The last enemy hit before the kill lands at the kill moment. */
+  readonly simultaneous: boolean;
+}
+
+/** Expected kills and time until death, starting with r hits left, for r = 0..R (exact; HP carries over, no regeneration). */
+function survivalChain(outcomes: readonly FightOutcome[], R: number, overhead: number, firstAttackDelay: number, enemyInterval: number): { K: Float64Array; T: Float64Array } {
+  const K = new Float64Array(R + 1);
+  const T = new Float64Array(R + 1);
+  const harmless = outcomes.filter((o) => o.hits === 0);
+  const q0 = harmless.reduce((s, o) => s + o.p, 0);
+  const ttk0 = harmless.reduce((s, o) => s + o.p * o.ttk, 0);
+  for (let r = 1; r <= R; r += 1) {
+    let k = q0; // a harmless fight is a win that leaves r unchanged (solved below)
+    let t = overhead + ttk0;
+    for (const o of outcomes) {
+      if (o.hits === 0) continue;
+      if (o.hits < r) {
+        k += o.p * (1 + (K[r - o.hits] as number));
+        t += o.p * (o.ttk + (T[r - o.hits] as number));
+      } else {
+        const creditedAtDeath = o.hits === r && o.simultaneous;
+        if (creditedAtDeath) k += o.p;
+        t += o.p * (creditedAtDeath ? o.ttk : firstAttackDelay + (r - 1) * enemyInterval);
+      }
+    }
+    // X(r) = q0 * (fight + X(r)) + rest  =>  X(r) = (...) / (1 - q0); q0 < 1 because the zone is not harmless.
+    K[r] = k / (1 - q0);
+    T[r] = t / (1 - q0);
+  }
+  return { K, T };
+}
+
+export function estimateZone(content: CompiledContent, level: number, zoneOrder: number): ZoneEstimate {
+  const zone = content.zones[zoneOrder - 1];
+  if (!zone) throw new Error(`unknown zone order ${zoneOrder}`);
+  const stats = content.heroStats(level);
+  const enemy = zone.enemy;
+  const K = content.combat.mitigationK;
+  const minDamage = content.combat.minDamagePerHit;
+  const mitigation = mitigationRatio(enemy.defence, K);
+  const critMultBp = content.hero.critMultBp;
+  const damageNormal = damagePerHit({ rawMilli: stats.attackRawMilli, crit: false, critMultBp, mitigation, minDamage });
+  const damageCrit = damagePerHit({ rawMilli: stats.attackRawMilli, crit: true, critMultBp, mitigation, minDamage });
+  const enemyDamage = damagePerHit({ rawMilli: enemy.attackMilli, crit: false, critMultBp: 10_000, mitigation: mitigationRatio(stats.defence, K), minDamage });
+  const pHit = zone.heroHitThreshold / TWO_POW_32;
+  const pCrit = Math.min(content.hero.critChanceBp, 10_000) / 10_000;
+  const interval = content.hero.attackIntervalMs;
+  const overhead = content.travel.engageOverheadMs;
+  const entryWalk = content.travel.zoneEntryWalkMs;
+  const firstSwingDelay = Math.max(0, interval - overhead);
+  const fad = enemy.firstAttackDelayMs;
+  const ei = enemy.attackIntervalMs;
+
+  const sd = swingDistributionDetailed(enemy.hp, damageNormal, damageCrit, pHit, pCrit);
+  const common = { estimator: 's1.1' as const, zoneOrder, level, damageNormal, damageCrit, enemyDamage, swingDistribution: sd.probabilities, unresolvedMass: sd.unresolved };
+
+  // 1. No kill possible, or not resolvable within the budget: never present as efficient.
+  if (sd.stop === 'no-hit' || sd.unresolved > ESTIMATOR_BUDGET.unresolvedTolerance) {
+    const reason = sd.stop === 'no-hit' ? 'NO_HIT_CHANCE' : sd.stop === 'work-budget' ? 'WORK_BUDGET' : 'SWING_BUDGET';
+    return {
+      ...common,
+      expectedSwings: null,
+      expectedTtkMs: null,
+      attackBoundPerHour: 0,
+      spawnBoundPerHour: 0,
+      damageTakenPerKill: null,
+      killsPerLife: 0,
+      winChanceFromFullHp: sd.stop === 'no-hit' ? 0 : null,
+      ttkS: null,
+      killsPerHour: 0,
+      expPerHour: 0,
+      goldPerHour: 0,
+      deathsPerHour: null,
+      limitingFactor: 'attack',
+      reliability: 'unreachable',
+      reasons: [reason],
+      materialsPerHour: Object.fromEntries(enemy.drops.map((d) => [d.resourceId, 0])),
+    };
+  }
+
+  // 2. Fight outcomes.
+  const outcomes: FightOutcome[] = [];
+  let expectedSwings = 0;
+  let expectedTtk = 0;
+  let expectedEnemyHits = 0;
+  sd.probabilities.forEach((p, i) => {
+    if (p <= 0) return;
+    const n = i + 1;
+    const ttk = firstSwingDelay + (n - 1) * interval;
+    const hits = ttk >= fad ? Math.floor((ttk - fad) / ei) + 1 : 0;
+    outcomes.push({ p, ttk, hits, simultaneous: hits > 0 && (ttk - fad) % ei === 0 });
+    expectedSwings += p * n;
+    expectedTtk += p * ttk;
+    expectedEnemyHits += p * hits;
+  });
+  const attackCycle = overhead + expectedTtk;
+  const spawnCycle = (zone.respawnMs + overhead + expectedTtk) / zone.spawnSlots;
+  const attackBoundPerHour = 3_600_000 / attackCycle;
+  const spawnBoundPerHour = 3_600_000 / spawnCycle;
+  const damageTakenPerKill = expectedEnemyHits * enemyDamage;
+  const reasons: string[] = [];
+
+  // 3. Survival.
+  let killsPerLife: number | null = null;
+  let winChance = 1;
+  let chainKillsPerHour = attackBoundPerHour;
+  let deathDowntimeShare = 0;
+  let deathsPerHourChain = 0;
+  if (damageTakenPerKill > 0) {
+    const R = Math.ceil(stats.maxHp / enemyDamage);
+    winChance = outcomes.reduce((s, o) => s + (o.hits < R || (o.hits === R && o.simultaneous) ? o.p : 0), 0);
+    const deathDowntime = content.hero.respawnDelayMs + Math.max(0, entryWalk - overhead);
+    if (R * outcomes.length <= ESTIMATOR_BUDGET.maxSurvivalWork) {
+      const chain = survivalChain(outcomes, R, overhead, fad, ei);
+      killsPerLife = chain.K[R] as number;
+      const lifeMs = deathDowntime + (chain.T[R] as number);
+      chainKillsPerHour = (killsPerLife * 3_600_000) / lifeMs;
+      deathsPerHourChain = 3_600_000 / lifeMs;
+      deathDowntimeShare = deathDowntime / lifeMs;
+    } else {
+      // Beyond the budget: the S1 renewal approximation, flagged.
+      reasons.push('SURVIVAL_BUDGET');
+      killsPerLife = stats.maxHp / damageTakenPerKill;
+      const perDeath = deathDowntime + expectedTtk / 2;
+      const msPerKill = attackCycle + perDeath / killsPerLife;
+      chainKillsPerHour = 3_600_000 / msPerKill;
+      deathsPerHourChain = chainKillsPerHour / killsPerLife;
+      deathDowntimeShare = perDeath / killsPerLife / msPerKill;
+    }
+  }
+
+  // 4. Rates, then reliability.
+  const spawnBinds = spawnBoundPerHour < chainKillsPerHour;
+  const killsPerHour = killsPerLife === 0 ? 0 : Math.min(chainKillsPerHour, spawnBoundPerHour);
+  const deathsPerHour = killsPerLife === null ? 0 : killsPerLife > 0 ? killsPerHour / killsPerLife : deathsPerHourChain;
+  const windowDeaths = (deathsPerHour * content.autoFarm.deathWindowMs) / 3_600_000;
+
+  let reliability: EstimateReliability;
+  if (killsPerLife === 0) {
+    reliability = 'unreachable';
+    reasons.push('DIES_BEFORE_KILL');
+  } else if (killsPerLife !== null && (killsPerLife < 1 || windowDeaths >= content.autoFarm.stopAfterDeaths)) {
+    reliability = 'unsafe';
+    if (killsPerLife < 1) reasons.push('UNDER_ONE_KILL_PER_LIFE');
+    if (windowDeaths >= content.autoFarm.stopAfterDeaths) reasons.push('AUTO_FARM_STOP_EXPECTED');
+  } else {
+    if (deathDowntimeShare >= 0.1) reasons.push('SURVIVAL_LIMITED');
+    if (spawnBinds && killsPerLife !== null) reasons.push('SPAWN_WAITS_NOT_MODELLED');
+    if (killsPerLife !== null && content.hero.outOfCombatDelayMs <= overhead) reasons.push('REGEN_NOT_MODELLED');
+    reliability = reasons.length > 0 ? 'approximate' : 'reliable';
+  }
+  let limitingFactor: DisplayedEstimate['limitingFactor'] = spawnBinds ? 'spawn' : 'attack';
+  if (reliability === 'unreachable' || reliability === 'unsafe' || deathDowntimeShare >= 0.1) limitingFactor = 'survival';
+
+  const materialsPerHour: Record<string, number> = {};
+  for (const d of enemy.drops) materialsPerHour[d.resourceId] = (materialsPerHour[d.resourceId] ?? 0) + (killsPerHour * d.chanceBp * d.qty) / 10_000;
+
+  return {
+    ...common,
+    expectedSwings,
+    expectedTtkMs: expectedTtk,
+    attackBoundPerHour,
+    spawnBoundPerHour,
+    damageTakenPerKill,
+    killsPerLife,
+    winChanceFromFullHp: winChance,
+    ttkS: expectedTtk / 1000,
+    killsPerHour,
+    expPerHour: killsPerHour * enemy.exp,
+    goldPerHour: killsPerHour * enemy.gold,
+    deathsPerHour,
+    limitingFactor,
+    reliability,
+    reasons,
+    materialsPerHour,
+  };
+}
