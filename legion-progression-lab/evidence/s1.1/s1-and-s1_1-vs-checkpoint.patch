+    const h = this.state.hero;
+    const window = this.content.autoFarm.deathWindowMs;
+    const deathTimes = [...deathsInWindow(h.deathTimes, t, window), t];
+    this.setHero({
+      status: 'dead',
+      hp: 0,
+      epoch: h.epoch + 1,
+      deathTimes,
+      regenRem: 0,
+      regenChain: h.regenChain + 1,
+      targetSlot: null,
+      engageOrigin: null,
+      waitingForSpawn: false,
+      manualEngagePending: false,
+      needsEntryWalk: true,
+      lastCombatMs: t,
