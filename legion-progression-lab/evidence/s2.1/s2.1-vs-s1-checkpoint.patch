@@ -0,0 +1,16 @@
+/** Worker thread for the S2 runner: compiles each variant once, runs its share of jobs, returns the results. */
+import { parentPort, workerData } from 'node:worker_threads';
+import { compileLegionContent, type LegionContent } from '../model/legionContent.ts';
+import { runS2Job, type S2Job, type S2JobResult } from '../experiments/legionJobs.ts';
+
+interface Input {
+  readonly variants: readonly { id: string; base: unknown; table: unknown; legion: unknown }[];
+  readonly jobs: readonly S2Job[];
+}
+
+const input = workerData as Input;
+const compiled = new Map<string, LegionContent>();
+for (const v of input.variants) compiled.set(v.id, compileLegionContent(v.base, v.table, v.legion));
+const results: S2JobResult[] = [];
+for (const job of input.jobs) results.push(runS2Job(job, compiled.get(job.cell.variant) as LegionContent));
+parentPort?.postMessage(results);
diff --git a/legion-progression-lab/src/cli/exp2.ts b/legion-progression-lab/src/cli/exp2.ts
new file mode 100644
index 0000000..51699fe
--- /dev/null
+++ b/legion-progression-lab/src/cli/exp2.ts
@@ -0,0 +1,175 @@
+/**
+ * Runs or verifies a pre-registered S2 or S2.1 experiment (manifests/s2/ or manifests/s2.1/; each folder has its own
+ * preregistration.json). --results-dir <dir> writes elsewhere than results/<folder>/ (the S2.1 impact audit re-runs the
+ * S2 manifests into results/s2.1/audit/ and never overwrites results/s2/).
+ *   node src/cli/exp2.ts manifests/s2/<id>.json [--workers N] [--ledger reference|persistent]   run, write results/s2/<id>/
+ *   node src/cli/exp2.ts manifests/s2/<id>.json --verify [...]                                  re-run, compare the fingerprint
+ *   node src/cli/exp2.ts manifests/s2/<id>.json --determinism <secondRoot> [...]                re-run + second seeds + KS
+ * Refuses a manifest that is not in manifests/s2/preregistration.json with the same SHA-256, and a content pack whose
+ * fingerprint differs from the manifest's. The ledger implementation is recorded in environment.json; it is never part
+ * of the semantic result (the reference-ledger cross-check compares fingerprints).
+ */
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { existsSync, readFileSync } from 'node:fs';
+import { arch, cpus, platform, release } from 'node:os';
+import { dirname, resolve } from 'node:path';
+import { Worker } from 'node:worker_threads';
+import { canonicalJson, fingerprint } from '../core/hash/canonicalJson.ts';
+import { compileLegionContent } from '../model/legionContent.ts';
+import { S2ManifestSchema, type S2Manifest } from '../experiments/legionManifest.ts';
+import type { S2Job, S2JobResult } from '../experiments/legionJobs.ts';
+import { renderS2QuantilesCsv, renderS2Report, summariseS2, type S2CellMeta } from '../experiments/legionSummary.ts';
+import { variantPack, type SweepTable } from '../experiments/patch.ts';
+import { ksTwoSample } from '../experiments/stats.ts';
+import { LAB_ROOT, prettyJson, readJson, writeText } from './paths.ts';
+import { readS1Pack } from './s1-content.ts';
+
+const args = process.argv.slice(2);
+const flag = (name: string): string | undefined => {
+  const i = args.indexOf(name);
+  return i >= 0 ? args[i + 1] : undefined;
+};
+const flagValues = new Set([flag('--workers'), flag('--ledger'), flag('--determinism'), flag('--results-dir')].filter((x): x is string => x !== undefined));
+const manifestRel = (args.find((a) => !a.startsWith('--') && !flagValues.has(a)) ?? '').replace(/\\/g, '/');
+const workerCount = Math.max(1, Number(flag('--workers') ?? Math.min(15, cpus().length - 1)));
+const verify = args.includes('--verify');
+const secondRoot = flag('--determinism');
+const ledgerImpl = (flag('--ledger') ?? 'persistent') as 'reference' | 'persistent';
+if (ledgerImpl !== 'reference' && ledgerImpl !== 'persistent') throw new Error(`unknown --ledger ${String(ledgerImpl)}`);
+
+function refuse(message: string): never {
+  console.error(`REFUSED: ${message}`);
+  process.exit(2);
+}
+
+const raw = readFileSync(resolve(LAB_ROOT, manifestRel));
+const manifestSha = createHash('sha256').update(raw).digest('hex');
+const manifest: S2Manifest = S2ManifestSchema.parse(JSON.parse(raw.toString('utf8')));
+const manifestDir = dirname(manifestRel);
+const prereg = readJson(resolve(LAB_ROOT, manifestDir, 'preregistration.json')) as { manifests: { path: string; sha256: string }[]; amendments?: { path: string; sha256: string }[] };
+const registered = [...prereg.manifests, ...(prereg.amendments ?? [])].find((m) => m.path === manifestRel);
+if (!registered) refuse(`${manifestRel} is not pre-registered`);
+if (registered.sha256 !== manifestSha) refuse(`${manifestRel} changed after pre-registration (registered ${registered.sha256}, now ${manifestSha})`);
+
+const legionPack = readJson(resolve(LAB_ROOT, manifest.contentRef.path)) as { basePack: { path: string; sha256: string } } & Record<string, unknown>;
+if (fingerprint(legionPack) !== manifest.contentRef.sha256) refuse(`content ${manifest.contentRef.path} does not match the manifest's fingerprint`);
+const base = readS1Pack(legionPack.basePack.path);
+if (fingerprint(base.pack) !== legionPack.basePack.sha256) refuse('the S1 base pack does not match the S2 pack\'s basePack fingerprint');
+const index = readJson(resolve(LAB_ROOT, 'content/tables/xp-sweep.index.json')) as { tables: { a: number; p: number; path: string; sha256: string }[] };
+const sweep: SweepTable[] = index.tables.map((t) => {
+  const json = readJson(resolve(LAB_ROOT, t.path));
+  if (fingerprint(json) !== t.sha256) refuse(`sweep table ${t.path} does not match its recorded fingerprint`);
+  return { ...t, json };
+});
+
+// Each variant patches the S1 base; the S2 pack is compiled on the patched base (its basePack hash set to the patched one).
+const variants = manifest.variants.map((v) => {
+  const patched = variantPack(base, v.params, sweep);
+  const legion = { ...legionPack, basePack: { ...legionPack.basePack, sha256: fingerprint(patched.pack) } };
+  return { id: v.id, base: patched.pack, table: patched.table, legion };
+});
+const variantHashes = Object.fromEntries(
+  variants.map((v) => {
+    const c = compileLegionContent(v.base, v.table, v.legion);
+    return [v.id, { contentHash: c.contentHash, tableHash: c.tableHash, legionContentHash: c.legionContentHash }];
+  }),
+);
+
+const cells: S2CellMeta[] = manifest.cells.map((c, index) => ({
+  index,
+  id: c.id,
+  kind: c.kind,
+  variant: c.variant,
+  tag: c.kind === 'search' ? 'oracle' : c.kind === 'campaign' ? (c.legion ? 'realistic' : 'control') : 'diagnostic',
+  policy: c.kind === 'campaign' ? c.policy : c.kind === 'search' ? `ORC2-SEARCH-${c.objective}` : null,
+  profile: c.kind === 'campaign' || c.kind === 'search' ? c.profile : null,
+}));
+for (const c of manifest.cells) if (!variants.some((v) => v.id === c.variant)) refuse(`cell ${c.id}: unknown variant ${c.variant}`);
+
+const jobsFor = (root: string): S2Job[] => {
+  const jobs: S2Job[] = [];
+  manifest.cells.forEach((cell, index) => {
+    for (let i = 0; i < manifest.seeds.replicates; i += 1) jobs.push({ cellIndex: index, replicate: i, seedRoot: `${root}#rep-${i}`, cell, ledger: ledgerImpl, ...(i === 0 ? { trace: true } : {}) });
+  });
+  return jobs;
+};
+
+async function runAll(jobs: S2Job[]): Promise<S2JobResult[]> {
+  // Longest jobs first (search, then longer sessions) spread across workers round-robin.
+  const shares: S2Job[][] = Array.from({ length: Math.min(workerCount, jobs.length) }, () => []);
+  jobs.forEach((j, i) => (shares[i % shares.length] as S2Job[]).push(j));
+  const parts = await Promise.all(
+    shares.map(
+      (share) =>
+        new Promise<S2JobResult[]>((ok, ko) => {
+          const w = new Worker(new URL('./exp2-worker.ts', import.meta.url), { workerData: { variants, jobs: share } });
+          w.once('message', (m: S2JobResult[]) => ok(m));
+          w.once('error', ko);
+        }),
+    ),
+  );
+  return parts.flat().sort((a, b) => a.cell - b.cell || a.replicate - b.replicate);
+}
+
+function gitInfo(): { commit: string; dirty: boolean } {
+  try {
+    const commit = execFileSync('git', ['--no-optional-locks', 'rev-parse', 'HEAD'], { cwd: LAB_ROOT }).toString().trim();
+    const dirty = execFileSync('git', ['--no-optional-locks', 'status', '--porcelain'], { cwd: LAB_ROOT }).toString().trim().length > 0;
+    return { commit, dirty };
+  } catch {
+    return { commit: 'unknown', dirty: true };
+  }
+}
+
+const started = Date.now();
+const results = await runAll(jobsFor(manifest.seeds.root));
+const stripTrace = (rs: S2JobResult[]): S2JobResult[] => rs.map(({ trace: _t, ...r }) => r);
+const semantic = summariseS2(manifest, manifestSha, variantHashes, cells, stripTrace(results));
+const semanticFingerprint = fingerprint(semantic);
+const outDir = resolve(LAB_ROOT, flag('--results-dir') ?? `results/${manifestDir.replace(/^manifests\//, '')}`, manifest.experimentId);
+const git = gitInfo();
+const environment = { experimentId: manifest.experimentId, node: process.version, platform: platform(), release: release(), arch: arch(), cpus: cpus().length, workers: workerCount, ledger: ledgerImpl, labCommit: git.commit, workingTreeDirty: git.dirty, startedAt: new Date(started).toISOString(), durationMs: Date.now() - started, jobs: results.length };
+
+if (verify) {
+  const stored = existsSync(resolve(outDir, 'fingerprint.txt')) ? readFileSync(resolve(outDir, 'fingerprint.txt'), 'utf8').trim() : '(none)';
+  const match = stored === semanticFingerprint;
+  console.log(`${manifest.experimentId}: stored ${stored}`);
+  console.log(`${manifest.experimentId}: rerun  ${semanticFingerprint} (ledger ${ledgerImpl})`);
+  console.log(`${manifest.experimentId}: ${match ? 'MATCH' : 'MISMATCH'} (${environment.durationMs} ms, ${workerCount} workers)`);
+  process.exit(match ? 0 : 1);
+}
+
+if (secondRoot !== undefined) {
+  const again = await runAll(jobsFor(manifest.seeds.root));
+  const other = await runAll(jobsFor(secondRoot));
+  const identical = results.every((r, i) => r.digest !== null && r.digest === again[i]?.digest);
+  const sameFingerprint = fingerprint(summariseS2(manifest, manifestSha, variantHashes, cells, stripTrace(again))) === semanticFingerprint;
+  const differ = results.filter((r, i) => r.digest !== other[i]?.digest).length;
+  const ksMetrics = manifest.metrics;
+  const ks = cells.flatMap((c) =>
+    ksMetrics.map((m) => {
+      const a = results.filter((r) => r.cell === c.index).map((r) => r.values[m]).filter((v): v is number => v !== null && v !== undefined);
+      const b = other.filter((r) => r.cell === c.index).map((r) => r.values[m]).filter((v): v is number => v !== null && v !== undefined);
+      if (a.length === 0 || b.length === 0) return { cell: c.id, metric: m, n: [a.length, b.length], d: null, critical: null, distributionsDiffer: false };
+      const t = ksTwoSample(a, b);
+      return { cell: c.id, metric: m, n: [a.length, b.length], d: t.d, critical: t.critical, distributionsDiffer: t.differs };
+    }),
+  );
+  const report = { experimentId: manifest.experimentId, runsCompared: results.length, rerunEventLogDigestsIdentical: identical, rerunSemanticFingerprintIdentical: sameFingerprint, secondSeedRoot: secondRoot, secondSeedRunsWithDifferentEventLogs: differ, ksAlpha: 0.001, ksTests: ks.length, ksRejections: ks.filter((k) => k.distributionsDiffer).length, ks };
+  writeText(resolve(outDir, 'determinism.json'), prettyJson(report));
+  console.log(`${manifest.experimentId}: determinism rerun identical=${identical} fingerprint=${sameFingerprint}; second root differs in ${differ}/${results.length}; KS rejections ${report.ksRejections}/${ks.length}`);
+  process.exit(identical && sameFingerprint ? 0 : 1);
+}
+
+writeText(resolve(outDir, 'semantic.json'), prettyJson(semantic));
+writeText(resolve(outDir, 'fingerprint.txt'), `${semanticFingerprint}\n`);
+writeText(resolve(outDir, 'environment.json'), prettyJson(environment));
+writeText(resolve(outDir, 'report.md'), renderS2Report(manifest, semantic, semanticFingerprint));
+writeText(resolve(outDir, 'quantiles.csv'), renderS2QuantilesCsv(semantic));
+const traced = results.filter((r) => r.trace && r.trace.length > 0).slice(0, 3);
+for (const r of traced) writeText(resolve(outDir, `events.cell-${r.cell}.sample.jsonl`), `${(r.trace ?? []).map((e) => canonicalJson(e)).join('\n')}\n`);
+console.log(`${manifest.experimentId}: ${results.length} runs, ${environment.durationMs} ms, ${workerCount} workers, ledger ${ledgerImpl}`);
+console.log(`semantic fingerprint ${semanticFingerprint}`);
+const inv = semantic.sections['invariants'] as { checks: number; violations: number };
+console.log(`invariant monitor: ${inv.checks} checks, ${inv.violations} violations`);
diff --git a/legion-progression-lab/src/cli/ledger-differential.ts b/legion-progression-lab/src/cli/ledger-differential.ts
new file mode 100644
index 0000000..79fcd24
--- /dev/null
+++ b/legion-progression-lab/src/cli/ledger-differential.ts
@@ -0,0 +1,84 @@
+/**
+ * L1 large randomised differential run (planning/L1_LEDGER_SPECIFICATION.md §3 item 4): seeds x operations applied to
+ * the reference and persistent ledgers in lock step, in worker threads. Writes results/l1/differential.json.
+ *   node src/cli/ledger-differential.ts [--seeds 50] [--ops 20000] [--compare-every 500] [--workers N]
+ * S2.1: --extremes adds near-limit turnover operations and --reconstruct round-trips both ledgers through serialization
+ * and validated reconstruction at every comparison; with either flag the report goes to results/s2.1/ledger-differential.json.
+ */
+import { cpus } from 'node:os';
+import { resolve } from 'node:path';
+import { isMainThread, parentPort, Worker, workerData } from 'node:worker_threads';
+import { LEDGER_IMPLEMENTATIONS } from '../core/ledger/implementations.ts';
+import { generateOps, runDifferential, type DifferentialReport } from '../core/ledger/differential.ts';
+import { LAB_ROOT, prettyJson, writeText } from './paths.ts';
+
+interface Job {
+  readonly seed: number;
+  readonly ops: number;
+  readonly compareEvery: number;
+  readonly extremes: boolean;
+  readonly reconstruct: boolean;
+}
+
+if (!isMainThread) {
+  const jobs = workerData as Job[];
+  const out = jobs.map((j) => {
+    const t0 = performance.now();
+    const r = runDifferential(generateOps(j.seed, j.ops, { extremes: j.extremes }), LEDGER_IMPLEMENTATIONS.reference, LEDGER_IMPLEMENTATIONS.persistent, { compareEvery: j.compareEvery, reconstruct: j.reconstruct });
+    return { seed: j.seed, ms: Math.round(performance.now() - t0), ...r };
+  });
+  parentPort?.postMessage(out);
+} else {
+  const args = process.argv.slice(2);
+  const num = (name: string, dflt: number): number => {
+    const i = args.indexOf(name);
+    return i >= 0 ? Number(args[i + 1]) : dflt;
+  };
+  const seeds = num('--seeds', 50);
+  const ops = num('--ops', 20_000);
+  const compareEvery = num('--compare-every', 500);
+  const workers = Math.max(1, num('--workers', Math.min(15, cpus().length - 1)));
+  const extremes = args.includes('--extremes');
+  const reconstruct = args.includes('--reconstruct');
+  const jobs: Job[] = Array.from({ length: seeds }, (_, s) => ({ seed: s + 1, ops, compareEvery, extremes, reconstruct }));
+  const shares: Job[][] = Array.from({ length: Math.min(workers, jobs.length) }, () => []);
+  jobs.forEach((j, i) => (shares[i % shares.length] as Job[]).push(j));
+  const t0 = Date.now();
+  const parts = await Promise.all(
+    shares.map(
+      (share) =>
+        new Promise<(DifferentialReport & { seed: number; ms: number })[]>((ok, ko) => {
+          const w = new Worker(new URL(import.meta.url), { workerData: share });
+          w.once('message', ok);
+          w.once('error', ko);
+        }),
+    ),
+  );
+  const runs = parts.flat().sort((a, b) => a.seed - b.seed);
+  const sum = (f: (r: (typeof runs)[number]) => Record<string, number>) => runs.reduce<Record<string, number>>((acc, r) => {
+    for (const [k, v] of Object.entries(f(r))) acc[k] = (acc[k] ?? 0) + v;
+    return acc;
+  }, {});
+  const report = {
+    implementations: ['reference', 'persistent'],
+    seeds,
+    opsPerSeed: ops,
+    compareEvery,
+    extremes,
+    reconstruct,
+    totalOperations: runs.reduce((s, r) => s + r.steps, 0),
+    contentComparisons: runs.reduce((s, r) => s + r.contentComparisons, 0),
+    reconstructions: runs.reduce((s, r) => s + r.reconstructions, 0),
+    mismatches: runs.flatMap((r) => r.mismatches.map((m) => `seed ${r.seed}: ${m}`)),
+    opCounts: sum((r) => r.opCounts),
+    outcomeCounts: sum((r) => r.outcomeCounts),
+    wallMs: Date.now() - t0,
+    runs: runs.map((r) => ({ seed: r.seed, steps: r.steps, mismatches: r.mismatches.length, finalCommitted: r.finalCommittedA, ms: r.ms })),
+  };
+  writeText(resolve(LAB_ROOT, extremes || reconstruct ? 'results/s2.1/ledger-differential.json' : 'results/l1/differential.json'), prettyJson(report));
+  console.log(`differential: ${report.totalOperations} operations over ${seeds} seeds, ${report.contentComparisons} full-content comparisons, ${report.reconstructions} reconstructions, ${report.mismatches.length} mismatches (${report.wallMs} ms)`);
+  console.log(`operations: ${JSON.stringify(report.opCounts)}`);
+  console.log(`outcomes: ${JSON.stringify(report.outcomeCounts)}`);
+  for (const m of report.mismatches.slice(0, 10)) console.log(`MISMATCH ${m}`);
+  process.exit(report.mismatches.length === 0 ? 0 : 1);
+}
diff --git a/legion-progression-lab/src/cli/s2-analyse.ts b/legion-progression-lab/src/cli/s2-analyse.ts
new file mode 100644
index 0000000..8a2ade2
--- /dev/null
+++ b/legion-progression-lab/src/cli/s2-analyse.ts
@@ -0,0 +1,203 @@
+/**
+ * Pre-registered S2 analyses B0-B6 (manifests/s2/PREREGISTRATION.md section 4) over results/s2/<id>/semantic.json and
+ * the S1.1 control results. Writes results/s2/analysis-gates.json and prints a plain-text report.
+ *   node src/cli/s2-analyse.ts
+ * Every number is model output from candidate inputs. Misses are reported, never re-targeted.
+ */
+import { existsSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { canonicalJson } from '../core/hash/canonicalJson.ts';
+import { LAB_ROOT, prettyJson, readJson, writeText } from './paths.ts';
+
+type Summary = { n: number; reached: number; p10: number | null; p50: number | null; p90: number | null; mean: number | null; min: number | null; max: number | null };
+type Cell = { id: string; kind?: string; tag: string; runLogsDigest: string; metrics: Record<string, Summary> };
+type Sem = { cells: Cell[]; hypotheses: { id: string; statement: string; role: string; metric: string; stat: string; op: string; value?: number; range?: [number, number]; results: { cell: string; observed: number | null; outcome: string }[] }[]; sections: Record<string, any> };
+
+const IDS = ['S2-E00-control-a0', 'S2-E01-deploy-scaling', 'S2-E02-hero-damage-share', 'S2-E04-class-switch-abuse', 'S2-E05-squad-vs-workers', 'S2-E06-assignment-switching', 'S2-E07-knockout-sensitivity', 'S2-E08-first-recruit-timing', 'S2-E09-hindsight-search', 'S2-E10-estimator-vs-realisation'];
+// S2.1: --results <dir> --out <file> run the same analyses on another result set (the impact audit).
+const argv = process.argv.slice(2);
+const opt = (name: string, dflt: string): string => (argv.includes(name) ? (argv[argv.indexOf(name) + 1] as string) : dflt);
+const RESULTS = opt('--results', 'results/s2');
+const OUT = opt('--out', 'results/s2/analysis-gates.json');
+const load = (id: string): Sem | null => {
+  const p = resolve(LAB_ROOT, RESULTS, id, 'semantic.json');
+  return existsSync(p) ? (readJson(p) as Sem) : null;
+};
+const sem: Record<string, Sem | null> = Object.fromEntries(IDS.map((id) => [id, load(id)]));
+const s11 = readJson(resolve(LAB_ROOT, 'results/s1.1/S1.1-E01-base-attribution/semantic.json')) as Sem;
+const out: Record<string, unknown> = { labels: { values: 'model-output from candidate inputs', approved: false } };
+const lines: string[] = [];
+const say = (s = '') => lines.push(s);
+const cell = (s: Sem | null | undefined, id: string): Cell | undefined => s?.cells.find((c) => c.id === id);
+const f = (v: number | null | undefined, d = 2) => (v === null || v === undefined ? 'n/a' : Number.isInteger(v) ? String(v) : v.toFixed(d));
+
+// ---------------------------------------------------------------- B0
+{
+  const e0 = sem['S2-E00-control-a0'];
+  const rows: unknown[] = [];
+  let compared = 0;
+  let differing = 0;
+  let digestsEqual = 0;
+  for (const c of e0?.cells ?? []) {
+    const ref = cell(s11, `${c.id}|est-s1.1`);
+    if (!ref) {
+      rows.push({ cell: c.id, error: 'no S1.1-E01 cell' });
+      differing += 1;
+      continue;
+    }
+    const shared = Object.keys(c.metrics).filter((m) => m in ref.metrics);
+    const diff = shared.filter((m) => canonicalJson(c.metrics[m]) !== canonicalJson(ref.metrics[m]));
+    compared += shared.length;
+    differing += diff.length;
+    if (c.runLogsDigest === ref.runLogsDigest) digestsEqual += 1;
+    rows.push({ cell: c.id, s11Cell: ref.id, metricsCompared: shared.length, metricsDiffering: diff, runLogsDigestEqual: c.runLogsDigest === ref.runLogsDigest });
+  }
+  const pass = e0 !== null && differing === 0 && digestsEqual === (e0?.cells.length ?? -1);
+  out['B0'] = { gate: true, pass, metricSummariesCompared: compared, differing, cellsWithIdenticalRunLogs: digestsEqual, rows };
+  say('B0 (gate) control A0 against S1.1-E01');
+  say(`  ${compared} metric summaries compared, ${differing} differ; event-log digests identical in ${digestsEqual}/${e0?.cells.length ?? 0} cells -> ${pass ? 'PASS' : 'FAIL'}`);
+}
+
+// ---------------------------------------------------------------- B1
+{
+  let runs = 0;
+  let checks = 0;
+  let violations = 0;
+  const perExperiment: Record<string, unknown> = {};
+  for (const id of IDS) {
+    const inv = sem[id]?.sections['invariants'];
+    if (!inv) continue;
+    runs += inv.runs;
+    checks += inv.checks;
+    violations += inv.violations;
+    perExperiment[id] = { runs: inv.runs, checks: inv.checks, violations: inv.violations };
+  }
+  const engineering = IDS.flatMap((id) => (sem[id]?.hypotheses ?? []).filter((h) => h.role === 'engineering').flatMap((h) => h.results.map((r) => ({ experiment: id, id: h.id, statement: h.statement, cell: r.cell, observed: r.observed, outcome: r.outcome }))));
+  const engFail = engineering.filter((r) => r.outcome !== 'pass');
+  const pass = violations === 0 && engFail.length === 0;
+  out['B1'] = { gate: true, pass, runs, checks, violations, perExperiment, engineeringHypotheses: engineering.length, engineeringNotPassed: engFail };
+  say();
+  say('B1 (gate) invariants H-S2-02, H-S2-05, H-S2-06 in every run');
+  say(`  invariant monitor: ${runs} runs, ${checks} checks, ${violations} violations; engineering hypotheses ${engineering.length - engFail.length}/${engineering.length} pass -> ${pass ? 'PASS' : 'FAIL'}`);
+}
+
+// ---------------------------------------------------------------- B2
+{
+  const target = (id: string, hid: string) => (sem[id]?.hypotheses ?? []).filter((h) => h.id === hid).flatMap((h) => h.results);
+  const h01 = [...target('S2-E08-first-recruit-timing', 'H-S2-01'), ...target('S2-E01-deploy-scaling', 'H-S2-01'), ...target('S2-E05-squad-vs-workers', 'H-S2-01')];
+  const h03 = target('S2-E02-hero-damage-share', 'H-S2-03');
+  const e6 = sem['S2-E06-assignment-switching'];
+  const mean = (id: string) => cell(e6, id)?.metrics['legionExpTotal']?.mean ?? null;
+  const squad = mean('a10-p1.6-g100|PR-BAL|POL2-SQUAD');
+  const workers = mean('a10-p1.6-g100|PR-BAL|POL2-WORKERS');
+  const best = squad !== null && workers !== null ? Math.max(squad, workers) : null;
+  const h04 = (e6?.cells ?? [])
+    .filter((c) => c.id.includes('POL2-SWITCH'))
+    .map((c) => {
+      const m = c.metrics['legionExpTotal']?.mean ?? null;
+      const gain = m !== null && best ? m / best - 1 : null;
+      return { cell: c.id, meanLegionExp: m, bestSetAndForget: best, gain, outcome: gain === null ? 'not-reached' : gain <= 0.05 ? 'pass' : 'miss' };
+    });
+  out['B2'] = { gate: false, 'H-S2-01': h01, 'H-S2-03': h03, 'H-S2-04': { setAndForget: { squad, workers }, rows: h04 } };
+  say();
+  say('B2 targets (a miss does not block acceptance)');
+  say(`  H-S2-01 first recruit in [2, 5] min (p50): ${h01.filter((r) => r.outcome === 'pass').length}/${h01.length} cells pass`);
+  for (const r of h01) say(`    ${r.cell}: ${f(r.observed)} min ${r.outcome}`);
+  say(`  H-S2-03 hero damage share in [0.30, 0.60] (p50, mixed, passive): ${h03.filter((r) => r.outcome === 'pass').length}/${h03.length} pass`);
+  for (const r of h03) say(`    ${r.cell}: ${f(r.observed, 3)} ${r.outcome}`);
+  say(`  H-S2-04 switching gain over the better set-and-forget (squad ${f(squad, 0)}, workers ${f(workers, 0)} mean legion EXP):`);
+  for (const r of h04) say(`    ${r.cell}: gain ${r.gain === null ? 'n/a' : `${(r.gain * 100).toFixed(2)}%`} ${r.outcome}`);
+}
+
+// ---------------------------------------------------------------- B3
+{
+  const e5 = sem['S2-E05-squad-vs-workers'];
+  const objectives: [string, string, 'max' | 'min'][] = [
+    ['hero EXP', 'expTotal', 'max'],
+    ['legion EXP', 'legionExpTotal', 'max'],
+    ['gold earned per hour', 'goldPerHour', 'max'],
+    ['gold held', 'goldHeld', 'max'],
+    ['conquest score', 'conquestScore', 'max'],
+    ['zone 3 first visit (min)', 'zone3FirstVisitMin', 'min'],
+  ];
+  const rows: unknown[] = [];
+  say();
+  say('B3 squad versus workers, per objective (no single best across objectives)');
+  for (const profile of ['PR-BAL', 'PR-OPT']) {
+    for (const [name, metric, dir] of objectives) {
+      const vals = ['POL2-SQUAD', 'POL2-WORKERS', 'POL2-MIXED'].map((p) => ({ policy: p, mean: cell(e5, `a10-p1.6-g100|${profile}|${p}`)?.metrics[metric]?.mean ?? null, p50: cell(e5, `a10-p1.6-g100|${profile}|${p}`)?.metrics[metric]?.p50 ?? null }));
+      const known = vals.filter((v) => v.mean !== null) as { policy: string; mean: number; p50: number | null }[];
+      const bestRow = known.length ? known.reduce((a, b) => ((dir === 'max' ? b.mean > a.mean : b.mean < a.mean) ? b : a)) : null;
+      rows.push({ profile, objective: name, metric, values: vals, bestByMean: bestRow?.policy ?? null });
+      say(`  ${profile} ${name}: ${vals.map((v) => `${v.policy} ${f(v.mean, 1)}`).join(', ')} -> best ${bestRow?.policy ?? 'n/a'}`);
+    }
+  }
+  out['B3'] = { gate: false, rows };
+}
+
+// ---------------------------------------------------------------- B4
+{
+  const e9 = sem['S2-E09-hindsight-search'];
+  const comp = (e9?.sections['searchComparison'] ?? []) as { search: string; objective: string; metric: string; realistic: string; searchMean: number | null; realisticMean: number | null; ratio: number | null }[];
+  const budgets = (e9?.cells ?? []).filter((c) => c.tag === 'oracle').map((c) => ({ cell: c.id, forksMean: c.metrics['searchForks']?.mean ?? null, decisionsMean: c.metrics['searchDecisions']?.mean ?? null, exhaustedShare: c.metrics['searchBudgetExhausted']?.mean ?? null }));
+  out['B4'] = { gate: false, label: 'best feasible found with hindsight within the declared budget; gaps are lower bounds on the true gap, never upper bounds', comparison: comp, budgets };
+  say();
+  say('B4 hindsight search (best feasible found; never an upper bound)');
+  for (const r of comp) say(`  ${r.objective}: search ${f(r.searchMean, 1)} vs ${r.realistic.split('|').pop()} ${f(r.realisticMean, 1)} -> ratio ${f(r.ratio, 3)}`);
+  for (const b of budgets) say(`  ${b.cell}: forks ${f(b.forksMean, 1)}, decisions ${f(b.decisionsMean, 1)}, budget exhausted in ${f((b.exhaustedShare ?? 0) * 100, 0)}% of runs`);
+}
+
+// ---------------------------------------------------------------- B5
+{
+  const e10 = sem['S2-E10-estimator-vs-realisation'];
+  const rows = (e10?.sections['estimatorComparison'] ?? []) as { cell: string; squad: { members: number; predictedKillsPerHour: number; reliability: string } | null; realisedMeanKillsPerHour: number | null; errorPct: number | null; bothZero: boolean; worker: { predictedKillsPerHour: number; reliability: string; realisedMeanKillsPerHour: number | null; errorPct: number | null } | null }[];
+  const groups: Record<string, number[]> = {};
+  for (const r of rows) {
+    if (r.cell.includes('|worker-')) {
+      if (r.worker && r.worker.errorPct !== null) (groups[`worker ${r.worker.reliability}`] ??= []).push(r.worker.errorPct);
+      continue;
+    }
+    if (r.squad && r.errorPct !== null) (groups[`squad of ${r.squad.members} ${r.squad.reliability}`] ??= []).push(r.errorPct);
+  }
+  const summary = Object.entries(groups)
+    .sort(([a], [b]) => (a < b ? -1 : 1))
+    .map(([k, v]) => {
+      const abs = v.map(Math.abs).sort((a, b) => a - b);
+      return { group: k, cells: v.length, medianAbsErrorPct: abs[Math.floor((abs.length - 1) / 2)] ?? null, maxAbsErrorPct: abs[abs.length - 1] ?? null, meanSignedErrorPct: v.reduce((a, b) => a + b, 0) / v.length };
+    });
+  const bothZero = rows.filter((r) => r.bothZero).length;
+  out['B5'] = { gate: false, note: 'No accuracy target for the squad estimator (owner section 11). Estimates are never results.', summary, cellsBothZero: bothZero, rows };
+  say();
+  say('B5 estimator against realisation (no accuracy target)');
+  for (const s of summary) say(`  ${s.group}: ${s.cells} cells, median |error| ${f(s.medianAbsErrorPct, 1)}%, max |error| ${f(s.maxAbsErrorPct, 1)}%, mean signed ${f(s.meanSignedErrorPct, 1)}%`);
+  say(`  cells where both the estimate and the realisation are 0: ${bothZero}`);
+}
+
+// ---------------------------------------------------------------- B6
+{
+  const metrics = ['minToL5', 'minToL10', 'zone2FirstVisitMin', 'zone3FirstVisitMin', 'levelAt45'];
+  const e8 = sem['S2-E08-first-recruit-timing'];
+  const rows: unknown[] = [];
+  say();
+  say('B6 / H-S2-07 recruit-dependent timing against the S1.1 control (p50)');
+  for (const profile of ['PR-NEW', 'PR-BAL']) {
+    const ctl = cell(s11, `a10-p1.6-g100|${profile}|POL-FRONTIER|est-s1.1`);
+    say(`  ${profile} S1.1 POL-FRONTIER: ${metrics.map((m) => `${m} ${f(ctl?.metrics[m]?.p50)}`).join(', ')}`);
+    for (const pol of ['POL2-SQUAD-W', 'POL2-WORKERS', 'POL2-MIXED']) {
+      const c = cell(e8, `a10-p1.6-g100|${profile}|${pol}|Q40`);
+      rows.push({ profile, policy: pol, control: Object.fromEntries(metrics.map((m) => [m, ctl?.metrics[m]?.p50 ?? null])), s2: Object.fromEntries(metrics.map((m) => [m, c?.metrics[m]?.p50 ?? null])) });
+      say(`  ${profile} ${pol} (Q40): ${metrics.map((m) => `${m} ${f(c?.metrics[m]?.p50)}`).join(', ')}`);
+    }
+  }
+  out['B6'] = { gate: false, control: 'S1.1-E01 POL-FRONTIER est-s1.1', rows };
+}
+
+// ---------------------------------------------------------------- reported S1 targets
+{
+  const rows = IDS.flatMap((id) => (sem[id]?.hypotheses ?? []).filter((h) => h.id.startsWith('H-S1-')).flatMap((h) => h.results.map((r) => ({ experiment: id, id: h.id, cell: r.cell, observed: r.observed, inS1Range: h.range ? r.observed !== null && r.observed >= h.range[0] && r.observed <= h.range[1] : h.op === '<=' ? r.observed !== null && r.observed <= (h.value ?? 0) : h.op === '>' ? r.observed !== null && r.observed > (h.value ?? 0) : null }))));
+  out['S1TargetsReported'] = rows;
+}
+
+writeText(resolve(LAB_ROOT, OUT), prettyJson(out));
+console.log(lines.join('\n'));
+console.log(`\nwrote ${OUT}`);
