+      rng: { ...x.rng, hit: rng.hit, crit: rng.crit },
+      hp,
+      lastSwingMs: swung ? t : x.lastSwingMs,
+      abilityReadyMs: cast && st.ability ? t + st.ability.cooldownMs : x.abilityReadyMs,
+      worker: { ...x.worker, fight: { ...fight, enemyHp } },
