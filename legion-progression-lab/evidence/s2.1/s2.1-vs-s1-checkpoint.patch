+  private log(kind: string, detail: LogEntry['detail'] = {}): void {
+    const key = this.current;
+    const entry: LogEntry = { t: key ? key.t : this.state.tMs, pass: key ? key.pass : 0, phase: key ? key.phase : PHASE.BOUNDARY, kind, detail };
