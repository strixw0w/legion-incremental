+    const data = { member: id, mepoch: c.epoch, fight: fight.id };
+    this.schedule(c.lastSwingMs === null ? t : Math.max(t, c.lastSwingMs + st.attackIntervalMs), PHASE.COMPLETE, `worker:${id}`, 'WorkerSwing', { data });
