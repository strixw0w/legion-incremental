+      return;
+    }
+    if (killed) {
+      this.scheduleWorkerEngage(id);
+      return;
+    }
+    if (swung) this.schedule(t + st.attackIntervalMs, PHASE.COMPLETE, `worker:${id}`, 'WorkerSwing', { data });
