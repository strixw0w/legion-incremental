+    const enemy = zone.enemy;
+    const st = this.statsOf(c);
+    let rng = { hit: c.rng.hit, crit: c.rng.crit };
+    let damage = 0;
+    let swung = false;
+    let cast = false;
+    for (const ev of [...events].sort((a, b) => (a.kind === 'WorkerAbility' ? 1 : 0) - (b.kind === 'WorkerAbility' ? 1 : 0))) {
