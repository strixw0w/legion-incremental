@@ -0,0 +1,66 @@
+/**
+ * S2.1 ability-aware worker classification (owner L1/S2 review §4; spec/formulas/s2-legion.md v1.1 §4).
+ *
+ * The worker estimate is estimator v1.2 applied to the worker's own stats with BASIC ATTACKS ONLY. That is a
+ * conservative production estimate (an automatic ability only adds damage: it has its own timer and delays no swing),
+ * but it cannot support "impossible": an ability can make a fight winnable that basic attacks lose.
+ *
+ * Structural feasibility (upper bound, from full HP): every swing at 0, interval, 2 x interval, ... and every cast at 0,
+ * cooldown, 2 x cooldown, ... (the ability assumed ready at the start), each hitting for its maximum (crit damage when
+ * crits are possible), until the moment the enemy's hits would knock the worker out (blows at that moment still land).
+ * If even this bound is below the enemy's HP, the fight is PROVEN impossible. Otherwise it is not.
+ *
+ * Classification of a classed worker's estimate:
+ * - basic attacks can win  -> the v1.2 rates are kept as a conservative estimate; "reliable" becomes "approximate";
+ *                             reason ABILITY_NOT_MODELLED is always added (whatever the reliability);
+ * - basic attacks cannot win, bound below HP -> "unreachable" (DIES_BEFORE_KILL, ABILITY_INCLUDED_IN_BOUND): proven;
+ * - basic attacks cannot win, bound reaches HP -> "unresolved" (ABILITY_DEPENDENT): kills are possible only with the
+ *   ability; production is NOT estimated (0 shown, never a claim of impossibility). In practice the ability is ready
+ *   at the first fight after each recovery and then on cooldown, so such zones yield about one kill per knockout cycle.
+ * - no hit chance, or an unresolved v1.2 computation (budgets): unchanged (unreachable), ABILITY_NOT_MODELLED added.
+ * Not an exact ability-aware estimator (deliberately bounded for S2.1).
+ */
+import { damagePerHit, mitigationRatio } from '../core/formulas/combat.ts';
+import type { CharacterStats, LegionContent } from '../model/legionContent.ts';
+import type { ZoneEstimate } from './estimator.ts';
+
+export interface WorkerFeasibility {
+  readonly hitPossible: boolean;
+  /** Time from engagement at which the worker is knocked out from full HP (null if the enemy cannot hurt it). */
+  readonly knockoutMs: number | null;
+  /** Upper bound on the damage the worker can deal by then (ability included). Infinity if never knocked out. */
+  readonly damageBound: number;
+  readonly enemyHp: number;
+  readonly provenImpossible: boolean;
+}
+
+export function workerFeasibility(content: LegionContent, stats: CharacterStats, zoneOrder: number): WorkerFeasibility {
+  const zone = content.zones[zoneOrder - 1];
+  if (!zone) throw new Error(`unknown zone order ${zoneOrder}`);
+  const enemy = zone.enemy;
+  const K = content.combat.mitigationK;
+  const minDamage = content.combat.minDamagePerHit;
+  const critMultBp = content.hero.critMultBp;
+  const mitigation = mitigationRatio(enemy.defence, K);
+  const hitPossible = zone.heroHitThreshold > 0;
+  const canCrit = stats.critChanceBp > 0;
+  const maxBlow = (raw: number) => damagePerHit({ rawMilli: raw, crit: canCrit, critMultBp, mitigation, minDamage });
+  const enemyDamage = damagePerHit({ rawMilli: enemy.attackMilli, crit: false, critMultBp: 10_000, mitigation: mitigationRatio(stats.defence, K), minDamage });
+  if (!hitPossible) return { hitPossible, knockoutMs: null, damageBound: 0, enemyHp: enemy.hp, provenImpossible: true };
+  const R = Math.ceil(stats.maxHp / enemyDamage);
+  const knockoutMs = enemy.firstAttackDelayMs + (R - 1) * enemy.attackIntervalMs;
+  let bound = maxBlow(stats.attackRawMilli) * (Math.floor(knockoutMs / stats.attackIntervalMs) + 1);
+  if (stats.ability) bound += maxBlow(stats.ability.rawMilli) * (Math.floor(knockoutMs / stats.ability.cooldownMs) + 1);
+  return { hitPossible, knockoutMs, damageBound: bound, enemyHp: enemy.hp, provenImpossible: bound < enemy.hp };
+}
+
+/** Reclassifies a classed worker's basic-attack v1.2 estimate (see the module header). Classless workers are unchanged. */
+export function abilityAwareWorkerEstimate(base: ZoneEstimate, content: LegionContent, stats: CharacterStats, zoneOrder: number): ZoneEstimate {
+  if (stats.ability === null) return base;
+  const withReason = (e: ZoneEstimate, ...r: string[]): ZoneEstimate => ({ ...e, reasons: [...e.reasons, ...r.filter((x) => !e.reasons.includes(x))] });
+  if (base.reliability !== 'unreachable') return withReason({ ...base, reliability: base.reliability === 'reliable' ? 'approximate' : base.reliability }, 'ABILITY_NOT_MODELLED');
+  if (!base.reasons.includes('DIES_BEFORE_KILL')) return withReason(base, 'ABILITY_NOT_MODELLED'); // no hit chance or unresolved budgets
+  const f = workerFeasibility(content, stats, zoneOrder);
+  if (f.provenImpossible) return withReason(base, 'ABILITY_INCLUDED_IN_BOUND');
+  return { ...base, reliability: 'unresolved', limitingFactor: 'survival', reasons: ['ABILITY_DEPENDENT', 'BASIC_ATTACKS_DIE_BEFORE_KILL', 'ABILITY_NOT_MODELLED'] };
+}
diff --git a/legion-progression-lab/src/experiments/legionJobs.ts b/legion-progression-lab/src/experiments/legionJobs.ts
new file mode 100644
index 0000000..79d5cc8
--- /dev/null
+++ b/legion-progression-lab/src/experiments/legionJobs.ts
@@ -0,0 +1,305 @@
+/**
+ * S2 experiment jobs: one replicate of one cell. Pure: compiled content in, named values out (units in the names).
+ * Seed policy: replicate i uses "<root>#rep-<i>" in every cell (common random numbers), as in S1.
+ */
+import type { LedgerImplementationId } from '../core/ledger/implementations.ts';
+import { LegionSimulation, type StartCharacter } from '../engine/legion.ts';
+import { displayed, squadEstimateFor } from '../engine/legionObservation.ts';
+import type { ClassId, LegionContent, TalentAllocation } from '../model/legionContent.ts';
+import type { LegionCommand, LegionObservation, LegionPolicy } from '../model/legionTypes.ts';
+import type { LogEntry } from '../model/types.ts';
+import { makeOrc2Search, objectiveScore, type SearchObjective } from '../policy/legionSearch.ts';
+import { makePol2, TALENT_PRIORITY, type Pol2Config } from '../policy/legionRealistic.ts';
+import { fixedZonePolicyS1 } from '../policy/realistic.ts';
+import { campaignValues, makePolicy, type Values } from './jobs.ts';
+import { LegionMetricsRecorder, type LegionRunMetrics } from './legionMetrics.ts';
+import type { S2Cell } from './legionManifest.ts';
+import { PROFILES } from './manifest.ts';
+import { MetricsRecorder } from './metrics.ts';
+import type { Simulation } from '../engine/simulation.ts';
+
+export interface S2Job {
+  readonly cellIndex: number;
+  readonly replicate: number;
+  readonly seedRoot: string;
+  readonly cell: S2Cell;
+  readonly ledger?: LedgerImplementationId;
+  readonly trace?: boolean;
+}
+
+export interface S2JobResult {
+  readonly cell: number;
+  readonly replicate: number;
+  readonly values: Values;
+  readonly digest: string | null;
+  readonly trace?: readonly LogEntry[];
+  readonly extra?: unknown;
+}
+
+const MIN = 60_000;
+const perHour = (n: number, ms: number): number => (n * 3_600_000) / ms;
+const toMin = (ms: number | null | undefined): number | null => (ms === null || ms === undefined ? null : ms / MIN);
+const RELIABILITY_CODE = { reliable: 0, approximate: 1, unsafe: 2, unreachable: 3, unresolved: 4 } as const;
+
+const POL2_BASES: Readonly<Record<string, Partial<Pol2Config>>> = {
+  'POL2-SQUAD': { mode: 'squad', extras: 'idle' },
+  'POL2-SQUAD-W': { mode: 'squad', extras: 'workers' },
+  'POL2-WORKERS': { mode: 'workers' },
+  'POL2-MIXED': { mode: 'mixed' },
+};
+
+export function makeS2Policy(name: string, over: Partial<Pol2Config> = {}): LegionPolicy {
+  const base = POL2_BASES[name];
+  if (base) return makePol2({ id: name, heroClass: 'archer', composition: 'mixed', mode: 'squad', maxDeploy: 3, extras: 'workers', buyRecruits: true, attentive: false, ...base, ...over });
+  return makePolicy(name) as unknown as LegionPolicy; // S1.1 policies (control A0)
+}
+
+/** Full talent allocation for a level, by the fixed POL2 priority (fill the first talent to its maximum, then the next). */
+export function autoTalents(content: LegionContent, cls: ClassId, level: number): TalentAllocation {
+  let free = Math.max(0, level - 1) * content.legion.talentPointsPerLevel;
+  const out: Record<string, number> = {};
+  for (const t of TALENT_PRIORITY[cls]) {
+    const n = Math.min(free, content.legion.maxPointsPerTalent);
+    if (n > 0) out[t] = n;
+    free -= n;
+  }
+  return out;
+}
+
+/** S2 values of a legion run (the S1 campaign values are added by the caller where they apply). */
+export function legionValues(m: LegionRunMetrics, sim: LegionSimulation): Values {
+  const h = m.base.horizonMs;
+  const recruits = Object.entries(m.characters).filter(([id]) => id !== 'hero');
+  const s = sim.state;
+  return {
+    firstRecruitMin: toMin(m.firstRecruitMs),
+    recruit2Min: toMin(m.recruitMs[1] ?? null),
+    recruit3Min: toMin(m.recruitMs[2] ?? null),
+    squadKillsPerHour: perHour(m.squadKills, h),
+    workerKillsPerHour: perHour(m.workerKills, h),
+    legionExpPerHour: perHour(m.legionExp, h),
+    heroExpPerHour: perHour(m.heroExp, h),
+    legionExpTotal: m.legionExp,
+    heroDamageShare: m.heroDamageShare,
+    heroAbilityDamageShare: m.squadDamage > 0 ? m.heroAbilityDamage / m.squadDamage : null,
+    memberKnockoutsPerHour: perHour(m.memberKnockouts, h),
+    workerStops: m.workerStops,
+    goldSpent: m.goldSpent,
+    goldHeld: sim.goldBalance(),
+    classChanges: m.classChanges,
+    recruitsOwned: recruits.length,
+    recruitLevelMean: recruits.length > 0 ? recruits.reduce((a, [, c]) => a + c.level, 0) / recruits.length : null,
+    recordWarrior: m.records.warrior,
+    recordArcher: m.records.archer,
+    recordMage: m.records.mage,
+    conquestScore: s.zones.filter((z) => z.accessUnlocked).length * 1e9 + (s.boss.opened ? 1e6 : 0) + s.zones.reduce((a, z) => a + z.kills, 0),
+    bossGateOpen: s.boss.opened ? 1 : 0,
+    automationMin: m.time.automation / MIN,
+    manualCombatMin: m.time.manualCombat / MIN,
+    restingMin: m.time.resting / MIN,
+    travellingMin: m.time.travelling / MIN,
+    waitingMin: m.time.waiting / MIN,
+    idleMin: m.time.idle / MIN,
+    connectedMin: m.time.connectedMs / MIN,
+    elapsedMin: m.time.elapsedMs / MIN,
+    invariantChecks: m.invariants.checks,
+    invariantViolations: m.invariants.violations,
+  };
+}
+
+function withAbility(p: LegionPolicy, attentive: boolean): LegionPolicy {
+  if (!attentive) return p;
+  return {
+    ...p,
+    attentive: true,
+    decide(obs: LegionObservation, oracle: unknown): readonly LegionCommand[] {
+      const out: LegionCommand[] = [...p.decide(obs, oracle)];
+      if (obs.sessionOpen && obs.legion.heroInCombat && obs.legion.heroAbilityReady) out.unshift({ type: 'UseAbility' });
+      return out;
+    },
+  };
+}
+
+function runCampaign(job: S2Job, cell: Extract<S2Cell, { kind: 'campaign' }>, content: LegionContent): S2JobResult {
+  const ms = PROFILES[cell.profile].sessionMin * MIN;
+  const policy = makeS2Policy(cell.policy, (cell.over ?? {}) as Partial<Pol2Config>);
+  const sim = new LegionSimulation({
+    content,
+    seedRoot: job.seedRoot,
+    sessions: [{ startMs: 0, endMs: ms }],
+    policy,
+    legion: cell.legion,
+    keepLog: job.trace ? 1500 : 0,
+    ...(cell.questKills !== undefined ? { diagnostic: { questKills: cell.questKills } } : {}),
+    ...(job.ledger ? { ledger: job.ledger } : {}),
+  });
+  if (!cell.legion) {
+    // Control A0: the S1 recorder alone, exactly as S1.1 measured.
+    const rec = new MetricsRecorder(sim as unknown as Simulation);
+    sim.run(ms);
+    return { cell: job.cellIndex, replicate: job.replicate, values: campaignValues(rec.finish(sim as unknown as Simulation, ms), content), digest: sim.logDigest(), ...(job.trace ? { trace: sim.keptLog } : {}) };
+  }
+  const rec = new LegionMetricsRecorder(sim);
+  sim.run(ms);
+  const m = rec.finish(ms);
+  return { cell: job.cellIndex, replicate: job.replicate, values: { ...campaignValues(m.base, content), ...legionValues(m, sim) }, digest: sim.logDigest(), ...(job.trace ? { trace: sim.keptLog } : {}), ...(m.invariants.first.length > 0 ? { extra: { violations: m.invariants.first } } : {}) };
+}
+
+function runMatched(job: S2Job, cell: Extract<S2Cell, { kind: 'matched' }>, content: LegionContent): S2JobResult {
+  const ms = cell.minutes * MIN;
+  const recruits: StartCharacter[] = cell.recruits.map((r) => ({
+    level: r.level,
+    ...(r.cls ? { cls: r.cls, talents: autoTalents(content, r.cls, r.level) } : {}),
+    assignment: r.assignment,
+  }));
+  const squad = cell.recruits.filter((r) => r.assignment === 'squad').length;
+  const logic: LegionPolicy =
+    cell.logic === 'CONTINUOUS'
+      ? { id: `CONTINUOUS-${cell.zone}`, kind: 'control', decide: (obs) => fixedZonePolicyS1(cell.zone).decide(obs, null) as readonly LegionCommand[] }
+      : makePol2({ id: `POL2-FIXED-${cell.zone}`, heroClass: cell.heroClass, composition: 'mixed', mode: 'squad', maxDeploy: squad, extras: 'idle', buyRecruits: false, attentive: false, fixedZone: cell.zone });
+  const policy = withAbility(logic, cell.attentive);
+  const sim = new LegionSimulation({
+    content,
+    seedRoot: job.seedRoot,
+    sessions: [{ startMs: 0, endMs: ms }],
+    policy,
+    legion: true,
+    keepLog: job.trace ? 1500 : 0,
+    diagnostic: {
+      startLevel: cell.heroLevel,
+      freezeLevel: true,
+      startZoneOrder: cell.zone,
+      unlockAllZones: true,
+      ...(cell.heroClass ? { heroClass: cell.heroClass, heroTalents: autoTalents(content, cell.heroClass, cell.heroLevel) } : {}),
+      recruits,
+      startSlots: recruits.length,
+      startDeployCap: 3,
+    },
+    ...(job.ledger ? { ledger: job.ledger } : {}),
+  });
+  // Predictions shown at the start (the squad estimator for this squad; the worker estimator for the first worker).
+  const predicted = squadEstimateFor(sim, cell.zone, cell.attentive);
+  const worker = sim.state.legion.chars.find((c) => c.assignment.kind === 'worker');
+  const wPred = worker ? displayed(sim.workerEstimate(worker, worker.assignment.kind === 'worker' ? worker.assignment.zoneOrder : cell.zone)) : null;
+  const rec = new LegionMetricsRecorder(sim);
+  sim.run(ms);
+  const m = rec.finish(ms);
+  return {
+    cell: job.cellIndex,
+    replicate: job.replicate,
+    digest: sim.logDigest(),
+    ...(job.trace ? { trace: sim.keptLog } : {}),
+    values: {
+      killsPerHour: perHour(m.squadKills, ms),
+      workerKillsPerHour: perHour(m.workerKills, ms),
+      heroDamageShare: m.heroDamageShare,
+      heroAbilityDamageShare: m.squadDamage > 0 ? m.heroAbilityDamage / m.squadDamage : null,
+      legionExpPerHour: perHour(m.legionExp, ms),
+      heroExpPerHour: perHour(m.heroExp, ms),
+      memberKnockoutsPerHour: perHour(m.memberKnockouts, ms),
+      deathsPerHour: perHour(m.base.deaths, ms),
+      workerStops: m.workerStops,
+      medianTtkS: m.base.medianTtkMs[String(cell.zone)] === null || m.base.medianTtkMs[String(cell.zone)] === undefined ? null : (m.base.medianTtkMs[String(cell.zone)] as number) / 1000,
+      predictedKillsPerHour: predicted.killsPerHour,
+      predictedTtkS: predicted.ttkS,
+      predictedReliability: RELIABILITY_CODE[predicted.reliability],
+      predictedWorkerKillsPerHour: wPred ? wPred.killsPerHour : null,
+      predictedWorkerReliability: wPred ? RELIABILITY_CODE[wPred.reliability] : null,
+      invariantChecks: m.invariants.checks,
+      invariantViolations: m.invariants.violations,
+    },
+    extra: { predicted, workerPredicted: wPred, ...(m.invariants.first.length > 0 ? { violations: m.invariants.first } : {}) },
+  };
+}
+
+/**
+ * S2-E04 class-switch abuse: the hero and three recruits at `level` cycle Warrior -> Archer -> Mage -> ... `cycles`
+ * times each. Without training every switch happens at the session start, with no combat. With training the squad
+ * farms zone 1 for `trainMs` between switches (levels are not frozen). The invariant monitor checks every switch.
+ */
+function runSwitchAbuse(job: S2Job, cell: Extract<S2Cell, { kind: 'switch-abuse' }>, content: LegionContent): S2JobResult {
+  const order: ClassId[] = ['warrior', 'archer', 'mage'];
+  const ids = ['hero', 'rec:1', 'rec:2', 'rec:3'];
+  let done = 0;
+  let lastSwitch = Number.NEGATIVE_INFINITY;
+  const policy: LegionPolicy = {
+    id: `SWITCH-ABUSE-${cell.train ? 'train' : 'none'}`,
+    kind: 'control',
+    decide(obs) {
+      if (!obs.sessionOpen) return [];
+      const out: LegionCommand[] = [];
+      const free = obs.legion.roster.every((c) => !c.inCombat);
+      while (done < cell.cycles && free && obs.tMs >= lastSwitch + (cell.train ? cell.trainMs : 0)) {
+        for (const id of ids) out.push({ type: 'SetClass', characterId: id, cls: order[done % 3] as ClassId });
+        done += 1;
+        lastSwitch = obs.tMs;
+        if (cell.train) break;
+      }
+      if (cell.train && !obs.hero.autoFarm && obs.hero.status !== 'dead') out.push({ type: 'SetAutoFarm', on: true, zoneId: obs.hero.zoneId });
+      return out;
+    },
+  };
+  const ms = cell.train ? cell.cycles * cell.trainMs + 60_000 : 60_000;
+  const sim = new LegionSimulation({
+    content,
+    seedRoot: job.seedRoot,
+    sessions: [{ startMs: 0, endMs: ms }],
+    policy,
+    legion: true,
+    diagnostic: { startLevel: cell.level, startZoneOrder: 1, unlockAllZones: true, recruits: [1, 2, 3].map(() => ({ level: cell.level, assignment: 'squad' as const })), startSlots: 3, startDeployCap: 3, startGold: cell.cycles * 4 * content.legion.classChangeCostGold },
+    ...(job.ledger ? { ledger: job.ledger } : {}),
+  });
+  const rec = new LegionMetricsRecorder(sim);
+  sim.run(ms);
+  const m = rec.finish(ms);
+  const chars = sim.state.legion.chars;
+  const masteryTotal = chars.reduce((a, c) => a + c.mastery.warrior + c.mastery.archer + c.mastery.mage, 0);
+  return {
+    cell: job.cellIndex,
+    replicate: job.replicate,
+    digest: sim.logDigest(),
+    values: {
+      switchesAccepted: m.classChanges,
+      switchesRequested: done * ids.length,
+      masteryTotal,
+      masteryMinusCombatExp: masteryTotal - chars.reduce((a, c) => a + c.totalExp, 0),
+      recordsSum: m.records.warrior + m.records.archer + m.records.mage,
+      legionExpTotal: m.legionExp,
+      goldSpent: m.goldSpent,
+      invariantChecks: m.invariants.checks,
+      invariantViolations: m.invariants.violations,
+    },
+    ...(m.invariants.first.length > 0 ? { extra: { violations: m.invariants.first } } : {}),
+  };
+}
+
+function runSearch(job: S2Job, cell: Extract<S2Cell, { kind: 'search' }>, content: LegionContent): S2JobResult {
+  const ms = PROFILES[cell.profile].sessionMin * MIN;
+  const policy = makeOrc2Search(cell.objective as SearchObjective, cell.budget);
+  const sim = new LegionSimulation({ content, seedRoot: job.seedRoot, sessions: [{ startMs: 0, endMs: ms }], policy, legion: true, ...(job.ledger ? { ledger: job.ledger } : {}) });
+  const rec = new LegionMetricsRecorder(sim);
+  sim.run(ms);
+  const m = rec.finish(ms);
+  const report = policy.report();
+  return {
+    cell: job.cellIndex,
+    replicate: job.replicate,
+    digest: sim.logDigest(),
+    values: { ...campaignValues(m.base, content), ...legionValues(m, sim), objectiveScore: objectiveScore(sim, cell.objective as SearchObjective), searchForks: report.forksUsed, searchDecisions: report.decisions.length, searchBudgetExhausted: report.budgetExhausted ? 1 : 0 },
+    extra: { decisions: report.decisions.map((d) => `${d.tMs}:${d.candidate}`) },
+  };
+}
+
+export function runS2Job(job: S2Job, content: LegionContent): S2JobResult {
+  const c = job.cell;
+  switch (c.kind) {
+    case 'campaign':
+      return runCampaign(job, c, content);
+    case 'matched':
+      return runMatched(job, c, content);
+    case 'switch-abuse':
+      return runSwitchAbuse(job, c, content);
+    case 'search':
+      return runSearch(job, c, content);
+  }
+}
diff --git a/legion-progression-lab/src/experiments/legionManifest.ts b/legion-progression-lab/src/experiments/legionManifest.ts
new file mode 100644
index 0000000..0077a1d
--- /dev/null
+++ b/legion-progression-lab/src/experiments/legionManifest.ts
@@ -0,0 +1,118 @@
+/**
+ * S2 experiment manifests (manifests/s2/PREREGISTRATION.md). Each manifest lists its cells explicitly (no hidden cross
+ * products) and is registered (SHA-256 in manifests/s2/preregistration.json) before it runs; the S2 runner refuses an
+ * unregistered or changed manifest. Hypotheses use the S1 hypothesis format (`H-S2-..`, or `H-S1-..` reported again).
+ */
+import { z } from 'zod';
+import { CLASS_IDS } from '../model/legionContent.ts';
+
+const Cls = z.enum(CLASS_IDS);
+const Profile = z.enum(['PR-NEW', 'PR-BAL', 'PR-OPT']);
+
+/** Overrides of the POL2 realistic policy (src/policy/legionRealistic.ts). */
+const Pol2Over = z
+  .object({
+    heroClass: Cls.nullable().optional(),
+    composition: z.enum(['mixed', 'all-W', 'all-A', 'all-M']).optional(),
+    mode: z.enum(['squad', 'workers', 'mixed']).optional(),
+    maxDeploy: z.number().int().min(0).max(3).optional(),
+    extras: z.enum(['idle', 'workers']).optional(),
+    buyRecruits: z.boolean().optional(),
+    attentive: z.boolean().optional(),
+    switchPeriodMs: z.number().int().min(1).optional(),
+  })
+  .strict();
+
+const CampaignCell = z
+  .object({
+    id: z.string().regex(/^[A-Za-z0-9|.:=+-]+$/),
+    kind: z.literal('campaign'),
+    variant: z.string(),
+    profile: Profile,
+    /** A POL2 base name (POL2-*) with optional overrides, or an S1.1 policy name for the A0 control. */
+    policy: z.string().min(3),
+    over: Pol2Over.optional(),
+    legion: z.boolean(),
+    questKills: z.number().int().min(1).optional(),
+  })
+  .strict();
+
+const Recruit = z.object({ level: z.number().int().min(1), cls: Cls.nullable(), assignment: z.enum(['squad', 'idle']).or(z.object({ worker: z.number().int().min(1) }).strict()) }).strict();
+
+const MatchedCell = z
+  .object({
+    id: z.string().regex(/^[A-Za-z0-9|.:=+-]+$/),
+    kind: z.literal('matched'),
+    variant: z.string(),
+    minutes: z.number().int().min(1),
+    zone: z.number().int().min(1),
+    heroLevel: z.number().int().min(1),
+    heroClass: Cls.nullable(),
+    recruits: z.array(Recruit).max(3),
+    /** Squad farming logic: the S2 fixed-zone policy (rests, respects stops) or continuous farming (estimator reference). */
+    logic: z.enum(['POL2-FIXED', 'CONTINUOUS']),
+    attentive: z.boolean(),
+  })
+  .strict();
+
+const SwitchCell = z
+  .object({
+    id: z.string().regex(/^[A-Za-z0-9|.:=+-]+$/),
+    kind: z.literal('switch-abuse'),
+    variant: z.string(),
+    level: z.number().int().min(1),
+    cycles: z.number().int().min(1),
+    train: z.boolean(),
+    trainMs: z.number().int().min(1),
+  })
+  .strict();
+
+const SearchCell = z
+  .object({
+    id: z.string().regex(/^[A-Za-z0-9|.:=+-]+$/),
+    kind: z.literal('search'),
+    variant: z.string(),
+    profile: Profile,
+    objective: z.enum(['heroExp', 'legionExp', 'gold', 'conquest']),
+    budget: z.object({ horizonMs: z.number().int().min(1), maxForksPerDecision: z.number().int().min(1), maxForksPerRun: z.number().int().min(1), minDecisionGapMs: z.number().int().min(0) }).strict(),
+  })
+  .strict();
+
+export const S2CellSchema = z.discriminatedUnion('kind', [CampaignCell, MatchedCell, SwitchCell, SearchCell]);
+export type S2Cell = z.infer<typeof S2CellSchema>;
+
+const HypothesisSchema = z
+  .object({
+    id: z.string().regex(/^H-S[12](\.1)?-\d\d[a-z]?$/),
+    statement: z.string().min(5),
+    source: z.string().min(2),
+    metric: z.string().min(2),
+    stat: z.enum(['p10', 'p50', 'p90', 'mean', 'max']),
+    op: z.enum(['<=', '>=', '<', '>', 'in', '==']),
+    value: z.number().optional(),
+    range: z.tuple([z.number(), z.number()]).optional(),
+    unit: z.string().min(1),
+    role: z.enum(['target', 'diagnostic', 'reported', 'engineering']),
+    scope: z.object({ cells: z.array(z.string()).optional() }).strict().optional(),
+  })
+  .strict();
+
+export const S2ManifestSchema = z
+  .object({
+    experimentId: z.string().regex(/^S2(\.1)?-E\d\d-[a-z0-9-]+$/),
+    increment: z.enum(['S2', 'S2.1']),
+    question: z.string().min(10),
+    design: z.string().min(10),
+    contentRef: z.object({ path: z.string(), sha256: z.string().regex(/^[0-9a-f]{64}$/) }).strict(),
+    /** Variants patch the S1 base pack (S1 VARIANT_PARAMS); the S2 pack is then compiled on the patched base. */
+    variants: z.array(z.object({ id: z.string().regex(/^[a-z0-9.-]+$/), params: z.record(z.string(), z.union([z.number(), z.string()])) }).strict()).min(1),
+    cells: z.array(S2CellSchema).min(1),
+    seeds: z.object({ root: z.string().min(1), replicates: z.number().int().min(1).max(100_000) }).strict(),
+    metrics: z.array(z.string()).min(1),
+    hypotheses: z.array(HypothesisSchema),
+    notes: z.array(z.string()),
+  })
+  .strict();
+
+export type S2Manifest = z.infer<typeof S2ManifestSchema>;
+export type S2Hypothesis = z.infer<typeof HypothesisSchema>;
diff --git a/legion-progression-lab/src/experiments/legionMetrics.ts b/legion-progression-lab/src/experiments/legionMetrics.ts
new file mode 100644
index 0000000..e6fa537
--- /dev/null
+++ b/legion-progression-lab/src/experiments/legionMetrics.ts
@@ -0,0 +1,378 @@
+/**
+ * S2 per-run metrics and the reward-invariant monitor (planning/S2_SPECIFICATION.md §8; pre-registration B1).
+ *
+ * The S1 MetricsRecorder runs unchanged underneath (hero-centric metrics; gold and materials reconciled with the ledger,
+ * legion spending included). On top of it:
+ *
+ * INVARIANT MONITOR — independent shadow bookkeeping, checked on every credited kill and every loadout change:
+ *  I1 eligibility: the awarded characters are exactly the hero plus the participants present at the encounter's start,
+ *     minus those knocked out or withdrawn before the killing batch (squad); the worker alone (worker stream).
+ *  I2 full EXP: every award equals the enemy's EXP (never divided).
+ *  I3 nobody else: every character's total EXP equals the shadow total (ineligible characters gain nothing), and its
+ *     level progress (cumulative EXP from the table) moved by exactly the same amount (levels unfrozen, below the cap).
+ *  I4 loot once: replaying ONE reward roll on a shadow of the right loot stream (account for squads, the worker's own
+ *     for workers) reproduces the logged gold and drops AND the engine's stream state afterwards, whatever the squad size.
+ *  I5 counters once: the zone kill counter and quest progress advance by exactly one per credited kill.
+ *  I6 identity once: the committed credit count equals the number of accepted credits.
+ *  I7 mastery: only the class held at the credit gains, by the award; class, talent, respec and assignment changes never
+ *     change mastery; account records equal the maximum mastery level over all owned characters.
+ *  I8 exclusivity: nobody is both an active squad participant and in a worker fight; a worker fight only for a worker.
+ *  I9 (S2.1, D-01) worker eligibility: every worker assignment and every worker fight is in a zone that is accessible
+ *     AND visited by the hero; checked at every assignment, fight start, encounter start and credit.
+ * Violations are counted and the first ten are kept with their time. Any violation fails gate B1.
+ */
+import { fail } from '../core/errors.ts';
+import type { RngState } from '../core/rng/xoshiro128ss.ts';
+import { levelForExp, type LegionSimulation } from '../engine/legion.ts';
+import { workerZoneAllowed } from '../engine/legionCommands.ts';
+import { encodeDropItems, rollKillReward } from '../engine/rewards.ts';
+import type { Simulation } from '../engine/simulation.ts';
+import { CLASS_IDS, type ClassId, type HeldClass } from '../model/legionContent.ts';
+import type { CharacterState, TimeCategory } from '../model/legionTypes.ts';
+import type { LogEntry } from '../model/types.ts';
+import { MetricsRecorder, type RunMetrics } from './metrics.ts';
+
+export interface CharacterMetrics {
+  readonly level: number;
+  readonly totalExp: number;
+  readonly cls: HeldClass;
+  readonly damage: number;
+  readonly knockouts: number;
+  readonly classChanges: number;
+  readonly assignment: string;
+}
+
+export interface LegionRunMetrics {
+  readonly base: RunMetrics;
+  readonly firstRecruitMs: number | null;
+  readonly recruitMs: readonly number[];
+  readonly squadKills: number;
+  readonly workerKills: number;
+  readonly legionExp: number;
+  readonly heroExp: number;
+  readonly squadDamage: number;
+  readonly heroDamage: number;
+  readonly heroAbilityDamage: number;
+  /** Hero damage / total squad damage (worker damage excluded); null when the squad dealt none. */
+  readonly heroDamageShare: number | null;
+  readonly memberKnockouts: number;
+  readonly workerStops: number;
+  readonly goldSpent: number;
+  readonly classChanges: number;
+  readonly characters: Readonly<Record<string, CharacterMetrics>>;
+  readonly records: Readonly<Record<ClassId, number>>;
+  /** Time categories (owner S1.1 §3): no category is "active player input". */
+  readonly time: Readonly<Record<TimeCategory, number>> & { readonly connectedMs: number; readonly elapsedMs: number };
+  readonly invariants: { readonly checks: number; readonly violations: number; readonly first: readonly string[] };
+}
+
+interface Shadow {
+  totalExp: Map<string, number>;
+  /** Cumulative table EXP minus total EXP at the start (or when the character joined): constant while levels move. */
+  progressOffset: Map<string, number>;
+  mastery: Map<string, Record<ClassId, number>>;
+  cls: Map<string, HeldClass>;
+  loot: Map<string, RngState>;
+  zoneKills: number[];
+  quest: number;
+  questDone: boolean;
+  committed: number;
+}
+
+export class LegionMetricsRecorder {
+  private readonly base: MetricsRecorder;
+  private readonly sim: LegionSimulation;
+  private readonly shadow: Shadow;
+  private readonly participants = new Map<string, string[]>();
+  private readonly eligible = new Map<string, string[]>();
+  private readonly ko = new Set<string>();
+  private readonly damage = new Map<string, number>();
+  private readonly kos = new Map<string, number>();
+  private firstRecruitMs: number | null = null;
+  private readonly recruitMs: number[] = [];
+  private squadKills = 0;
+  private workerKills = 0;
+  private legionExp = 0;
+  private heroExp = 0;
+  private heroAbilityDamage = 0;
+  private workerStops = 0;
+  private goldSpent = 0;
+  private classChanges = 0;
+  private checks = 0;
+  private violations = 0;
+  private readonly first: string[] = [];
+
+  constructor(sim: LegionSimulation) {
+    this.sim = sim;
+    this.base = new MetricsRecorder(sim as unknown as Simulation);
+    const s = sim.state;
+    this.shadow = {
+      totalExp: new Map(s.legion.chars.map((c) => [c.id, c.totalExp])),
+      progressOffset: new Map(s.legion.chars.map((c) => [c.id, this.cumulative(c) - c.totalExp])),
+      mastery: new Map(s.legion.chars.map((c) => [c.id, { ...c.mastery }])),
+      cls: new Map(s.legion.chars.map((c) => [c.id, c.cls])),
+      loot: new Map([['account', s.rng.loot], ...s.legion.chars.map((c) => [`worker:${c.id}`, c.rng.loot] as [string, RngState])]),
+      zoneKills: s.zones.map((z) => z.kills),
+      quest: s.legion.quest.kills,
+      questDone: s.legion.quest.done,
+      committed: s.legion.credits.committedCount,
+    };
+    sim.addObserver((e) => this.onEntry(e));
+  }
+
+  private violate(t: number, what: string): void {
+    this.violations += 1;
+    if (this.first.length < 10) this.first.push(`t=${t} ${what}`);
+  }
+
+  private check(t: number, ok: boolean, what: string): void {
+    this.checks += 1;
+    if (!ok) this.violate(t, what);
+  }
+
+  /** Cumulative EXP implied by a character's level and EXP into the level (the hero's live record for the hero). */
+  private cumulative(c: CharacterState): number {
+    const s = this.sim.state;
+    const level = c.id === 'hero' ? s.hero.level : c.level;
+    let total = c.id === 'hero' ? s.hero.expIntoLevel : c.expIntoLevel;
+    for (let l = 1; l < level; l += 1) total += this.sim.content.table[l - 1] as number;
+    return total;
+  }
+
+  private charOf(id: string): CharacterState | undefined {
+    return this.sim.state.legion.chars.find((c) => c.id === id);
+  }
+
+  private addCharacter(id: string): void {
+    const c = this.charOf(id);
+    if (!c) return;
+    this.shadow.totalExp.set(id, c.totalExp);
+    this.shadow.progressOffset.set(id, this.cumulative(c) - c.totalExp);
+    this.shadow.mastery.set(id, { ...c.mastery });
+    this.shadow.cls.set(id, c.cls);
+    this.shadow.loot.set(`worker:${id}`, c.rng.loot);
+  }
+
+  private checkMasteryAndRecords(t: number, why: string): void {
+    const s = this.sim.state;
+    // Expected record per class: the highest mastery level of any owned character with mastery EXP in it, else 0.
+    const best: Record<ClassId, number> = { warrior: 0, archer: 0, mage: 0 };
+    for (const c of s.legion.chars) {
+      const m = this.shadow.mastery.get(c.id);
+      for (const k of CLASS_IDS) {
+        this.check(t, m !== undefined && m[k] === c.mastery[k], `I7 mastery of ${c.id}/${k} changed outside a credit (${why})`);
+        if (c.mastery[k] > 0) best[k] = Math.max(best[k], levelForExp(this.sim.content.table, c.mastery[k]));
+      }
+    }
+    for (const k of CLASS_IDS) this.check(t, s.legion.records[k] === best[k], `I7 record ${k} ${s.legion.records[k]} is not the maximum mastery level ${best[k]}`);
+  }
+
+  /** Runs the exclusivity and worker-eligibility checks (I8, I9) now; returns the violation total so far (tests). */
+  auditNow(t: number): number {
+    this.checkExclusive(t);
+    return this.violations;
+  }
+
+  private checkExclusive(t: number): void {
+    const s = this.sim.state;
+    const active = new Set(s.encounter ? s.encounter.participants.filter((id) => !(this.charOf(id) as CharacterState).knockedOut) : []);
+    for (const c of s.legion.chars) {
+      if (c.worker.fight !== null) {
+        this.check(t, c.assignment.kind === 'worker', `I8 ${c.id} fights as a worker while assigned ${c.assignment.kind}`);
+        this.check(t, !active.has(c.id), `I8 ${c.id} is in the squad and a worker fight at once`);
+      }
+      if (active.has(c.id)) this.check(t, c.assignment.kind === 'squad', `I8 ${c.id} fights in the squad while assigned ${c.assignment.kind}`);
+      if (c.assignment.kind === 'worker') this.check(t, workerZoneAllowed(s.zones, c.assignment.zoneOrder), `I9 ${c.id} is assigned to work in zone ${c.assignment.zoneOrder}, which the hero has not visited`);
+      if (c.worker.fight !== null) this.check(t, workerZoneAllowed(s.zones, c.worker.fight.zoneOrder), `I9 ${c.id} fights as a worker in zone ${c.worker.fight.zoneOrder}, which the hero has not visited`);
+    }
+  }
+
+  private onEntry(e: LogEntry): void {
+    const d = e.detail;
+    switch (e.kind) {
+      case 'EncounterStarted':
+        this.participants.set(String(d['encounterId']), d['participants'] ? String(d['participants']).split(',') : []);
+        this.checkExclusive(e.t);
+        break;
+      case 'MemberLeftSquad': {
+        const p = this.participants.get(String(d['encounterId']));
+        if (p) this.participants.set(String(d['encounterId']), p.filter((x) => x !== d['member']));
+        break;
+      }
+      case 'MemberKnockedOut':
+        this.ko.add(String(d['member']));
+        this.kos.set(String(d['member']), (this.kos.get(String(d['member'])) ?? 0) + 1);
+        break;
+      case 'MemberRecovered':
+        this.ko.delete(String(d['member']));
+        break;
+      case 'EnemyKilled': {
+        const id = String(d['encounterId']);
+        this.eligible.set(id, ['hero', ...(this.participants.get(id) ?? []).filter((m) => !this.ko.has(m))]);
+        this.participants.delete(id);
+        break;
+      }
+      case 'WorkerKill':
+        this.eligible.set(String(d['fight']), [String(d['member'])]);
+        break;
+      case 'WorkerFightStarted':
+      case 'Assigned':
+        this.checkExclusive(e.t);
+        if (e.kind === 'Assigned') this.checkMasteryAndRecords(e.t, 'assignment');
+        break;
+      case 'Swing': {
+        const m = d['member'] === undefined ? 'hero' : String(d['member']);
+        const dmg = d['damage'] as number;
+        this.damage.set(m, (this.damage.get(m) ?? 0) + dmg);
+        if (m === 'hero' && d['ability'] === true) this.heroAbilityDamage += dmg;
+        break;
+      }
+      case 'QuestCompleted':
+        this.firstRecruitMs = e.t;
+        this.shadow.questDone = true;
+        break;
+      case 'RecruitAcquired':
+      case 'RareHeroAcquired':
+        this.recruitMs.push(e.t);
+        this.addCharacter(String(d['member']));
+        break;
+      case 'WorkerStopped':
+        this.workerStops += 1;
+        break;
+      case 'LegionSpend':
+        this.goldSpent += d['amount'] as number;
+        break;
+      case 'ClassChanged':
+        this.classChanges += 1;
+        this.shadow.cls.set(String(d['member']), d['to'] as HeldClass);
+        this.checkMasteryAndRecords(e.t, 'class change');
+        break;
+      case 'TalentAllocated':
+      case 'TalentsReset':
+        this.checkMasteryAndRecords(e.t, e.kind);
+        break;
+      case 'KillCredited':
+        this.onCredit(e);
+        break;
+      default:
+        break;
+    }
+  }
+
+  private onCredit(e: LogEntry): void {
+    const d = e.detail;
+    const t = e.t;
+    const s = this.sim.state;
+    if (d['awards'] === undefined) {
+      this.violate(t, 'I1 a legion credit without awards');
+      return;
+    }
+    const encounterId = String(d['encounterId']);
+    const stream = String(d['stream']);
+    const boss = d['boss'] === true;
+    const zoneOrder = d['zoneOrder'] as number;
+    const enemy = boss ? this.sim.content.boss.enemy : (this.sim.content.zones[zoneOrder - 1] as (typeof this.sim.content.zones)[number]).enemy;
+    const enemyExp = enemy.exp;
+    // Each award is "<characterId>:<exp>:<levelAfter>"; character ids may contain ':' (rec:1), so parse from the right.
+    const awards = String(d['awards']).split(',').filter((x) => x !== '').map((a) => {
+      const parts = a.split(':');
+      parts.pop();
+      const exp = Number(parts.pop());
+      return { id: parts.join(':'), exp };
+    });
+    const worker = stream.startsWith('worker:') ? stream.slice(7) : null;
+    if (worker === null) this.squadKills += 1;
+    else this.workerKills += 1;
+    // I1
+    const expected = this.eligible.get(encounterId) ?? [];
+    this.eligible.delete(encounterId);
+    const got = awards.map((a) => a.id).sort();
+    this.check(t, JSON.stringify(got) === JSON.stringify([...expected].sort()), `I1 ${encounterId} awarded [${got.join(',')}], eligible [${[...expected].sort().join(',')}]`);
+    // I2
+    for (const a of awards) this.check(t, a.exp === enemyExp, `I2 ${a.id} got ${a.exp} EXP, enemy gives ${enemyExp}`);
+    // I3 + I7 (credit)
+    for (const a of awards) {
+      this.shadow.totalExp.set(a.id, (this.shadow.totalExp.get(a.id) ?? 0) + a.exp);
+      const cls = this.shadow.cls.get(a.id) ?? 'none';
+      if (cls !== 'none') {
+        const m = this.shadow.mastery.get(a.id) as Record<ClassId, number>;
+        m[cls] += a.exp;
+      }
+      this.legionExp += a.exp;
+      if (a.id === 'hero') this.heroExp += a.exp;
+    }
+    for (const c of s.legion.chars) this.check(t, this.shadow.totalExp.get(c.id) === c.totalExp, `I3 ${c.id} total EXP ${c.totalExp} differs from the shadow ${this.shadow.totalExp.get(c.id)}`);
+    if (this.sim.options.diagnostic?.freezeLevel !== true) {
+      const cap = this.sim.content.table.length + 1;
+      for (const c of s.legion.chars) {
+        const level = c.id === 'hero' ? s.hero.level : c.level;
+        if (level >= cap) continue;
+        this.check(t, this.cumulative(c) - c.totalExp === this.shadow.progressOffset.get(c.id), `I3 ${c.id} level progress differs from the EXP awarded`);
+      }
+    }
+    this.checkMasteryAndRecords(t, 'credit');
+    // I4
+    const key = worker === null ? 'account' : `worker:${worker}`;
+    const before = this.shadow.loot.get(key) as RngState;
+    const roll = rollKillReward(before, enemy);
+    this.shadow.loot.set(key, roll.loot);
+    const engineLoot = worker === null ? s.rng.loot : (this.charOf(worker) as CharacterState).rng.loot;
+    this.check(t, encodeDropItems(roll.drops) === d['dropItems'] && d['gold'] === enemy.gold, `I4 ${encounterId} rewards differ from one roll`);
+    this.check(t, JSON.stringify(roll.loot) === JSON.stringify(engineLoot), `I4 ${encounterId} loot stream ${key} is not exactly one roll ahead`);
+    // I5
+    if (!boss) this.shadow.zoneKills[zoneOrder - 1] = (this.shadow.zoneKills[zoneOrder - 1] ?? 0) + 1;
+    s.zones.forEach((z, i) => this.check(t, z.kills === this.shadow.zoneKills[i], `I5 zone ${i + 1} kills ${z.kills} differ from the shadow ${this.shadow.zoneKills[i]}`));
+    // Quest Q1 counts every credited zone-1 kill (squad or worker) until it is completed.
+    if (s.legion.enabled && !boss && zoneOrder === 1 && !this.shadow.questDone) this.shadow.quest += 1;
+    this.check(t, s.legion.quest.kills === this.shadow.quest, `I5 quest progress ${s.legion.quest.kills} differs from the shadow ${this.shadow.quest}`);
+    // I6
+    this.shadow.committed += 1;
+    this.check(t, s.legion.credits.committedCount === this.shadow.committed, `I6 committed credits ${s.legion.credits.committedCount} differ from accepted ${this.shadow.committed}`);
+    // I8
+    this.checkExclusive(t);
+  }
+
+  finish(horizonMs: number): LegionRunMetrics {
+    const base = this.base.finish(this.sim as unknown as Simulation, horizonMs);
+    const s = this.sim.state;
+    // Violations are reported, not thrown: the experiment records them and fails gate B1.
+    const characters: Record<string, CharacterMetrics> = {};
+    for (const c of s.legion.chars) {
+      characters[c.id] = {
+        level: c.id === 'hero' ? s.hero.level : c.level,
+        totalExp: c.totalExp,
+        cls: c.cls,
+        damage: this.damage.get(c.id) ?? 0,
+        knockouts: this.kos.get(c.id) ?? 0,
+        classChanges: c.classChanges,
+        assignment: c.assignment.kind === 'worker' ? `worker:${c.assignment.zoneOrder}` : c.assignment.kind,
+      };
+    }
+    const squadDamage = [...this.damage.values()].reduce((a, b) => a + b, 0);
+    const heroDamage = this.damage.get('hero') ?? 0;
+    const lt = s.legion.time;
+    const connectedMs = lt.automation + lt.manualCombat + lt.resting + lt.travelling + lt.waiting + lt.idle;
+    if (connectedMs + lt.offline !== s.time.accountedToMs) fail('INVALID_STATE', 'time categories do not add up to the elapsed time', { connectedMs, offline: lt.offline, elapsed: s.time.accountedToMs });
+    return {
+      base,
+      firstRecruitMs: this.firstRecruitMs,
+      recruitMs: [...this.recruitMs],
+      squadKills: this.squadKills,
+      workerKills: this.workerKills,
+      legionExp: this.legionExp,
+      heroExp: this.heroExp,
+      squadDamage,
+      heroDamage,
+      heroAbilityDamage: this.heroAbilityDamage,
+      heroDamageShare: squadDamage > 0 ? heroDamage / squadDamage : null,
+      memberKnockouts: [...this.kos.values()].reduce((a, b) => a + b, 0),
+      workerStops: this.workerStops,
+      goldSpent: this.goldSpent,
+      classChanges: this.classChanges,
+      characters,
+      records: { ...s.legion.records },
+      time: { ...lt, connectedMs, elapsedMs: connectedMs + lt.offline },
+      invariants: { checks: this.checks, violations: this.violations, first: [...this.first] },
+    };
+  }
+}
diff --git a/legion-progression-lab/src/experiments/legionSummary.ts b/legion-progression-lab/src/experiments/legionSummary.ts
new file mode 100644
index 0000000..17fe0bd
--- /dev/null
+++ b/legion-progression-lab/src/experiments/legionSummary.ts
@@ -0,0 +1,181 @@
+/**
+ * Semantic result of an S2 experiment (pure; no paths, times or machine details, so its fingerprint reproduces).
+ * Per-cell quantiles, pre-registered hypothesis outcomes, and kind-specific sections:
+ * - invariants: every run's monitor totals (gate B1), with the first violations if any;
+ * - estimatorComparison (matched cells): the displayed squad / worker estimate against the realised mean (B5);
+ * - searchComparison (search + campaign cells): ORC2-SEARCH per objective against each realistic policy (B4), labelled
+ *   "best feasible found with hindsight; a lower bound on the true gap, never an upper bound".
+ */
+import { createHash } from 'node:crypto';
+import type { S2Cell, S2Hypothesis, S2Manifest } from './legionManifest.ts';
+import type { S2JobResult } from './legionJobs.ts';
+import { summarise, type Summary } from './stats.ts';
+
+export interface S2CellMeta {
+  readonly index: number;
+  readonly id: string;
+  readonly kind: S2Cell['kind'];
+  readonly variant: string;
+  readonly tag: 'realistic' | 'oracle' | 'control' | 'diagnostic';
+  readonly policy: string | null;
+  readonly profile: string | null;
+}
+
+function evaluate(h: S2Hypothesis, observed: number | null): 'pass' | 'miss' | 'not-reached' | 'reported' {
+  if (h.role === 'reported') return 'reported';
+  if (observed === null) return 'not-reached';
+  const v = h.value ?? 0;
+  switch (h.op) {
+    case '<=':
+      return observed <= v ? 'pass' : 'miss';
+    case '>=':
+      return observed >= v ? 'pass' : 'miss';
+    case '<':
+      return observed < v ? 'pass' : 'miss';
+    case '>':
+      return observed > v ? 'pass' : 'miss';
+    case '==':
+      return observed === v ? 'pass' : 'miss';
+    case 'in': {
+      const [lo, hi] = h.range ?? [Number.NEGATIVE_INFINITY, Number.POSITIVE_INFINITY];
+      return observed >= lo && observed <= hi ? 'pass' : 'miss';
+    }
+  }
+}
+
+const OBJECTIVE_METRIC: Readonly<Record<string, string>> = { heroExp: 'expTotal', legionExp: 'legionExpTotal', gold: 'goldHeld', conquest: 'conquestScore' };
+
+export function summariseS2(manifest: S2Manifest, manifestSha256: string, variantHashes: Readonly<Record<string, unknown>>, cells: readonly S2CellMeta[], results: readonly S2JobResult[]) {
+  const byCell = new Map<number, S2JobResult[]>();
+  for (const r of results) byCell.set(r.cell, [...(byCell.get(r.cell) ?? []), r]);
+  const cellResults = cells.map((c) => {
+    const rs = (byCell.get(c.index) ?? []).slice().sort((a, b) => a.replicate - b.replicate);
+    const names = new Set<string>();
+    for (const r of rs) for (const k of Object.keys(r.values)) names.add(k);
+    const metrics: Record<string, Summary> = {};
+    for (const name of [...names].sort()) metrics[name] = summarise(rs.map((r) => (name in r.values ? (r.values[name] ?? null) : null)));
+    const h = createHash('sha256');
+    for (const r of rs) h.update(`${r.replicate}:${r.digest ?? 'none'}\n`);
+    return { ...c, runs: rs.length, runLogsDigest: h.digest('hex'), metrics };
+  });
+
+  const hypotheses = manifest.hypotheses.map((h) => ({
+    ...h,
+    results: cellResults
+      .filter((c) => (h.scope?.cells ? h.scope.cells.includes(c.id) : true) && h.metric in c.metrics)
+      .map((c) => {
+        const observed = (c.metrics[h.metric] as Summary)[h.stat];
+        return { cell: c.id, observed, outcome: evaluate(h, observed) };
+      }),
+  }));
+
+  const sections: Record<string, unknown> = {};
+  let checks = 0;
+  let violations = 0;
+  const first: string[] = [];
+  for (const r of results) {
+    checks += r.values['invariantChecks'] ?? 0;
+    violations += r.values['invariantViolations'] ?? 0;
+    const ex = r.extra as { violations?: string[] } | undefined;
+    if (ex?.violations && first.length < 20) first.push(...ex.violations.slice(0, 20 - first.length).map((v) => `cell ${r.cell} rep ${r.replicate}: ${v}`));
+  }
+  sections['invariants'] = { runs: results.length, checks, violations, first };
+
+  const matched = cellResults.filter((c) => c.kind === 'matched');
+  if (matched.length > 0) {
+    sections['estimatorComparison'] = matched.map((c) => {
+      const rs = byCell.get(c.index) ?? [];
+      const ex = (rs[0]?.extra ?? {}) as { predicted?: { killsPerHour: number; ttkS: number | null; reliability: string; reasons: readonly string[]; assumptions: readonly string[]; members: readonly string[]; heroIsThreatTarget: boolean; fightsPerKnockout: number | null }; workerPredicted?: { killsPerHour: number; reliability: string; reasons: readonly string[] } | null };
+      const sim = c.metrics['killsPerHour']?.mean ?? null;
+      const wsim = c.metrics['workerKillsPerHour']?.mean ?? null;
+      const p = ex.predicted;
+      const w = ex.workerPredicted ?? null;
+      return {
+        cell: c.id,
+        squad: p ? { members: p.members.length, predictedKillsPerHour: p.killsPerHour, predictedTtkS: p.ttkS, reliability: p.reliability, reasons: p.reasons, assumptions: p.assumptions, heroIsThreatTarget: p.heroIsThreatTarget, fightsPerKnockout: p.fightsPerKnockout } : null,
+        realisedMeanKillsPerHour: sim,
+        realisedMedianTtkS: c.metrics['medianTtkS']?.p50 ?? null,
+        errorPct: p && sim ? ((p.killsPerHour - sim) / sim) * 100 : null,
+        bothZero: p !== undefined && sim === 0 && p.killsPerHour === 0,
+        worker: w ? { predictedKillsPerHour: w.killsPerHour, reliability: w.reliability, reasons: w.reasons, realisedMeanKillsPerHour: wsim, errorPct: wsim ? ((w.killsPerHour - wsim) / wsim) * 100 : null } : null,
+      };
+    });
+  }
+
+  const searches = cellResults.filter((c) => c.kind === 'search');
+  if (searches.length > 0) {
+    const realistic = cellResults.filter((c) => c.kind === 'campaign');
+    sections['searchComparison'] = searches.flatMap((sc) => {
+      const objective = (manifest.cells[sc.index] as Extract<S2Cell, { kind: 'search' }>).objective;
+      const metric = OBJECTIVE_METRIC[objective] as string;
+      const sm = sc.metrics[metric]?.mean ?? null;
+      return realistic
+        .filter((r) => r.profile === sc.profile && r.variant === sc.variant)
+        .map((r) => {
+          const rm = r.metrics[metric]?.mean ?? null;
+          return { search: sc.id, objective, metric, realistic: r.id, searchMean: sm, realisticMean: rm, ratio: sm !== null && rm ? sm / rm : null, label: 'best feasible found with hindsight within the declared budget; the gap is a lower bound on the true gap, never an upper bound' };
+        });
+    });
+  }
+
+  return {
+    schema: 'legion.s2.experiment.v1',
+    labels: { values: 'model-output from candidate inputs', liveValidated: false, approved: false },
+    experimentId: manifest.experimentId,
+    manifestSha256,
+    contentRef: manifest.contentRef,
+    variantContent: variantHashes,
+    seeds: manifest.seeds,
+    cells: cellResults,
+    hypotheses,
+    sections,
+  };
+}
+
+export type S2SemanticResult = ReturnType<typeof summariseS2>;
+
+const fmt = (v: number | null | undefined, digits = 2): string => (v === null || v === undefined ? 'not reached' : Number.isInteger(v) ? String(v) : v.toFixed(digits));
+
+export function renderS2Report(manifest: S2Manifest, semantic: S2SemanticResult, fingerprint: string): string {
+  const out: string[] = [];
+  out.push(`# ${manifest.experimentId}`, '');
+  out.push('**Labels:** all values are `model-output` from `candidate` inputs (S2 legion model). Nothing here is approved or live-validated. Oracle (search) rows use hindsight and are the best feasible outcome found, never an upper bound.', '');
+  out.push(`**Question.** ${manifest.question}`, '', `**Design.** ${manifest.design}`, '');
+  out.push(`**Seeds:** root \`${manifest.seeds.root}\`, ${manifest.seeds.replicates} replicates per cell. **Semantic fingerprint:** \`${fingerprint}\` (manifest SHA-256 \`${semantic.manifestSha256}\`).`, '');
+  if (semantic.hypotheses.length > 0) {
+    out.push('## Pre-registered hypotheses', '', '| ID | Hypothesis | Role | Target | Cell | Observed | Outcome |', '|---|---|---|---|---|---|---|');
+    for (const h of semantic.hypotheses) {
+      const target = h.op === 'in' && h.range ? `${h.stat} in [${h.range[0]}, ${h.range[1]}] ${h.unit}` : `${h.stat} ${h.op} ${h.value ?? ''} ${h.unit}`;
+      if (h.results.length === 0) out.push(`| ${h.id} | ${h.statement} | ${h.role} | ${target} | — | — | no cell in scope |`);
+      for (const r of h.results) out.push(`| ${h.id} | ${h.statement} | ${h.role} | ${target} | ${r.cell} | ${fmt(r.observed, 3)} | ${r.outcome} |`);
+    }
+    out.push('');
+  }
+  out.push('## Cells (p10 / p50 / p90)', '');
+  const shown = manifest.metrics;
+  out.push(`| Cell | Tag | ${shown.join(' | ')} |`, `|---|---|${shown.map(() => '---').join('|')}|`);
+  for (const c of semantic.cells) out.push(`| ${c.id} | model-output (${c.tag}) | ${shown.map((m) => (c.metrics[m] ? `${fmt(c.metrics[m].p10)} / ${fmt(c.metrics[m].p50)} / ${fmt(c.metrics[m].p90)}` : '—')).join(' | ')} |`);
+  out.push('');
+  const inv = semantic.sections['invariants'] as { runs: number; checks: number; violations: number; first: string[] };
+  out.push('## Reward-invariant monitor (gate B1)', '', `${inv.runs} runs, ${inv.checks} checks, **${inv.violations} violations**.`, ...inv.first.map((f) => `- ${f}`), '');
+  const est = semantic.sections['estimatorComparison'] as Record<string, any>[] | undefined;
+  if (est) {
+    out.push('## Estimate (labelled) against realisation (model-output)', '', '| Cell | Squad size | Predicted kills/h | Reliability | Realised mean kills/h | Error | Worker predicted | Worker realised | Worker error |', '|---|---|---|---|---|---|---|---|---|');
+    for (const r of est) out.push(`| ${r['cell']} | ${r['squad']?.members ?? '—'} | ${fmt(r['squad']?.predictedKillsPerHour, 1)} | ${r['squad']?.reliability ?? '—'} | ${fmt(r['realisedMeanKillsPerHour'], 1)} | ${r['bothZero'] ? 'both 0' : `${fmt(r['errorPct'], 1)}%`} | ${fmt(r['worker']?.predictedKillsPerHour, 1)} | ${fmt(r['worker']?.realisedMeanKillsPerHour, 1)} | ${r['worker'] ? `${fmt(r['worker'].errorPct, 1)}%` : '—'} |`);
+    out.push('');
+  }
+  const sc = semantic.sections['searchComparison'] as Record<string, any>[] | undefined;
+  if (sc) {
+    out.push('## Hindsight search against realistic policies (B4)', '', '| Search | Objective | Metric | Realistic | Search mean (oracle, hindsight) | Realistic mean | Ratio |', '|---|---|---|---|---|---|---|');
+    for (const r of sc) out.push(`| ${r['search']} | ${r['objective']} | ${r['metric']} | ${r['realistic']} | ${fmt(r['searchMean'], 1)} | ${fmt(r['realisticMean'], 1)} | ${fmt(r['ratio'], 3)} |`);
+    out.push('', 'The ratio is a lower bound on what hindsight could gain over the realistic policy; it is not an upper bound.', '');
+  }
+  if (manifest.notes.length > 0) out.push('## Notes and limitations', '', ...manifest.notes.map((n) => `- ${n}`), '');
+  return `${out.join('\n')}\n`;
+}
+
+export function renderS2QuantilesCsv(semantic: S2SemanticResult): string {
+  const lines = ['cell,tag,metric,n,reached,p10,p50,p90,mean,min,max'];
+  for (const c of semantic.cells) for (const [m, s] of Object.entries(c.metrics)) lines.push([c.id, c.tag, m, s.n, s.reached, s.p10, s.p50, s.p90, s.mean, s.min, s.max].map((v) => (v === null ? '' : String(v))).join(','));
+  return `${lines.join('\n')}\n`;
+}
diff --git a/legion-progression-lab/src/model/legionContent.ts b/legion-progression-lab/src/model/legionContent.ts
