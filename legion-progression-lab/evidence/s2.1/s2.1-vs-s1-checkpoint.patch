+    }
+    if (down) {
+      this.setChar(id, (x) => ({ worker: { ...x.worker, fight: null } }));
+      const window = this.content.legion.workerKoWindowMs;
+      const koTimes = [...deathsInWindow((this.char(id) as CharacterState).worker.koTimes, t, window), t];
