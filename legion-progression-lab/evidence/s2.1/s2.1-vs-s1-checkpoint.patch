+      this.setZone(to, { visited: true });
+      this.log('ZoneVisited', { zoneOrder: to, zoneId: id });
+    }
+    if (!(this.state.zones[to - 1] as ZoneState).checkpointDiscovered) {
+      this.setZone(to, { checkpointDiscovered: true });
