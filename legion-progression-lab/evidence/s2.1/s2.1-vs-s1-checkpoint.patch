+    const seq = c.worker.seq + 1;
+    const fight: WorkerFight = { id: `w:${id}:${seq}`, zoneOrder, enemyHp: zone.enemy.hp, startMs: t };
+    this.setChar(id, { worker: { ...c.worker, fight, seq } });
