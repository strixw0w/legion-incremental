+
+  private onEngageArrived(): void {
+    const t = this.now().t;
+    const h = this.state.hero;
+    const slotIndex = h.targetSlot as number;
+    const slot = (this.state.zones[h.zoneOrder - 1] as ZoneState).slots[slotIndex] as SlotState;
