@@ -0,0 +1,29 @@
+/**
+ * L1 randomised differential test: random operation sequences, with branching, applied to the reference and the
+ * persistent ledger; every step must give the same result (or the same error code) and the same canonical content.
+ * The large run (50 seeds x 20,000 operations) is src/cli/ledger-differential.ts; this is the per-commit version.
+ */
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LEDGER_IMPLEMENTATIONS } from '../src/core/ledger/implementations.ts';
+import { generateOps, runDifferential } from '../src/core/ledger/differential.ts';
+
+describe('ledger differential: reference vs persistent', () => {
+  it('agree on every step of random sequences with replays, conflicts, failures and branch switches', () => {
+    fc.assert(
+      fc.property(fc.integer({ min: 0, max: 2 ** 31 - 1 }), fc.integer({ min: 1, max: 120 }), (seed, n) => {
+        const report = runDifferential(generateOps(seed, n), LEDGER_IMPLEMENTATIONS.reference, LEDGER_IMPLEMENTATIONS.persistent, { compareEvery: 1 });
+        expect(report.mismatches).toEqual([]);
+        expect(report.steps).toBe(n);
+      }),
+      { numRuns: 300 },
+    );
+  });
+
+  it('the generator exercises every operation kind and outcome', () => {
+    const report = runDifferential(generateOps(12345, 3000), LEDGER_IMPLEMENTATIONS.reference, LEDGER_IMPLEMENTATIONS.persistent, { compareEvery: 50 });
+    expect(report.mismatches).toEqual([]);
+    for (const k of ['credit', 'debit', 'multi', 'reserve', 'overflow', 'invalid', 'replay', 'conflict', 'branch']) expect(report.opCounts[k] ?? 0, k).toBeGreaterThan(0);
+    for (const o of ['ok', 'replayed', 'TX_CONFLICT', 'NEGATIVE_BALANCE', 'NUMERIC_LIMIT', 'INVALID_TX']) expect(report.outcomeCounts[o] ?? 0, o).toBeGreaterThan(0);
+  });
+});
diff --git a/legion-progression-lab/test/ledger.persistent.test.ts b/legion-progression-lab/test/ledger.persistent.test.ts
new file mode 100644
index 0000000..cd4cc51
--- /dev/null
+++ b/legion-progression-lab/test/ledger.persistent.test.ts
@@ -0,0 +1,204 @@
+/**
+ * L1 persistent ledger: tree invariants, key replacement, adversarial keys, insertion-history independence, validated
+ * reconstruction and mutation protection (planning/L1_LEDGER_SPECIFICATION.md §3 item 3).
+ */
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { applyTx, emptyLedger, balance, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import {
+  applyTxPersistent,
+  emptyPersistentLedger,
+  isPersistentLedger,
+  ledgerContent,
+  persistentLedgerInvariants,
+  reconstructPersistentLedger,
+  serializeLedger,
+} from '../src/core/ledger/persistentLedger.ts';
+import { checkInvariants, pentries, pget, pset, type PNode } from '../src/core/ledger/persistentMap.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+const grant = (txId: string, delta: number, resourceId = 'res.gold'): Tx => ({ txId, purpose: 'grant', lines: [{ resourceId, bucket: 'available', delta }] });
+const P = (txs: readonly Tx[], from: Ledger = emptyPersistentLedger()) => txs.reduce((l, tx) => applyTxPersistent(l, tx).ledger, from);
+
+/** FNV-1a 32-bit, the hash the benchmark-only HAMT prototype uses. */
+function fnv1a(s: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < s.length; i += 1) {
+    h ^= s.charCodeAt(i);
+    h = Math.imul(h, 0x01000193) >>> 0;
+  }
+  return h >>> 0;
+}
+
+/** Brute-force FNV-1a collisions among keys "<prefix><n>" (deterministic; a birthday search over about 2^17 keys). */
+function fnvCollisions(prefix: string, wanted: number): [string, string][] {
+  const seen = new Map<number, string>();
+  const out: [string, string][] = [];
+  for (let n = 0; out.length < wanted; n += 1) {
+    const k = `${prefix}${n.toString(36)}`;
+    const h = fnv1a(k);
+    const prior = seen.get(h);
+    if (prior !== undefined) out.push([prior, k]);
+    else seen.set(h, k);
+  }
+  return out;
+}
+
+describe('persistent ordered map (AVL, path copying)', () => {
+  it('keeps the AVL invariants and ascending order under random inserts and replacements', () => {
+    fc.assert(
+      fc.property(fc.array(fc.tuple(fc.string({ maxLength: 6 }), fc.integer()), { maxLength: 400 }), (ops) => {
+        let t: PNode<number> | null = null;
+        const model = new Map<string, number>();
+        for (const [k, v] of ops) {
+          t = pset(t, k, v);
+          model.set(k, v);
+        }
+        expect(checkInvariants(t)).toBeNull();
+        expect([...pentries(t)]).toEqual([...model.entries()].sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0)));
+      }),
+      { numRuns: 200 },
+    );
+  });
+
+  it('never changes an old root: every earlier version still describes its own map', () => {
+    const versions: (PNode<number> | null)[] = [null];
+    for (let i = 0; i < 500; i += 1) versions.push(pset(versions[versions.length - 1] ?? null, `k${(i * 7919) % 211}`, i));
+    const replay = new Map<string, number>();
+    versions.forEach((t, i) => {
+      if (i > 0) replay.set(`k${((i - 1) * 7919) % 211}`, i - 1);
+      expect(new Map(pentries(t))).toEqual(replay);
+    });
+  });
+});
+
+describe('persistent ledger: specific properties', () => {
+  it('key replacement: a new balance in the new snapshot, the old one untouched', () => {
+    const s1 = P([grant('tx.a', 5)]);
+    const s2 = P([grant('tx.b', 3)], s1);
+    expect([balance(s1, 'res.gold'), balance(s2, 'res.gold')]).toEqual([5, 8]);
+    expect(persistentLedgerInvariants(s2)).toBeNull();
+  });
+
+  it('adversarial keys: FNV-1a 32-bit collisions, long shared prefixes, Unicode and NUL are all distinct keys', () => {
+    const pairs = fnvCollisions('tx.', 6);
+    for (const [a, b] of pairs) expect(fnv1a(a)).toBe(fnv1a(b));
+    const resPairs = fnvCollisions('res.k', 3);
+    const odd = ['tx.\u0000', 'tx.\u0000\u0000', 'tx.é', 'tx.é', 'tx.😀', `tx.${'a'.repeat(250)}`, `tx.${'a'.repeat(249)}b`];
+    let l = emptyPersistentLedger();
+    let r = emptyLedger();
+    const txs: Tx[] = [];
+    pairs.forEach(([a, b], i) => txs.push(grant(a, i + 1), grant(b, 100 + i)));
+    resPairs.forEach(([a, b], i) => txs.push(grant(`tx.res.${i}`, 7, a), grant(`tx.res2.${i}`, 9, b)));
+    odd.forEach((k, i) => txs.push(grant(k, 1000 + i)));
+    for (const tx of txs) {
+      l = applyTxPersistent(l, tx).ledger;
+      r = applyTx(r, tx).ledger;
+    }
+    expect(l.committed.size).toBe(txs.length);
+    for (const [a, b] of resPairs) expect([balance(l, a), balance(l, b)]).toEqual([7, 9]);
+    pairs.forEach(([a, b], i) => {
+      expect(applyTxPersistent(l, grant(a, i + 1)).result.replayed).toBe(true);
+      expect(code(() => applyTxPersistent(l, grant(b, i + 1)))).toBe('TX_CONFLICT'); // b was committed with 100 + i
+    });
+    expect(serializeLedger(l)).toBe(serializeLedger(r));
+    expect(persistentLedgerInvariants(l)).toBeNull();
+  });
+
+  it('serialization is independent of insertion history (commutative transactions in any order)', () => {
+    const txs = Array.from({ length: 60 }, (_, i) => grant(`tx.${(i * 37) % 60}`, (i % 5) + 1, `res.r${i % 7}`));
+    const forward = P(txs);
+    const backward = P([...txs].reverse());
+    const shuffled = P([...txs].sort((a, b) => (fnv1a(a.txId) < fnv1a(b.txId) ? -1 : 1)));
+    expect(serializeLedger(backward)).toBe(serializeLedger(forward));
+    expect(serializeLedger(shuffled)).toBe(serializeLedger(forward));
+  });
+
+  it('validated reconstruction: round trip, then replays and conflicts behave exactly as before saving', () => {
+    const l = P([grant('tx.a', 5), grant('tx.b', 3, 'res.iron'), { txId: 'tx.c', purpose: 'reserve', lines: [{ resourceId: 'res.iron', bucket: 'available', delta: -1 }, { resourceId: 'res.iron', bucket: 'reserved', delta: 1 }] }, { txId: 'tx.zero', purpose: 'noop', lines: [{ resourceId: 'res.gold', bucket: 'available', delta: 2 }, { resourceId: 'res.gold', bucket: 'available', delta: -2 }] }]);
+    const text = serializeLedger(l);
+    const back = reconstructPersistentLedger(text);
+    expect(isPersistentLedger(back)).toBe(true);
+    expect(serializeLedger(back)).toBe(text);
+    expect(reconstructPersistentLedger(ledgerContent(l)) && serializeLedger(reconstructPersistentLedger(ledgerContent(l)))).toBe(text);
+    expect(applyTxPersistent(back, grant('tx.a', 5)).result.replayed).toBe(true);
+    expect(code(() => applyTxPersistent(back, grant('tx.a', 6)))).toBe('TX_CONFLICT');
+    expect(balance(applyTxPersistent(back, grant('tx.d', 1)).ledger, 'res.gold')).toBe(6);
+    expect(persistentLedgerInvariants(back)).toBeNull();
+    // A reference ledger's content reconstructs to the same persistent ledger.
+    const ref = [grant('tx.a', 5), grant('tx.b', 3, 'res.iron')].reduce((x, tx) => applyTx(x, tx).ledger, emptyLedger());
+    expect(serializeLedger(reconstructPersistentLedger(serializeLedger(ref)))).toBe(serializeLedger(ref));
+  });
+
+  it('validated reconstruction refuses every corruption (INVALID_STATE, no ledger)', () => {
+    const good = JSON.parse(serializeLedger(P([grant('tx.a', 5), grant('tx.b', 3, 'res.iron')])));
+    const variants: [string, (d: any) => unknown][] = [
+      ['not JSON', () => '{nope'],
+      ['wrong schema', (d) => ({ ...d, schema: 'legion.ledger.v0' })],
+      ['extra field', (d) => ({ ...d, extra: 1 })],
+      ['unsorted balances', (d) => ({ ...d, balances: [...d.balances].reverse() })],
+      ['duplicate txId', (d) => ({ ...d, committed: [d.committed[0], d.committed[0], d.committed[1]] })],
+      ['negative balance', (d) => ({ ...d, balances: d.balances.map(([id, b]: any) => [id, { ...b, available: -1 }]) })],
+      ['fractional balance', (d) => ({ ...d, balances: d.balances.map(([id, b]: any) => [id, { ...b, available: b.available + 0.5 }]) })],
+      ['conservation broken', (d) => ({ ...d, balances: d.balances.map(([id, b]: any) => [id, { ...b, available: b.available + 1 }]) })],
+      ['missing resource for a net', (d) => ({ ...d, balances: d.balances.slice(1) })],
+      ['bad payload hash', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, { ...r, payloadHash: 'X'.repeat(64) }]) })],
+      ['zero delta', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, { ...r, nets: r.nets.map((n: any) => [n[0], n[1], 0]) }]) })],
+      ['bad bucket', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, { ...r, nets: r.nets.map((n: any) => [n[0], 'stash', n[2]]) }]) })],
+      ['bad resource id', (d) => ({ ...d, balances: [['gold', { available: 0, reserved: 0 }], ...d.balances] })],
+      ['empty txId', (d) => ({ ...d, committed: [['', d.committed[0][1]], ...d.committed.slice(1)] })],
+      ['record field missing', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, { nets: r.nets }]) })],
+    ];
+    for (const [name, corrupt] of variants) expect(code(() => reconstructPersistentLedger(corrupt(structuredClone(good)))), name).toBe('INVALID_STATE');
+    // Refused for the right reason: key order and uniqueness are checked on the input itself, not only by the tree.
+    const why = (d: unknown): string => {
+      try {
+        reconstructPersistentLedger(d);
+      } catch (e) {
+        if (e instanceof LabError) return e.message;
+        throw e;
+      }
+      return 'accepted';
+    };
+    const g = structuredClone(good);
+    expect(why({ ...g, balances: [...g.balances].reverse() })).toMatch(/strictly ascending resourceId order/);
+    expect(why({ ...g, committed: [g.committed[0], g.committed[0], g.committed[1]] })).toMatch(/strictly ascending txId order/);
+  });
+
+  it('mutation protection: the tree is unreachable from the public ledger; views expose nothing writable', () => {
+    const l = P([grant('tx.a', 5)]);
+    expect(Object.getOwnPropertyNames(l.balances)).toEqual([]);
+    expect(Object.getOwnPropertySymbols(l.balances)).toEqual([]);
+    expect(JSON.stringify(l.balances)).toBe('{}');
+    expect(() => {
+      (l as { balances: unknown }).balances = new Map();
+    }).toThrow(TypeError);
+    expect(pget(null, 'x')).toBeUndefined();
+  });
+
+  it('a randomly built persistent ledger keeps its tree invariants (balances and committed)', () => {
+    fc.assert(
+      fc.property(fc.array(fc.tuple(fc.integer({ min: 0, max: 40 }), fc.integer({ min: 1, max: 9 }), fc.integer({ min: 0, max: 5 })), { maxLength: 150 }), (ops) => {
+        let l = emptyPersistentLedger();
+        ops.forEach(([t, d, r]) => {
+          try {
+            l = applyTxPersistent(l, grant(`tx.${t}`, d, `res.r${r}`)).ledger;
+          } catch (e) {
+            if (!(e instanceof LabError)) throw e;
+          }
+        });
+        expect(persistentLedgerInvariants(l)).toBeNull();
+      }),
+      { numRuns: 150 },
+    );
+  });
+});
diff --git a/legion-progression-lab/test/ledger.reconstruction.test.ts b/legion-progression-lab/test/ledger.reconstruction.test.ts
new file mode 100644
index 0000000..928f213
--- /dev/null
+++ b/legion-progression-lab/test/ledger.reconstruction.test.ts
@@ -0,0 +1,114 @@
+/**
+ * S2.1 (owner L1/S2 review §3): validated reconstruction accepts every valid serialisable history, including large
+ * cumulative turnover summed in canonical (txId) order, and still refuses every corruption.
+ */
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { LEDGER_IMPLEMENTATIONS } from '../src/core/ledger/implementations.ts';
+import { generateOps, runDifferential } from '../src/core/ledger/differential.ts';
+import { balance, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import { applyTxPersistent, emptyPersistentLedger, persistentLedgerInvariants, reconstructPersistentLedger, serializeLedger } from '../src/core/ledger/persistentLedger.ts';
+
+const M = Number.MAX_SAFE_INTEGER;
+const tx = (txId: string, delta: number, resourceId = 'res.gold', bucket: 'available' | 'reserved' = 'available'): Tx => ({ txId, purpose: 'review', lines: [{ resourceId, bucket, delta }] });
+const apply = (txs: readonly Tx[], from: Ledger = emptyPersistentLedger()): Ledger => txs.reduce((l, t) => applyTxPersistent(l, t).ledger, from);
+const roundTrip = (l: Ledger): Ledger => reconstructPersistentLedger(serializeLedger(l));
+function error(fn: () => unknown): { code: string; message: string } | null {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return { code: e.code, message: e.message };
+    throw e;
+  }
+  return null;
+}
+
+describe('validated reconstruction at numerical boundaries (S2.1)', () => {
+  it('the reviewer reproduction: credit M, debit M, credit M (txIds a, z, b) reconstructs to balance M', () => {
+    const l = apply([tx('a', M), tx('z', -M), tx('b', M)]);
+    const back = roundTrip(l);
+    expect(balance(back, 'res.gold')).toBe(M);
+    expect(serializeLedger(back)).toBe(serializeLedger(l));
+    expect(persistentLedgerInvariants(back)).toBeNull();
+  });
+
+  it('every lexicographic order of the transaction IDs is accepted (the canonical summing order never matters)', () => {
+    const ids = ['a', 'm', 'z'];
+    const perms = [[0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]];
+    for (const p of perms) {
+      // chronological order is always +M, -M, +M; only the IDs (hence the canonical order) change
+      const l = apply([tx(ids[p[0] as number] as string, M), tx(ids[p[1] as number] as string, -M), tx(ids[p[2] as number] as string, M)]);
+      expect(serializeLedger(roundTrip(l))).toBe(serializeLedger(l));
+    }
+  });
+
+  it('large positive and negative cumulative turnover, independent resources and reserved buckets', () => {
+    const txs: Tx[] = [];
+    for (let i = 0; i < 50; i += 1) {
+      txs.push(tx(`t${String(99 - i).padStart(3, '0')}.in`, M - i, 'res.gold'), tx(`t${String(i).padStart(3, '0')}.out`, -(M - i), 'res.gold'));
+      txs.push(tx(`r${i}.in`, M, 'res.iron', 'reserved'), tx(`r${i}.out`, -M, 'res.iron', 'reserved'));
+    }
+    txs.push(tx('final.gold', 7), tx('final.iron', M, 'res.iron', 'reserved'), { txId: 'multi', purpose: 'review', lines: [{ resourceId: 'res.wood', bucket: 'available', delta: M }, { resourceId: 'res.wood', bucket: 'reserved', delta: M - 1 }] });
+    const l = apply(txs);
+    const back = roundTrip(l);
+    expect(serializeLedger(back)).toBe(serializeLedger(l));
+    expect(balance(back, 'res.gold')).toBe(7);
+    expect(balance(back, 'res.iron', 'reserved')).toBe(M);
+    expect(balance(back, 'res.wood', 'reserved')).toBe(M - 1);
+  });
+
+  it('after reconstruction, an exact replay returns the original receipt and a different payload is TX_CONFLICT', () => {
+    const l = roundTrip(apply([tx('a', M), tx('z', -M), tx('b', M)]));
+    const again = applyTxPersistent(l, tx('z', -M));
+    expect(again.result.replayed).toBe(true);
+    expect(again.result.nets).toEqual([{ resourceId: 'res.gold', bucket: 'available', delta: -M }]);
+    expect(again.ledger).toBe(l);
+    expect(error(() => applyTxPersistent(l, tx('z', -1)))?.code).toBe('TX_CONFLICT');
+    expect(error(() => applyTxPersistent(l, tx('new', 1)))?.code).toBe('NUMERIC_LIMIT'); // the balance itself stays bounded
+  });
+
+  it('branched histories each reconstruct to their own content', () => {
+    const base = apply([tx('a', M), tx('b', -M)]);
+    const left = apply([tx('c', M), tx('d', -5)], base);
+    const right = apply([tx('c', 3), tx('e', M - 3)], base);
+    expect(serializeLedger(roundTrip(left))).toBe(serializeLedger(left));
+    expect(serializeLedger(roundTrip(right))).toBe(serializeLedger(right));
+    expect(serializeLedger(roundTrip(base))).toBe(serializeLedger(base));
+    expect(balance(roundTrip(left), 'res.gold')).toBe(M - 5);
+    expect(balance(roundTrip(right), 'res.gold')).toBe(M);
+  });
+
+  it('corrupted balances and receipts are still refused, as invalid input (INVALID_STATE), never as NUMERIC_LIMIT', () => {
+    const good = JSON.parse(serializeLedger(apply([tx('a', M), tx('z', -M), tx('b', M)])));
+    const cases: [string, (d: any) => unknown, RegExp][] = [
+      ['balance off by one', (d) => ({ ...d, balances: [[d.balances[0][0], { ...d.balances[0][1], available: M - 1 }]] }), /does not equal the sum/],
+      ['balance above the safe range', (d) => ({ ...d, balances: [[d.balances[0][0], { ...d.balances[0][1], available: M + 1 }]] }), /non-negative safe integers/],
+      ['receipt changed', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, id === 'z' ? { ...r, nets: [[r.nets[0][0], r.nets[0][1], -M + 1]] } : r]) }), /does not equal the sum/],
+      ['receipt delta beyond the safe range', (d) => ({ ...d, committed: d.committed.map(([id, r]: any) => [id, id === 'b' ? { ...r, nets: [[r.nets[0][0], r.nets[0][1], M + 2]] } : r]) }), /non-zero safe integer/],
+      ['a receipt removed', (d) => ({ ...d, committed: d.committed.filter(([id]: any) => id !== 'z') }), /does not equal the sum/],
+      ['turnover on a resource missing from balances', (d) => ({ ...d, committed: [...d.committed, ['zz', { payloadHash: 'a'.repeat(64), nets: [['res.iron', 'available', M]] }]] }), /missing from balances/],
+    ];
+    for (const [name, corrupt, why] of cases) {
+      const e = error(() => reconstructPersistentLedger(corrupt(structuredClone(good))));
+      expect(e?.code, name).toBe('INVALID_STATE');
+      expect(e?.message, name).toMatch(why);
+    }
+  });
+
+  it('a self-consistent but forged history is accepted: reconstruction checks structure and conservation, not authenticity', () => {
+    const forged = { schema: 'legion.ledger.v1', balances: [['res.gold', { available: 5, reserved: 0 }]], committed: [['gift', { payloadHash: 'f'.repeat(64), nets: [['res.gold', 'available', 5]] }]] };
+    expect(balance(reconstructPersistentLedger(forged), 'res.gold')).toBe(5);
+  });
+
+  it('randomised: every valid history with near-limit turnover survives serialization and reconstruction, in both implementations', () => {
+    fc.assert(
+      fc.property(fc.integer({ min: 1, max: 1_000_000 }), (seed) => {
+        const r = runDifferential(generateOps(seed, 400, { extremes: true }), LEDGER_IMPLEMENTATIONS.reference, LEDGER_IMPLEMENTATIONS.persistent, { compareEvery: 20, reconstruct: true });
+        expect(r.mismatches).toEqual([]);
+        expect(r.reconstructions).toBeGreaterThan(0);
+      }),
+      { numRuns: 60 },
+    );
+  });
+});
diff --git a/legion-progression-lab/test/s2.invariants.test.ts b/legion-progression-lab/test/s2.invariants.test.ts
new file mode 100644
index 0000000..59f71bf
--- /dev/null
+++ b/legion-progression-lab/test/s2.invariants.test.ts
@@ -0,0 +1,91 @@
+/**
+ * S2 reward invariants under realistic and adversarial play (owner §7; pre-registration B1, H-S2-02, H-S2-06).
+ * The invariant monitor (src/experiments/legionMetrics.ts) checks every credited kill and every loadout change with
+ * independent shadow bookkeeping; these tests run it across every S2 policy, harsher content, and a policy that
+ * switches assignments at every decision (attack, death, credit, level-up and session boundaries).
+ */
+import { describe, expect, it } from 'vitest';
+import type { LegionCommand } from '../src/model/legionTypes.ts';
+import { LEGION_REALISTIC_POLICIES, pol2 } from '../src/policy/legionRealistic.ts';
+import { awards, lpolicy, lrun, of, s2Content, setv } from './helpers/s2.ts';
+
+/** Enemies hit `scale` times harder (knockouts, hero deaths and worker stops happen). */
+const harsh = (scale: number) =>
+  s2Content((b) => {
+    for (const e of b.enemies) setv(e, 'attackMilli', Math.round((typeof e.attackMilli === 'object' ? e.attackMilli.value : e.attackMilli) * scale));
+  });
+
+describe('the reward-invariant monitor finds no violation (B1)', () => {
+  const content = s2Content();
+  for (const name of Object.keys(LEGION_REALISTIC_POLICIES)) {
+    it(`${name}: 2 seeds x 45 min`, () => {
+      for (const seed of ['inv#rep-0', 'inv#rep-1']) {
+        const r = lrun(content, { policy: (LEGION_REALISTIC_POLICIES[name] as () => never)(), untilMs: 2_700_000, seedRoot: seed });
+        expect(r.first).toEqual([]);
+        expect(r.violations).toBe(0);
+        expect(of(r.log, 'KillCredited').length).toBeGreaterThan(100);
+      }
+    });
+  }
+
+  it('harsher enemies (x3 damage): knockouts, hero deaths and worker stops happen, and still no violation', () => {
+    const content3 = harsh(3);
+    let kos = 0;
+    let stops = 0;
+    for (const name of ['POL2-SQUAD-W', 'POL2-WORKERS', 'POL2-MIXED']) {
+      const r = lrun(content3, { policy: (LEGION_REALISTIC_POLICIES[name] as () => never)(), untilMs: 2_700_000 });
+      expect(r.first).toEqual([]);
+      kos += of(r.log, 'MemberKnockedOut').length;
+      stops += of(r.log, 'WorkerStopped').length;
+    }
+    expect(kos).toBeGreaterThan(0);
+    expect(stops).toBeGreaterThanOrEqual(0);
+  });
+
+  it('switching every recruit between squad and workers at EVERY decision (all boundaries) credits each kill once', () => {
+    let flip = false;
+    const base = pol2('P', { mode: 'squad', extras: 'workers' });
+    const policy = lpolicy('TEST2-FLIP', (obs) => {
+      const out: LegionCommand[] = [...base.decide(obs, null)].filter((c) => c.type !== 'Assign');
+      if (obs.legion.enabled) {
+        flip = !flip;
+        for (const c of obs.legion.roster) {
+          if (c.id === 'hero' || c.assignment.kind === 'reserve') continue;
+          if (flip && c.assignment.kind !== 'squad') out.push({ type: 'Assign', characterId: c.id, to: 'squad' });
+          if (!flip && c.assignment.kind !== 'worker') out.push({ type: 'Assign', characterId: c.id, to: 'worker', zoneId: obs.hero.zoneId });
+        }
+      }
+      return out;
+    });
+    for (const content2 of [s2Content(), harsh(3)]) {
+      const r = lrun(content2, { policy, untilMs: 1_800_000, sessions: [{ startMs: 0, endMs: 900_000 }, { startMs: 1_000_000, endMs: 1_800_000 }] });
+      expect(r.first).toEqual([]);
+      const credited = of(r.log, 'KillCredited');
+      expect(r.sim.state.legion.credits.committedCount).toBe(credited.length);
+      expect(new Set(credited.map((e) => e.detail['txId'])).size).toBe(credited.length);
+      expect(r.sim.counters.duplicateCredits).toBe(0);
+      expect(of(r.log, 'Assigned').length).toBeGreaterThan(50);
+      expect(of(r.log, 'WorkerFightCancelled').length).toBeGreaterThan(0);
+    }
+  });
+});
+
+describe('H-S2-02 and H-S2-06 across squad sizes 0-3 (matched state, level 10, zone 2, frozen levels)', () => {
+  const content = s2Content();
+  for (const k of [0, 1, 2, 3]) {
+    it(`squad of ${k}: account gold per credited kill equals the enemy's, every eligible member gets full EXP`, () => {
+      const recruits = (['warrior', 'archer', 'mage'] as const).slice(0, k).map((cls) => ({ level: 10, cls, assignment: 'squad' as const }));
+      const r = lrun(content, { policy: pol2('P', { buyRecruits: false, maxDeploy: k, heroClass: 'archer', fixedZone: 2 }), untilMs: 600_000, diagnostic: { startLevel: 10, freezeLevel: true, startZoneOrder: 2, unlockAllZones: true, heroClass: 'archer', recruits, startSlots: k, startDeployCap: 3 } });
+      const credited = of(r.log, 'KillCredited');
+      expect(credited.length).toBeGreaterThan(20);
+      for (const e of credited) {
+        const enemy = content.zones[(e.detail['zoneOrder'] as number) - 1]?.enemy;
+        expect(e.detail['zoneOrder']).toBe(2);
+        expect(e.detail['gold']).toBe(enemy?.gold);
+        expect(awards(e).map((a) => a.id)).toEqual(['hero', ...recruits.map((_, i) => `rec:${i + 1}`)].filter((id) => awards(e).some((a) => a.id === id)));
+        for (const a of awards(e)) expect(a.exp).toBe(enemy?.exp);
+      }
+      expect(r.first).toEqual([]);
+    });
+  }
+});
