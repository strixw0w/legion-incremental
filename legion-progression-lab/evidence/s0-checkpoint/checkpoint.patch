++  const expBits = (bits >> 52n) & 0x7ffn;
++  const frac = bits & 0xfffffffffffffn;
++  const mantissa = expBits === 0n ? frac : frac | (1n << 52n);
++  const exp = (expBits === 0n ? 1n : expBits) - 1075n;
++  if (exp >= 0n) return { num: sign * (mantissa << exp), shift: 0n };
