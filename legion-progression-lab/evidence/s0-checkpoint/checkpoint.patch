+{
+  "fixtureSet": "numeric",
+  "fixtureVersion": 2,
+  "specRef": "spec/formulas/numeric.md#v1",
+  "status": "candidate",
+  "independence": "Expected values derived by hand from spec/formulas/numeric.md; every case is re-checked with unbounded Python integers and exact Fractions by spec/oracle/exact_oracle.py. S0.1 adds mulDivRem cases, derived by hand and re-checked with unbounded Python integers.",
+  "cases": [
+    {
+      "id": "numeric.add.001",
+      "kind": "normal",
+      "description": "Small addition",
+      "input": {
+        "op": "add",
+        "a": 2,
+        "b": 3
+      },
+      "expected": {
+        "result": 5
+      },
+      "derivation": "2 + 3 = 5"
+    },
+    {
+      "id": "numeric.add.limit.001",
+      "kind": "boundary",
+      "description": "Addition reaching exactly 2^53 - 1",
+      "input": {
+        "op": "add",
+        "a": 9007199254740990,
+        "b": 1
+      },
+      "expected": {
+        "result": 9007199254740991
+      },
+      "derivation": "(2^53 - 2) + 1 = 2^53 - 1, the largest safe integer"
+    },
+    {
+      "id": "numeric.add.overflow.001",
