+        "a",
+        "p",
+        "g"
+      ],
+      "additionalProperties": false
+    },
+    "rounding": {
+      "type": "string",
+      "const": "roundHalfUp"
+    },
+    "indexing": {
+      "type": "string",
+      "const": "thresholds[i] = EXP from level i+1 to level i+2"
