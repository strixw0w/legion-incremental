@@ -0,0 +1,64 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { applyTx, BUCKETS, emptyLedger, type Bucket, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import { safeIntArb } from './helpers/reference.ts';
+
+const RESOURCES = ['res.gold', 'res.mat.slime_gel', 'res.mat.copper_ore'];
+const lineArb = fc.record({
+  resourceId: fc.constantFrom(...RESOURCES),
+  bucket: fc.constantFrom<Bucket>(...BUCKETS),
+  delta: fc.oneof(safeIntArb(-50, 50), safeIntArb(-1_000_000, 1_000_000)).filter((d) => d !== 0),
+});
+const txArb = fc.array(fc.array(lineArb, { minLength: 1, maxLength: 5 }), { minLength: 1, maxLength: 60 });
+
+function run(ledger: Ledger, txs: Tx[]): { ledger: Ledger; committed: Tx[]; nets: Map<string, number> } {
+  let current = ledger;
+  const committed: Tx[] = [];
+  const nets = new Map<string, number>();
+  for (const tx of txs) {
+    try {
+      const out = applyTx(current, tx);
+      if (!out.result.replayed) {
+        committed.push(tx);
+        for (const n of out.result.nets) nets.set(`${n.resourceId}|${n.bucket}`, (nets.get(`${n.resourceId}|${n.bucket}`) ?? 0) + n.delta);
+      }
+      current = out.ledger;
+    } catch (e) {
+      if (!(e instanceof LabError)) throw e;
+    }
+  }
+  return { ledger: current, committed, nets };
+}
+
+describe('ledger properties over random transaction sequences', () => {
+  it('balances are never negative and always equal the sum of committed nets (conservation)', () => {
+    fc.assert(
+      fc.property(txArb, (lineSets) => {
+        const txs: Tx[] = lineSets.map((lines, i) => ({ txId: `tx.${i}`, purpose: 'random', lines }));
+        const { ledger, nets } = run(emptyLedger(), txs);
+        for (const r of RESOURCES) {
+          for (const b of BUCKETS) {
+            const bal = ledger.balances.get(r)?.[b] ?? 0;
+            expect(bal).toBeGreaterThanOrEqual(0);
+            expect(bal).toBe(nets.get(`${r}|${b}`) ?? 0);
+          }
+        }
+      }),
+      { seed: 20261113, numRuns: 500 },
+    );
+  });
+
+  it('replaying every transaction again changes nothing (no repeated claims)', () => {
+    fc.assert(
+      fc.property(txArb, (lineSets) => {
+        const txs: Tx[] = lineSets.map((lines, i) => ({ txId: `tx.${i}`, purpose: 'random', lines }));
+        const first = run(emptyLedger(), txs);
+        const again = run(first.ledger, first.committed);
+        expect(again.committed.length).toBe(0);
+        expect([...again.ledger.balances.entries()]).toEqual([...first.ledger.balances.entries()]);
+      }),
+      { seed: 20261113, numRuns: 300 },
+    );
+  });
+});
diff --git a/legion-progression-lab/test/ledger.test.ts b/legion-progression-lab/test/ledger.test.ts
new file mode 100644
index 0000000..59b9f56
--- /dev/null
+++ b/legion-progression-lab/test/ledger.test.ts
@@ -0,0 +1,252 @@
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { applyTx, balance, emptyLedger, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import { MAX_SAFE } from '../src/core/numeric/safeInt.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+const grant = (txId: string, delta: number, resourceId = 'res.gold'): Tx => ({ txId, purpose: 'grant', lines: [{ resourceId, bucket: 'available', delta }] });
+
+describe('ledger', () => {
+  it('aggregates lines per bucket before validating', () => {
+    const { ledger, result } = applyTx(emptyLedger(), {
+      txId: 'tx.1',
+      purpose: 'deposit',
+      lines: [
+        { resourceId: 'res.gold', bucket: 'available', delta: -3 },
+        { resourceId: 'res.gold', bucket: 'available', delta: 5 },
+      ],
+    });
+    expect(balance(ledger, 'res.gold')).toBe(2);
+    expect(result.nets).toEqual([{ resourceId: 'res.gold', bucket: 'available', delta: 2 }]);
+  });
+
+  it('is atomic: a failing line changes nothing, and the input ledger is never mutated', () => {
+    const start = applyTx(emptyLedger(), grant('tx.a', 5)).ledger;
+    const snapshot = JSON.stringify([...start.balances.entries()]);
+    expect(
+      code(() =>
+        applyTx(start, {
+          txId: 'tx.b',
+          purpose: 'craft',
+          lines: [
+            { resourceId: 'res.gold', bucket: 'available', delta: -10 },
+            { resourceId: 'res.mat.slime_gel', bucket: 'available', delta: 1 },
+          ],
+        }),
+      ),
+    ).toBe('NEGATIVE_BALANCE');
+    expect(JSON.stringify([...start.balances.entries()])).toBe(snapshot);
+    expect(balance(start, 'res.mat.slime_gel')).toBe(0);
+    expect(start.committed.has('tx.b')).toBe(false);
+  });
+
+  it('replays an identical transaction without applying it twice', () => {
+    const first = applyTx(emptyLedger(), grant('tx.c', 10));
+    const second = applyTx(first.ledger, grant('tx.c', 10));
+    expect(second.ledger).toBe(first.ledger);
+    expect(second.result.replayed).toBe(true);
+    expect(balance(second.ledger, 'res.gold')).toBe(10);
+  });
+
+  it('identical payloads replay regardless of object key order (canonical hashing)', () => {
+    const first = applyTx(emptyLedger(), { txId: 'tx.k', purpose: 'grant', lines: [{ resourceId: 'res.gold', bucket: 'available', delta: 3 }] });
+    const reordered = { lines: [{ delta: 3, bucket: 'available', resourceId: 'res.gold' }], purpose: 'grant', txId: 'tx.k' } as unknown as Tx;
+    expect(applyTx(first.ledger, reordered).result.replayed).toBe(true);
+  });
+
+  it('refuses the same txId with a different payload', () => {
+    const first = applyTx(emptyLedger(), grant('tx.d', 10)).ledger;
+    expect(code(() => applyTx(first, grant('tx.d', 11)))).toBe('TX_CONFLICT');
+    expect(code(() => applyTx(first, { ...grant('tx.d', 10), purpose: 'other' }))).toBe('TX_CONFLICT');
+  });
+
+  it('a failed transaction is not recorded and can succeed later', () => {
+    let ledger: Ledger = emptyLedger();
+    expect(code(() => applyTx(ledger, grant('tx.e', -5)))).toBe('NEGATIVE_BALANCE');
+    ledger = applyTx(ledger, grant('tx.f', 10)).ledger;
+    ledger = applyTx(ledger, grant('tx.e', -5)).ledger;
+    expect(balance(ledger, 'res.gold')).toBe(5);
+  });
+
+  it('refuses overflow, including overflow while aggregating', () => {
+    const full = applyTx(emptyLedger(), grant('tx.g', MAX_SAFE)).ledger;
+    expect(code(() => applyTx(full, grant('tx.h', 1)))).toBe('NUMERIC_LIMIT');
+    expect(
+      code(() =>
+        applyTx(emptyLedger(), {
+          txId: 'tx.i',
+          purpose: 'grant',
+          lines: [
+            { resourceId: 'res.gold', bucket: 'available', delta: MAX_SAFE },
+            { resourceId: 'res.gold', bucket: 'available', delta: MAX_SAFE },
+          ],
+        }),
+      ),
+    ).toBe('NUMERIC_LIMIT');
+  });
+
+  it('refuses malformed transactions', () => {
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 0)))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 1.5)))).toBe('INVALID_NUMBER');
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 1, 'gold')))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { txId: 'tx.z', purpose: 'grant', lines: [] }))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { ...grant('tx.z', 1), cause: undefined } as unknown as Tx))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { ...grant('', 1) }))).toBe('INVALID_TX');
+  });
+});
+
+describe('ledger immutability boundary (S0.1)', () => {
+  it('S0 review reproduction: mutating a returned receipt cannot change the replay receipt', () => {
+    const first = applyTx(emptyLedger(), grant('tx.gold.1', 5));
+    expect(() => {
+      (first.result.nets[0] as { delta: number }).delta = 999;
+    }).toThrow(TypeError);
+    const replay = applyTx(first.ledger, grant('tx.gold.1', 5));
+    expect(replay.result.replayed).toBe(true);
+    expect(replay.result.nets).toEqual([{ resourceId: 'res.gold', bucket: 'available', delta: 5 }]);
+    expect(balance(replay.ledger, 'res.gold')).toBe(5);
+  });
+
+  it('committed history cannot be cleared or rewritten through the returned ledger (S0 allowed a double grant)', () => {
+    const { ledger } = applyTx(emptyLedger(), grant('tx.gold.1', 5));
+    const committed = ledger.committed as unknown as Map<string, unknown>;
+    expect(() => committed.clear()).toThrow(TypeError);
+    expect(() => committed.delete('tx.gold.1')).toThrow(TypeError);
+    expect(() => committed.set('tx.other', {})).toThrow(TypeError);
+    const record = ledger.committed.get('tx.gold.1') as { payloadHash: string };
+    expect(() => {
+      record.payloadHash = 'forged';
+    }).toThrow(TypeError);
+    const replay = applyTx(ledger, grant('tx.gold.1', 5));
+    expect(replay.result.replayed).toBe(true);
+    expect(balance(replay.ledger, 'res.gold')).toBe(5);
+    expect(code(() => applyTx(ledger, grant('tx.gold.1', 6)))).toBe('TX_CONFLICT');
+  });
+
+  it('balances cannot be overwritten through the returned ledger', () => {
+    const { ledger } = applyTx(emptyLedger(), grant('tx.gold.1', 5));
+    const balances = ledger.balances as unknown as Map<string, unknown>;
+    expect(() => balances.set('res.gold', { available: 1_000_000, reserved: 0 })).toThrow(TypeError);
+    const entry = ledger.balances.get('res.gold') as { available: number };
+    expect(() => {
+      entry.available = 1_000_000;
+    }).toThrow(TypeError);
+    expect(() => {
+      (ledger as { balances: unknown }).balances = new Map();
+    }).toThrow(TypeError);
+    expect(balance(ledger, 'res.gold')).toBe(5);
+  });
+
+  it('every reachable object is frozen, including replay receipts', () => {
+    const first = applyTx(emptyLedger(), grant('tx.gold.1', 5));
+    const replay = applyTx(first.ledger, grant('tx.gold.1', 5));
+    const reachable = [
+      first.ledger,
+      first.ledger.balances,
+      first.ledger.committed,
+      first.result,
+      first.result.nets,
+      first.result.nets[0],
+      replay.result,
+      replay.result.nets,
+      replay.result.nets[0],
+      first.ledger.balances.get('res.gold'),
+      first.ledger.committed.get('tx.gold.1'),
+    ];
+    for (const value of reachable) expect(Object.isFrozen(value)).toBe(true);
+  });
+
+  it('only ledgers made by emptyLedger or applyTx are accepted', () => {
+    const forged = { balances: new Map([['res.gold', { available: 1_000_000, reserved: 0 }]]), committed: new Map() } as unknown as Ledger;
+    expect(code(() => applyTx(forged, grant('tx.x', 1)))).toBe('INVALID_STATE');
+    expect(code(() => applyTx(null as unknown as Ledger, grant('tx.x', 1)))).toBe('INVALID_STATE');
+  });
+
+  it('refuses sparse or malformed line lists with INVALID_TX (S0 raised INVALID_JSON_VALUE)', () => {
+    expect(code(() => applyTx(emptyLedger(), { txId: 't', purpose: 'grant', lines: new Array(1) }))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { txId: 't', purpose: 'grant', lines: [null] as unknown as Tx['lines'] }))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { txId: 't', purpose: 'grant', lines: 'x' } as unknown as Tx))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), [] as unknown as Tx))).toBe('INVALID_TX');
+  });
+
+  it('values stay readable: entries can be read, iterated and copied', () => {
+    const { ledger } = applyTx(emptyLedger(), grant('tx.gold.1', 5));
+    expect([...ledger.balances.entries()]).toEqual([['res.gold', { available: 5, reserved: 0 }]]);
+    expect(new Map(ledger.balances).get('res.gold')).toEqual({ available: 5, reserved: 0 });
+    expect(ledger.committed.size).toBe(1);
+    expect([...ledger.committed.keys()]).toEqual(['tx.gold.1']);
+  });
+});
+
+describe('ledger identity: only registered ledgers are accepted (S0.1 final correction)', () => {
+  const gold5 = grant('tx.gold.5', 5);
+
+  it('S0.1 review reproduction: mixing the balances of one genuine ledger with the history of another is refused', () => {
+    const original = emptyLedger();
+    const credited = applyTx(original, gold5).ledger;
+    const mixed = Object.freeze({ ...credited, committed: original.committed }) as Ledger;
+    expect(code(() => applyTx(mixed, gold5))).toBe('INVALID_STATE');
+    const reversed = Object.freeze({ ...original, committed: credited.committed }) as Ledger;
+    expect(code(() => applyTx(reversed, grant('tx.other', 1)))).toBe('INVALID_STATE');
+    // The genuine ledgers are unaffected.
+    expect(applyTx(credited, gold5).result.replayed).toBe(true);
+    expect(balance(applyTx(credited, gold5).ledger, 'res.gold')).toBe(5);
+  });
+
+  it('frozen shallow copies of genuine ledgers are refused, as are maps forged through the map constructor', () => {
+    const genuine = applyTx(emptyLedger(), gold5).ledger;
+    expect(code(() => applyTx(Object.freeze({ ...genuine }) as Ledger, grant('tx.x', 1)))).toBe('INVALID_STATE');
+    expect(code(() => applyTx({ ...genuine } as Ledger, grant('tx.x', 1)))).toBe('INVALID_STATE');
+    expect(code(() => applyTx(Object.create(genuine) as Ledger, grant('tx.x', 1)))).toBe('INVALID_STATE');
+    const MapCtor = genuine.balances.constructor as new (m: Map<string, unknown>) => unknown;
+    const forged = Object.freeze({
+      balances: new MapCtor(new Map([['res.gold', Object.freeze({ available: 1_000_000, reserved: 0 })]])),
+      committed: new MapCtor(new Map()),
+    }) as unknown as Ledger;
+    expect(code(() => applyTx(forged, grant('tx.x', 1)))).toBe('INVALID_STATE');
+  });
+
+  it('every earlier genuine ledger is an independent branch starting point', () => {
+    const l0 = emptyLedger();
+    const l1 = applyTx(l0, grant('tx.1', 5)).ledger;
+    const l2 = applyTx(l1, grant('tx.2', 7)).ledger;
+    // Branch A continues l2; branch B restarts from l1; branch C restarts from the empty ledger.
+    const a = applyTx(l2, grant('tx.3', 1)).ledger;
+    const b = applyTx(l1, grant('tx.3', 100)).ledger;
+    const c = applyTx(l0, grant('tx.1', 9)).ledger;
+    expect([balance(l0, 'res.gold'), balance(l1, 'res.gold'), balance(l2, 'res.gold')]).toEqual([0, 5, 12]);
+    expect([balance(a, 'res.gold'), balance(b, 'res.gold'), balance(c, 'res.gold')]).toEqual([13, 105, 9]);
+    expect([...b.committed.keys()].sort()).toEqual(['tx.1', 'tx.3']);
+    expect(l2.committed.has('tx.3')).toBe(false);
+  });
+
+  it('replay and conflict detection follow each branch’s own history', () => {
+    const l1 = applyTx(emptyLedger(), grant('tx.1', 5)).ledger;
+    const l2 = applyTx(l1, grant('tx.2', 7)).ledger;
+    const branch = applyTx(l1, grant('tx.b', 3)).ledger;
+    // tx.1 is in both histories: an identical payload replays, a different one conflicts, in both branches.
+    for (const ledger of [l2, branch]) {
+      const replay = applyTx(ledger, grant('tx.1', 5));
+      expect(replay.result.replayed).toBe(true);
+      expect(replay.ledger).toBe(ledger);
+      expect(code(() => applyTx(ledger, grant('tx.1', 6)))).toBe('TX_CONFLICT');
+    }
+    // tx.2 was committed only on the l2 branch: it is new on the other branch, with any payload.
+    expect(applyTx(branch, grant('tx.2', 7)).result.replayed).toBe(false);
+    expect(balance(applyTx(branch, grant('tx.2', 70)).ledger, 'res.gold')).toBe(78);
+    expect(applyTx(l2, grant('tx.2', 7)).result.replayed).toBe(true);
+    expect(code(() => applyTx(l2, grant('tx.2', 70)))).toBe('TX_CONFLICT');
+    // tx.b was committed only on the branch.
+    expect(applyTx(branch, grant('tx.b', 3)).result.replayed).toBe(true);
+    expect(applyTx(l2, grant('tx.b', 3)).result.replayed).toBe(false);
+  });
+});
diff --git a/legion-progression-lab/test/numeric.property.test.ts b/legion-progression-lab/test/numeric.property.test.ts
new file mode 100644
index 0000000..26fe8f9
--- /dev/null
+++ b/legion-progression-lab/test/numeric.property.test.ts
@@ -0,0 +1,88 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { roundHalfUp } from '../src/core/numeric/rounding.ts';
+import { addSafe, divRem, MAX_SAFE, mulDivRem, mulSafe } from '../src/core/numeric/safeInt.ts';
+import { MAX, refMulDivRem, refRoundHalfUp, safeIntArb } from './helpers/reference.ts';
+
+const OPTIONS = { seed: 20261113, numRuns: 3000 };
+const anySafe = safeIntArb(-MAX_SAFE, MAX_SAFE);
+
+function outcome(fn: () => number): bigint | string {
+  try {
+    return BigInt(fn());
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+}
+
+describe('safe-integer operations agree with exact BigInt arithmetic', () => {
+  it('addSafe: exact result, or NUMERIC_LIMIT exactly when out of range', () => {
+    fc.assert(
+      fc.property(anySafe, anySafe, (a, b) => {
+        const exact = BigInt(a) + BigInt(b);
+        const expected = exact > MAX || exact < -MAX ? 'NUMERIC_LIMIT' : exact;
+        expect(outcome(() => addSafe(a, b))).toBe(expected);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('mulSafe: exact result, or NUMERIC_LIMIT exactly when out of range', () => {
+    const near = fc.oneof(safeIntArb(-200_000_000, 200_000_000), anySafe);
+    fc.assert(
+      fc.property(near, near, (a, b) => {
+        const exact = BigInt(a) * BigInt(b);
+        const expected = exact > MAX || exact < -MAX ? 'NUMERIC_LIMIT' : exact;
+        expect(outcome(() => mulSafe(a, b))).toBe(expected);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('divRem is exact for every non-negative safe dividend', () => {
+    fc.assert(
+      fc.property(safeIntArb(0, MAX_SAFE), fc.oneof(safeIntArb(1, 1000), safeIntArb(1, MAX_SAFE)), (a, b) => {
+        const { q, r } = divRem(a, b);
+        expect(BigInt(q)).toBe(BigInt(a) / BigInt(b));
+        expect(BigInt(r)).toBe(BigInt(a) % BigInt(b));
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('roundHalfUp equals exact floor(x + 1/2) for any finite double in the safe range', () => {
+    const doubles = fc.oneof(
+      fc.double({ min: -(2 ** 53), max: 2 ** 53, noNaN: true, noDefaultInfinity: true }),
+      fc.double({ min: -10, max: 10, noNaN: true, noDefaultInfinity: true }),
+      safeIntArb(-1_000_000, 1_000_000).map((n) => n + 0.5),
+    );
+    fc.assert(
+      fc.property(doubles, (x) => {
+        expect(BigInt(roundHalfUp(x))).toBe(refRoundHalfUp(x));
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('mulDivRem: exact quotient and remainder for any safe inputs, NUMERIC_LIMIT exactly when the quotient is unsafe (S0.1)', () => {
+    const factor = fc.oneof(safeIntArb(0, 1000), safeIntArb(0, 2 ** 26), safeIntArb(0, 2 ** 40), safeIntArb(0, MAX_SAFE), fc.constantFrom(0, 1, MAX_SAFE, MAX_SAFE - 1, 2 ** 52));
+    const divisor = fc.oneof(safeIntArb(1, 1000), safeIntArb(1, 3_600_000_000), safeIntArb(1, MAX_SAFE), fc.constantFrom(1, 2, MAX_SAFE, MAX_SAFE - 1, 10_000_000));
+    fc.assert(
+      fc.property(factor, factor, divisor, (a, m, d) => {
+        const ref = refMulDivRem(a, m, d);
+        let got: { q: number; r: number } | string;
+        try {
+          got = mulDivRem(a, m, d);
+        } catch (e) {
+          if (!(e instanceof LabError)) throw e;
+          got = e.code;
+        }
+        if (ref.q > MAX) expect(got).toBe('NUMERIC_LIMIT');
+        else expect(got).toEqual({ q: Number(ref.q), r: Number(ref.r) });
+      }),
+      { seed: 20261113, numRuns: 20_000 },
+    );
+  });
+});
diff --git a/legion-progression-lab/test/numeric.test.ts b/legion-progression-lab/test/numeric.test.ts
new file mode 100644
index 0000000..6029ad4
--- /dev/null
+++ b/legion-progression-lab/test/numeric.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { roundHalfUp, roundHalfUpToSafeInt } from '../src/core/numeric/rounding.ts';
+import { addSafe, ceilDiv, divRem, MAX_SAFE, mulSafe, subSafe, TWO_POW_52 } from '../src/core/numeric/safeInt.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+describe('safe integers', () => {
+  it('adds up to the limit and refuses one past it', () => {
+    expect(addSafe(MAX_SAFE - 1, 1)).toBe(MAX_SAFE);
+    expect(code(() => addSafe(MAX_SAFE, 1))).toBe('NUMERIC_LIMIT');
+    expect(code(() => subSafe(-MAX_SAFE, 1))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('refuses non-integers, NaN, Infinity and unsafe inputs', () => {
+    expect(code(() => addSafe(1.5, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => addSafe(Number.NaN, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => mulSafe(Number.POSITIVE_INFINITY, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => addSafe(2 ** 53, 0))).toBe('INVALID_NUMBER');
+  });
+
+  it('normalises -0 to +0', () => {
+    expect(Object.is(addSafe(-0, 0), 0)).toBe(true);
+    expect(Object.is(mulSafe(-1, 0), 0)).toBe(true);
+  });
+
+  it('checks intermediate products, not only final results', () => {
+    // (2^52 * 4) / 8 would be 2^51, but the intermediate 2^54 is refused.
+    expect(code(() => divRem(mulSafe(TWO_POW_52, 4), 8))).toBe('NUMERIC_LIMIT');
+    expect(mulSafe(94_906_265, 94_906_265)).toBe(9_007_199_136_250_225);
+    expect(code(() => mulSafe(94_906_266, 94_906_266))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('divides exactly near 2^53 where floating division rounds', () => {
+    expect(divRem(MAX_SAFE, 3)).toEqual({ q: 3_002_399_751_580_330, r: 1 });
+    expect(divRem(MAX_SAFE - 1, MAX_SAFE)).toEqual({ q: 0, r: MAX_SAFE - 1 }); // a/b rounds to 1.0
+    expect(divRem(MAX_SAFE, MAX_SAFE - 1)).toEqual({ q: 1, r: 1 });
+    expect(divRem(0, 7)).toEqual({ q: 0, r: 0 });
+    expect(ceilDiv(15, 8)).toBe(2);
+    expect(code(() => divRem(5, 0))).toBe('INVALID_NUMBER');
+    expect(code(() => divRem(-1, 3))).toBe('INVALID_NUMBER');
+  });
+});
+
+describe('roundHalfUp', () => {
+  it('fixes both failure cases of floor(x + 0.5)', () => {
+    expect(Math.floor(0.49999999999999994 + 0.5)).toBe(1); // the naive bug, demonstrated
+    expect(roundHalfUp(0.49999999999999994)).toBe(0);
+    expect(Math.floor(TWO_POW_52 + 1 + 0.5)).toBe(TWO_POW_52 + 2); // the naive bug, demonstrated
+    expect(roundHalfUp(TWO_POW_52 + 1)).toBe(TWO_POW_52 + 1);
+  });
+
+  it('rounds halves up, including negatives', () => {
+    expect(roundHalfUp(2.5)).toBe(3);
+    expect(roundHalfUp(2.4999)).toBe(2);
+    expect(roundHalfUp(-2.5)).toBe(-2);
+    expect(roundHalfUp(TWO_POW_52 - 0.5)).toBe(TWO_POW_52);
+    expect(Object.is(roundHalfUp(-0.4), 0)).toBe(true);
+  });
+
+  it('refuses non-finite input and results beyond the safe range', () => {
+    expect(code(() => roundHalfUp(Number.NaN))).toBe('INVALID_NUMBER');
+    expect(roundHalfUpToSafeInt(MAX_SAFE)).toBe(MAX_SAFE);
+    expect(code(() => roundHalfUpToSafeInt(2 ** 53))).toBe('NUMERIC_LIMIT');
+  });
+});
diff --git a/legion-progression-lab/test/purity.test.ts b/legion-progression-lab/test/purity.test.ts
new file mode 100644
index 0000000..1c2713a
--- /dev/null
+++ b/legion-progression-lab/test/purity.test.ts
@@ -0,0 +1,62 @@
+/**
+ * The deterministic core must not touch the clock, ambient randomness, the process, timers or I/O.
+ * Scanned folders: src/core, src/spec, src/report (pure modules). src/cli is the only place for I/O.
+ */
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative, resolve, sep } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { LAB_ROOT } from '../src/cli/paths.ts';
+
+const PURE_DIRS = ['src/core', 'src/spec', 'src/report'];
+const ALLOWED_PACKAGES = new Set(['zod', 'node:crypto']);
+const FORBIDDEN: [RegExp, string][] = [
+  [/\bDate\b/, 'Date (clock)'],
+  [/Math\.random/, 'Math.random (ambient RNG)'],
+  [/\bprocess\b/, 'process'],
+  [/\bperformance\b/, 'performance (clock)'],
+  [/\bset(Timeout|Interval|Immediate)\b/, 'timers'],
+  [/\bcrypto\.(randomUUID|randomBytes|getRandomValues)\b/, 'crypto randomness'],
+];
+
+function files(dir: string): string[] {
+  return readdirSync(dir).flatMap((name) => {
+    const p = join(dir, name);
+    return statSync(p).isDirectory() ? files(p) : p.endsWith('.ts') ? [p] : [];
+  });
+}
+
+function stripComments(text: string): string {
+  return text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1');
+}
+
+function importSpecifiers(text: string): string[] {
+  const out: string[] = [];
+  for (const m of text.matchAll(/(?:import|export)\s+(?:type\s+)?[^'"]*?from\s+['"]([^'"]+)['"]/g)) out.push(m[1] ?? '');
+  for (const m of text.matchAll(/import\s*\(\s*['"]([^'"]+)['"]\s*\)/g)) out.push(m[1] ?? '');
+  for (const m of text.matchAll(/^\s*import\s+['"]([^'"]+)['"]/gm)) out.push(m[1] ?? '');
+  return out;
+}
+
+describe('purity of the deterministic core', () => {
+  const pureFiles = PURE_DIRS.flatMap((d) => files(resolve(LAB_ROOT, d)));
+
+  it('finds the pure modules', () => {
+    expect(pureFiles.length).toBeGreaterThanOrEqual(15);
+  });
+
+  for (const file of pureFiles) {
+    const rel = relative(LAB_ROOT, file).split(sep).join('/');
+    it(`${rel} uses no clock, ambient RNG, process, timers or I/O`, () => {
+      const code = stripComments(readFileSync(file, 'utf8'));
+      for (const [pattern, what] of FORBIDDEN) expect(pattern.test(code), `${rel} uses ${what}`).toBe(false);
+      for (const spec of importSpecifiers(code)) {
+        if (spec.startsWith('.')) {
+          const target = relative(LAB_ROOT, resolve(file, '..', spec)).split(sep).join('/');
+          expect(PURE_DIRS.some((d) => target.startsWith(`${d}/`)), `${rel} imports non-pure ${target}`).toBe(true);
+        } else {
+          expect(ALLOWED_PACKAGES.has(spec), `${rel} imports package ${spec}`).toBe(true);
+        }
+      }
+    });
+  }
+});
diff --git a/legion-progression-lab/test/remainder.property.test.ts b/legion-progression-lab/test/remainder.property.test.ts
new file mode 100644
index 0000000..ec1a0ed
--- /dev/null
+++ b/legion-progression-lab/test/remainder.property.test.ts
@@ -0,0 +1,157 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { accrue, accruePerHour, MAX_DEN, MILLI_PER_UNIT, MS_PER_HOUR, PER_HOUR_DEN, type PerHourState } from '../src/core/numeric/remainder.ts';
+import { MAX_SAFE } from '../src/core/numeric/safeInt.ts';
+import { MAX, refAccrue, refPerHour, safeIntArb } from './helpers/reference.ts';
+
+const OPTIONS = { seed: 20261113, numRuns: 2000 };
+
+const stateArb: fc.Arbitrary<PerHourState> = fc.record({ msRem: safeIntArb(0, MS_PER_HOUR - 1), milliRem: safeIntArb(0, MILLI_PER_UNIT - 1) });
+// Rates and durations across the whole safe range, with extra weight on realistic and boundary values.
+const rateArb = fc.oneof(safeIntArb(0, 10_000), safeIntArb(0, 10_000_000_000), safeIntArb(0, MAX_SAFE), fc.constantFrom(0, 1, MAX_SAFE, PER_HOUR_DEN));
+const msArb = fc.oneof(safeIntArb(0, MS_PER_HOUR), safeIntArb(0, 30 * 24 * MS_PER_HOUR), safeIntArb(0, MAX_SAFE), fc.constantFrom(0, 1, PER_HOUR_DEN, MAX_SAFE));
+
+function tryPerHour(state: PerHourState, rate: number, ms: number): { granted: number; state: PerHourState } | string {
+  try {
+    return accruePerHour(state, rate, ms);
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+}
+
+/** Applies pieces in order, summing grants with unbounded integers; returns the error code of the first failing call. */
+function runPieces(start: PerHourState, pieces: readonly (readonly [number, number])[]): { granted: bigint; state: PerHourState } | string {
+  let state = start;
+  let granted = 0n;
+  for (const [rate, ms] of pieces) {
+    const r = tryPerHour(state, rate, ms);
+    if (typeof r === 'string') return r;
+    granted += BigInt(r.granted);
+    state = r.state;
+  }
+  return { granted, state };
+}
+
+describe('remainder accumulator properties', () => {
+  it('matches exact BigInt arithmetic for any valid inputs', () => {
+    const arb = safeIntArb(1, MAX_DEN).chain((den) =>
+      fc.tuple(fc.constant(den), safeIntArb(0, den - 1), fc.oneof(safeIntArb(0, 1_000_000), safeIntArb(0, MAX_SAFE)), fc.oneof(safeIntArb(0, 100_000_000), safeIntArb(0, MAX_SAFE))),
+    );
+    fc.assert(
+      fc.property(arb, ([den, rem, num, steps]) => {
+        const ref = refAccrue(rem, num, steps, den);
+        let got: { granted: number; rem: number } | string;
+        try {
+          got = accrue(rem, num, steps, den);
+        } catch (e) {
+          if (!(e instanceof LabError)) throw e;
+          got = e.code;
+        }
+        if (ref.granted > MAX) expect(got).toBe('NUMERIC_LIMIT');
+        else expect(got).toEqual({ granted: Number(ref.granted), rem: Number(ref.rem) });
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('G1: any partition of the steps gives the same total and remainder', () => {
+    const arb = safeIntArb(1, MAX_DEN).chain((den) =>
+      fc.tuple(fc.constant(den), safeIntArb(0, den - 1), safeIntArb(0, 10_000_000), fc.array(safeIntArb(0, 1_000_000_000), { minLength: 1, maxLength: 20 })),
+    );
+    fc.assert(
+      fc.property(arb, ([den, rem, num, parts]) => {
+        const total = parts.reduce((s, p) => s + p, 0);
+        // Only representable totals: overflow behaviour is covered by the BigInt comparison above.
+        fc.pre(refAccrue(rem, num, total, den).granted <= MAX);
+        const once = accrue(rem, num, total, den);
+        let r = rem;
+        let granted = 0;
+        for (const p of parts) {
+          const step = accrue(r, num, p, den);
+          granted += step.granted;
+          r = step.rem;
+        }
+        expect({ granted, rem: r }).toEqual(once);
+      }),
+      OPTIONS,
+    );
+  });
+});
+
+describe('per-hour chain properties (remainder.md v2, S0.1)', () => {
+  it('one call matches the BigInt reference for any state, rate and duration; NUMERIC_LIMIT exactly when the grant is unsafe', () => {
+    fc.assert(
+      fc.property(stateArb, rateArb, msArb, (state, rate, ms) => {
+        const ref = refPerHour(state, [[rate, ms]]);
+        const got = tryPerHour(state, rate, ms);
+        if (ref.granted > MAX) expect(got).toBe('NUMERIC_LIMIT');
+        else expect(got).toEqual({ granted: Number(ref.granted), state: { msRem: ref.msRem, milliRem: ref.milliRem } });
+      }),
+      { seed: 20261113, numRuns: 10_000 },
+    );
+  });
+
+  it('G1: any partition of a duration gives the same total and state, for rates up to 2^53 - 1', () => {
+    const arb = fc.tuple(stateArb, rateArb, fc.array(msArb, { minLength: 1, maxLength: 12 }));
+    fc.assert(
+      fc.property(arb, ([state, rate, parts]) => {
+        const totalMs = parts.reduce((s, p) => s + BigInt(p), 0n);
+        fc.pre(totalMs <= MAX);
+        const ref = refPerHour(state, [[rate, Number(totalMs)]]);
+        const once = tryPerHour(state, rate, Number(totalMs));
+        const split = runPieces(
+          state,
+          parts.map((p) => [rate, p] as const),
+        );
+        if (ref.granted > MAX) {
+          // The single call is refused; the parts cannot all be granted and summed within the safe range either.
+          expect(once).toBe('NUMERIC_LIMIT');
+          if (typeof split === 'string') expect(split).toBe('NUMERIC_LIMIT');
+          else expect(split.granted > MAX).toBe(true);
+          return;
+        }
+        expect(once).toEqual({ granted: Number(ref.granted), state: { msRem: ref.msRem, milliRem: ref.milliRem } });
+        expect(split).toEqual({ granted: ref.granted, state: { msRem: ref.msRem, milliRem: ref.milliRem } });
+      }),
+      { seed: 20261113, numRuns: 5000 },
+    );
+  });
+
+  it('G3: a timeline of rate changes, each segment split arbitrarily, equals the exact integral', () => {
+    const segment = fc.tuple(rateArb, fc.array(fc.oneof(safeIntArb(0, MS_PER_HOUR), safeIntArb(0, 1_000_000_000)), { minLength: 1, maxLength: 6 }));
+    fc.assert(
+      fc.property(stateArb, fc.array(segment, { minLength: 1, maxLength: 6 }), (state, segments) => {
+        const pieces = segments.flatMap(([rate, parts]) => parts.map((p) => [rate, p] as const));
+        const ref = refPerHour(state, pieces);
+        const got = runPieces(state, pieces);
+        if (typeof got === 'string') {
+          // A single piece can only fail if its own grant is unsafe, which implies the whole timeline is too.
+          expect(got).toBe('NUMERIC_LIMIT');
+          expect(ref.granted > MAX).toBe(true);
+          return;
+        }
+        expect(got).toEqual({ granted: ref.granted, state: { msRem: ref.msRem, milliRem: ref.milliRem } });
+      }),
+      { seed: 20261113, numRuns: 3000 },
+    );
+  });
+
+  it('settling at any cadence equals settling once, from any persisted state (save/load round trip included)', () => {
+    fc.assert(
+      fc.property(stateArb, safeIntArb(0, 1_000_000_000), fc.array(safeIntArb(0, 10_000_000), { minLength: 1, maxLength: 40 }), (state, rate, parts) => {
+        let s = state;
+        let granted = 0n;
+        for (const p of parts) {
+          const r = accruePerHour(JSON.parse(JSON.stringify(s)) as PerHourState, rate, p);
+          granted += BigInt(r.granted);
+          s = r.state;
+        }
+        const ref = refPerHour(state, [[rate, parts.reduce((a, b) => a + b, 0)]]);
+        expect({ granted, state: s }).toEqual({ granted: ref.granted, state: { msRem: ref.msRem, milliRem: ref.milliRem } });
+      }),
+      OPTIONS,
+    );
+  });
+});
diff --git a/legion-progression-lab/test/remainder.test.ts b/legion-progression-lab/test/remainder.test.ts
