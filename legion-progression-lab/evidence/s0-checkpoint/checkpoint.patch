++    if op == "uniformInt":
++        s, values, draws = derive(inp["id"]), [], []
++        for _ in range(inp["count"]):
++            v, s, d = uniform_int(s, inp["lo"], inp["hi"])
++            values.append(v)
++            draws.append(d)
