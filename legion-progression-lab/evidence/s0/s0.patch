+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { evaluateStat, type StatCategory, type StatSource } from '../src/core/formulas/stats.ts';
+import { safeIntArb } from './helpers/reference.ts';
+
+const CATS: StatCategory[] = [
+  { id: 'cat.damage.additive', kind: 'additivePool', active: true },
+  { id: 'cat.damage.monument', kind: 'multiplier', active: true },
+  { id: 'cat.research', kind: 'multiplier', active: false },
+];
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+describe('stat stacking', () => {
+  it('adds within a category and multiplies across categories', () => {
+    const r = evaluateStat(
+      6,
+      [
+        { sourceId: 'src.weapon', kind: 'flat', value: 2 },
+        { sourceId: 'src.talent', kind: 'bp', categoryId: 'cat.damage.additive', value: 2500 },
+        { sourceId: 'src.feat', kind: 'bp', categoryId: 'cat.damage.additive', value: 2500 },
+        { sourceId: 'src.monument', kind: 'bp', categoryId: 'cat.damage.monument', value: 5000 },
+      ],
+      CATS,
+    );
+    expect(r.value).toBe(18);
+    expect(r.flatTotal).toBe(8);
+  });
+
+  it('the breakdown reproduces the applied value exactly', () => {
+    const sourcesArb = fc.array(
+      fc.oneof(
+        safeIntArb(0, 50).map((v) => ({ kind: 'flat' as const, value: v })),
+        fc.tuple(fc.constantFrom(...CATS.map((c) => c.id)), safeIntArb(-3000, 20000)).map(([categoryId, value]) => ({ kind: 'bp' as const, categoryId, value })),
+      ),
+      { maxLength: 12 },
+    );
+    fc.assert(
+      fc.property(safeIntArb(0, 1000), sourcesArb, (base, raw) => {
+        const sources: StatSource[] = raw.map((s, i) => ({ ...s, sourceId: `src.${i}` }));
+        const r = evaluateStat(base, sources, CATS);
+        let v = r.flatTotal;
+        for (const c of r.categories) if (c.active) v = (v * c.factorNumerator) / 10_000;
+        expect(v).toBe(r.value);
+      }),
+      { seed: 20261113, numRuns: 1000 },
+    );
+  });
+
+  it('source order does not change the result', () => {
+    const sources: StatSource[] = [
+      { sourceId: 'src.a', kind: 'bp', categoryId: 'cat.damage.additive', value: 1234 },
+      { sourceId: 'src.b', kind: 'flat', value: 7 },
+      { sourceId: 'src.c', kind: 'bp', categoryId: 'cat.damage.monument', value: 777 },
+      { sourceId: 'src.d', kind: 'bp', categoryId: 'cat.damage.additive', value: 4321 },
+    ];
+    const forward = evaluateStat(3, sources, CATS);
+    const backward = evaluateStat(3, [...sources].reverse(), [...CATS].reverse());
+    expect(backward.value).toBe(forward.value);
+  });
+
+  it('inactive categories are neutral; unknown or duplicate entries are refused', () => {
+    expect(evaluateStat(10, [{ sourceId: 'src.lab', kind: 'bp', categoryId: 'cat.research', value: 10_000 }], CATS).value).toBe(10);
+    expect(code(() => evaluateStat(1, [{ sourceId: 'src.x', kind: 'bp', categoryId: 'cat.unknown', value: 1 }], CATS))).toBe('UNKNOWN_CATEGORY');
+    expect(code(() => evaluateStat(1, [{ sourceId: 'src.x', kind: 'flat', value: 1 }, { sourceId: 'src.x', kind: 'flat', value: 1 }], CATS))).toBe('INVALID_CONTENT');
+    expect(code(() => evaluateStat(1, [], [CATS[0] as StatCategory, CATS[0] as StatCategory]))).toBe('INVALID_CONTENT');
+    expect(code(() => evaluateStat(1, [{ sourceId: 'src.x', kind: 'bp', categoryId: 'cat.damage.additive', value: -10_001 }], CATS))).toBe('INVALID_STATE');
+  });
+});
diff --git a/legion-progression-lab/test/stats/rng.distribution.test.ts b/legion-progression-lab/test/stats/rng.distribution.test.ts
new file mode 100644
index 0000000..37ef904
--- /dev/null
+++ b/legion-progression-lab/test/stats/rng.distribution.test.ts
@@ -0,0 +1,105 @@
+/**
+ * Distribution tests for the RNG primitives, kept separate from replay tests (review item D).
+ * Fixed seeds make the outcome deterministic; the significance level is pre-declared: alpha = 0.001.
+ * Critical values: chi-square df = 255 via Wilson-Hilferty (about 330.5); df = 5: 20.515; df = 2: 13.816.
+ * Binomial: |x - n p| <= 3.2905 * sqrt(n p (1 - p)) (two-sided normal approximation, alpha = 0.001).
+ */
+import { describe, expect, it } from 'vitest';
+import { deriveRngState, type StreamId } from '../../src/core/rng/streamId.ts';
+import { bernoulli, thresholdFromBp, uniformInt } from '../../src/core/rng/sample.ts';
+import { nextU32, type RngState } from '../../src/core/rng/xoshiro128ss.ts';
+
+const Z = 3.0902; // one-sided 0.999 quantile of the standard normal
+const Z_TWO_SIDED = 3.2905;
+const stream = (purpose: string, counter = 0): StreamId => ({ root: 'S0-stats', purpose, entity: 'test', counter });
+
+function chiSquareCritical(df: number): number {
+  const t = 2 / (9 * df);
+  return df * (1 - t + Z * Math.sqrt(t)) ** 3;
+}
+
+function chiSquare(counts: number[], expected: number): number {
+  return counts.reduce((s, c) => s + ((c - expected) ** 2) / expected, 0);
+}
+
+describe('RNG distribution (fixed seeds, alpha = 0.001)', () => {
+  const N = 1_000_000;
+
+  it('high and low bytes of nextU32 are uniform (chi-square, 256 buckets)', () => {
+    let s: RngState = deriveRngState(stream('uniformity'));
+    const high = new Array<number>(256).fill(0);
+    const low = new Array<number>(256).fill(0);
+    for (let i = 0; i < N; i += 1) {
+      const [v, next] = nextU32(s);
+      s = next;
+      high[v >>> 24] = (high[v >>> 24] ?? 0) + 1;
+      low[v & 0xff] = (low[v & 0xff] ?? 0) + 1;
+    }
+    const critical = chiSquareCritical(255);
+    expect(critical).toBeGreaterThan(329);
+    expect(critical).toBeLessThan(332);
+    expect(chiSquare(high, N / 256)).toBeLessThan(critical);
+    expect(chiSquare(low, N / 256)).toBeLessThan(critical);
+  });
+
+  for (const bp of [5000, 100, 20]) {
+    it(`Bernoulli at ${bp} bp has the correct success rate (binomial interval)`, () => {
+      let s: RngState = deriveRngState(stream(`bernoulli.${bp}`));
+      const t = thresholdFromBp(bp);
+      let hits = 0;
+      for (let i = 0; i < N; i += 1) {
+        const [hit, next] = bernoulli(s, t);
+        s = next;
+        if (hit) hits += 1;
+      }
+      const p = bp / 10_000;
+      const sd = Math.sqrt(N * p * (1 - p));
+      expect(Math.abs(hits - N * p)).toBeLessThanOrEqual(Z_TWO_SIDED * sd);
+    });
+  }
+
+  it('uniformInt(1, 6) is unbiased (chi-square, df = 5)', () => {
+    let s: RngState = deriveRngState(stream('d6'));
+    const counts = new Array<number>(6).fill(0);
+    const n = 600_000;
+    for (let i = 0; i < n; i += 1) {
+      const r = uniformInt(s, 1, 6);
+      s = r.state;
+      counts[r.value - 1] = (counts[r.value - 1] ?? 0) + 1;
+    }
+    expect(chiSquare(counts, n / 6)).toBeLessThan(20.515);
+  });
+
+  it('uniformInt with span 2^31 + 1 rejects about half of all draws, and stays unbiased across halves', () => {
+    let s: RngState = deriveRngState(stream('worst-span'));
+    const n = 200_000;
+    let draws = 0;
+    let lowHalf = 0;
+    for (let i = 0; i < n; i += 1) {
+      const r = uniformInt(s, 0, 2 ** 31);
+      s = r.state;
+      draws += r.draws;
+      if (r.value < 2 ** 30) lowHalf += 1;
+    }
+    // Acceptance probability (2^31 + 1) / 2^32: expected draws per call = 2^32 / (2^31 + 1), about 2.
+    const pAccept = (2 ** 31 + 1) / 2 ** 32;
+    const expectedDraws = n / pAccept;
+    const sdDraws = Math.sqrt((n * (1 - pAccept)) / pAccept ** 2);
+    expect(Math.abs(draws - expectedDraws)).toBeLessThanOrEqual(Z_TWO_SIDED * sdDraws);
+    // Values below 2^30 occur with probability 2^30 / (2^31 + 1), about 0.5.
+    const pLow = 2 ** 30 / (2 ** 31 + 1);
+    expect(Math.abs(lowHalf - n * pLow)).toBeLessThanOrEqual(Z_TWO_SIDED * Math.sqrt(n * pLow * (1 - pLow)));
+  });
+
+  it('streams with adjacent counters are not correlated (chi-square on paired top bits, df = 3)', () => {
+    const counts = [0, 0, 0, 0];
+    const n = 200_000;
+    for (let c = 0; c < n; c += 1) {
+      const [a] = nextU32(deriveRngState(stream('pairs', c)));
+      const [b] = nextU32(deriveRngState(stream('pairs', c + 1)));
+      const k = ((a >>> 31) << 1) | (b >>> 31);
+      counts[k] = (counts[k] ?? 0) + 1;
+    }
+    expect(chiSquare(counts, n / 4)).toBeLessThan(16.266); // chi-square 0.999 quantile, df = 3
+  });
+});
