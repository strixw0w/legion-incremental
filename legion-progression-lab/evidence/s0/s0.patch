@@ -0,0 +1,13 @@
+/** Basis points: integer hundredths of a percent (2500 bp = +25%). spec/formulas/units.md. */
+import { assertSafeIntInRange, MAX_SAFE } from './safeInt.ts';
+
+export const BP_SCALE = 10_000;
+
+export function assertBp(value: unknown, name = 'bp', min = 0, max = MAX_SAFE): number {
+  return assertSafeIntInRange(value, min, max, name);
+}
+
+/** A probability or share in basis points: 0..10000. */
+export function assertProbabilityBp(value: unknown, name = 'bp'): number {
+  return assertSafeIntInRange(value, 0, BP_SCALE, name);
+}
diff --git a/legion-progression-lab/src/core/numeric/remainder.ts b/legion-progression-lab/src/core/numeric/remainder.ts
new file mode 100644
index 0000000..ebaff86
--- /dev/null
+++ b/legion-progression-lab/src/core/numeric/remainder.ts
@@ -0,0 +1,75 @@
+/**
+ * Exact remainder accounting (spec/formulas/remainder.md v1; architecture v1.1 section 6.3).
+ *
+ * accrue(rem, num, steps, den) returns, exactly,
+ *   granted = floor((rem + num*steps) / den)   and   rem' = (rem + num*steps) mod den
+ * for safe integers 0 <= rem < den, num >= 0, steps >= 0, 1 <= den <= 2^26.
+ *
+ * With steps = qs*den + j and num = a*den + b (0 <= j, b < den):
+ *   granted = a*qs*den + a*j + b*qs + floor((b*j + rem) / den),   rem' = (b*j + rem) mod den.
+ * b*j + rem < 2^52 is exact because den <= 2^26; every other term is part of `granted` and is
+ * computed with checked arithmetic, so the only failure is a result that cannot be represented.
+ *
+ * G1 partition invariance: splitting `steps` into any parts, carrying `rem`, gives the same total
+ * granted and the same final remainder, because this is exact integer arithmetic.
+ * G2 zero duration: steps = 0 changes nothing.
+ * G5 no epsilon: nothing is ever added before a floor.
+ */
+import { fail } from '../errors.ts';
+import { addSafe, assertNonNegativeSafeInt, assertSafeInt, divRem, mulSafe, TWO_POW_26 } from './safeInt.ts';
+
+export const MAX_DEN = TWO_POW_26;
+
+export interface AccrueResult {
+  readonly granted: number;
+  readonly rem: number;
+}
+
+export function assertDenominator(den: unknown): number {
+  const d = assertSafeInt(den, 'den');
+  if (d < 1 || d > MAX_DEN) fail('INVALID_DENOMINATOR', `den must be in [1, ${MAX_DEN}]`, { den: d });
+  return d;
+}
+
+export function accrue(rem: number, num: number, steps: number, den: number): AccrueResult {
+  const d = assertDenominator(den);
+  const r0 = assertNonNegativeSafeInt(rem, 'rem');
+  if (r0 >= d) fail('INVALID_STATE', 'remainder must be < den', { rem: r0, den: d });
+  const n = assertNonNegativeSafeInt(num, 'num');
+  const s = assertNonNegativeSafeInt(steps, 'steps');
+
+  const { q: qs, r: j } = divRem(s, d);
+  const { q: a, r: b } = divRem(n, d);
+  const tail = divRem(b * j + r0, d); // b*j + r0 < 2^52: exact
+
+  let granted = mulSafe(mulSafe(a, qs), d);
+  granted = addSafe(granted, mulSafe(a, j));
+  granted = addSafe(granted, mulSafe(b, qs));
+  granted = addSafe(granted, tail.q);
+  return { granted, rem: tail.r };
+}
+
+/** Standard per-hour chain: stage 1 ms -> milli-units (den 3,600,000), stage 2 milli-units -> units (den 1000). */
+export const MS_PER_HOUR = 3_600_000;
+export const MILLI_PER_UNIT = 1000;
+
+export interface PerHourState {
+  /** Stage-1 remainder, in [0, 3_600_000). */
+  readonly msRem: number;
+  /** Stage-2 remainder (milli-units not yet a whole unit), in [0, 1000). */
+  readonly milliRem: number;
+}
+
+export const ZERO_PER_HOUR_STATE: PerHourState = Object.freeze({ msRem: 0, milliRem: 0 });
+
+export interface PerHourResult {
+  readonly granted: number;
+  readonly state: PerHourState;
+}
+
+/** Accrues `dMs` milliseconds at an integer rate of `rateMilliPerHour` thousandths of a unit per hour. */
+export function accruePerHour(state: PerHourState, rateMilliPerHour: number, dMs: number): PerHourResult {
+  const stage1 = accrue(state.msRem, rateMilliPerHour, dMs, MS_PER_HOUR);
+  const stage2 = accrue(state.milliRem, 1, stage1.granted, MILLI_PER_UNIT);
+  return { granted: stage2.granted, state: { msRem: stage1.rem, milliRem: stage2.rem } };
+}
diff --git a/legion-progression-lab/src/core/numeric/rounding.ts b/legion-progression-lab/src/core/numeric/rounding.ts
new file mode 100644
index 0000000..532f508
--- /dev/null
+++ b/legion-progression-lab/src/core/numeric/rounding.ts
@@ -0,0 +1,27 @@
+/**
+ * Round half up (spec/formulas/numeric.md v1, section "roundHalfUp").
+ *
+ * The naive floor(x + 0.5) is wrong in two places: for x = 0.49999999999999994 it returns 1 (x + 0.5
+ * rounds up to 1.0 before the floor), and for x = 2^52 + 1 it returns 2^52 + 2 (x + 0.5 rounds to even).
+ * Here: for |x| >= 2^52 every double is already an integer and is returned unchanged; otherwise
+ * f = floor(x) and d = x - f, which is exact in that range, and the result is f + (d >= 0.5 ? 1 : 0).
+ */
+import { fail } from '../errors.ts';
+import { normZero, TWO_POW_52 } from './safeInt.ts';
+
+export function roundHalfUp(x: number): number {
+  if (typeof x !== 'number' || !Number.isFinite(x)) {
+    fail('INVALID_NUMBER', 'roundHalfUp requires a finite number', { x: String(x) });
+  }
+  if (Math.abs(x) >= TWO_POW_52) return normZero(x);
+  const f = Math.floor(x);
+  const d = x - f;
+  return normZero(d >= 0.5 ? f + 1 : f);
+}
+
+/** roundHalfUp, then require the result to be a safe integer (2^53 and beyond are refused). */
+export function roundHalfUpToSafeInt(x: number): number {
+  const r = roundHalfUp(x);
+  if (!Number.isSafeInteger(r)) fail('NUMERIC_LIMIT', 'rounded value is outside the safe integer range', { x });
+  return r;
+}
diff --git a/legion-progression-lab/src/core/numeric/safeInt.ts b/legion-progression-lab/src/core/numeric/safeInt.ts
new file mode 100644
index 0000000..51ddbc2
--- /dev/null
+++ b/legion-progression-lab/src/core/numeric/safeInt.ts
@@ -0,0 +1,88 @@
+/**
+ * Safe-integer arithmetic (spec/formulas/numeric.md v1).
+ *
+ * A safe integer is a double x with Number.isSafeInteger(x); -0 is normalised to +0.
+ * Each operation is performed once in IEEE-754 and the result is checked. For integer inputs this
+ * is sound: an exact result outside +/-(2^53 - 1) rounds to a double at or beyond +/-2^53, which
+ * fails the check; an exact result inside the range is represented exactly.
+ */
+import { fail } from '../errors.ts';
+
+export const MAX_SAFE = Number.MAX_SAFE_INTEGER; // 2^53 - 1 = 9_007_199_254_740_991
+export const TWO_POW_26 = 67_108_864;
+export const TWO_POW_32 = 4_294_967_296;
+export const TWO_POW_52 = 4_503_599_627_370_496;
+
+export function isSafeInt(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value);
+}
+
+/** Turns -0 into +0; leaves every other number unchanged. */
+export function normZero(value: number): number {
+  return value === 0 ? 0 : value;
+}
+
+export function assertSafeInt(value: unknown, name = 'value'): number {
+  if (!isSafeInt(value)) {
+    fail('INVALID_NUMBER', `${name} must be a safe integer`, { name, value: String(value) });
+  }
+  return normZero(value);
+}
+
+export function assertNonNegativeSafeInt(value: unknown, name = 'value'): number {
+  const v = assertSafeInt(value, name);
+  if (v < 0) fail('INVALID_NUMBER', `${name} must be >= 0`, { name, value: v });
+  return v;
+}
+
+export function assertSafeIntInRange(value: unknown, min: number, max: number, name = 'value'): number {
+  const v = assertSafeInt(value, name);
+  if (v < min || v > max) fail('INVALID_NUMBER', `${name} must be in [${min}, ${max}]`, { name, value: v });
+  return v;
+}
+
+function checked(result: number, op: string, a: number, b: number): number {
+  if (!Number.isSafeInteger(result)) {
+    fail('NUMERIC_LIMIT', `${op} result is outside the safe integer range`, { op, a, b });
+  }
+  return normZero(result);
+}
+
+export function addSafe(a: number, b: number): number {
+  const x = assertSafeInt(a, 'a');
+  const y = assertSafeInt(b, 'b');
+  return checked(x + y, 'add', x, y);
+}
+
+export function subSafe(a: number, b: number): number {
+  const x = assertSafeInt(a, 'a');
+  const y = assertSafeInt(b, 'b');
+  return checked(x - y, 'sub', x, y);
+}
+
+export function mulSafe(a: number, b: number): number {
+  const x = assertSafeInt(a, 'a');
+  const y = assertSafeInt(b, 'b');
+  return checked(x * y, 'mul', x, y);
+}
+
+/**
+ * Exact integer division for a >= 0, b >= 1: returns q, r with a = q*b + r and 0 <= r < b.
+ * Floating division alone can be off by one near 2^53, so q is corrected. A rounded product q*b
+ * is only ever compared, never used, unless it is <= a (and therefore exact).
+ */
+export function divRem(a: number, b: number): { q: number; r: number } {
+  const x = assertNonNegativeSafeInt(a, 'a');
+  const y = assertSafeInt(b, 'b');
+  if (y < 1) fail('INVALID_NUMBER', 'divisor must be >= 1', { b: y });
+  let q = Math.floor(x / y);
+  while (q > 0 && q * y > x) q -= 1;
+  while ((q + 1) * y <= x) q += 1;
+  return { q, r: x - q * y };
+}
+
+/** ceil(a / b) for a >= 0, b >= 1, exact. */
+export function ceilDiv(a: number, b: number): number {
+  const { q, r } = divRem(a, b);
+  return r > 0 ? q + 1 : q;
+}
diff --git a/legion-progression-lab/src/core/rng/sample.ts b/legion-progression-lab/src/core/rng/sample.ts
new file mode 100644
index 0000000..4b6fff3
--- /dev/null
+++ b/legion-progression-lab/src/core/rng/sample.ts
@@ -0,0 +1,71 @@
+/**
+ * Sampling primitives (spec/formulas/rng.md v1).
+ *
+ * Bernoulli: one trial consumes exactly one draw u and succeeds iff u < T.
+ *   from basis points: T = floor(bp * 2^32 / 10000), exact;  from a probability p: T = floor(p * 2^32).
+ *   A non-zero probability below 2^-32 is refused (PROBABILITY_TOO_SMALL).
+ * uniformInt(lo, hi), inclusive: span = hi - lo + 1 <= 2^32; limit = span * floor(2^32 / span);
+ *   draw u; accept if u < limit and return lo + (u mod span); otherwise draw again. Guard: 1000 attempts.
+ */
+import { fail } from '../errors.ts';
+import { assertProbabilityBp, BP_SCALE } from '../numeric/basisPoints.ts';
+import { assertSafeInt, divRem, mulSafe, TWO_POW_32 } from '../numeric/safeInt.ts';
+import { nextU32, type RngState } from './xoshiro128ss.ts';
+
+export const MIN_NONZERO_PROBABILITY = 2 ** -32;
+export const UNIFORM_INT_GUARD = 1000;
+
+export function thresholdFromBp(bp: number): number {
+  let b: number;
+  try {
+    b = assertProbabilityBp(bp);
+  } catch {
+    return fail('INVALID_PROBABILITY', 'probability in bp must be an integer in [0, 10000]', { bp: String(bp) });
+  }
+  return divRem(mulSafe(b, TWO_POW_32), BP_SCALE).q;
+}
+
+export function thresholdFromProb(p: number): number {
+  if (typeof p !== 'number' || !Number.isFinite(p) || p < 0 || p > 1) {
+    fail('INVALID_PROBABILITY', 'probability must be a finite number in [0, 1]', { p: String(p) });
+  }
+  if (p > 0 && p < MIN_NONZERO_PROBABILITY) {
+    fail('PROBABILITY_TOO_SMALL', 'non-zero probability below 2^-32 cannot be represented', { p });
+  }
+  return Math.floor(p * TWO_POW_32);
+}
+
+function assertThreshold(threshold: number): number {
+  if (!Number.isInteger(threshold) || threshold < 0 || threshold > TWO_POW_32) {
+    fail('INVALID_PROBABILITY', 'threshold must be an integer in [0, 2^32]', { threshold });
+  }
+  return threshold;
+}
+
+export function bernoulli(state: RngState, threshold: number): [boolean, RngState] {
+  const t = assertThreshold(threshold);
+  const [u, next] = nextU32(state);
+  return [u < t, next];
+}
+
+export interface UniformIntResult {
+  readonly value: number;
+  readonly state: RngState;
+  readonly draws: number;
+}
+
+export function uniformInt(state: RngState, lo: number, hi: number): UniformIntResult {
+  const low = assertSafeInt(lo, 'lo');
+  const high = assertSafeInt(hi, 'hi');
+  if (low > high) fail('INVALID_RANGE', 'lo must be <= hi', { lo: low, hi: high });
+  const span = high - low + 1; // exact whenever it is <= 2^32; beyond that it is refused anyway
+  if (!(span <= TWO_POW_32)) fail('RANGE_TOO_LARGE', 'range size must be <= 2^32', { lo: low, hi: high });
+  const limit = divRem(TWO_POW_32, span).q * span;
+  let s = state;
+  for (let attempt = 1; attempt <= UNIFORM_INT_GUARD; attempt += 1) {
+    const [u, next] = nextU32(s);
+    s = next;
+    if (u < limit) return { value: low + (u % span), state: s, draws: attempt };
+  }
+  return fail('RNG_REJECTION_GUARD', `no acceptance in ${UNIFORM_INT_GUARD} attempts`, { lo: low, hi: high });
+}
diff --git a/legion-progression-lab/src/core/rng/streamId.ts b/legion-progression-lab/src/core/rng/streamId.ts
new file mode 100644
index 0000000..97b3fae
--- /dev/null
+++ b/legion-progression-lab/src/core/rng/streamId.ts
@@ -0,0 +1,84 @@
+/**
+ * Stream identity and state initialisation (spec/formulas/rng.md v1).
+ *
+ * Encoding: for each field in the order "legion.rng.v1", root, purpose, entity, counter, a 4-byte
+ * big-endian unsigned length followed by the field's UTF-8 bytes. counter is a safe integer >= 0 in
+ * canonical decimal. String fields must be non-empty, well-formed, and at most 1024 UTF-8 bytes.
+ * The length prefixes make the encoding injective.
+ *
+ * State: SHA-256 of the encoding; words = big-endian u32 of bytes 0..15. If all zero, bytes 16..31.
+ * If those are all zero too: RNG_ZERO_STATE.
+ */
+import { createHash } from 'node:crypto';
+import { fail } from '../errors.ts';
+import { assertNonNegativeSafeInt } from '../numeric/safeInt.ts';
+import type { RngState } from './xoshiro128ss.ts';
+
+export const RNG_DOMAIN = 'legion.rng.v1';
+export const MAX_FIELD_BYTES = 1024;
+
+export interface StreamId {
+  readonly root: string;
+  readonly purpose: string;
+  readonly entity: string;
+  readonly counter: number;
+}
+
+const LONE_SURROGATE = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
+const encoder = new TextEncoder();
+
+function fieldBytes(value: unknown, name: string): Uint8Array {
+  if (typeof value !== 'string' || value.length === 0 || LONE_SURROGATE.test(value)) {
+    fail('INVALID_STREAM_ID', `${name} must be a non-empty well-formed string`, { name });
+  }
+  const bytes = encoder.encode(value);
+  if (bytes.length > MAX_FIELD_BYTES) fail('INVALID_STREAM_ID', `${name} exceeds ${MAX_FIELD_BYTES} UTF-8 bytes`, { name });
+  return bytes;
+}
+
+export function encodeStreamId(id: StreamId): Uint8Array {
+  let counter: number;
+  try {
+    counter = assertNonNegativeSafeInt(id.counter, 'counter');
+  } catch {
+    return fail('INVALID_STREAM_ID', 'counter must be a safe integer >= 0', { counter: String(id.counter) });
+  }
+  const fields = [
+    encoder.encode(RNG_DOMAIN),
+    fieldBytes(id.root, 'root'),
+    fieldBytes(id.purpose, 'purpose'),
+    fieldBytes(id.entity, 'entity'),
+    encoder.encode(String(counter)),
+  ];
+  const total = fields.reduce((sum, f) => sum + 4 + f.length, 0);
+  const out = new Uint8Array(total);
+  const view = new DataView(out.buffer);
+  let offset = 0;
+  for (const f of fields) {
+    view.setUint32(offset, f.length, false);
+    out.set(f, offset + 4);
+    offset += 4 + f.length;
+  }
+  return out;
+}
+
+/** Applies the state rule to a 32-byte digest. Exported so the all-zero rule can be tested directly. */
+export function stateFromDigest(digest: Uint8Array): RngState {
+  if (digest.length !== 32) fail('INVALID_STATE', 'digest must be 32 bytes');
+  const view = new DataView(digest.buffer, digest.byteOffset, digest.byteLength);
+  for (const base of [0, 16]) {
+    const words: [number, number, number, number] = [
+      view.getUint32(base, false),
+      view.getUint32(base + 4, false),
+      view.getUint32(base + 8, false),
+      view.getUint32(base + 12, false),
+    ];
+    if (words.some((w) => w !== 0)) return words;
+  }
+  return fail('RNG_ZERO_STATE', 'both digest halves are zero');
+}
+
+export function deriveRngState(id: StreamId): RngState {
+  const digest = createHash('sha256').update(encodeStreamId(id)).digest();
+  return stateFromDigest(new Uint8Array(digest.buffer, digest.byteOffset, digest.byteLength));
+}
diff --git a/legion-progression-lab/src/core/rng/xoshiro128ss.ts b/legion-progression-lab/src/core/rng/xoshiro128ss.ts
new file mode 100644
index 0000000..59485b8
--- /dev/null
+++ b/legion-progression-lab/src/core/rng/xoshiro128ss.ts
@@ -0,0 +1,42 @@
+/**
+ * xoshiro128** 1.1 (Blackman and Vigna), 32-bit words. spec/formulas/rng.md v1.
+ *
+ *   result = rotl(s1 * 5, 7) * 9           (mod 2^32)
+ *   t = s1 << 9
+ *   s2 ^= s0; s3 ^= s1; s1 ^= s2; s0 ^= s3; s2 ^= t; s3 = rotl(s3, 11)
+ *
+ * Pure: the state is an immutable 4-tuple; nextU32 returns the value and the next state.
+ */
+import { fail } from '../errors.ts';
+
+export type RngState = readonly [number, number, number, number];
+
+function isU32(value: unknown): value is number {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 0 && value <= 0xffffffff;
+}
+
+export function assertRngState(state: unknown): RngState {
+  if (!Array.isArray(state) || state.length !== 4 || !state.every(isU32)) {
+    fail('INVALID_STATE', 'RNG state must be four unsigned 32-bit integers');
+  }
+  const [a, b, c, d] = state as [number, number, number, number];
+  if (a === 0 && b === 0 && c === 0 && d === 0) fail('RNG_ZERO_STATE', 'the all-zero state is not allowed');
+  return [a, b, c, d];
+}
+
+function rotl(x: number, k: number): number {
+  return ((x << k) | (x >>> (32 - k))) >>> 0;
+}
+
+export function nextU32(state: RngState): [number, RngState] {
+  const [s0, s1, s2, s3] = state;
+  const result = Math.imul(rotl(Math.imul(s1, 5) >>> 0, 7), 9) >>> 0;
+  const t = (s1 << 9) >>> 0;
+  let n2 = (s2 ^ s0) >>> 0;
+  let n3 = (s3 ^ s1) >>> 0;
+  const n1 = (s1 ^ n2) >>> 0;
+  const n0 = (s0 ^ n3) >>> 0;
+  n2 = (n2 ^ t) >>> 0;
+  n3 = rotl(n3, 11);
+  return [result, [n0, n1, n2, n3]];
+}
