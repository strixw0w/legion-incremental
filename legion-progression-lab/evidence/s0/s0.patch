+    { "id": "numeric.muldiv.001", "kind": "normal", "description": "Checked product then exact division", "input": { "op": "mulThenDiv", "a": 1000, "b": 3600000, "c": 7 }, "expected": { "result": 514285714 }, "derivation": "1000 * 3600000 = 3600000000; floor(3600000000 / 7) = 514285714 (remainder 2)" },
