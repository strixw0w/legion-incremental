@@ -0,0 +1,68 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { roundHalfUp } from '../src/core/numeric/rounding.ts';
+import { addSafe, divRem, MAX_SAFE, mulSafe } from '../src/core/numeric/safeInt.ts';
+import { MAX, refRoundHalfUp, safeIntArb } from './helpers/reference.ts';
+
+const OPTIONS = { seed: 20261113, numRuns: 3000 };
+const anySafe = safeIntArb(-MAX_SAFE, MAX_SAFE);
+
+function outcome(fn: () => number): bigint | string {
+  try {
+    return BigInt(fn());
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+}
+
+describe('safe-integer operations agree with exact BigInt arithmetic', () => {
+  it('addSafe: exact result, or NUMERIC_LIMIT exactly when out of range', () => {
+    fc.assert(
+      fc.property(anySafe, anySafe, (a, b) => {
+        const exact = BigInt(a) + BigInt(b);
+        const expected = exact > MAX || exact < -MAX ? 'NUMERIC_LIMIT' : exact;
+        expect(outcome(() => addSafe(a, b))).toBe(expected);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('mulSafe: exact result, or NUMERIC_LIMIT exactly when out of range', () => {
+    const near = fc.oneof(safeIntArb(-200_000_000, 200_000_000), anySafe);
+    fc.assert(
+      fc.property(near, near, (a, b) => {
+        const exact = BigInt(a) * BigInt(b);
+        const expected = exact > MAX || exact < -MAX ? 'NUMERIC_LIMIT' : exact;
+        expect(outcome(() => mulSafe(a, b))).toBe(expected);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('divRem is exact for every non-negative safe dividend', () => {
+    fc.assert(
+      fc.property(safeIntArb(0, MAX_SAFE), fc.oneof(safeIntArb(1, 1000), safeIntArb(1, MAX_SAFE)), (a, b) => {
+        const { q, r } = divRem(a, b);
+        expect(BigInt(q)).toBe(BigInt(a) / BigInt(b));
+        expect(BigInt(r)).toBe(BigInt(a) % BigInt(b));
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('roundHalfUp equals exact floor(x + 1/2) for any finite double in the safe range', () => {
+    const doubles = fc.oneof(
+      fc.double({ min: -(2 ** 53), max: 2 ** 53, noNaN: true, noDefaultInfinity: true }),
+      fc.double({ min: -10, max: 10, noNaN: true, noDefaultInfinity: true }),
+      safeIntArb(-1_000_000, 1_000_000).map((n) => n + 0.5),
+    );
+    fc.assert(
+      fc.property(doubles, (x) => {
+        expect(BigInt(roundHalfUp(x))).toBe(refRoundHalfUp(x));
+      }),
+      OPTIONS,
+    );
+  });
+});
diff --git a/legion-progression-lab/test/numeric.test.ts b/legion-progression-lab/test/numeric.test.ts
new file mode 100644
index 0000000..6029ad4
--- /dev/null
+++ b/legion-progression-lab/test/numeric.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { roundHalfUp, roundHalfUpToSafeInt } from '../src/core/numeric/rounding.ts';
+import { addSafe, ceilDiv, divRem, MAX_SAFE, mulSafe, subSafe, TWO_POW_52 } from '../src/core/numeric/safeInt.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+describe('safe integers', () => {
+  it('adds up to the limit and refuses one past it', () => {
+    expect(addSafe(MAX_SAFE - 1, 1)).toBe(MAX_SAFE);
+    expect(code(() => addSafe(MAX_SAFE, 1))).toBe('NUMERIC_LIMIT');
+    expect(code(() => subSafe(-MAX_SAFE, 1))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('refuses non-integers, NaN, Infinity and unsafe inputs', () => {
+    expect(code(() => addSafe(1.5, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => addSafe(Number.NaN, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => mulSafe(Number.POSITIVE_INFINITY, 1))).toBe('INVALID_NUMBER');
+    expect(code(() => addSafe(2 ** 53, 0))).toBe('INVALID_NUMBER');
+  });
+
+  it('normalises -0 to +0', () => {
+    expect(Object.is(addSafe(-0, 0), 0)).toBe(true);
+    expect(Object.is(mulSafe(-1, 0), 0)).toBe(true);
+  });
+
+  it('checks intermediate products, not only final results', () => {
+    // (2^52 * 4) / 8 would be 2^51, but the intermediate 2^54 is refused.
+    expect(code(() => divRem(mulSafe(TWO_POW_52, 4), 8))).toBe('NUMERIC_LIMIT');
+    expect(mulSafe(94_906_265, 94_906_265)).toBe(9_007_199_136_250_225);
+    expect(code(() => mulSafe(94_906_266, 94_906_266))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('divides exactly near 2^53 where floating division rounds', () => {
+    expect(divRem(MAX_SAFE, 3)).toEqual({ q: 3_002_399_751_580_330, r: 1 });
+    expect(divRem(MAX_SAFE - 1, MAX_SAFE)).toEqual({ q: 0, r: MAX_SAFE - 1 }); // a/b rounds to 1.0
+    expect(divRem(MAX_SAFE, MAX_SAFE - 1)).toEqual({ q: 1, r: 1 });
+    expect(divRem(0, 7)).toEqual({ q: 0, r: 0 });
+    expect(ceilDiv(15, 8)).toBe(2);
+    expect(code(() => divRem(5, 0))).toBe('INVALID_NUMBER');
+    expect(code(() => divRem(-1, 3))).toBe('INVALID_NUMBER');
+  });
+});
+
+describe('roundHalfUp', () => {
+  it('fixes both failure cases of floor(x + 0.5)', () => {
+    expect(Math.floor(0.49999999999999994 + 0.5)).toBe(1); // the naive bug, demonstrated
+    expect(roundHalfUp(0.49999999999999994)).toBe(0);
+    expect(Math.floor(TWO_POW_52 + 1 + 0.5)).toBe(TWO_POW_52 + 2); // the naive bug, demonstrated
+    expect(roundHalfUp(TWO_POW_52 + 1)).toBe(TWO_POW_52 + 1);
+  });
+
+  it('rounds halves up, including negatives', () => {
+    expect(roundHalfUp(2.5)).toBe(3);
+    expect(roundHalfUp(2.4999)).toBe(2);
+    expect(roundHalfUp(-2.5)).toBe(-2);
+    expect(roundHalfUp(TWO_POW_52 - 0.5)).toBe(TWO_POW_52);
+    expect(Object.is(roundHalfUp(-0.4), 0)).toBe(true);
+  });
+
+  it('refuses non-finite input and results beyond the safe range', () => {
+    expect(code(() => roundHalfUp(Number.NaN))).toBe('INVALID_NUMBER');
+    expect(roundHalfUpToSafeInt(MAX_SAFE)).toBe(MAX_SAFE);
+    expect(code(() => roundHalfUpToSafeInt(2 ** 53))).toBe('NUMERIC_LIMIT');
+  });
+});
diff --git a/legion-progression-lab/test/purity.test.ts b/legion-progression-lab/test/purity.test.ts
new file mode 100644
index 0000000..1c2713a
--- /dev/null
+++ b/legion-progression-lab/test/purity.test.ts
@@ -0,0 +1,62 @@
+/**
+ * The deterministic core must not touch the clock, ambient randomness, the process, timers or I/O.
+ * Scanned folders: src/core, src/spec, src/report (pure modules). src/cli is the only place for I/O.
+ */
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative, resolve, sep } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { LAB_ROOT } from '../src/cli/paths.ts';
+
+const PURE_DIRS = ['src/core', 'src/spec', 'src/report'];
+const ALLOWED_PACKAGES = new Set(['zod', 'node:crypto']);
+const FORBIDDEN: [RegExp, string][] = [
+  [/\bDate\b/, 'Date (clock)'],
+  [/Math\.random/, 'Math.random (ambient RNG)'],
+  [/\bprocess\b/, 'process'],
+  [/\bperformance\b/, 'performance (clock)'],
+  [/\bset(Timeout|Interval|Immediate)\b/, 'timers'],
+  [/\bcrypto\.(randomUUID|randomBytes|getRandomValues)\b/, 'crypto randomness'],
+];
+
+function files(dir: string): string[] {
+  return readdirSync(dir).flatMap((name) => {
+    const p = join(dir, name);
+    return statSync(p).isDirectory() ? files(p) : p.endsWith('.ts') ? [p] : [];
+  });
+}
+
+function stripComments(text: string): string {
+  return text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1');
+}
+
+function importSpecifiers(text: string): string[] {
+  const out: string[] = [];
+  for (const m of text.matchAll(/(?:import|export)\s+(?:type\s+)?[^'"]*?from\s+['"]([^'"]+)['"]/g)) out.push(m[1] ?? '');
+  for (const m of text.matchAll(/import\s*\(\s*['"]([^'"]+)['"]\s*\)/g)) out.push(m[1] ?? '');
+  for (const m of text.matchAll(/^\s*import\s+['"]([^'"]+)['"]/gm)) out.push(m[1] ?? '');
+  return out;
+}
+
+describe('purity of the deterministic core', () => {
+  const pureFiles = PURE_DIRS.flatMap((d) => files(resolve(LAB_ROOT, d)));
+
+  it('finds the pure modules', () => {
+    expect(pureFiles.length).toBeGreaterThanOrEqual(15);
+  });
+
+  for (const file of pureFiles) {
+    const rel = relative(LAB_ROOT, file).split(sep).join('/');
+    it(`${rel} uses no clock, ambient RNG, process, timers or I/O`, () => {
+      const code = stripComments(readFileSync(file, 'utf8'));
+      for (const [pattern, what] of FORBIDDEN) expect(pattern.test(code), `${rel} uses ${what}`).toBe(false);
+      for (const spec of importSpecifiers(code)) {
+        if (spec.startsWith('.')) {
+          const target = relative(LAB_ROOT, resolve(file, '..', spec)).split(sep).join('/');
+          expect(PURE_DIRS.some((d) => target.startsWith(`${d}/`)), `${rel} imports non-pure ${target}`).toBe(true);
+        } else {
+          expect(ALLOWED_PACKAGES.has(spec), `${rel} imports package ${spec}`).toBe(true);
+        }
+      }
+    });
+  }
+});
diff --git a/legion-progression-lab/test/remainder.property.test.ts b/legion-progression-lab/test/remainder.property.test.ts
new file mode 100644
index 0000000..60f90aa
--- /dev/null
+++ b/legion-progression-lab/test/remainder.property.test.ts
@@ -0,0 +1,73 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { accrue, accruePerHour, MAX_DEN, ZERO_PER_HOUR_STATE } from '../src/core/numeric/remainder.ts';
+import { MAX_SAFE } from '../src/core/numeric/safeInt.ts';
+import { MAX, refAccrue, safeIntArb } from './helpers/reference.ts';
+
+const OPTIONS = { seed: 20261113, numRuns: 2000 };
+
+describe('remainder accumulator properties', () => {
+  it('matches exact BigInt arithmetic for any valid inputs', () => {
+    const arb = safeIntArb(1, MAX_DEN).chain((den) =>
+      fc.tuple(fc.constant(den), safeIntArb(0, den - 1), fc.oneof(safeIntArb(0, 1_000_000), safeIntArb(0, MAX_SAFE)), fc.oneof(safeIntArb(0, 100_000_000), safeIntArb(0, MAX_SAFE))),
+    );
+    fc.assert(
+      fc.property(arb, ([den, rem, num, steps]) => {
+        const ref = refAccrue(rem, num, steps, den);
+        let got: { granted: number; rem: number } | string;
+        try {
+          got = accrue(rem, num, steps, den);
+        } catch (e) {
+          if (!(e instanceof LabError)) throw e;
+          got = e.code;
+        }
+        if (ref.granted > MAX) expect(got).toBe('NUMERIC_LIMIT');
+        else expect(got).toEqual({ granted: Number(ref.granted), rem: Number(ref.rem) });
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('G1: any partition of the steps gives the same total and remainder', () => {
+    const arb = safeIntArb(1, MAX_DEN).chain((den) =>
+      fc.tuple(fc.constant(den), safeIntArb(0, den - 1), safeIntArb(0, 10_000_000), fc.array(safeIntArb(0, 1_000_000_000), { minLength: 1, maxLength: 20 })),
+    );
+    fc.assert(
+      fc.property(arb, ([den, rem, num, parts]) => {
+        const total = parts.reduce((s, p) => s + p, 0);
+        // Only representable totals: overflow behaviour is covered by the BigInt comparison above.
+        fc.pre(refAccrue(rem, num, total, den).granted <= MAX);
+        const once = accrue(rem, num, total, den);
+        let r = rem;
+        let granted = 0;
+        for (const p of parts) {
+          const step = accrue(r, num, p, den);
+          granted += step.granted;
+          r = step.rem;
+        }
+        expect({ granted, rem: r }).toEqual(once);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('G1 for the per-hour chain: any partition of an interval gives the same result', () => {
+    const arb = fc.tuple(safeIntArb(0, 10_000_000_000), fc.array(safeIntArb(0, 300_000_000), { minLength: 1, maxLength: 25 }));
+    fc.assert(
+      fc.property(arb, ([rate, parts]) => {
+        const total = parts.reduce((s, p) => s + p, 0);
+        const once = accruePerHour(ZERO_PER_HOUR_STATE, rate, total);
+        let state = ZERO_PER_HOUR_STATE;
+        let granted = 0;
+        for (const p of parts) {
+          const r = accruePerHour(state, rate, p);
+          granted += r.granted;
+          state = r.state;
+        }
+        expect({ granted, state }).toEqual(once);
+      }),
+      OPTIONS,
+    );
+  });
+});
diff --git a/legion-progression-lab/test/remainder.test.ts b/legion-progression-lab/test/remainder.test.ts
new file mode 100644
index 0000000..763056f
--- /dev/null
+++ b/legion-progression-lab/test/remainder.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { accrue, accruePerHour, MAX_DEN, ZERO_PER_HOUR_STATE, type PerHourState } from '../src/core/numeric/remainder.ts';
+import { MAX_SAFE } from '../src/core/numeric/safeInt.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+function runPerHour(rate: number, parts: number[], start: PerHourState = ZERO_PER_HOUR_STATE): { granted: number; state: PerHourState } {
+  let state = start;
+  let granted = 0;
+  for (const p of parts) {
+    const r = accruePerHour(state, rate, p);
+    granted += r.granted;
+    state = r.state;
+  }
+  return { granted, state };
+}
+
+describe('exact remainder accumulator', () => {
+  it('splitting an interval never changes the total or the remainder (G1)', () => {
+    const whole = accrue(0, 3, 10, 7);
+    let rem = 0;
+    let granted = 0;
+    for (const part of [3, 0, 4, 2, 1]) {
+      const r = accrue(rem, 3, part, 7);
+      granted += r.granted;
+      rem = r.rem;
+    }
+    expect({ granted, rem }).toEqual(whole);
+    expect(whole).toEqual({ granted: 4, rem: 2 });
+  });
+
+  it('a zero-duration interval changes nothing (G2)', () => {
+    expect(accrue(5, 3, 0, 7)).toEqual({ granted: 0, rem: 5 });
+    expect(accruePerHour({ msRem: 123, milliRem: 456 }, 999, 0)).toEqual({ granted: 0, state: { msRem: 123, milliRem: 456 } });
+  });
+
+  it('per-hour chain: one hour at 1.5 units/hour, split three different ways', () => {
+    const expected = { granted: 1, state: { msRem: 0, milliRem: 500 } };
+    expect(runPerHour(1500, [3_600_000])).toEqual(expected);
+    expect(runPerHour(1500, [1, 3_599_999])).toEqual(expected);
+    expect(runPerHour(1500, Array.from({ length: 3600 }, () => 1000))).toEqual(expected);
+  });
+
+  it('settling every millisecond equals settling once (no gain from frequent rejoining)', () => {
+    const rate = 7_777; // 7.777 units per hour
+    const once = runPerHour(rate, [600_000]);
+    const everyMs = runPerHour(rate, Array.from({ length: 600_000 }, () => 1));
+    expect(everyMs).toEqual(once);
+  });
+
+  it('persisted remainders survive a save/load round trip and complete later units', () => {
+    const first = runPerHour(1500, [1_800_000]); // 750 milli, not yet a unit
+    const saved = JSON.parse(JSON.stringify(first.state)) as PerHourState;
+    const second = runPerHour(1500, [1_800_000], saved);
+    expect(first.granted + second.granted).toBe(runPerHour(1500, [3_600_000]).granted);
+    expect(second.state).toEqual(runPerHour(1500, [3_600_000]).state);
+  });
+
+  it('assignment switching: separate keys never leak into each other', () => {
+    // Two streams accrue into separate remainders; interleaving does not change either total.
+    let a = ZERO_PER_HOUR_STATE;
+    let b = ZERO_PER_HOUR_STATE;
+    let ga = 0;
+    let gb = 0;
+    for (let i = 0; i < 10; i += 1) {
+      const ra = accruePerHour(a, 1234, 360_000);
+      a = ra.state;
+      ga += ra.granted;
+      const rb = accruePerHour(b, 4321, 360_000);
+      b = rb.state;
+      gb += rb.granted;
+    }
+    expect({ granted: ga, state: a }).toEqual(runPerHour(1234, [3_600_000]));
+    expect({ granted: gb, state: b }).toEqual(runPerHour(4321, [3_600_000]));
+  });
+
+  it('large balances: results near 2^53 are exact and beyond it are refused', () => {
+    expect(accrue(0, MAX_DEN - 1, MAX_SAFE, MAX_DEN)).toEqual({ granted: 9_007_199_120_523_263, rem: 1 });
+    expect(accrue(0, 1, MAX_SAFE, 1)).toEqual({ granted: MAX_SAFE, rem: 0 });
+    expect(code(() => accrue(0, 2, MAX_SAFE, 1))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('refuses invalid parameters', () => {
+    expect(code(() => accrue(0, 1, 1, MAX_DEN + 1))).toBe('INVALID_DENOMINATOR');
+    expect(code(() => accrue(0, 1, 1, 0))).toBe('INVALID_DENOMINATOR');
+    expect(code(() => accrue(7, 1, 1, 7))).toBe('INVALID_STATE');
+    expect(code(() => accrue(0, -1, 1, 7))).toBe('INVALID_NUMBER');
+    expect(code(() => accrue(0, 1, 1.5, 7))).toBe('INVALID_NUMBER');
+  });
+});
diff --git a/legion-progression-lab/test/rng.test.ts b/legion-progression-lab/test/rng.test.ts
new file mode 100644
index 0000000..d730515
--- /dev/null
+++ b/legion-progression-lab/test/rng.test.ts
@@ -0,0 +1,136 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { deriveRngState, encodeStreamId, stateFromDigest, type StreamId } from '../src/core/rng/streamId.ts';
+import { bernoulli, thresholdFromBp, thresholdFromProb, uniformInt } from '../src/core/rng/sample.ts';
+import { assertRngState, nextU32, type RngState } from '../src/core/rng/xoshiro128ss.ts';
+import { safeIntArb } from './helpers/reference.ts';
+
+const OPTIONS = { seed: 20261113, numRuns: 1000 };
+const ID: StreamId = { root: 'fixture-a', purpose: 'combat.crit', entity: 'hero', counter: 0 };
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+function take(state: RngState, n: number): number[] {
+  const out: number[] = [];
+  let s = state;
+  for (let i = 0; i < n; i += 1) {
+    const [v, next] = nextU32(s);
+    out.push(v);
+    s = next;
+  }
+  return out;
+}
+
+const field = fc.string({ minLength: 1, maxLength: 12, unit: 'grapheme-ascii' });
+
+describe('stream identity', () => {
+  it('is injective: different field tuples never share an encoding', () => {
+    fc.assert(
+      fc.property(field, field, field, field, (a, b, c, d) => {
+        const x = encodeStreamId({ root: 'r', purpose: a, entity: b, counter: 0 });
+        const y = encodeStreamId({ root: 'r', purpose: c, entity: d, counter: 0 });
+        const same = a === c && b === d;
+        expect(Buffer.from(x).equals(Buffer.from(y))).toBe(same);
+      }),
+      OPTIONS,
+    );
+    // The classic concatenation collision is avoided by length prefixes:
+    const ab = encodeStreamId({ root: 'r', purpose: 'ab', entity: 'c', counter: 0 });
+    const a = encodeStreamId({ root: 'r', purpose: 'a', entity: 'bc', counter: 0 });
+    expect(Buffer.from(ab).equals(Buffer.from(a))).toBe(false);
+  });
+
+  it('refuses empty, oversized, ill-formed or badly counted identities', () => {
+    expect(code(() => encodeStreamId({ ...ID, purpose: '' }))).toBe('INVALID_STREAM_ID');
+    expect(code(() => encodeStreamId({ ...ID, entity: 'x'.repeat(1025) }))).toBe('INVALID_STREAM_ID');
+    expect(encodeStreamId({ ...ID, entity: 'x'.repeat(1024) }).length).toBeGreaterThan(1024);
+    expect(code(() => encodeStreamId({ ...ID, entity: '\ud800' }))).toBe('INVALID_STREAM_ID');
+    expect(code(() => encodeStreamId({ ...ID, counter: -1 }))).toBe('INVALID_STREAM_ID');
+    expect(code(() => encodeStreamId({ ...ID, counter: 2 ** 53 }))).toBe('INVALID_STREAM_ID');
+  });
+
+  it('never yields the all-zero state, and applies the fallback rule exactly', () => {
+    const zero = new Uint8Array(32);
+    expect(code(() => stateFromDigest(zero))).toBe('RNG_ZERO_STATE');
+    const second = new Uint8Array(32);
+    second[31] = 1;
+    expect(stateFromDigest(second)).toEqual([0, 0, 0, 1]);
+    expect(code(() => assertRngState([0, 0, 0, 0]))).toBe('RNG_ZERO_STATE');
+    fc.assert(
+      fc.property(safeIntArb(0, 1_000_000), (counter) => {
+        const s = deriveRngState({ ...ID, counter });
+        expect(s.some((w) => w !== 0)).toBe(true);
+      }),
+      { seed: 20261113, numRuns: 200 },
+    );
+  });
+});
+
+describe('generator and sampling', () => {
+  it('replays exactly: the same stream gives the same sequence', () => {
+    expect(take(deriveRngState(ID), 32)).toEqual(take(deriveRngState(ID), 32));
+    expect(take(deriveRngState(ID), 8)).not.toEqual(take(deriveRngState({ ...ID, counter: 1 }), 8));
+  });
+
+  it('produces unsigned 32-bit integers and never reaches the zero state', () => {
+    let s = deriveRngState(ID);
+    for (let i = 0; i < 10_000; i += 1) {
+      const [v, next] = nextU32(s);
+      expect(Number.isInteger(v) && v >= 0 && v <= 0xffffffff).toBe(true);
+      expect(next.some((w) => w !== 0)).toBe(true);
+      s = next;
+    }
+  });
+
+  it('Bernoulli always consumes exactly one draw, including p = 0 and p = 1', () => {
+    const s = deriveRngState(ID);
+    const [, afterOne] = nextU32(s);
+    expect(bernoulli(s, 0)[1]).toEqual(afterOne);
+    expect(bernoulli(s, 2 ** 32)[1]).toEqual(afterOne);
+    expect(bernoulli(s, 0)[0]).toBe(false);
+    expect(bernoulli(s, 2 ** 32)[0]).toBe(true);
+  });
+
+  it('computes thresholds exactly and refuses unrepresentable probabilities', () => {
+    expect(thresholdFromBp(5000)).toBe(2 ** 31);
+    expect(thresholdFromBp(1)).toBe(429_496);
+    expect(thresholdFromBp(10_000)).toBe(2 ** 32);
+    expect(thresholdFromProb(2 ** -32)).toBe(1);
+    expect(code(() => thresholdFromProb(1e-12))).toBe('PROBABILITY_TOO_SMALL');
+    expect(code(() => thresholdFromBp(10_001))).toBe('INVALID_PROBABILITY');
+    expect(code(() => thresholdFromProb(Number.NaN))).toBe('INVALID_PROBABILITY');
+  });
+
+  it('uniformInt stays inside [lo, hi] and reports how many draws it used', () => {
+    const range = safeIntArb(-1_000_000, 1_000_000).chain((lo) => fc.tuple(fc.constant(lo), safeIntArb(lo, lo + 4_294_967_295)));
+    fc.assert(
+      fc.property(range, safeIntArb(0, 1_000_000), ([lo, hi], counter) => {
+        const r = uniformInt(deriveRngState({ ...ID, counter }), lo, hi);
+        expect(r.value >= lo && r.value <= hi).toBe(true);
+        expect(r.draws >= 1).toBe(true);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('uniformInt boundary behaviour: span 1, span 2^32, refusals', () => {
+    const s = deriveRngState(ID);
+    const one = uniformInt(s, 9, 9);
+    expect(one).toEqual({ value: 9, state: nextU32(s)[1], draws: 1 });
+    const full = uniformInt(s, 0, 4_294_967_295);
+    expect(full.value).toBe(nextU32(s)[0]);
+    expect(full.draws).toBe(1);
+    expect(code(() => uniformInt(s, 5, 4))).toBe('INVALID_RANGE');
+    expect(code(() => uniformInt(s, 0, 4_294_967_296))).toBe('RANGE_TOO_LARGE');
+    expect(code(() => uniformInt(s, 0.5, 4))).toBe('INVALID_NUMBER');
+  });
+});
