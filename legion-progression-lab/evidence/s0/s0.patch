+{
+  "fixtureSet": "remainder",
+  "fixtureVersion": 1,
+  "specRef": "spec/formulas/remainder.md#v1",
+  "status": "candidate",
+  "independence": "Expected values derived by hand from spec/formulas/remainder.md; re-checked with unbounded Python integers by spec/oracle/exact_oracle.py.",
+  "cases": [
+    { "id": "remainder.accrue.001", "kind": "normal", "description": "Simple accrual with remainder", "input": { "op": "accrue", "rem": 0, "num": 3, "steps": 10, "den": 7 }, "expected": { "granted": 4, "rem": 2 }, "derivation": "0 + 3*10 = 30; 30 = 4*7 + 2" },
+    { "id": "remainder.accrue.zero-steps.001", "kind": "boundary", "description": "Zero duration changes nothing (G2)", "input": { "op": "accrue", "rem": 5, "num": 3, "steps": 0, "den": 7 }, "expected": { "granted": 0, "rem": 5 }, "derivation": "5 + 0 = 5 < 7" },
+    { "id": "remainder.split.001", "kind": "normal", "description": "Same interval split five ways gives the same result (G1)", "input": { "op": "accrueSplit", "rem": 0, "num": 3, "den": 7, "parts": [3, 0, 4, 2, 1] }, "expected": { "granted": 4, "rem": 2 }, "derivation": "9 -> 1 r2; +0 -> r2; 2+12=14 -> 2 r0; 0+6=6 -> 0 r6; 6+3=9 -> 1 r2; total 4 r2 = single call (0+30 = 4*7+2)" },
+    { "id": "remainder.efficiency.001", "kind": "normal", "description": "60% efficiency on 7 kills", "input": { "op": "accrue", "rem": 0, "num": 6000, "steps": 7, "den": 10000 }, "expected": { "granted": 4, "rem": 2000 }, "derivation": "6000*7 = 42000 = 4*10000 + 2000" },
+    { "id": "remainder.efficiency.split.001", "kind": "normal", "description": "60% efficiency on 3 then 4 kills equals 7 at once", "input": { "op": "accrueSplit", "rem": 0, "num": 6000, "den": 10000, "parts": [3, 4] }, "expected": { "granted": 4, "rem": 2000 }, "derivation": "18000 -> 1 r8000; 8000+24000=32000 -> 3 r2000; total 4 r2000" },
+    { "id": "remainder.accrue.huge-product.001", "kind": "boundary", "description": "num*steps is about 2^79 but is never formed; result exact", "input": { "op": "accrue", "rem": 0, "num": 67108863, "steps": 9007199254740991, "den": 67108864 }, "expected": { "granted": 9007199120523263, "rem": 1 }, "derivation": "(2^26-1)(2^53-1) = 2^79 - 2^53 - 2^26 + 1; divided by 2^26: 2^53 - 2^27 - 1 remainder 1" },
+    { "id": "remainder.accrue.max-den.001", "kind": "boundary", "description": "Largest allowed denominator 2^26", "input": { "op": "accrue", "rem": 67108863, "num": 1, "steps": 1, "den": 67108864 }, "expected": { "granted": 1, "rem": 0 }, "derivation": "(2^26 - 1) + 1 = 2^26 -> 1 r0" },
+    { "id": "remainder.accrue.overflow.001", "kind": "failure", "description": "Granted amount beyond 2^53 - 1", "input": { "op": "accrue", "rem": 0, "num": 134217728, "steps": 9007199254740991, "den": 67108864 }, "expectedError": "NUMERIC_LIMIT", "derivation": "granted = 2*(2^53 - 1) > 2^53 - 1" },
+    { "id": "remainder.accrue.den-too-large.001", "kind": "failure", "description": "Denominator above 2^26", "input": { "op": "accrue", "rem": 0, "num": 1, "steps": 1, "den": 67108865 }, "expectedError": "INVALID_DENOMINATOR", "derivation": "den must be <= 2^26 = 67108864" },
+    { "id": "remainder.accrue.den-zero.001", "kind": "failure", "description": "Zero denominator", "input": { "op": "accrue", "rem": 0, "num": 1, "steps": 1, "den": 0 }, "expectedError": "INVALID_DENOMINATOR", "derivation": "den must be >= 1" },
+    { "id": "remainder.accrue.bad-rem.001", "kind": "failure", "description": "Remainder not below the denominator", "input": { "op": "accrue", "rem": 7, "num": 1, "steps": 1, "den": 7 }, "expectedError": "INVALID_STATE", "derivation": "rem must be in [0, den)" },
+    { "id": "remainder.accrue.negative.001", "kind": "failure", "description": "Negative numerator", "input": { "op": "accrue", "rem": 0, "num": -1, "steps": 1, "den": 7 }, "expectedError": "INVALID_NUMBER", "derivation": "num must be >= 0" },
+    { "id": "remainder.perhour.001", "kind": "normal", "description": "1.5 units per hour for one hour", "input": { "op": "perHour", "state": { "msRem": 0, "milliRem": 0 }, "rateMilliPerHour": 1500, "parts": [3600000] }, "expected": { "granted": 1, "state": { "msRem": 0, "milliRem": 500 } }, "derivation": "stage 1: 1500*3600000/3600000 = 1500 milli r0; stage 2: 1500 milli = 1 unit r500" },
+    { "id": "remainder.perhour.split.001", "kind": "normal", "description": "Same hour split as 1 ms + the rest", "input": { "op": "perHour", "state": { "msRem": 0, "milliRem": 0 }, "rateMilliPerHour": 1500, "parts": [1, 3599999] }, "expected": { "granted": 1, "state": { "msRem": 0, "milliRem": 500 } }, "derivation": "1500*1 = 1500 -> 0 r1500; 1500 + 1500*3599999 = 5400000000 -> 1500 milli r0; 1500 milli -> 1 r500" },
+    { "id": "remainder.perhour.split.002", "kind": "normal", "description": "Same hour split in halves", "input": { "op": "perHour", "state": { "msRem": 0, "milliRem": 0 }, "rateMilliPerHour": 1500, "parts": [1800000, 1800000] }, "expected": { "granted": 1, "state": { "msRem": 0, "milliRem": 500 } }, "derivation": "each half: 750 milli r0; 750 -> 0 r750; then 750+750 = 1500 -> 1 r500" },
+    { "id": "remainder.perhour.tiny.001", "kind": "boundary", "description": "Very small rate keeps both remainders", "input": { "op": "perHour", "state": { "msRem": 0, "milliRem": 0 }, "rateMilliPerHour": 1, "parts": [7200001] }, "expected": { "granted": 0, "state": { "msRem": 1, "milliRem": 2 } }, "derivation": "1*7200001 = 2*3600000 + 1 -> 2 milli r1; 2 milli -> 0 units r2" },
+    { "id": "remainder.perhour.persisted.001", "kind": "boundary", "description": "Persisted remainders from an earlier settlement complete a unit", "input": { "op": "perHour", "state": { "msRem": 1, "milliRem": 999 }, "rateMilliPerHour": 1, "parts": [3599999] }, "expected": { "granted": 1, "state": { "msRem": 0, "milliRem": 0 } }, "derivation": "1 + 3599999 = 3600000 -> 1 milli r0; 999 + 1 = 1000 -> 1 unit r0" },
+    { "id": "remainder.perhour.large.001", "kind": "boundary", "description": "Large rate: 3.6 million units per hour for one hour", "input": { "op": "perHour", "state": { "msRem": 0, "milliRem": 0 }, "rateMilliPerHour": 3600000000, "parts": [3600000] }, "expected": { "granted": 3600000, "state": { "msRem": 0, "milliRem": 0 } }, "derivation": "num = 1000*den exactly -> 3600000000 milli r0 -> 3600000 units r0" }
+  ]
+}
