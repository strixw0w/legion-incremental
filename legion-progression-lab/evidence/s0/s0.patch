new file mode 100644
index 0000000..d719248
--- /dev/null
+++ b/legion-progression-lab/src/cli/build-xp-table.ts
@@ -0,0 +1,43 @@
+/**
+ * Builds the integer XP table artifact from the content pack's candidate curve.
+ *   node src/cli/build-xp-table.ts [pack] [--update-pack]
+ * The artifact must then pass `npm run oracle:check` (independent decimal oracle) before use.
+ */
+import { resolve } from 'node:path';
+import { buildXpTable, type XpCurve } from '../core/formulas/xp.ts';
+import { fingerprint } from '../core/hash/canonicalJson.ts';
+import { ContentPackS0Schema, XpTableArtifactSchema } from '../core/content/schema.ts';
+import { DEFAULT_PACK, LAB_ROOT, prettyJson, readJson, repoRelative, writeText } from './paths.ts';
+
+const args = process.argv.slice(2);
+const packPath = resolve(LAB_ROOT, args.find((a) => !a.startsWith('--')) ?? DEFAULT_PACK);
+const packJson = readJson(packPath) as Record<string, unknown>;
+const pack = ContentPackS0Schema.parse(packJson);
+
+const curve: XpCurve = { family: 'powerGeometric', a: pack.xp.curve.a.value, p: pack.xp.curve.p.value, g: pack.xp.curve.g.value };
+const artifact = XpTableArtifactSchema.parse({
+  artifact: 'xp-table',
+  artifactVersion: 1,
+  formulaVersion: 1,
+  contentId: pack.contentId,
+  label: 'candidate',
+  curve,
+  rounding: 'roundHalfUp',
+  indexing: 'thresholds[i] = EXP from level i+1 to level i+2',
+  thresholds: buildXpTable(curve, pack.xp.tableLength.value),
+});
+
+const tablePath = resolve(LAB_ROOT, pack.xp.table.path);
+writeText(tablePath, prettyJson(artifact));
+const hash = fingerprint(artifact);
+console.log(`wrote ${repoRelative(tablePath)} (${artifact.thresholds.length} thresholds)`);
+console.log(`artifact fingerprint ${hash}`);
+
+if (args.includes('--update-pack')) {
+  const xp = packJson['xp'] as Record<string, unknown>;
+  (xp['table'] as Record<string, unknown>)['sha256'] = hash;
+  writeText(packPath, prettyJson(packJson));
+  console.log(`updated xp.table.sha256 in ${repoRelative(packPath)}`);
+} else if (pack.xp.table.sha256 !== hash) {
+  console.log('NOTE: the content pack records a different table hash; rerun with --update-pack after review.');
+}
diff --git a/legion-progression-lab/src/cli/curve-preview.ts b/legion-progression-lab/src/cli/curve-preview.ts
new file mode 100644
index 0000000..1c8cc74
--- /dev/null
+++ b/legion-progression-lab/src/cli/curve-preview.ts
@@ -0,0 +1,48 @@
+/**
+ * S0-R01 candidate EXP curve inspection report.
+ *   node src/cli/curve-preview.ts [pack]
+ * Writes results/s0/S0-R01-curve-preview/{semantic.json, environment.json, report.md, fingerprint.txt}.
+ * Only semantic.json is fingerprinted; environment.json holds machine/runtime/time metadata.
+ */
+import { execFileSync } from 'node:child_process';
+import { resolve } from 'node:path';
+import { fingerprint } from '../core/hash/canonicalJson.ts';
+import { validateContentPack } from '../core/content/validate.ts';
+import { buildCurvePreview, renderCurvePreviewMarkdown } from '../report/curvePreview.ts';
+import { DEFAULT_PACK, LAB_ROOT, prettyJson, readJson, repoRelative, writeText } from './paths.ts';
+
+const packPath = resolve(LAB_ROOT, process.argv[2] ?? DEFAULT_PACK);
+const packJson = readJson(packPath) as { xp?: { table?: { path?: string } } };
+const tablePath = resolve(LAB_ROOT, packJson.xp?.table?.path ?? '');
+const content = validateContentPack(packJson, readJson(tablePath));
+
+const semantic = buildCurvePreview(content);
+const fp = fingerprint(semantic);
+
+function gitState(): { commit: string; dirty: boolean } | 'unavailable' {
+  try {
+    const commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: LAB_ROOT, encoding: 'utf8' }).trim();
+    const dirty = execFileSync('git', ['status', '--porcelain'], { cwd: LAB_ROOT, encoding: 'utf8' }).trim().length > 0;
+    return { commit, dirty };
+  } catch {
+    return 'unavailable';
+  }
+}
+
+const environment = {
+  note: 'Environment metadata. Recorded, never fingerprinted.',
+  node: process.version,
+  platform: process.platform,
+  arch: process.arch,
+  generatedAt: new Date().toISOString(),
+  git: gitState(),
+  inputs: { pack: repoRelative(packPath), table: repoRelative(tablePath) },
+};
+
+const outDir = resolve(LAB_ROOT, 'results', 's0', 'S0-R01-curve-preview');
+writeText(resolve(outDir, 'semantic.json'), prettyJson(semantic));
+writeText(resolve(outDir, 'environment.json'), prettyJson(environment));
+writeText(resolve(outDir, 'report.md'), renderCurvePreviewMarkdown(semantic, fp));
+writeText(resolve(outDir, 'fingerprint.txt'), `${fp}\n`);
+console.log(`S0-R01 semantic fingerprint ${fp}`);
+console.log(`wrote ${repoRelative(outDir)}/{semantic.json, environment.json, report.md, fingerprint.txt}`);
diff --git a/legion-progression-lab/src/cli/export-schemas.ts b/legion-progression-lab/src/cli/export-schemas.ts
new file mode 100644
index 0000000..54017fe
--- /dev/null
+++ b/legion-progression-lab/src/cli/export-schemas.ts
@@ -0,0 +1,30 @@
+/**
+ * Exports JSON Schemas from the zod source of truth into spec/schema/.
+ *   node src/cli/export-schemas.ts          write the files
+ *   node src/cli/export-schemas.ts --check  fail if the committed files differ
+ * Note: zod refinements (for example "safe integer" or "range") are not representable in JSON Schema and
+ * are therefore absent from the exported files; the zod schemas remain authoritative.
+ */
+import { existsSync, readFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { schemaFiles } from '../spec/exportedSchemas.ts';
+import { prettyJson, repoRelative, SPEC_ROOT, writeText } from './paths.ts';
+
+const check = process.argv.includes('--check');
+let drift = 0;
+for (const [name, schema] of Object.entries(schemaFiles())) {
+  const path = resolve(SPEC_ROOT, 'schema', name);
+  const text = prettyJson(schema);
+  if (check) {
+    const same = existsSync(path) && readFileSync(path, 'utf8') === text;
+    console.log(`${same ? 'OK   ' : 'DRIFT'} ${repoRelative(path)}`);
+    if (!same) drift += 1;
+  } else {
+    writeText(path, text);
+    console.log(`wrote ${repoRelative(path)}`);
+  }
+}
+if (drift > 0) {
+  console.error(`${drift} schema file(s) differ from the zod source; run npm run schemas:export`);
+  process.exit(1);
+}
diff --git a/legion-progression-lab/src/cli/fixtures-check.ts b/legion-progression-lab/src/cli/fixtures-check.ts
new file mode 100644
index 0000000..c9a43d6
--- /dev/null
+++ b/legion-progression-lab/src/cli/fixtures-check.ts
@@ -0,0 +1,48 @@
+/**
+ * Validates every spec/fixtures/*.json file and runs each case through the lab.
+ *   node src/cli/fixtures-check.ts
+ * Fails on: schema violations, duplicate case IDs, a family without boundary or failure cases, any mismatch.
+ */
+import { resolve } from 'node:path';
+import { FixtureFileSchema } from '../spec/fixtureSchema.ts';
+import { runFixtureCase } from '../spec/fixtureRunner.ts';
+import { listJson, readJson, repoRelative, SPEC_ROOT } from './paths.ts';
+
+let failures = 0;
+const ids = new Set<string>();
+const rows: string[] = [];
+for (const path of listJson(resolve(SPEC_ROOT, 'fixtures'))) {
+  const parsed = FixtureFileSchema.safeParse(readJson(path));
+  if (!parsed.success) {
+    console.error(`SCHEMA ${repoRelative(path)}: ${parsed.error.message}`);
+    failures += 1;
+    continue;
+  }
+  const file = parsed.data;
+  const kinds = { normal: 0, boundary: 0, failure: 0 };
+  let passed = 0;
+  for (const c of file.cases) {
+    if (ids.has(c.id)) {
+      console.error(`DUPLICATE case id ${c.id}`);
+      failures += 1;
+    }
+    ids.add(c.id);
+    kinds[c.kind] += 1;
+    const outcome = runFixtureCase(file.fixtureSet, c);
+    if (outcome.passed) passed += 1;
+    else {
+      failures += 1;
+      console.error(`FAIL ${c.id}: ${outcome.detail}`);
+    }
+  }
+  if (kinds.boundary === 0 || kinds.failure === 0) {
+    console.error(`COVERAGE ${file.fixtureSet}: needs at least one boundary and one failure case`);
+    failures += 1;
+  }
+  rows.push(`| ${file.fixtureSet} | ${repoRelative(path)} | ${file.cases.length} | ${kinds.normal} | ${kinds.boundary} | ${kinds.failure} | ${passed} |`);
+}
+console.log('| Family | File | Cases | Normal | Boundary | Failure | Passed |');
+console.log('|---|---|---|---|---|---|---|');
+for (const r of rows) console.log(r);
+console.log(`total cases: ${ids.size}; problems: ${failures}`);
+if (failures > 0) process.exit(1);
diff --git a/legion-progression-lab/src/cli/paths.ts b/legion-progression-lab/src/cli/paths.ts
new file mode 100644
index 0000000..40d4eea
--- /dev/null
+++ b/legion-progression-lab/src/cli/paths.ts
@@ -0,0 +1,34 @@
+/** File-system helpers for the command-line entry points. All I/O in the lab lives under src/cli. */
+import { mkdirSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, relative, resolve, sep } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export const LAB_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+export const REPO_ROOT = resolve(LAB_ROOT, '..');
+export const SPEC_ROOT = resolve(REPO_ROOT, 'spec');
+export const DEFAULT_PACK = 'content/s0-core.candidate.v0.1.0.json';
+
+/** Repository-relative path with forward slashes (never an absolute path in semantic output). */
+export function repoRelative(path: string): string {
+  return relative(REPO_ROOT, path).split(sep).join('/');
+}
+
+export function readJson(path: string): unknown {
+  return JSON.parse(readFileSync(path, 'utf8')) as unknown;
+}
+
+export function writeText(path: string, text: string): void {
+  mkdirSync(dirname(path), { recursive: true });
+  writeFileSync(path, text, 'utf8');
+}
+
+export function prettyJson(value: unknown): string {
+  return `${JSON.stringify(value, null, 2)}\n`;
+}
+
+export function listJson(dir: string): string[] {
+  return readdirSync(dir)
+    .filter((f) => f.endsWith('.json'))
+    .sort()
+    .map((f) => resolve(dir, f));
+}
diff --git a/legion-progression-lab/src/core/content/labels.ts b/legion-progression-lab/src/core/content/labels.ts
new file mode 100644
index 0000000..5c9e0c7
--- /dev/null
+++ b/legion-progression-lab/src/core/content/labels.ts
@@ -0,0 +1,22 @@
+/**
+ * Value labels (architecture v1.1 section 7). Adapted, as an idea only, from the frozen lab's
+ * provenance labels (see PROVENANCE.md): a result is never more trustworthy than its weakest input.
+ */
+export const VALUE_LABELS = ['approved', 'target', 'candidate', 'derived'] as const;
+export type ValueLabel = (typeof VALUE_LABELS)[number];
+
+/** Strength order: approved > target > derived > candidate. A derived value takes the weakest input label. */
+const STRENGTH: Record<ValueLabel, number> = { approved: 3, target: 2, derived: 1, candidate: 0 };
+
+export interface Labelled<T> {
+  readonly value: T;
+  readonly label: ValueLabel;
+  readonly range?: readonly [number, number];
+  readonly hypothesis?: string;
+  readonly note?: string;
+}
+
+export function weakestLabel(...labels: ValueLabel[]): ValueLabel {
+  if (labels.length === 0) return 'candidate';
+  return labels.reduce((weakest, l) => (STRENGTH[l] < STRENGTH[weakest] ? l : weakest));
+}
diff --git a/legion-progression-lab/src/core/content/schema.ts b/legion-progression-lab/src/core/content/schema.ts
new file mode 100644
index 0000000..89184ab
--- /dev/null
+++ b/legion-progression-lab/src/core/content/schema.ts
@@ -0,0 +1,101 @@
+/**
+ * Content schemas for S0 (spec/formulas/units.md; architecture v1.1 section 7).
+ * zod is the source of truth; JSON Schemas in spec/schema/ are exported from these (npm run schemas:export).
+ */
+import { z } from 'zod';
+import { VALUE_LABELS } from './labels.ts';
+
+export const StableIdSchema = z.string().regex(/^[a-z][a-z0-9_]*(\.[a-z0-9_]+)+$/, 'stable IDs are lowercase dotted, e.g. cat.damage.additive');
+export const SemVerSchema = z.string().regex(/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$/);
+export const Sha256HexSchema = z.string().regex(/^[0-9a-f]{64}$/);
+export const SafeIntSchema = z.number().int().refine((v) => Number.isSafeInteger(v), 'must be a safe integer');
+export const BpSchema = SafeIntSchema.refine((v) => v >= 0 && v <= 10_000, 'basis points must be in [0, 10000]');
+export const LabelSchema = z.enum(VALUE_LABELS);
+
+/** A labelled numeric content value. If `range` is given, value must lie inside it (checked in validate.ts). */
+export function labelled<T extends z.ZodType<number>>(inner: T) {
+  return z
+    .object({
+      value: inner,
+      label: LabelSchema,
+      range: z.tuple([z.number(), z.number()]).optional(),
+      hypothesis: z.string().min(1).optional(),
+      note: z.string().min(1).optional(),
+    })
+    .strict();
+}
+
+export const XpCurveSchema = z
+  .object({
+    family: z.literal('powerGeometric'),
+    a: labelled(z.number().positive()),
+    p: labelled(z.number().nonnegative()),
+    g: labelled(z.number().min(1)),
+  })
+  .strict();
+
+export const StatCategorySchema = z
+  .object({
+    id: StableIdSchema,
+    kind: z.enum(['additivePool', 'multiplier']),
+    active: z.boolean(),
+    note: z.string().min(1).optional(),
+  })
+  .strict();
+
+export const ContentPackS0Schema = z
+  .object({
+    schemaVersion: z.literal(1),
+    contentId: z.string().regex(/^[a-z][a-z0-9-]*$/),
+    contentVersion: SemVerSchema,
+    status: z.enum(['candidate', 'approved']),
+    formulaVersions: z
+      .object({
+        numeric: z.literal(1),
+        remainder: z.literal(1),
+        rng: z.literal(1),
+        xp: z.literal(1),
+        stats: z.literal(1),
+        combat: z.literal(1),
+        ledger: z.literal(1),
+        canonicalJson: z.literal(1),
+      })
+      .strict(),
+    xp: z
+      .object({
+        curve: XpCurveSchema,
+        tableLength: labelled(SafeIntSchema.refine((v) => v >= 1 && v <= 100_000)),
+        maxLevelUpsPerAward: labelled(SafeIntSchema.refine((v) => v >= 1)),
+        table: z.object({ path: z.string().regex(/^[a-z0-9_./-]+\.json$/), sha256: Sha256HexSchema }).strict(),
+      })
+      .strict(),
+    statCategories: z.array(StatCategorySchema).min(1),
+    combat: z
+      .object({
+        mitigationK: labelled(SafeIntSchema.refine((v) => v >= 1)),
+        minDamagePerHit: labelled(SafeIntSchema.refine((v) => v >= 1)),
+        hitCurve: z.object({ hAtReqBp: labelled(BpSchema), floorBp: labelled(BpSchema), k: labelled(SafeIntSchema.refine((v) => v >= 1 && v <= 8)) }).strict(),
+        critChanceBpBase: labelled(SafeIntSchema.refine((v) => v >= 0)),
+        critMultBpBase: labelled(SafeIntSchema.refine((v) => v >= 10_000)),
+      })
+      .strict(),
+  })
+  .strict();
+
+export type ContentPackS0 = z.infer<typeof ContentPackS0Schema>;
+
+export const XpTableArtifactSchema = z
+  .object({
+    artifact: z.literal('xp-table'),
+    artifactVersion: z.literal(1),
+    formulaVersion: z.literal(1),
+    contentId: z.string().regex(/^[a-z][a-z0-9-]*$/),
+    label: LabelSchema,
+    curve: z.object({ family: z.literal('powerGeometric'), a: z.number().positive(), p: z.number().nonnegative(), g: z.number().min(1) }).strict(),
+    rounding: z.literal('roundHalfUp'),
+    indexing: z.literal('thresholds[i] = EXP from level i+1 to level i+2'),
+    thresholds: z.array(SafeIntSchema.refine((v) => v >= 1)).min(1),
+  })
+  .strict();
+
+export type XpTableArtifact = z.infer<typeof XpTableArtifactSchema>;
diff --git a/legion-progression-lab/src/core/content/validate.ts b/legion-progression-lab/src/core/content/validate.ts
new file mode 100644
index 0000000..31f5161
--- /dev/null
+++ b/legion-progression-lab/src/core/content/validate.ts
@@ -0,0 +1,73 @@
+/**
+ * Content validation (spec/formulas/units.md "Content validation"). Pure: callers pass parsed JSON.
+ * An invalid pack is refused as a whole (INVALID_CONTENT); nothing is partly loaded.
+ */
+import { fail } from '../errors.ts';
+import { fingerprint } from '../hash/canonicalJson.ts';
+import { assertXpTable } from '../formulas/xp.ts';
+import { ContentPackS0Schema, XpTableArtifactSchema, type ContentPackS0, type XpTableArtifact } from './schema.ts';
+
+function zodMessage(error: { issues: readonly { path: readonly PropertyKey[]; message: string }[] }): string {
+  return error.issues.map((i) => `${i.path.map(String).join('.') || '(root)'}: ${i.message}`).join('; ');
+}
+
+function checkRanges(node: unknown, path: string, problems: string[]): void {
+  if (node === null || typeof node !== 'object') return;
+  if (Array.isArray(node)) {
+    node.forEach((child, i) => checkRanges(child, `${path}[${i}]`, problems));
+    return;
+  }
+  const record = node as Record<string, unknown>;
+  const range = record['range'];
+  const value = record['value'];
+  if (Array.isArray(range) && typeof value === 'number') {
+    const [lo, hi] = range as [number, number];
+    if (lo > hi) problems.push(`${path}: range lower bound exceeds upper bound`);
+    else if (value < lo || value > hi) problems.push(`${path}: value ${value} is outside its declared range [${lo}, ${hi}]`);
+  }
+  for (const [key, child] of Object.entries(record)) checkRanges(child, `${path}.${key}`, problems);
+}
+
+export function parseXpTableArtifact(json: unknown): XpTableArtifact {
+  const parsed = XpTableArtifactSchema.safeParse(json);
+  if (!parsed.success) fail('INVALID_CONTENT', `XP table artifact: ${zodMessage(parsed.error)}`);
+  try {
+    assertXpTable(parsed.data.thresholds);
+  } catch (e) {
+    fail('INVALID_CONTENT', `XP table artifact: ${(e as Error).message}`);
+  }
+  return parsed.data;
+}
+
+export interface ValidatedContent {
+  readonly pack: ContentPackS0;
+  readonly table: XpTableArtifact;
+  readonly contentHash: string;
+  readonly tableHash: string;
+}
+
+/** Validates the pack, its XP table artifact and every cross-reference. */
+export function validateContentPack(packJson: unknown, tableJson: unknown): ValidatedContent {
+  const parsed = ContentPackS0Schema.safeParse(packJson);
+  if (!parsed.success) fail('INVALID_CONTENT', `content pack: ${zodMessage(parsed.error)}`);
+  const pack = parsed.data;
+  const problems: string[] = [];
+  checkRanges(pack, '$', problems);
+
+  const ids = pack.statCategories.map((c) => c.id);
+  if (new Set(ids).size !== ids.length) problems.push('statCategories: duplicate category id');
+  const hit = pack.combat.hitCurve;
+  if (hit.floorBp.value > hit.hAtReqBp.value) problems.push('combat.hitCurve: floorBp must be <= hAtReqBp');
+
+  const table = parseXpTableArtifact(tableJson);
+  const tableHash = fingerprint(tableJson);
+  if (tableHash !== pack.xp.table.sha256) problems.push(`xp.table.sha256 does not match the artifact (artifact is ${tableHash})`);
+  if (table.contentId !== pack.contentId) problems.push('xp table artifact belongs to a different contentId');
+  if (table.thresholds.length !== pack.xp.tableLength.value) problems.push('xp table length differs from xp.tableLength');
+  const c = pack.xp.curve;
+  if (table.curve.a !== c.a.value || table.curve.p !== c.p.value || table.curve.g !== c.g.value) {
+    problems.push('xp table curve parameters differ from the content pack curve');
+  }
+  if (problems.length > 0) fail('INVALID_CONTENT', problems.join('; '), { problems });
+  return { pack, table, contentHash: fingerprint(packJson), tableHash };
+}
diff --git a/legion-progression-lab/src/core/errors.ts b/legion-progression-lab/src/core/errors.ts
new file mode 100644
index 0000000..37a9df8
--- /dev/null
+++ b/legion-progression-lab/src/core/errors.ts
@@ -0,0 +1,48 @@
+/**
+ * Stable error codes. Every refusal in the lab is one of these; nothing is silently clamped.
+ * Spec: spec/formulas/numeric.md, remainder.md, rng.md, xp.md, stats.md, combat.md, ledger.md, canonical-json.md.
+ */
+export const ERROR_CODES = [
+  'INVALID_NUMBER',
+  'NUMERIC_LIMIT',
+  'INVALID_DENOMINATOR',
+  'INVALID_STATE',
+  'INVALID_RANGE',
+  'RANGE_TOO_LARGE',
+  'INVALID_PROBABILITY',
+  'PROBABILITY_TOO_SMALL',
+  'INVALID_STREAM_ID',
+  'RNG_ZERO_STATE',
+  'RNG_REJECTION_GUARD',
+  'INVALID_TABLE',
+  'XP_TABLE_EXHAUSTED',
+  'LEVEL_UP_GUARD',
+  'UNKNOWN_CATEGORY',
+  'INVALID_TX',
+  'NEGATIVE_BALANCE',
+  'TX_CONFLICT',
+  'INVALID_JSON_VALUE',
+  'INVALID_CONTENT',
+] as const;
+
+export type ErrorCode = (typeof ERROR_CODES)[number];
+
+export class LabError extends Error {
+  readonly code: ErrorCode;
+  readonly detail: Readonly<Record<string, unknown>>;
+
+  constructor(code: ErrorCode, message: string, detail: Record<string, unknown> = {}) {
+    super(`${code}: ${message}`);
+    this.name = 'LabError';
+    this.code = code;
+    this.detail = detail;
+  }
+}
+
+export function fail(code: ErrorCode, message: string, detail: Record<string, unknown> = {}): never {
+  throw new LabError(code, message, detail);
+}
+
+export function isLabError(value: unknown): value is LabError {
+  return value instanceof LabError;
+}
diff --git a/legion-progression-lab/src/core/formulas/combat.ts b/legion-progression-lab/src/core/formulas/combat.ts
new file mode 100644
index 0000000..03c2c0c
--- /dev/null
+++ b/legion-progression-lab/src/core/formulas/combat.ts
@@ -0,0 +1,90 @@
+/**
+ * Combat primitives (spec/formulas/combat.md v1). All coefficients are content candidates.
+ *
+ * hitChance(A, R): R = 0 -> 1. A = 0 -> floor. Otherwise
+ *   ratio = R / A; pow = ratio^k by repeated multiplication (k integer 1..8, no Math.pow);
+ *   h = 1 - (1 - hAtReqBp/10000) * pow; result = min(1, max(floorBp/10000, h)).
+ *   Monotonic non-decreasing in A, 90% at A = R for hAtReqBp = 9000, tends to 1 as A grows.
+ * mitigationFactor(D, K) = K / (K + D), D >= 0, K >= 1 (diminishing, never 0).
+ * critChanceEffective(bp) = min(bp, 10000); overcap = max(0, bp - 10000) (R-A2: may reach exactly 100%).
+ * damagePerHit = max(minDamage, roundHalfUp((raw * critMultBp/10000 if crit) * mitigation)), multiplied
+ *   in that order; raw must be finite and > 0 (the floor applies to landed damaging hits only).
+ * hitsToKill(hp, damage) = ceil(hp / damage), integers >= 1.
+ */
+import { fail } from '../errors.ts';
+import { assertProbabilityBp, BP_SCALE } from '../numeric/basisPoints.ts';
+import { roundHalfUpToSafeInt } from '../numeric/rounding.ts';
+import { addSafe, assertNonNegativeSafeInt, assertSafeInt, assertSafeIntInRange, ceilDiv } from '../numeric/safeInt.ts';
+
+export interface HitCurve {
+  readonly hAtReqBp: number;
+  readonly floorBp: number;
+  readonly k: number;
+}
+
+export function assertHitCurve(curve: HitCurve): HitCurve {
+  const h = assertProbabilityBp(curve.hAtReqBp, 'hAtReqBp');
+  const f = assertProbabilityBp(curve.floorBp, 'floorBp');
+  assertSafeIntInRange(curve.k, 1, 8, 'k');
+  if (f > h) fail('INVALID_NUMBER', 'floorBp must be <= hAtReqBp', { floorBp: f, hAtReqBp: h });
+  return curve;
+}
+
+export function hitChance(accuracy: number, requirement: number, curve: HitCurve): number {
+  const a = assertNonNegativeSafeInt(accuracy, 'accuracy');
+  const r = assertNonNegativeSafeInt(requirement, 'requirement');
+  assertHitCurve(curve);
+  if (r === 0) return 1;
+  const floor = curve.floorBp / BP_SCALE;
+  if (a === 0) return floor;
+  const ratio = r / a;
+  let pow = 1;
+  for (let i = 0; i < curve.k; i += 1) pow *= ratio;
+  const h = 1 - (1 - curve.hAtReqBp / BP_SCALE) * pow;
+  return Math.min(1, Math.max(floor, h));
+}
+
+export function mitigationFactor(defence: number, k: number): number {
+  const d = assertNonNegativeSafeInt(defence, 'defence');
+  const kk = assertSafeInt(k, 'K');
+  if (kk < 1) fail('INVALID_NUMBER', 'K must be >= 1', { K: kk });
+  return kk / addSafe(kk, d);
+}
+
+export function critChanceEffective(critChanceBp: number): { effectiveBp: number; overcapBp: number } {
+  const bp = assertNonNegativeSafeInt(critChanceBp, 'critChanceBp');
+  return { effectiveBp: Math.min(bp, BP_SCALE), overcapBp: Math.max(0, bp - BP_SCALE) };
+}
+
+export interface DamageInput {
+  readonly raw: number;
+  readonly crit: boolean;
+  readonly critMultBp: number;
+  readonly mitigation: number;
+  readonly minDamage: number;
+}
+
+export function damagePerHit(input: DamageInput): number {
+  if (typeof input.raw !== 'number' || !Number.isFinite(input.raw) || input.raw <= 0) {
+    fail('INVALID_NUMBER', 'raw damage must be a finite number > 0', { raw: String(input.raw) });
+  }
+  const mult = assertSafeInt(input.critMultBp, 'critMultBp');
+  if (mult < BP_SCALE) fail('INVALID_NUMBER', 'critMultBp must be >= 10000', { critMultBp: mult });
+  if (typeof input.mitigation !== 'number' || !Number.isFinite(input.mitigation) || input.mitigation <= 0 || input.mitigation > 1) {
+    fail('INVALID_NUMBER', 'mitigation must be in (0, 1]', { mitigation: String(input.mitigation) });
+  }
+  const minDamage = assertSafeInt(input.minDamage, 'minDamage');
+  if (minDamage < 1) fail('INVALID_NUMBER', 'minDamage must be >= 1', { minDamage });
+  let x = input.raw;
+  if (input.crit) x = x * (mult / BP_SCALE);
+  x = x * input.mitigation;
+  return Math.max(minDamage, roundHalfUpToSafeInt(x));
+}
+
+export function hitsToKill(hp: number, damage: number): number {
+  const h = assertSafeInt(hp, 'hp');
+  const d = assertSafeInt(damage, 'damage');
+  if (h < 1) fail('INVALID_NUMBER', 'hp must be >= 1', { hp: h });
+  if (d < 1) fail('INVALID_NUMBER', 'damage must be >= 1', { damage: d });
+  return ceilDiv(h, d);
+}
diff --git a/legion-progression-lab/src/core/formulas/stats.ts b/legion-progression-lab/src/core/formulas/stats.ts
new file mode 100644
index 0000000..3534117
--- /dev/null
+++ b/legion-progression-lab/src/core/formulas/stats.ts
@@ -0,0 +1,84 @@
+/**
+ * Stat stacking (spec/formulas/stats.md v1; R05.17, R08.10).
+ *
+ * value = flatTotal * PRODUCT over active categories c, in ascending categoryId order, of (10000 + sumBp_c) / 10000
+ * evaluated in doubles exactly in that order: v = flatTotal; then for each c: v = (v * (10000 + sumBp_c)) / 10000.
+ * - flatTotal = base + sum of flat sources (safe integers, all >= 0).
+ * - Sources in a category add their basis points; categories multiply.
+ * - Inactive categories contribute factor 1 (their sources are listed in the breakdown but not applied).
+ * - Unknown category -> UNKNOWN_CATEGORY. Duplicate category or source IDs -> INVALID_CONTENT.
+ * - A category whose 10000 + sumBp is negative -> INVALID_STATE.
+ * The breakdown is produced by the same function, so it always matches the applied value.
+ */
+import { fail } from '../errors.ts';
+import { BP_SCALE } from '../numeric/basisPoints.ts';
+import { addSafe, assertNonNegativeSafeInt, assertSafeInt } from '../numeric/safeInt.ts';
+
+export type CategoryKind = 'additivePool' | 'multiplier';
+
+export interface StatCategory {
+  readonly id: string;
+  readonly kind: CategoryKind;
+  readonly active: boolean;
+}
+
+export type StatSource =
+  | { readonly sourceId: string; readonly kind: 'flat'; readonly value: number }
+  | { readonly sourceId: string; readonly kind: 'bp'; readonly categoryId: string; readonly value: number };
+
+export interface CategoryBreakdown {
+  readonly categoryId: string;
+  readonly kind: CategoryKind;
+  readonly active: boolean;
+  readonly sumBp: number;
+  readonly factorNumerator: number;
+  readonly sourceIds: readonly string[];
+}
+
+export interface StatResult {
+  readonly flatTotal: number;
+  readonly flatSourceIds: readonly string[];
+  readonly categories: readonly CategoryBreakdown[];
+  readonly value: number;
+}
+
+export function evaluateStat(base: number, sources: readonly StatSource[], categories: readonly StatCategory[]): StatResult {
+  let flatTotal = assertNonNegativeSafeInt(base, 'base');
+  const registry = new Map<string, StatCategory>();
+  for (const c of categories) {
+    if (registry.has(c.id)) fail('INVALID_CONTENT', 'duplicate category id', { id: c.id });
+    if (c.kind !== 'additivePool' && c.kind !== 'multiplier') fail('INVALID_CONTENT', 'unknown category kind', { id: c.id });
+    registry.set(c.id, c);
+  }
+  const seen = new Set<string>();
+  const flatIds: string[] = [];
+  const sums = new Map<string, { sumBp: number; ids: string[] }>();
+  for (const s of sources) {
+    if (seen.has(s.sourceId)) fail('INVALID_CONTENT', 'duplicate source id', { sourceId: s.sourceId });
+    seen.add(s.sourceId);
+    if (s.kind === 'flat') {
+      flatTotal = addSafe(flatTotal, assertNonNegativeSafeInt(s.value, `flat ${s.sourceId}`));
+      flatIds.push(s.sourceId);
+    } else if (s.kind === 'bp') {
+      if (!registry.has(s.categoryId)) fail('UNKNOWN_CATEGORY', 'source refers to an unregistered category', { categoryId: s.categoryId });
+      const entry = sums.get(s.categoryId) ?? { sumBp: 0, ids: [] };
+      entry.sumBp = addSafe(entry.sumBp, assertSafeInt(s.value, `bp ${s.sourceId}`));
+      entry.ids.push(s.sourceId);
+      sums.set(s.categoryId, entry);
+    } else {
+      fail('INVALID_CONTENT', 'unknown source kind');
+    }
+  }
+
+  const ordered = [...registry.values()].sort((x, y) => (x.id < y.id ? -1 : x.id > y.id ? 1 : 0));
+  let value = flatTotal;
+  const breakdown: CategoryBreakdown[] = [];
+  for (const c of ordered) {
+    const entry = sums.get(c.id) ?? { sumBp: 0, ids: [] };
+    const factorNumerator = addSafe(BP_SCALE, entry.sumBp);
+    if (factorNumerator < 0) fail('INVALID_STATE', 'category factor would be negative', { categoryId: c.id });
+    if (c.active) value = (value * factorNumerator) / BP_SCALE;
+    breakdown.push({ categoryId: c.id, kind: c.kind, active: c.active, sumBp: entry.sumBp, factorNumerator, sourceIds: entry.ids });
+  }
+  return { flatTotal, flatSourceIds: flatIds, categories: breakdown, value };
+}
diff --git a/legion-progression-lab/src/core/formulas/xp.ts b/legion-progression-lab/src/core/formulas/xp.ts
new file mode 100644
index 0000000..f9c4449
--- /dev/null
+++ b/legion-progression-lab/src/core/formulas/xp.ts
@@ -0,0 +1,180 @@
+/**
+ * EXP thresholds and awards (spec/formulas/xp.md v1).
+ *
+ * Indexing: T(L) is the EXP needed to go from level L to L + 1, for L >= 1. A table of length N
+ * stores T(1)..T(N); the highest reachable level is N + 1.
+ * Curve family "powerGeometric": T(L) = roundHalfUp(a * L^p * g^(L-1)), evaluated in doubles as
+ * (a * Math.pow(L, p)) * Math.pow(g, L - 1). This is used ONLY to build a table artifact, which must
+ * be independently verified (spec/oracle/xp_oracle.py) before use. Engines consume the integer table.
+ *
+ * State is (level, expIntoLevel); only single-level thresholds are ever compared. Cumulative EXP is
+ * report-only and can leave the safe range long before any single threshold does.
+ */
+import { fail } from '../errors.ts';
+import { roundHalfUp } from '../numeric/rounding.ts';
+import { addSafe, assertNonNegativeSafeInt, assertSafeInt, MAX_SAFE } from '../numeric/safeInt.ts';
+
+export interface XpCurve {
+  readonly family: 'powerGeometric';
+  readonly a: number;
+  readonly p: number;
+  readonly g: number;
+}
+
+export function assertXpCurve(curve: XpCurve): XpCurve {
+  const ok =
+    curve.family === 'powerGeometric' &&
+    Number.isFinite(curve.a) &&
+    curve.a > 0 &&
+    Number.isFinite(curve.p) &&
+    curve.p >= 0 &&
+    Number.isFinite(curve.g) &&
+    curve.g >= 1;
+  if (!ok) fail('INVALID_TABLE', 'curve needs family powerGeometric, a > 0, p >= 0, g >= 1 (all finite)', { ...curve });
+  return curve;
+}
+
+/** Real-valued curve, double precision, in the specified evaluation order. Report and table building only. */
+export function xpCurveValue(curve: XpCurve, level: number): number {
+  return curve.a * Math.pow(level, curve.p) * Math.pow(curve.g, level - 1);
+}
+
+export function buildXpTable(curve: XpCurve, length: number): number[] {
+  assertXpCurve(curve);
+  const n = assertSafeInt(length, 'length');
+  if (n < 1) fail('INVALID_TABLE', 'table length must be >= 1', { length: n });
+  const table: number[] = [];
+  for (let level = 1; level <= n; level += 1) {
+    const raw = xpCurveValue(curve, level);
+    if (!Number.isFinite(raw)) fail('NUMERIC_LIMIT', 'curve value is not finite', { level });
+    const t = roundHalfUp(raw);
+    if (!Number.isSafeInteger(t)) fail('NUMERIC_LIMIT', 'threshold exceeds the safe integer range', { level });
+    if (t < 1) fail('INVALID_TABLE', 'every threshold must be >= 1', { level, threshold: t });
+    const prev = table[table.length - 1];
+    if (prev !== undefined && t < prev) fail('INVALID_TABLE', 'thresholds must be non-decreasing', { level });
+    table.push(t);
+  }
+  return table;
+}
+
+export function assertXpTable(table: readonly number[]): readonly number[] {
+  if (!Array.isArray(table) || table.length < 1) fail('INVALID_TABLE', 'table must be a non-empty array');
+  let prev = 0;
+  table.forEach((t, i) => {
+    if (!Number.isSafeInteger(t) || t < 1) fail('INVALID_TABLE', 'thresholds must be safe integers >= 1', { index: i });
+    if (t < prev) fail('INVALID_TABLE', 'thresholds must be non-decreasing', { index: i });
+    prev = t;
+  });
+  return table;
+}
+
+export interface CumulativeReport {
+  /** C(L) = EXP to reach level L from level 1 (C(1) = 0), for L = 1..lastSafeCumulativeLevel. */
+  readonly cumulative: readonly number[];
+  /** Highest level L in 1..N+1 whose cumulative EXP is a safe integer. */
+  readonly lastSafeCumulativeLevel: number;
+  /** True when every C(L) for L = 1..N+1 is safe. */
+  readonly cumulativeCompleteWithinTable: boolean;
+}
+
+export function cumulativeReport(table: readonly number[]): CumulativeReport {
+  assertXpTable(table);
+  const cumulative: number[] = [0];
+  for (const t of table) {
+    const prev = cumulative[cumulative.length - 1] ?? 0;
+    const next = prev + t;
+    if (!Number.isSafeInteger(next)) {
+      return { cumulative, lastSafeCumulativeLevel: cumulative.length, cumulativeCompleteWithinTable: false };
+    }
+    cumulative.push(next);
+  }
+  return { cumulative, lastSafeCumulativeLevel: cumulative.length, cumulativeCompleteWithinTable: true };
+}
+
+export interface ExpState {
+  readonly level: number;
+  readonly expIntoLevel: number;
+}
+
+export interface ExpAwardResult extends ExpState {
+  readonly levelUps: readonly number[];
+}
+
+/**
+ * Applies an EXP award. Atomic: either the whole award is applied, or an error is thrown and the
+ * caller's state is unchanged. EXP is never discarded or clamped.
+ */
+export function applyExpAward(state: ExpState, award: number, table: readonly number[], maxLevelUps: number): ExpAwardResult {
+  assertXpTable(table);
+  const level = assertSafeInt(state.level, 'level');
+  if (level < 1 || level > table.length + 1) fail('INVALID_STATE', 'level must be in [1, table length + 1]', { level });
+  const into = assertNonNegativeSafeInt(state.expIntoLevel, 'expIntoLevel');
+  const threshold = table[level - 1];
+  if (threshold !== undefined && into >= threshold) fail('INVALID_STATE', 'expIntoLevel must be below the current threshold', { level, into });
+  const amount = assertNonNegativeSafeInt(award, 'award');
+  const guard = assertSafeInt(maxLevelUps, 'maxLevelUps');
+  if (guard < 1) fail('INVALID_NUMBER', 'maxLevelUps must be >= 1');
+
+  let total = addSafe(into, amount);
+  let current = level;
+  const levelUps: number[] = [];
+  for (;;) {
+    const t = table[current - 1];
+    if (t === undefined || total < t) break;
+    total -= t;
+    current += 1;
+    levelUps.push(current);
+    if (levelUps.length > guard) fail('LEVEL_UP_GUARD', `more than ${guard} level-ups in one award`, { award: amount });
+  }
+  if (current === table.length + 1 && total > 0) {
+    fail('XP_TABLE_EXHAUSTED', 'award runs past the end of the EXP table; extend the table through content', {
+      level: current,
+      leftover: total,
+    });
+  }
+  return { level: current, expIntoLevel: total, levelUps };
+}
+
+export interface LimitEstimate {
+  readonly level: number | null;
+  readonly method: string;
+}
+
+/**
+ * Report-only estimate of the first level whose single threshold would exceed 2^53 - 1, using the
+ * double-precision curve (exponential then binary search over levels up to 2^53). Approximate.
+ */
+export function estimateFirstUnsafeThresholdLevel(curve: XpCurve): LimitEstimate {
+  assertXpCurve(curve);
+  const exceeds = (level: number): boolean => !(xpCurveValue(curve, level) <= MAX_SAFE);
+  let hi = 1;
+  while (!exceeds(hi)) {
+    if (hi >= 2 ** 52) return { level: null, method: 'double curve search: no level below 2^53 exceeds the limit' };
+    hi *= 2;
+  }
+  let lo = Math.floor(hi / 2);
+  while (hi - lo > 1) {
+    const mid = Math.floor((lo + hi) / 2);
+    if (exceeds(mid)) hi = mid;
+    else lo = mid;
+  }
+  return { level: exceeds(1) ? 1 : hi, method: 'double curve, exponential + binary search (approximate, report-only)' };
+}
+
+/**
+ * Report-only estimate of the first level L whose cumulative EXP C(L) would exceed 2^53 - 1.
+ * g = 1: C(L) ~ a * (L-1)^(p+1) / (p+1) (integral approximation). g > 1: direct double summation.
+ */
+export function estimateFirstUnsafeCumulativeLevel(curve: XpCurve): LimitEstimate {
+  assertXpCurve(curve);
+  if (curve.g === 1) {
+    const level = Math.ceil(Math.pow((MAX_SAFE * (curve.p + 1)) / curve.a, 1 / (curve.p + 1))) + 1;
+    return { level, method: 'g = 1: integral approximation a*(L-1)^(p+1)/(p+1) (approximate, report-only)' };
+  }
+  let sum = 0;
+  for (let level = 1; level < 1e7; level += 1) {
+    sum += xpCurveValue(curve, level);
+    if (!(sum <= MAX_SAFE)) return { level: level + 1, method: 'g > 1: double summation (approximate, report-only)' };
+  }
+  return { level: null, method: 'g > 1: double summation did not exceed the limit within 10^7 levels' };
+}
diff --git a/legion-progression-lab/src/core/hash/canonicalJson.ts b/legion-progression-lab/src/core/hash/canonicalJson.ts
new file mode 100644
index 0000000..c45e5a9
--- /dev/null
+++ b/legion-progression-lab/src/core/hash/canonicalJson.ts
@@ -0,0 +1,67 @@
+/**
+ * Canonical JSON v1 and SHA-256 fingerprints (spec/formulas/canonical-json.md).
+ *
+ * - Object keys sorted by UTF-16 code-unit order; keys must be printable ASCII (0x20..0x7E).
+ * - Numbers must be finite; serialised with ECMAScript Number::toString (shortest round-trip); -0 -> "0".
+ * - Strings escaped as JSON.stringify does. Lone surrogates are refused.
+ * - Only null, booleans, finite numbers, strings, dense arrays and plain objects are allowed.
+ *   undefined values, functions, symbols, BigInt, sparse arrays and class instances are refused.
+ */
+import { createHash } from 'node:crypto';
+import { fail } from '../errors.ts';
+
+const PRINTABLE_ASCII = /^[\x20-\x7e]*$/;
+const LONE_SURROGATE = /[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/;
+
+export function canonicalJson(value: unknown): string {
+  return serialise(value, '$');
+}
+
+function serialise(value: unknown, path: string): string {
+  if (value === null) return 'null';
+  switch (typeof value) {
+    case 'boolean':
+      return value ? 'true' : 'false';
+    case 'number':
+      if (!Number.isFinite(value)) fail('INVALID_JSON_VALUE', `non-finite number at ${path}`, { path });
+      return Object.is(value, -0) ? '0' : String(value);
+    case 'string':
+      if (LONE_SURROGATE.test(value)) fail('INVALID_JSON_VALUE', `lone surrogate in string at ${path}`, { path });
+      return JSON.stringify(value);
+    case 'object': {
+      if (Array.isArray(value)) {
+        const parts: string[] = [];
+        for (let i = 0; i < value.length; i += 1) {
+          if (!(i in value)) fail('INVALID_JSON_VALUE', `sparse array at ${path}[${i}]`, { path });
+          parts.push(serialise(value[i], `${path}[${i}]`));
+        }
+        return `[${parts.join(',')}]`;
+      }
+      const proto: unknown = Object.getPrototypeOf(value);
+      if (proto !== Object.prototype && proto !== null) {
+        fail('INVALID_JSON_VALUE', `only plain objects are allowed at ${path}`, { path });
+      }
+      const record = value as Record<string, unknown>;
+      const keys = Object.keys(record).sort();
+      const parts: string[] = [];
+      for (const key of keys) {
+        if (!PRINTABLE_ASCII.test(key)) fail('INVALID_JSON_VALUE', `object key must be printable ASCII at ${path}`, { path, key });
+        const child = record[key];
+        if (child === undefined) fail('INVALID_JSON_VALUE', `undefined value at ${path}.${key}`, { path, key });
+        parts.push(`${JSON.stringify(key)}:${serialise(child, `${path}.${key}`)}`);
+      }
+      return `{${parts.join(',')}}`;
+    }
+    default:
+      return fail('INVALID_JSON_VALUE', `unsupported value of type ${typeof value} at ${path}`, { path });
+  }
+}
+
+export function sha256Hex(data: string | Uint8Array): string {
+  return createHash('sha256').update(data).digest('hex');
+}
+
+/** SHA-256 of the canonical JSON text (UTF-8). */
+export function fingerprint(value: unknown): string {
+  return sha256Hex(canonicalJson(value));
+}
diff --git a/legion-progression-lab/src/core/ledger/ledger.ts b/legion-progression-lab/src/core/ledger/ledger.ts
new file mode 100644
index 0000000..a95ebe1
--- /dev/null
+++ b/legion-progression-lab/src/core/ledger/ledger.ts
@@ -0,0 +1,112 @@
+/**
+ * Atomic, idempotent resource ledger (spec/formulas/ledger.md v1; architecture v1.1 section 10).
+ *
+ * applyTx(ledger, tx) -> { ledger', result } or throws LabError, leaving the input ledger untouched.
+ * 1. Validate the transaction.
+ * 2. payloadHash = SHA-256(canonicalJson(tx)).
+ * 3. txId already committed: same payloadHash -> stored result with replayed = true (ledger unchanged);
+ *    different payloadHash -> TX_CONFLICT.
+ * 4. Aggregate lines by (resourceId, bucket) with checked addition BEFORE validating balances.
+ * 5. Every affected bucket must end in [0, 2^53 - 1] (NEGATIVE_BALANCE / NUMERIC_LIMIT).
+ * 6. Commit all changes and record txId -> { payloadHash, result }. Failures record nothing.
+ */
+import { fail } from '../errors.ts';
+import { fingerprint } from '../hash/canonicalJson.ts';
+import { addSafe, isSafeInt } from '../numeric/safeInt.ts';
+
+export type Bucket = 'available' | 'reserved';
+export const BUCKETS: readonly Bucket[] = ['available', 'reserved'];
+
+export interface TxLine {
+  readonly resourceId: string;
+  readonly bucket: Bucket;
+  readonly delta: number;
+}
+
+export interface Tx {
+  readonly txId: string;
+  readonly purpose: string;
+  readonly cause?: string;
+  readonly lines: readonly TxLine[];
+}
+
+export interface TxResult {
+  readonly txId: string;
+  readonly nets: readonly TxLine[];
+  readonly replayed: boolean;
+}
+
+export interface BucketBalances {
+  readonly available: number;
+  readonly reserved: number;
+}
+
+export interface Ledger {
+  readonly balances: ReadonlyMap<string, BucketBalances>;
+  readonly committed: ReadonlyMap<string, { readonly payloadHash: string; readonly result: TxResult }>;
+}
+
+export const RESOURCE_ID = /^res(\.[a-z0-9_]+)+$/;
+const PURPOSE = /^[a-z][a-z0-9_.-]{0,63}$/;
+const MAX_LINES = 1000;
+
+export function emptyLedger(): Ledger {
+  return { balances: new Map(), committed: new Map() };
+}
+
+export function balance(ledger: Ledger, resourceId: string, bucket: Bucket = 'available'): number {
+  return ledger.balances.get(resourceId)?.[bucket] ?? 0;
+}
+
+function validateTx(tx: Tx): void {
+  if (tx === null || typeof tx !== 'object') fail('INVALID_TX', 'transaction must be an object');
+  const allowed = new Set(['txId', 'purpose', 'cause', 'lines']);
+  for (const key of Object.keys(tx)) if (!allowed.has(key)) fail('INVALID_TX', `unknown transaction field ${key}`);
+  if (typeof tx.txId !== 'string' || tx.txId.length < 1 || tx.txId.length > 256) fail('INVALID_TX', 'txId must be a string of 1..256 characters');
+  if (typeof tx.purpose !== 'string' || !PURPOSE.test(tx.purpose)) fail('INVALID_TX', 'purpose must match ^[a-z][a-z0-9_.-]{0,63}$');
+  if ('cause' in tx && (typeof tx.cause !== 'string' || tx.cause.length > 256)) fail('INVALID_TX', 'cause, when present, must be a string of at most 256 characters');
+  if (!Array.isArray(tx.lines) || tx.lines.length < 1 || tx.lines.length > MAX_LINES) fail('INVALID_TX', `lines must contain 1..${MAX_LINES} entries`);
+  tx.lines.forEach((line, i) => {
+    if (line === null || typeof line !== 'object') fail('INVALID_TX', `line ${i} must be an object`);
+    for (const key of Object.keys(line)) if (key !== 'resourceId' && key !== 'bucket' && key !== 'delta') fail('INVALID_TX', `unknown line field ${key}`);
+    if (typeof line.resourceId !== 'string' || !RESOURCE_ID.test(line.resourceId)) fail('INVALID_TX', `line ${i} has an invalid resourceId`);
+    if (line.bucket !== 'available' && line.bucket !== 'reserved') fail('INVALID_TX', `line ${i} has an invalid bucket`);
+    if (!isSafeInt(line.delta)) fail('INVALID_NUMBER', `line ${i} delta must be a safe integer`, { index: i });
+    if (line.delta === 0) fail('INVALID_TX', `line ${i} delta must not be zero`);
+  });
+}
+
+export function applyTx(ledger: Ledger, tx: Tx): { ledger: Ledger; result: TxResult } {
+  validateTx(tx);
+  const payloadHash = fingerprint(tx);
+  const prior = ledger.committed.get(tx.txId);
+  if (prior !== undefined) {
+    if (prior.payloadHash === payloadHash) return { ledger, result: { ...prior.result, replayed: true } };
+    fail('TX_CONFLICT', 'txId was already committed with a different payload', { txId: tx.txId });
+  }
+
+  const nets = new Map<string, TxLine>();
+  for (const line of tx.lines) {
+    const key = `${line.resourceId}\u0000${line.bucket}`;
+    const current = nets.get(key);
+    nets.set(key, { resourceId: line.resourceId, bucket: line.bucket, delta: current ? addSafe(current.delta, line.delta) : line.delta });
+  }
+
+  const balances = new Map(ledger.balances);
+  for (const net of nets.values()) {
+    if (net.delta === 0) continue;
+    const before = balances.get(net.resourceId) ?? { available: 0, reserved: 0 };
+    const after = before[net.bucket] + net.delta; // both safe integers; checked below
+    if (!Number.isSafeInteger(after)) fail('NUMERIC_LIMIT', 'balance would exceed the safe integer range', { resourceId: net.resourceId, bucket: net.bucket });
+    if (after < 0) fail('NEGATIVE_BALANCE', 'balance would become negative', { resourceId: net.resourceId, bucket: net.bucket, before: before[net.bucket], delta: net.delta });
+    balances.set(net.resourceId, { ...before, [net.bucket]: after === 0 ? 0 : after });
+  }
+
+  const sortedNets = [...nets.values()]
+    .filter((n) => n.delta !== 0)
+    .sort((x, y) => (x.resourceId < y.resourceId ? -1 : x.resourceId > y.resourceId ? 1 : x.bucket < y.bucket ? -1 : x.bucket > y.bucket ? 1 : 0));
+  const result: TxResult = { txId: tx.txId, nets: sortedNets, replayed: false };
+  const committed = new Map(ledger.committed);
+  committed.set(tx.txId, { payloadHash, result });
+  return { ledger: { balances, committed }, result };
+}
diff --git a/legion-progression-lab/src/core/numeric/basisPoints.ts b/legion-progression-lab/src/core/numeric/basisPoints.ts
