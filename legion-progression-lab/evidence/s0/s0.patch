+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { canonicalJson, fingerprint } from '../src/core/hash/canonicalJson.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+describe('canonical JSON', () => {
+  it('sorts keys and removes whitespace', () => {
+    expect(canonicalJson({ b: 1, a: [true, null, 'x'] })).toBe('{"a":[true,null,"x"],"b":1}');
+  });
+
+  it('is independent of key insertion order', () => {
+    const keyArb = fc.string({ minLength: 1, maxLength: 6, unit: 'grapheme-ascii' });
+    fc.assert(
+      fc.property(fc.dictionary(keyArb, fc.integer()), (obj) => {
+        const reversed = Object.fromEntries(Object.entries(obj).reverse());
+        expect(canonicalJson(reversed)).toBe(canonicalJson(obj));
+        expect(fingerprint(reversed)).toBe(fingerprint(obj));
+      }),
+      { seed: 20261113, numRuns: 500 },
+    );
+  });
+
+  it('formats numbers exactly as ECMAScript does (and -0 as 0)', () => {
+    fc.assert(
+      fc.property(fc.double({ noNaN: true, noDefaultInfinity: true }), (x) => {
+        expect(canonicalJson(x)).toBe(Object.is(x, -0) ? '0' : JSON.stringify(x));
+      }),
+      { seed: 20261113, numRuns: 2000 },
+    );
+    expect(canonicalJson([1e21, 1e-7, 1e16, -0])).toBe('[1e+21,1e-7,10000000000000000,0]');
+  });
+
+  it('refuses values that have no unambiguous canonical form', () => {
+    expect(code(() => canonicalJson(Number.NaN))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson({ x: Number.POSITIVE_INFINITY }))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson({ é: 1 }))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson({ x: undefined }))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson([1, , 3]))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson(new Date(0)))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson(10n))).toBe('INVALID_JSON_VALUE');
+    expect(code(() => canonicalJson('\ud800'))).toBe('INVALID_JSON_VALUE');
+  });
+});
diff --git a/legion-progression-lab/test/combat.test.ts b/legion-progression-lab/test/combat.test.ts
new file mode 100644
index 0000000..cc5216c
--- /dev/null
+++ b/legion-progression-lab/test/combat.test.ts
@@ -0,0 +1,86 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { critChanceEffective, damagePerHit, hitChance, hitsToKill, mitigationFactor, type HitCurve } from '../src/core/formulas/combat.ts';
+import { safeIntArb } from './helpers/reference.ts';
+
+const CURVE: HitCurve = { hAtReqBp: 9000, floorBp: 1000, k: 2 };
+const OPTIONS = { seed: 20261113, numRuns: 1500 };
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+describe('hit chance', () => {
+  it('is 1 without a requirement and 90% at the requirement (candidate curve)', () => {
+    expect(hitChance(10, 0, CURVE)).toBe(1);
+    expect(hitChance(50, 50, CURVE)).toBeCloseTo(0.9, 12);
+  });
+
+  it('is monotonic non-decreasing in accuracy and stays inside [floor, 1]', () => {
+    fc.assert(
+      fc.property(safeIntArb(1, 10_000), safeIntArb(0, 100_000), safeIntArb(0, 100_000), (req, a1, a2) => {
+        const lo = Math.min(a1, a2);
+        const hi = Math.max(a1, a2);
+        const hLo = hitChance(lo, req, CURVE);
+        const hHi = hitChance(hi, req, CURVE);
+        expect(hHi).toBeGreaterThanOrEqual(hLo);
+        expect(hLo).toBeGreaterThanOrEqual(0.1);
+        expect(hHi).toBeLessThanOrEqual(1);
+      }),
+      OPTIONS,
+    );
+  });
+
+  it('refuses inconsistent curves', () => {
+    expect(code(() => hitChance(10, 5, { hAtReqBp: 9000, floorBp: 9500, k: 2 }))).toBe('INVALID_NUMBER');
+    expect(code(() => hitChance(10, 5, { hAtReqBp: 9000, floorBp: 1000, k: 9 }))).toBe('INVALID_NUMBER');
+  });
+});
+
+describe('mitigation, crit and damage', () => {
+  it('mitigation is diminishing and never reaches zero', () => {
+    fc.assert(
+      fc.property(safeIntArb(1, 1000), safeIntArb(0, 1_000_000), safeIntArb(0, 1_000_000), (k, d1, d2) => {
+        const lo = Math.min(d1, d2);
+        const hi = Math.max(d1, d2);
+        expect(mitigationFactor(hi, k)).toBeLessThanOrEqual(mitigationFactor(lo, k));
+        expect(mitigationFactor(hi, k)).toBeGreaterThan(0);
+      }),
+      OPTIONS,
+    );
+    expect(mitigationFactor(100, 100)).toBe(0.5);
+  });
+
+  it('crit chance may reach exactly 100%; the excess is reported, not applied (R-A2)', () => {
+    expect(critChanceEffective(10_000)).toEqual({ effectiveBp: 10_000, overcapBp: 0 });
+    expect(critChanceEffective(12_500)).toEqual({ effectiveBp: 10_000, overcapBp: 2_500 });
+  });
+
+  it('damage per landed hit is an integer, rounds half up, and has a floor', () => {
+    expect(damagePerHit({ raw: 7, crit: true, critMultBp: 15_000, mitigation: 1, minDamage: 1 })).toBe(11);
+    expect(damagePerHit({ raw: 1.2, crit: false, critMultBp: 15_000, mitigation: 0.3, minDamage: 1 })).toBe(1);
+    expect(code(() => damagePerHit({ raw: 0, crit: false, critMultBp: 15_000, mitigation: 1, minDamage: 1 }))).toBe('INVALID_NUMBER');
+    expect(code(() => damagePerHit({ raw: 2 ** 53, crit: false, critMultBp: 15_000, mitigation: 1, minDamage: 1 }))).toBe('NUMERIC_LIMIT');
+  });
+
+  it('hits-to-kill never increases when damage increases (breakpoints are exact)', () => {
+    fc.assert(
+      fc.property(safeIntArb(1, 1_000_000), safeIntArb(1, 100_000), safeIntArb(1, 100_000), (hp, d1, d2) => {
+        const lo = Math.min(d1, d2);
+        const hi = Math.max(d1, d2);
+        expect(hitsToKill(hp, hi)).toBeLessThanOrEqual(hitsToKill(hp, lo));
+        expect(hitsToKill(hp, hi) * hi).toBeGreaterThanOrEqual(hp);
+        expect((hitsToKill(hp, hi) - 1) * hi).toBeLessThan(hp);
+      }),
+      OPTIONS,
+    );
+    expect([hitsToKill(15, 7), hitsToKill(15, 8)]).toEqual([3, 2]);
+  });
+});
