+      "input": { "txs": [{ "txId": "tx.n", "purpose": "grant", "lines": [{ "resourceId": "gold", "bucket": "available", "delta": 1 }] }] },
+      "expected": { "steps": [{ "ok": false, "error": "INVALID_TX" }], "balances": {} },
+      "derivation": "resourceId must match ^res(\\.[a-z0-9_]+)+$"
