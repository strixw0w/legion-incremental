+/**
+ * The lab is isolated: it never imports code from outside its own folder (only data under ../spec is
+ * read, by path, from src/cli and tests), and it never refers to the frozen baseline simulator.
+ */
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join, relative, resolve, sep } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { LAB_ROOT } from '../src/cli/paths.ts';
+
+const ALLOWED_PACKAGES = new Set(['zod', 'fast-check', 'vitest', 'vitest/config']);
+// Built from parts so this file does not match its own patterns.
+const FROZEN_WORKSPACE = ['Roblox', 'Incremental'].join(' ');
+const FROZEN_LAB = new RegExp(`(?<![\\w-])${['progression', 'lab'].join('-')}(?![\\w-])`);
+
+function files(dir: string): string[] {
+  return readdirSync(dir).flatMap((name) => {
+    if (name === 'node_modules' || name === 'results' || name === 'evidence') return [];
+    const p = join(dir, name);
+    return statSync(p).isDirectory() ? files(p) : /\.(ts|json)$/.test(p) && !p.endsWith('package-lock.json') ? [p] : [];
+  });
+}
+
+function importSpecifiers(text: string): string[] {
+  const out: string[] = [];
+  for (const m of text.matchAll(/(?:import|export)\s+(?:type\s+)?[^'"]*?from\s+['"]([^'"]+)['"]/g)) out.push(m[1] ?? '');
+  for (const m of text.matchAll(/import\s*\(\s*['"]([^'"]+)['"]\s*\)/g)) out.push(m[1] ?? '');
+  return out;
+}
+
+describe('isolation of the Legion lab', () => {
+  const all = files(LAB_ROOT);
+
+  for (const file of all) {
+    const rel = relative(LAB_ROOT, file).split(sep).join('/');
+    it(`${rel} stays inside the lab and never references the frozen baseline`, () => {
+      const text = readFileSync(file, 'utf8');
+      expect(text.includes(FROZEN_WORKSPACE), `${rel} mentions the frozen workspace`).toBe(false);
+      expect(FROZEN_LAB.test(text), `${rel} mentions the frozen lab`).toBe(false);
+      if (!file.endsWith('.ts')) return;
+      for (const spec of importSpecifiers(text)) {
+        if (spec.startsWith('.')) {
+          const target = relative(LAB_ROOT, resolve(file, '..', spec));
+          expect(target.startsWith('..'), `${rel} imports outside the lab: ${spec}`).toBe(false);
+        } else {
+          expect(spec.startsWith('node:') || ALLOWED_PACKAGES.has(spec), `${rel} imports package ${spec}`).toBe(true);
+        }
+      }
+    });
+  }
+});
diff --git a/legion-progression-lab/test/ledger.property.test.ts b/legion-progression-lab/test/ledger.property.test.ts
new file mode 100644
index 0000000..c31c2c2
--- /dev/null
+++ b/legion-progression-lab/test/ledger.property.test.ts
@@ -0,0 +1,64 @@
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { applyTx, BUCKETS, emptyLedger, type Bucket, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import { safeIntArb } from './helpers/reference.ts';
+
+const RESOURCES = ['res.gold', 'res.mat.slime_gel', 'res.mat.copper_ore'];
+const lineArb = fc.record({
+  resourceId: fc.constantFrom(...RESOURCES),
+  bucket: fc.constantFrom<Bucket>(...BUCKETS),
+  delta: fc.oneof(safeIntArb(-50, 50), safeIntArb(-1_000_000, 1_000_000)).filter((d) => d !== 0),
+});
+const txArb = fc.array(fc.array(lineArb, { minLength: 1, maxLength: 5 }), { minLength: 1, maxLength: 60 });
+
+function run(ledger: Ledger, txs: Tx[]): { ledger: Ledger; committed: Tx[]; nets: Map<string, number> } {
+  let current = ledger;
+  const committed: Tx[] = [];
+  const nets = new Map<string, number>();
+  for (const tx of txs) {
+    try {
+      const out = applyTx(current, tx);
+      if (!out.result.replayed) {
+        committed.push(tx);
+        for (const n of out.result.nets) nets.set(`${n.resourceId}|${n.bucket}`, (nets.get(`${n.resourceId}|${n.bucket}`) ?? 0) + n.delta);
+      }
+      current = out.ledger;
+    } catch (e) {
+      if (!(e instanceof LabError)) throw e;
+    }
+  }
+  return { ledger: current, committed, nets };
+}
+
+describe('ledger properties over random transaction sequences', () => {
+  it('balances are never negative and always equal the sum of committed nets (conservation)', () => {
+    fc.assert(
+      fc.property(txArb, (lineSets) => {
+        const txs: Tx[] = lineSets.map((lines, i) => ({ txId: `tx.${i}`, purpose: 'random', lines }));
+        const { ledger, nets } = run(emptyLedger(), txs);
+        for (const r of RESOURCES) {
+          for (const b of BUCKETS) {
+            const bal = ledger.balances.get(r)?.[b] ?? 0;
+            expect(bal).toBeGreaterThanOrEqual(0);
+            expect(bal).toBe(nets.get(`${r}|${b}`) ?? 0);
+          }
+        }
+      }),
+      { seed: 20261113, numRuns: 500 },
+    );
+  });
+
+  it('replaying every transaction again changes nothing (no repeated claims)', () => {
+    fc.assert(
+      fc.property(txArb, (lineSets) => {
+        const txs: Tx[] = lineSets.map((lines, i) => ({ txId: `tx.${i}`, purpose: 'random', lines }));
+        const first = run(emptyLedger(), txs);
+        const again = run(first.ledger, first.committed);
+        expect(again.committed.length).toBe(0);
+        expect([...again.ledger.balances.entries()]).toEqual([...first.ledger.balances.entries()]);
+      }),
+      { seed: 20261113, numRuns: 300 },
+    );
+  });
+});
diff --git a/legion-progression-lab/test/ledger.test.ts b/legion-progression-lab/test/ledger.test.ts
new file mode 100644
index 0000000..4bd7411
--- /dev/null
+++ b/legion-progression-lab/test/ledger.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, it } from 'vitest';
+import { LabError } from '../src/core/errors.ts';
+import { applyTx, balance, emptyLedger, type Ledger, type Tx } from '../src/core/ledger/ledger.ts';
+import { MAX_SAFE } from '../src/core/numeric/safeInt.ts';
+
+function code(fn: () => unknown): string {
+  try {
+    fn();
+  } catch (e) {
+    if (e instanceof LabError) return e.code;
+    throw e;
+  }
+  return 'NO_ERROR';
+}
+
+const grant = (txId: string, delta: number, resourceId = 'res.gold'): Tx => ({ txId, purpose: 'grant', lines: [{ resourceId, bucket: 'available', delta }] });
+
+describe('ledger', () => {
+  it('aggregates lines per bucket before validating', () => {
+    const { ledger, result } = applyTx(emptyLedger(), {
+      txId: 'tx.1',
+      purpose: 'deposit',
+      lines: [
+        { resourceId: 'res.gold', bucket: 'available', delta: -3 },
+        { resourceId: 'res.gold', bucket: 'available', delta: 5 },
+      ],
+    });
+    expect(balance(ledger, 'res.gold')).toBe(2);
+    expect(result.nets).toEqual([{ resourceId: 'res.gold', bucket: 'available', delta: 2 }]);
+  });
+
+  it('is atomic: a failing line changes nothing, and the input ledger is never mutated', () => {
+    const start = applyTx(emptyLedger(), grant('tx.a', 5)).ledger;
+    const snapshot = JSON.stringify([...start.balances.entries()]);
+    expect(
+      code(() =>
+        applyTx(start, {
+          txId: 'tx.b',
+          purpose: 'craft',
+          lines: [
+            { resourceId: 'res.gold', bucket: 'available', delta: -10 },
+            { resourceId: 'res.mat.slime_gel', bucket: 'available', delta: 1 },
+          ],
+        }),
+      ),
+    ).toBe('NEGATIVE_BALANCE');
+    expect(JSON.stringify([...start.balances.entries()])).toBe(snapshot);
+    expect(balance(start, 'res.mat.slime_gel')).toBe(0);
+    expect(start.committed.has('tx.b')).toBe(false);
+  });
+
+  it('replays an identical transaction without applying it twice', () => {
+    const first = applyTx(emptyLedger(), grant('tx.c', 10));
+    const second = applyTx(first.ledger, grant('tx.c', 10));
+    expect(second.ledger).toBe(first.ledger);
+    expect(second.result.replayed).toBe(true);
+    expect(balance(second.ledger, 'res.gold')).toBe(10);
+  });
+
+  it('identical payloads replay regardless of object key order (canonical hashing)', () => {
+    const first = applyTx(emptyLedger(), { txId: 'tx.k', purpose: 'grant', lines: [{ resourceId: 'res.gold', bucket: 'available', delta: 3 }] });
+    const reordered = { lines: [{ delta: 3, bucket: 'available', resourceId: 'res.gold' }], purpose: 'grant', txId: 'tx.k' } as unknown as Tx;
+    expect(applyTx(first.ledger, reordered).result.replayed).toBe(true);
+  });
+
+  it('refuses the same txId with a different payload', () => {
+    const first = applyTx(emptyLedger(), grant('tx.d', 10)).ledger;
+    expect(code(() => applyTx(first, grant('tx.d', 11)))).toBe('TX_CONFLICT');
+    expect(code(() => applyTx(first, { ...grant('tx.d', 10), purpose: 'other' }))).toBe('TX_CONFLICT');
+  });
+
+  it('a failed transaction is not recorded and can succeed later', () => {
+    let ledger: Ledger = emptyLedger();
+    expect(code(() => applyTx(ledger, grant('tx.e', -5)))).toBe('NEGATIVE_BALANCE');
+    ledger = applyTx(ledger, grant('tx.f', 10)).ledger;
+    ledger = applyTx(ledger, grant('tx.e', -5)).ledger;
+    expect(balance(ledger, 'res.gold')).toBe(5);
+  });
+
+  it('refuses overflow, including overflow while aggregating', () => {
+    const full = applyTx(emptyLedger(), grant('tx.g', MAX_SAFE)).ledger;
+    expect(code(() => applyTx(full, grant('tx.h', 1)))).toBe('NUMERIC_LIMIT');
+    expect(
+      code(() =>
+        applyTx(emptyLedger(), {
+          txId: 'tx.i',
+          purpose: 'grant',
+          lines: [
+            { resourceId: 'res.gold', bucket: 'available', delta: MAX_SAFE },
+            { resourceId: 'res.gold', bucket: 'available', delta: MAX_SAFE },
+          ],
+        }),
+      ),
+    ).toBe('NUMERIC_LIMIT');
+  });
+
+  it('refuses malformed transactions', () => {
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 0)))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 1.5)))).toBe('INVALID_NUMBER');
+    expect(code(() => applyTx(emptyLedger(), grant('tx.z', 1, 'gold')))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { txId: 'tx.z', purpose: 'grant', lines: [] }))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { ...grant('tx.z', 1), cause: undefined } as unknown as Tx))).toBe('INVALID_TX');
+    expect(code(() => applyTx(emptyLedger(), { ...grant('', 1) }))).toBe('INVALID_TX');
+  });
+});
