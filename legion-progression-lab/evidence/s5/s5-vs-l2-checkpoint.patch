@@ -0,0 +1,37 @@
+/**
+ * S5 exploratory workload (owner §17: small exploratory workloads before registering the expensive comparisons): one
+ * seed per profile, seven wall days, observed at D1, D3 and D7; the lab cost per replicate and where the slice content
+ * ends (the EXP table runs out at level 201). Not a registered experiment.
+ *   node repro/s5/explore_profiles.ts <out.json>
+ */
+import { writeFileSync } from 'node:fs';
+import { loadS5Content } from '../../src/cli/s5-content.ts';
+import { LegionSimulation } from '../../src/engine/legion.ts';
+import { HOUR_MS as H } from '../../src/engine/offline.ts';
+import { PROFILE_IDS, pol5, profileSessions } from '../../src/s5/profiles.ts';
+
+const out = process.argv[2] ?? 'explore-profiles.json';
+const C = loadS5Content();
+const D = 24 * H;
+const rows: Record<string, unknown>[] = [];
+for (const p of PROFILE_IDS) {
+  const sessions = profileSessions(p, 7);
+  const sim = new LegionSimulation({ content: C, seedRoot: `explore#${p}`, sessions, policy: pol5('POL5-BAL'), legion: true, industry: true, permanent: true, keepLog: 0, hashLog: false, ledger: 'bounded', identity: 'l2', offline: {} });
+  const t0 = performance.now();
+  const obs: Record<string, unknown>[] = [];
+  let stopped: string | null = null;
+  for (const day of [1, 3, 7]) {
+    try {
+      // Advance to the wall day (sessions and absences in order).
+      sim.runToWall(day * D);
+    } catch (e) {
+      stopped = `before D${day}: ${(e as Error).message.slice(0, 120)}`;
+      break;
+    }
+    const st = sim.state;
+    obs.push({ day, gameHours: Math.round((st.tMs / H) * 10) / 10, heroLevel: st.hero.level, gold: sim.goldBalance(), eternity: st.permanent?.monuments['monument.eternity']?.level ?? 0, recruits: st.legion.chars.length - 1, wallMsLab: Math.round(performance.now() - t0) });
+  }
+  rows.push({ profile: p, sessionsPerWeek: sessions.length, observations: obs, stopped, wallMsLab: Math.round(performance.now() - t0) });
+  console.log(JSON.stringify(rows[rows.length - 1]));
+}
+writeFileSync(out, JSON.stringify({ note: 'exploratory, one seed per profile', rows }, null, 2) + '\n');
diff --git a/legion-progression-lab/repro/s5/growth.ts b/legion-progression-lab/repro/s5/growth.ts
new file mode 100644
index 0000000..fd6a9d2
--- /dev/null
+++ b/legion-progression-lab/repro/s5/growth.ts
@@ -0,0 +1,75 @@
+/**
+ * S5 checkpoint A (owner §6): long-duration state growth of the ACTUAL engine account (S4 content: legion, industry
+ * and permanent progression), L1 identity against the bounded identity. A daily play pattern (two sessions a day,
+ * 07:00–10:00 and 18:00–21:00 game time), measured at the end of every day: the full checkpoint size and its parts,
+ * and the live heap after a forced collection when node runs with --expose-gc.
+ *   node --expose-gc repro/s5/growth.ts <out.json> [days both identities] [days bounded only]
+ * This measures the lab engine's checkpoint document; it is not a measurement of a Roblox DataStore record.
+ */
+import { writeFileSync } from 'node:fs';
+import { loadS4Content } from '../../src/cli/s4-content.ts';
+import { LegionSimulation, type LegionOptions } from '../../src/engine/legion.ts';
+import { saveSimulation } from '../../src/l2/simCheckpoint.ts';
+import { pol4 } from '../../src/policy/permanentPolicies.ts';
+
+const out = process.argv[2] ?? 'growth.json';
+const daysBoth = Number(process.argv[3] ?? '7');
+const daysBounded = Number(process.argv[4] ?? '28');
+const H = 3_600_000;
+const D = 24 * H;
+const C = loadS4Content();
+const sessionsFor = (days: number) => Array.from({ length: days }, (_, d) => [{ startMs: d * D + 7 * H, endMs: d * D + 10 * H }, { startMs: d * D + 18 * H, endMs: d * D + 21 * H }]).flat();
+const POLICIES = ['POL4-BALANCED2', 'POL4-MONUMENT2', 'POL4-BESTIARY'];
+const gc = (globalThis as { gc?: () => void }).gc;
+const sz = (x: unknown) => (x === undefined ? 0 : Buffer.byteLength(JSON.stringify(x)));
+
+type Row = { day: number; bytes: number; ledger: number; credits: number; items: number; itemCount: number; jobs: number; events: number; other: number; heapMB: number | null; wallMs: number };
+/** Measures day by day; stops early (recorded) if the run leaves the content (e.g. the EXP table ends). */
+function measure(policy: string, l2: boolean, days: number): { rows: Row[]; stopped: string | null } {
+  const o: LegionOptions = { content: C, seedRoot: `growth#${policy}`, sessions: sessionsFor(days), policy: pol4(policy), legion: true, industry: true, permanent: true, keepLog: 0, ledger: l2 ? 'bounded' : 'persistent', ...(l2 ? { identity: 'l2' as const } : {}) };
+  const sim = new LegionSimulation(o);
+  const rows: Row[] = [];
+  const t0 = performance.now();
+  for (let day = 1; day <= days; day += 1) {
+    try {
+      sim.run(day * D - 1);
+    } catch (e) {
+      return { rows, stopped: `day ${day}: ${(e as Error).message}` };
+    }
+    const text = saveSimulation(sim);
+    const d = JSON.parse(text);
+    const st = d.state;
+    const ledger = sz(st.ledger);
+    const credits = sz(st.legion?.credits);
+    const items = sz(st.industry?.items);
+    const jobs = sz(st.industry?.jobs);
+    const events = sz(d.runtime?.events);
+    const bytes = Buffer.byteLength(text);
+    let heapMB: number | null = null;
+    if (gc) {
+      gc();
+      heapMB = Math.round((process.memoryUsage().heapUsed / 2 ** 20) * 10) / 10;
+    }
+    rows.push({ day, bytes, ledger, credits, items, itemCount: (st.industry?.items ?? []).length, jobs, events, other: bytes - ledger - credits - items - jobs - events, heapMB, wallMs: Math.round(performance.now() - t0) });
+  }
+  return { rows, stopped: null };
+}
+
+const t0 = performance.now();
+const runs: { policy: string; identity: string; days: number; stopped: string | null; rows: Row[] }[] = [];
+for (const p of POLICIES) {
+  for (const l2 of [false, true]) {
+    const { rows, stopped } = measure(p, l2, daysBoth);
+    runs.push({ policy: p, identity: l2 ? 'l2-bounded' : 'l1', days: daysBoth, stopped, rows });
+    const last = rows[rows.length - 1] as Row;
+    console.log(`${p} ${l2 ? 'l2' : 'l1'} ${daysBoth}d: ${last.bytes} B (ledger ${last.ledger}, credits ${last.credits}, items ${last.items}/${last.itemCount}), heap ${last.heapMB} MB, ${last.wallMs} ms`);
+  }
+}
+for (const p of POLICIES) {
+  const { rows: long, stopped } = measure(p, true, daysBounded);
+  runs.push({ policy: p, identity: 'l2-bounded', days: daysBounded, stopped, rows: long });
+  const ll = long[long.length - 1] as Row;
+  console.log(`${p} l2 ${daysBounded}d: reached day ${ll.day}${stopped ? ` (stopped ${stopped})` : ''}: ${ll.bytes} B (ledger ${ll.ledger}, credits ${ll.credits}, items ${ll.items}/${ll.itemCount}), heap ${ll.heapMB} MB, ${ll.wallMs} ms; max over days ${Math.max(...long.map((r) => r.bytes))} B`);
+}
+const result = { note: 'Actual lab-engine checkpoint documents (S4 content, two 3-hour sessions per game day). Not a Roblox DataStore measurement.', sessionsPerDay: 2, sessionHours: 3, gcExposed: Boolean(gc), runs, wallMs: Math.round(performance.now() - t0) };
+writeFileSync(out, JSON.stringify(result, null, 2) + '\n');
diff --git a/legion-progression-lab/repro/s5/historical_controls.sh b/legion-progression-lab/repro/s5/historical_controls.sh
new file mode 100644
index 0000000..6dad751
--- /dev/null
+++ b/legion-progression-lab/repro/s5/historical_controls.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# S5 historical regression (owner §17): the exact dependency cache shows which historical experiments S5's engine and
+# core changes invalidate; representative controls are then re-executed fresh (--verify against their stored baseline
+# fingerprints) instead of re-running all 45 families. Run alone, after the registered S5 runs.
+#   bash repro/s5/historical_controls.sh <out-dir> <node-dir> <L2 review zip>
+set -u
+OUT="${1:?out dir}"
+NODE_DIR="${2:?node dir}"
+L2ZIP="${3:?the L2 review package (the cache baseline)}"
+mkdir -p "$OUT"
+python -I -X utf8 repro/l2.1/history_cache.py . "$L2ZIP" "$NODE_DIR" > "$OUT/history-cache.txt" 2>&1
+echo "history cache exit $?" >> "$OUT/history-cache.txt"
+# S2 experiments verify against the S2.1 audit baseline and S3 experiments against the S3.1 audit (as in L2.1).
+CONTROLS=(
+  "exp.ts|manifests/s1.1/S1.1-E03-earlier-zone-audit.json|"
+  "exp2.ts|manifests/s2/S2-E04-class-switch-abuse.json|evidence/s2.1/experiments/audit"
+  "exp2.ts|manifests/s2/S2-E05-squad-vs-workers.json|evidence/s2.1/experiments/audit"
+  "exp2.ts|manifests/s2.1/S2.1-E03-knockout-diagnostic.json|"
+  "exp3.ts|manifests/s3/S3-E02-queue-contention.json|results/s3.1/audit"
+  "exp3.ts|manifests/s3/S3-E03-shortage-timelines.json|results/s3.1/audit"
+  "exp3.ts|manifests/s3.1/S3.1-E03-equipment-strength.json|"
+  "exp4.ts|manifests/s4/S4-E03-elasticity.json|"
+  "exp4.ts|manifests/s4/S4-E04-soft-caps.json|"
+)
+{
+  echo "# Representative historical controls executed with the S5 code (--verify against the stored baseline fingerprints)"
+  for c in "${CONTROLS[@]}"; do
+    IFS='|' read -r runner manifest results <<< "$c"
+    extra=()
+    if [ -n "$results" ]; then extra=(--results-dir "$results"); fi
+    t0=$(date +%s%3N)
+    node "src/cli/$runner" "$manifest" --verify "${extra[@]}" > "$OUT/control.log" 2>&1
+    code=$?
+    t1=$(date +%s%3N)
+    verdict=$(grep -E ': (MATCH|MISMATCH)' "$OUT/control.log" | tail -1)
+    echo "$(basename "$manifest" .json): exit $code ($((t1 - t0)) ms) ${verdict:-no verdict line}"
+  done
+} > "$OUT/historical-controls.txt" 2>&1
+rm -f "$OUT/control.log"
diff --git a/legion-progression-lab/repro/s5/identity_differential.ts b/legion-progression-lab/repro/s5/identity_differential.ts
new file mode 100644
index 0000000..2fd2d58
--- /dev/null
+++ b/legion-progression-lab/repro/s5/identity_differential.ts
@@ -0,0 +1,89 @@
+/**
+ * S5 checkpoint A: the actual engine under the L1 identity (persistent ledger) and the bounded identity (bounded ledger,
+ * settled credit ranges, retired items and jobs), same content, policy, seed and sessions. Gameplay must be identical:
+ * the event log digest, the run counters, and the state outside the identity evidence (the ledger's history, the
+ * credit registry's representation, spent items and finished jobs, the counters). Also the checkpoint size of both at
+ * each cut, and save / restore / resume in the bounded identity.
+ *   node repro/s5/identity_differential.ts <out.json> [hours] [seeds]
+ */
+import { writeFileSync } from 'node:fs';
+import { canonicalJson } from '../../src/core/hash/canonicalJson.ts';
+import { loadS2Content } from '../../src/cli/s2-content.ts';
+import { loadS3Content } from '../../src/cli/s3-content.ts';
+import { loadS4Content } from '../../src/cli/s4-content.ts';
+import { LegionSimulation, type LegionOptions } from '../../src/engine/legion.ts';
+import { restoreSimulation, saveSimulation } from '../../src/l2/simCheckpoint.ts';
+import { pol2 } from '../../src/policy/legionRealistic.ts';
+import { pol3 } from '../../src/policy/industryRealistic.ts';
+import { pol4 } from '../../src/policy/permanentPolicies.ts';
+
+const out = process.argv[2] ?? 'identity-differential.json';
+const hours = Number(process.argv[3] ?? '14');
+const seeds = Number(process.argv[4] ?? '2');
+const H = 3_600_000;
+const sessions = hours > 8 ? [{ startMs: 0, endMs: 5 * H }, { startMs: 8 * H, endMs: hours * H }] : [{ startMs: 0, endMs: hours * H }];
+const s2 = loadS2Content();
+const s3 = loadS3Content();
+const s4 = loadS4Content();
+const CONFIGS = [
+  { id: 's2-squad', content: s2, policy: () => pol2('POL2-SQUAD'), industry: false, permanent: false },
+  { id: 's2-workers', content: s2, policy: () => pol2('POL2-WORKERS'), industry: false, permanent: false },
+  { id: 's3-bal', content: s3, policy: () => pol3('POL3-BAL'), industry: true, permanent: false },
+  { id: 's3-equip', content: s3, policy: () => pol3('POL3-EQUIP'), industry: true, permanent: false },
+  { id: 's4-bal2', content: s4, policy: () => pol4('POL4-BALANCED2'), industry: true, permanent: true },
+  { id: 's4-mon2', content: s4, policy: () => pol4('POL4-MONUMENT2'), industry: true, permanent: true },
+  { id: 's4-best', content: s4, policy: () => pol4('POL4-BESTIARY'), industry: true, permanent: true },
+];
+const opts = (c: (typeof CONFIGS)[number], seed: string, l2: boolean): LegionOptions => ({ content: c.content as never, seedRoot: `${c.id}#${seed}`, sessions, policy: c.policy(), legion: true, industry: c.industry, permanent: c.permanent, keepLog: 0, ledger: l2 ? 'bounded' : 'persistent', ...(l2 ? { identity: 'l2' as const } : {}) });
+
+/** The state outside the identity evidence, as canonical text. */
+function gameplay(sim: LegionSimulation): string {
+  const st = JSON.parse(saveSimulation(sim)).state;
+  st.ledger = { balances: st.ledger.balances };
+  st.legion.credits = { pending: st.legion.credits.pending };
+  if (st.industry) {
+    st.industry.items = st.industry.items.filter((i: { location: { kind: string } }) => i.location.kind !== 'consumed' && i.location.kind !== 'salvaged');
+    const used = new Set([...Object.values(st.industry.work), ...Object.values(st.industry.pending)].map((w) => ((w as { kind: string }).kind === 'unit' ? (w as { jobId: string }).jobId : '')));
+    st.industry.jobs = st.industry.jobs.filter((j: { id: string; state: string }) => (j.state !== 'complete' && j.state !== 'cancelled') || used.has(j.id));
+    delete st.industry.nextItem;
+    delete st.industry.nextJob;
+  }
+  return canonicalJson(st);
+}
+
+const rows: unknown[] = [];
+let mismatches = 0;
+const t0 = performance.now();
+for (const c of CONFIGS) {
+  for (let k = 0; k < seeds; k += 1) {
+    const seed = `identity-${k}`;
+    const a = new LegionSimulation(opts(c, seed, false));
+    let b = new LegionSimulation(opts(c, seed, true));
+    const sizes: { h: number; l1Bytes: number; l2Bytes: number; l1Committed: number; l2Settled: number }[] = [];
+    let same = true;
+    let restoreCycles = 0;
+    for (let h = 2; h <= hours; h += 2) {
+      a.run(h * H);
+      b.run(h * H);
+      const ta = saveSimulation(a);
+      const tb = saveSimulation(b);
+      // Save / restore / resume in the bounded identity at every cut.
+      b = restoreSimulation(tb, opts(c, seed, true));
+      restoreCycles += 1;
+      const da = JSON.parse(ta).state.legion.credits;
+      const db = JSON.parse(tb).state.legion.credits;
+      sizes.push({ h, l1Bytes: Buffer.byteLength(ta), l2Bytes: Buffer.byteLength(tb), l1Committed: da.committedCount, l2Settled: Object.values(db.settled as Record<string, { p: number; runs: number[][] }>).reduce((s, r) => s + r.p + r.runs.reduce((x, [p, q]) => x + (q as number) - (p as number) + 1, 0), 0) });
+      if (gameplay(a) !== gameplay(b) || canonicalJson(a.counters as never) !== canonicalJson(b.counters as never)) same = false;
+    }
+    // The log digests: the bounded run was restored mid-way (its digest is a resume chain), so compare a fresh
+    // uninterrupted bounded run's digest with the L1 one.
+    const c2 = new LegionSimulation(opts(c, seed, true));
+    c2.run(hours * H);
+    const digestSame = c2.logDigest() === a.logDigest();
+    if (!same || !digestSame) mismatches += 1;
+    rows.push({ config: c.id, seed, gameplayIdentical: same, logDigestIdentical: digestSame, restoreCycles, sizes });
