+{
+  "fixtureSet": "s5-offline-credit",
+  "fixtureVersion": 1,
+  "specRef": "spec/formulas/s5-offline.md#v1",
+  "status": "candidate",
+  "independence": "S5 rules (spec/formulas/s5-offline.md v1) re-derived by spec/oracle/s5_oracle.py from the rule text with Python integers and exact fractions; the lab side calls the real S5 functions. Derivations are hand-written. Written by the same author as the code (not an independent party).",
+  "cases": [
+    {
+      "id": "s5.cr.zero",
+      "kind": "boundary",
+      "description": "zero absence credits nothing",
+      "input": {
+        "w": 0,
+        "normalBp": 6000
+      },
+      "derivation": "P(0) = 0 by the first case of the rule (w <= 0).",
+      "expected": {
+        "rateE8": 30000000,
+        "creditedMs": 0,
+        "windows": []
+      }
+    },
+    {
+      "id": "s5.cr.negative",
+      "kind": "boundary",
+      "description": "a negative clock anomaly credits nothing",
+      "input": {
+        "w": -5000,
+        "normalBp": 6000
+      },
+      "derivation": "w <= 0 gives 0; the absence clock never runs backwards into credit.",
+      "expected": {
+        "rateE8": 30000000,
+        "creditedMs": 0,
+        "windows": []
+      }
+    },
+    {
+      "id": "s5.cr.one-ms",
+      "kind": "boundary",
+      "description": "one millisecond floors to zero at 60 %",
+      "input": {
+        "w": 1,
+        "normalBp": 6000
+      },
+      "derivation": "floor(6000 * 10^4 * 1 / 10^8) = floor(0.6) = 0.",
+      "expected": {
+        "rateE8": 30000000,
+        "creditedMs": 0,
+        "windows": [
+          {
+            "window": "normal",
+            "fromMs": 0,
+            "toMs": 1,
+            "rateE8": 60000000
+          }
+        ]
+      }
+    },
+    {
+      "id": "s5.cr.two-ms",
+      "kind": "boundary",
+      "description": "two milliseconds credit one",
+      "input": {
+        "w": 2,
+        "normalBp": 6000
+      },
+      "derivation": "floor(6000 * 10^4 * 2 / 10^8) = floor(1.2) = 1.",
+      "expected": {
+        "rateE8": 30000000,
+        "creditedMs": 1,
+        "windows": [
+          {
+            "window": "normal",
+            "fromMs": 0,
+            "toMs": 2,
+            "rateE8": 60000000
+          }
+        ]
+      }
+    },
+    {
