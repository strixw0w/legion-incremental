+    const st = JSON.parse(store.load(env).checkpoint).state;
+    const reclaim = code(handle(store, { type: 'settle', id: rid(), branch: 'main', absence: 'absence:0', fromWallMs: T, toWallMs: T + w }, T + w, env));
+    const checks = {
