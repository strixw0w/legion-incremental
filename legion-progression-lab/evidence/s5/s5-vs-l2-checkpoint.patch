+      windows: canonicalJson((sum?.credited.windows ?? []).map((x) => x.window) as never) === canonicalJson([...(w > 0 ? ['normal'] : []), ...(w > 24 * H ? ['reduced'] : []), ...(w > 72 * H ? ['beyond-cap'] : [])] as never),
