+++ b/legion-progression-lab/src/cli/exp4-worker.ts
@@ -0,0 +1,17 @@
+/** Worker thread for the S4 runner: compiles each variant once, runs its share of jobs, returns the results. */
+import { parentPort, workerData } from 'node:worker_threads';
+import { compileIndustryContent } from '../model/industryContent.ts';
+import { compilePermanentContent, type PermanentContent } from '../model/permanentContent.ts';
+import { runS4Job, type S4Job, type S4JobResult } from '../experiments/s4Jobs.ts';
+
+interface Input {
+  readonly variants: readonly { id: string; base: unknown; table: unknown; legion: unknown; industry: unknown; permanent: unknown }[];
+  readonly jobs: readonly S4Job[];
+}
+
+const input = workerData as Input;
+const compiled = new Map<string, PermanentContent>();
+for (const v of input.variants) compiled.set(v.id, compilePermanentContent(compileIndustryContent(v.base, v.table, v.legion, v.industry), v.industry, v.permanent));
+const results: S4JobResult[] = [];
+for (const job of input.jobs) results.push(runS4Job(job, compiled.get(job.cell.variant) as PermanentContent));
+parentPort?.postMessage(results);
diff --git a/legion-progression-lab/src/cli/exp4.ts b/legion-progression-lab/src/cli/exp4.ts
new file mode 100644
index 0000000..8fdd7a2
--- /dev/null
+++ b/legion-progression-lab/src/cli/exp4.ts
@@ -0,0 +1,176 @@
+/**
+ * Runs or verifies a pre-registered S4 experiment (manifests/s4/; preregistration.json there).
+ *   node src/cli/exp4.ts manifests/s4/<id>.json [--workers N] [--ledger reference|persistent]   run, write results/s4/<id>/
+ *   node src/cli/exp4.ts manifests/s4/<id>.json --verify [...]                                  re-run, compare the fingerprint
+ *   node src/cli/exp4.ts manifests/s4/<id>.json --determinism <secondRoot> [...]                re-run + second seeds + KS
+ * Refuses a manifest that is not registered with the same SHA-256, and content whose fingerprints differ from the
+ * manifest's chain (S4 pack -> S3 pack -> S2 pack -> S1 pack). The semantic result reuses the S2 summary under the
+ * schema name legion.s4.experiment.v1.
+ */
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import { existsSync, readFileSync } from 'node:fs';
+import { arch, cpus, platform, release } from 'node:os';
+import { dirname, resolve } from 'node:path';
+import { Worker } from 'node:worker_threads';
+import { canonicalJson, fingerprint } from '../core/hash/canonicalJson.ts';
+import { compileIndustryContent } from '../model/industryContent.ts';
+import { compilePermanentContent } from '../model/permanentContent.ts';
+import type { S2Manifest } from '../experiments/legionManifest.ts';
+import type { S2JobResult } from '../experiments/legionJobs.ts';
+import { renderS2QuantilesCsv, renderS2Report, summariseS2, type S2CellMeta } from '../experiments/legionSummary.ts';
+import type { SweepTable } from '../experiments/patch.ts';
+import { S4ManifestSchema, type S4Manifest } from '../experiments/s4Manifest.ts';
+import type { S4Job, S4JobResult } from '../experiments/s4Jobs.ts';
+import { patchS4Variant } from '../experiments/s4Patch.ts';
+import { ksTwoSample } from '../experiments/stats.ts';
+import { LAB_ROOT, prettyJson, readJson, writeText } from './paths.ts';
+import { readS1Pack } from './s1-content.ts';
+
+const args = process.argv.slice(2);
+const flag = (name: string): string | undefined => {
+  const i = args.indexOf(name);
+  return i >= 0 ? args[i + 1] : undefined;
+};
+const flagValues = new Set([flag('--workers'), flag('--ledger'), flag('--determinism'), flag('--results-dir')].filter((x): x is string => x !== undefined));
+const manifestRel = (args.find((a) => !a.startsWith('--') && !flagValues.has(a)) ?? '').replace(/\\/g, '/');
+const workerCount = Math.max(1, Number(flag('--workers') ?? Math.min(15, cpus().length - 1)));
+const verify = args.includes('--verify');
+const secondRoot = flag('--determinism');
+const ledgerImpl = (flag('--ledger') ?? 'persistent') as 'reference' | 'persistent';
+if (ledgerImpl !== 'reference' && ledgerImpl !== 'persistent') throw new Error(`unknown --ledger ${String(ledgerImpl)}`);
+
+function refuse(message: string): never {
+  console.error(`REFUSED: ${message}`);
+  process.exit(2);
+}
+
+const raw = readFileSync(resolve(LAB_ROOT, manifestRel));
+const manifestSha = createHash('sha256').update(raw).digest('hex');
+const manifest: S4Manifest = S4ManifestSchema.parse(JSON.parse(raw.toString('utf8')));
+const manifestDir = dirname(manifestRel);
+const prereg = readJson(resolve(LAB_ROOT, manifestDir, 'preregistration.json')) as { manifests: { path: string; sha256: string }[]; amendments?: { path: string; sha256: string }[] };
+const registered = [...prereg.manifests, ...(prereg.amendments ?? [])].find((m) => m.path === manifestRel);
+if (!registered) refuse(`${manifestRel} is not pre-registered`);
+if (registered.sha256 !== manifestSha) refuse(`${manifestRel} changed after pre-registration (registered ${registered.sha256}, now ${manifestSha})`);
+
+const permanentPack = readJson(resolve(LAB_ROOT, manifest.contentRef.path)) as { basePack: { path: string; sha256: string } } & Record<string, unknown>;
+if (fingerprint(permanentPack) !== manifest.contentRef.sha256) refuse(`content ${manifest.contentRef.path} does not match the manifest's fingerprint`);
+const industryPack = readJson(resolve(LAB_ROOT, permanentPack.basePack.path)) as { basePack: { path: string; sha256: string } } & Record<string, unknown>;
+if (fingerprint(industryPack) !== permanentPack.basePack.sha256) refuse("the S3 pack does not match the S4 pack's basePack fingerprint");
+const legionPack = readJson(resolve(LAB_ROOT, industryPack.basePack.path)) as { basePack: { path: string; sha256: string } } & Record<string, unknown>;
+if (fingerprint(legionPack) !== industryPack.basePack.sha256) refuse("the S2 pack does not match the S3 pack's basePack fingerprint");
+const base = readS1Pack(legionPack.basePack.path);
+if (fingerprint(base.pack) !== legionPack.basePack.sha256) refuse("the S1 base pack does not match the S2 pack's basePack fingerprint");
+const index = readJson(resolve(LAB_ROOT, 'content/tables/xp-sweep.index.json')) as { tables: { a: number; p: number; path: string; sha256: string }[] };
+const sweep: SweepTable[] = index.tables.map((t) => {
+  const json = readJson(resolve(LAB_ROOT, t.path));
+  if (fingerprint(json) !== t.sha256) refuse(`sweep table ${t.path} does not match its recorded fingerprint`);
+  return { ...t, json };
+});
+
+const variants = manifest.variants.map((v) => ({ id: v.id, ...patchS4Variant(base, legionPack, industryPack, permanentPack, v.params, sweep) }));
+const variantHashes = Object.fromEntries(
+  variants.map((v) => {
+    const c = compilePermanentContent(compileIndustryContent(v.base, v.table, v.legion, v.industry), v.industry, v.permanent);
+    return [v.id, { contentHash: c.contentHash, tableHash: c.tableHash, legionContentHash: c.legionContentHash, industryContentHash: c.industryContentHash, permanentContentHash: c.permanentContentHash }];
+  }),
+);
+
+const cells: S2CellMeta[] = manifest.cells.map((c, index) => ({
+  index,
+  id: c.id,
+  kind: c.kind as S2CellMeta['kind'],
+  variant: c.variant,
+  tag: c.start ? 'diagnostic' : 'realistic',
+  policy: c.policy,
+  profile: null,
+}));
+for (const c of manifest.cells) if (!variants.some((v) => v.id === c.variant)) refuse(`cell ${c.id}: unknown variant ${c.variant}`);
+
+const jobsFor = (root: string): S4Job[] => {
+  const jobs: S4Job[] = [];
+  manifest.cells.forEach((cell, index) => {
+    for (let i = 0; i < manifest.seeds.replicates; i += 1) jobs.push({ cellIndex: index, replicate: i, seedRoot: `${root}#rep-${i}`, cell, ledger: ledgerImpl, ...(i === 0 ? { trace: true } : {}) });
+  });
+  return jobs;
+};
+
+async function runAll(jobs: S4Job[]): Promise<S4JobResult[]> {
+  const shares: S4Job[][] = Array.from({ length: Math.min(workerCount, jobs.length) }, () => []);
+  jobs.forEach((j, i) => (shares[i % shares.length] as S4Job[]).push(j));
+  const parts = await Promise.all(
+    shares.map(
+      (share) =>
+        new Promise<S4JobResult[]>((ok, ko) => {
+          const w = new Worker(new URL('./exp4-worker.ts', import.meta.url), { workerData: { variants, jobs: share } });
+          w.once('message', (m: S4JobResult[]) => ok(m));
+          w.once('error', ko);
+        }),
+    ),
+  );
+  return parts.flat().sort((a, b) => a.cell - b.cell || a.replicate - b.replicate);
+}
+
+function gitInfo(): { commit: string; dirty: boolean } {
+  try {
+    const commit = execFileSync('git', ['--no-optional-locks', 'rev-parse', 'HEAD'], { cwd: LAB_ROOT }).toString().trim();
+    const dirty = execFileSync('git', ['--no-optional-locks', 'status', '--porcelain'], { cwd: LAB_ROOT }).toString().trim().length > 0;
+    return { commit, dirty };
+  } catch {
+    return { commit: 'unknown', dirty: true };
+  }
+}
+
+const summarise = (rs: S4JobResult[]) => ({ ...summariseS2(manifest as unknown as S2Manifest, manifestSha, variantHashes, cells, rs as unknown as S2JobResult[]), schema: 'legion.s4.experiment.v1' });
+const started = Date.now();
+const results = await runAll(jobsFor(manifest.seeds.root));
+const stripTrace = (rs: S4JobResult[]): S4JobResult[] => rs.map(({ trace: _t, ...r }) => r);
+const semantic = summarise(stripTrace(results));
+const semanticFingerprint = fingerprint(semantic);
+const outDir = resolve(LAB_ROOT, flag('--results-dir') ?? `results/${manifestDir.replace(/^manifests\//, '')}`, manifest.experimentId);
+const git = gitInfo();
+const mem = process.memoryUsage();
+const environment = { experimentId: manifest.experimentId, node: process.version, platform: platform(), release: release(), arch: arch(), cpus: cpus().length, workers: workerCount, ledger: ledgerImpl, labCommit: git.commit, workingTreeDirty: git.dirty, startedAt: new Date(started).toISOString(), durationMs: Date.now() - started, jobs: results.length, mainRssMb: Math.round(mem.rss / 1e6), mainHeapUsedMb: Math.round(mem.heapUsed / 1e6) };
+
+if (verify) {
+  const stored = existsSync(resolve(outDir, 'fingerprint.txt')) ? readFileSync(resolve(outDir, 'fingerprint.txt'), 'utf8').trim() : '(none)';
+  const match = stored === semanticFingerprint;
+  console.log(`${manifest.experimentId}: stored ${stored}`);
+  console.log(`${manifest.experimentId}: rerun  ${semanticFingerprint} (ledger ${ledgerImpl})`);
+  console.log(`${manifest.experimentId}: ${match ? 'MATCH' : 'MISMATCH'} (${environment.durationMs} ms, ${workerCount} workers)`);
+  process.exit(match ? 0 : 1);
+}
+
+if (secondRoot !== undefined) {
+  const again = await runAll(jobsFor(manifest.seeds.root));
+  const other = await runAll(jobsFor(secondRoot));
+  const identical = results.every((r, i) => r.digest !== null && r.digest === again[i]?.digest);
+  const sameFingerprint = fingerprint(summarise(stripTrace(again))) === semanticFingerprint;
+  const differ = results.filter((r, i) => r.digest !== other[i]?.digest).length;
+  const ks = cells.flatMap((c) =>
+    manifest.metrics.map((m) => {
+      const a = results.filter((r) => r.cell === c.index).map((r) => r.values[m]).filter((v): v is number => v !== null && v !== undefined);
+      const b = other.filter((r) => r.cell === c.index).map((r) => r.values[m]).filter((v): v is number => v !== null && v !== undefined);
+      if (a.length === 0 || b.length === 0) return { cell: c.id, metric: m, n: [a.length, b.length], d: null, critical: null, distributionsDiffer: false };
+      const t = ksTwoSample(a, b);
+      return { cell: c.id, metric: m, n: [a.length, b.length], d: t.d, critical: t.critical, distributionsDiffer: t.differs };
+    }),
+  );
+  const report = { experimentId: manifest.experimentId, runsCompared: results.length, rerunEventLogDigestsIdentical: identical, rerunSemanticFingerprintIdentical: sameFingerprint, secondSeedRoot: secondRoot, secondSeedRunsWithDifferentEventLogs: differ, ksAlpha: 0.001, ksTests: ks.length, ksRejections: ks.filter((k) => k.distributionsDiffer).length, ks };
+  writeText(resolve(outDir, 'determinism.json'), prettyJson(report));
+  console.log(`${manifest.experimentId}: determinism rerun identical=${identical} fingerprint=${sameFingerprint}; second root differs in ${differ}/${results.length}; KS rejections ${report.ksRejections}/${ks.length}`);
+  process.exit(identical && sameFingerprint ? 0 : 1);
+}
+
+writeText(resolve(outDir, 'semantic.json'), prettyJson(semantic));
+writeText(resolve(outDir, 'fingerprint.txt'), `${semanticFingerprint}\n`);
+writeText(resolve(outDir, 'environment.json'), prettyJson(environment));
+writeText(resolve(outDir, 'report.md'), renderS2Report(manifest as unknown as S2Manifest, semantic, semanticFingerprint).replace('(S2 legion model)', '(S4 permanent progression on the S3 industry and S2 legion model)'));
+writeText(resolve(outDir, 'quantiles.csv'), renderS2QuantilesCsv(semantic));
+const traced = results.filter((r) => r.trace && r.trace.length > 0).slice(0, 3);
