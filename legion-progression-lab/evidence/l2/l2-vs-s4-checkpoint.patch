+});
+
+describe('validated reconstruction (contract §6)', () => {
+  const sample = () => {
+    let a = fresh();
+    a = deliver(a, { type: 'credit', atMs: 0, stream: 'squad', n: 1, gold: 500 }, ECON, STORE).account;
+    a = deliver(a, req(1, { kind: 'createJob', quantity: 5 }, 100_000), ECON, STORE).account;
+    a = deliver(a, req(2, { kind: 'settle', untilMs: 2_000_000 }, 2_000_000), ECON, STORE).account;
+    return a;
+  };
+  it('a checkpoint restores identically and continues identically', () => {
+    const a = sample();
+    const text = serializeCheckpoint(makeCheckpoint(a, ECON, POLICY, 1, ['main']));
+    const b = restoreCheckpoint(text, ECON, POLICY, ['main']).account;
+    expect(canonicalJson(b as never)).toBe(canonicalJson(a as never));
+    const next = req(3, { kind: 'settle', untilMs: 9_000_000 }, 9_000_000);
+    expect(economyView(deliver(b, next, ECON, STORE).account)).toBe(economyView(deliver(a, next, ECON, STORE).account));
+  });
+
+  it('malformed and inconsistent checkpoints are refused with the problem named, never repaired', () => {
+    const a = sample();
+    const cp = JSON.parse(serializeCheckpoint(makeCheckpoint(a, ECON, POLICY, 1, ['main'])));
+    const reseal = (doc: Record<string, unknown>) => {
+      const { digest: _d, ...body } = doc;
+      void _d;
+      return JSON.stringify({ ...body, digest: fingerprint(body as never) });
+    };
+    const edits: [string, (c: any) => void, RegExp][] = [
+      ['digest', (c) => (c.account.balances['res.gold'].available += 1), /digest mismatch/],
+      ['version', (c) => (c.versions.formula = 'l2-v0'), /version/],
+      ['policy', (c) => (c.versions.receipts.maxRecent = 99), /receipt policy/],
+      ['cursor', (c) => (c.cursor += 1), /settlement cursor/],
+      ['reserved', (c) => (c.account.balances['res.ore'].reserved += 1), /reserved res.ore/],
+      ['remainder', (c) => (c.account.gatherers[0].rem = 10_000_000), /remainder outside/],
+      ['feats', (c) => (c.account.feats = []), /Feat tiers differ/],
+      ['rng', (c) => (c.account.rng = [0, 0, 0, 0]), /RNG state/],
+      ['range', (c) => (c.account.ids.credits.squad = { p: 0, runs: [[1, 1]] }), /not in normal form/],
+      ['ownership', (c) => (c.account.gatherers[1].id = 'g9'), /assignment ownership/],
+      ['action', (c) => (c.account.gatherers[0].action.startMs = c.account.t + 1), /not open at the settlement cursor/],
+      ['receipt', (c) => (c.account.ids.requests.c.closedBelow = 99), /not above the closed horizon/],
+      ['extra field', (c) => (c.account.extra = 1), /exactly the v1 fields/],
+      ['producer', (c) => (c.account.ids.producers.job.allocated = 0), /above allocated|exactly one of open or retired/],
+    ];
+    for (const [name, edit, msg] of edits) {
+      const c = JSON.parse(JSON.stringify(cp));
+      edit(c);
+      const text = name === 'digest' ? JSON.stringify(c) : reseal(c);
+      expect(() => restoreCheckpoint(text, ECON, POLICY, ['main']), name).toThrow(msg);
+      expect(checkpointProblems(JSON.parse(text), ECON, POLICY).length, name).toBeGreaterThan(0);
+    }
+    expect(() => restoreCheckpoint('{not json', ECON, POLICY, ['main'])).toThrow(/INVALID_CHECKPOINT/);
+    // Branches (contract §8): a branch's checkpoint is not the parent's.
+    const branch = serializeCheckpoint(makeCheckpoint(a, ECON, POLICY, 2, ['main', 'what-if']));
+    expect(() => restoreCheckpoint(branch, ECON, POLICY, ['main'])).toThrow(/BRANCH_MISMATCH/);
+    expect(restoreCheckpoint(branch, ECON, POLICY, ['main', 'what-if']).checkpointId).toBe(2);
+  });
+});
+
+describe('chronological settlement and partition invariance (contract §1)', () => {
+  it("the owner's example: 100 ore per hour, +50% after 100 ore: 250 in one 2-hour batch, two 1-hour batches or many", () => {
+    expect(ownerExample([])).toBe(250);
+    expect(ownerExample([3_600_000])).toBe(250);
+    expect(ownerExample([1, 35_999, 36_000, 3_599_999, 3_600_000, 3_600_001, 7_199_999])).toBe(250);
+  });
+
+  it('random economies, schedules and partitions (with checkpoints) give identical results', () => {
+    const r = runPartition('l2-test-partition', 25, 4);
+    expect(r.mismatches).toBe(0);
+    expect(r.partitionsChecked).toBe(100);
+    expect(r.boundaryEvents.featGrants).toBeGreaterThan(0);
+    expect(r.boundaryEvents.levelUps).toBeGreaterThan(0);
+  });
+});
+
+describe('L1 differential (small; the registered run is 1,000,000 operations)', () => {
+  it('L2 agrees with the L1 full-history reference except the two counted old-replay changes', () => {
+    const r = runDifferential({ seed: 'l2-test-diff', operations: 20_000, policy: { maxRecent: 32, maxAgeMs: 6 * 3_600_000 }, checkpointEvery: 2000, branchEvery: 3000 });
+    expect(r.firstMismatches).toEqual([]);
+    expect(r.mismatches).toBe(0);
+    expect(r.invariantViolations).toBe(0);
+    expect(r.branchIsolationBreaks).toBe(0);
+    expect(r.restoredIdentically).toBe(r.checkpoints);
+    expect(r.changedSemantics.replayTooOld).toBeGreaterThan(0);
+    expect(r.changedSemantics.replayTooOldConflict).toBeGreaterThan(0);
+    expect(r.changedSemantics.requestExpired).toBeGreaterThan(0);
+    expect(r.l2MaxRecentPerStream).toBeLessThanOrEqual(32);
+    expect(r.l1ReceiptsAtEnd).toBeGreaterThan(1000);
+  });
+
+  it('the FULL store is a real reference: it keeps every receipt and never expires a stale request', () => {
+    let a = newAccount(FULL_STORE, ECON, [1, 2, 3, 4], 1);
+    for (let q = 1; q <= 600; q += 1) if (q !== 7) a = deliver(a, req(q, { kind: 'settle', untilMs: q * 1000 }, q * 1000), ECON, FULL_STORE).account;
+    expect(deliver(a, req(1, { kind: 'settle', untilMs: 1000 }, 700_000), ECON, FULL_STORE).outcome.code).toBe('REPLAY');
+    expect(deliver(a, req(7, { kind: 'settle', untilMs: 700_000 }, 700_000), ECON, FULL_STORE).outcome.code).toBe('APPLIED');
+    void DEFAULT_RECEIPT_POLICY;
+  });
+});
diff --git a/legion-progression-lab/test/l2.sim.test.ts b/legion-progression-lab/test/l2.sim.test.ts
new file mode 100644
index 0000000..200aa17
--- /dev/null
+++ b/legion-progression-lab/test/l2.sim.test.ts
@@ -0,0 +1,84 @@
+/**
+ * L2 validated save and restore of the actual simulation (planning/L2_CONTRACT.md §6; src/l2/simCheckpoint.ts):
+ * repeated save / load cycles continue exactly as the uninterrupted run (state and subsequent event log), with every
+ * S2, S3 and S4 system active; malformed and inconsistent simulation checkpoints are refused.
+ */
+import { describe, expect, it } from 'vitest';
+import { loadS4Content } from '../src/cli/s4-content.ts';
+import { canonicalJson, fingerprint } from '../src/core/hash/canonicalJson.ts';
+import { serializeLedger } from '../src/core/ledger/persistentLedger.ts';
+import { LegionSimulation, type LegionOptions } from '../src/engine/legion.ts';
+import { restoreSimulation, saveSimulation } from '../src/l2/simCheckpoint.ts';
+import { pol4 } from '../src/policy/permanentPolicies.ts';
+
+const C = loadS4Content();
+const END = 1_800_000;
+const opts = (policy = 'POL4-BALANCED2', seedRoot = 'l2sim#rep-0'): LegionOptions => ({ content: C, seedRoot, sessions: [{ startMs: 0, endMs: END / 2 }, { startMs: END / 2 + 600_000, endMs: END + 600_000 }], policy: pol4(policy), legion: true, industry: true, permanent: true, keepLog: 1_000_000, ledger: 'persistent' });
+// Canonical (key-sorted) form: a restored state comes from canonical JSON, so its key insertion order differs.
+const view = (s: LegionSimulation) => canonicalJson({ ...s.state, ledger: serializeLedger(s.state.ledger) } as never);
+
+describe('save, restore and resume the actual simulation', () => {
+  for (const policy of ['POL4-BALANCED2', 'POL4-MONUMENT2'] as const) {
+    it(`${policy}: four save / load cycles continue exactly as the uninterrupted run`, () => {
+      const ref = new LegionSimulation(opts(policy));
+      ref.run(END + 600_000);
+      let sim = new LegionSimulation(opts(policy));
+      let logged = 0;
+      const tail: string[] = [];
+      for (const cut of [200_000, 650_000, 1_100_000, 1_500_000]) {
+        sim.run(cut);
+        tail.push(...sim.keptLog.map((e) => canonicalJson(e as never)));
+        logged += sim.keptLog.length;
+        const text = saveSimulation(sim);
+        sim = restoreSimulation(JSON.parse(JSON.stringify(text)) as string, opts(policy));
+      }
+      sim.run(END + 600_000);
+      tail.push(...sim.keptLog.map((e) => canonicalJson(e as never)));
+      expect(view(sim)).toBe(view(ref));
+      expect(tail).toEqual(ref.keptLog.map((e) => canonicalJson(e as never)));
+      expect(canonicalJson(sim.counters as never)).toBe(canonicalJson(ref.counters as never));
+      void logged;
+    });
+  }
+
+  it('malformed and inconsistent simulation checkpoints are refused', () => {
+    const sim = new LegionSimulation(opts());
+    sim.run(900_000);
+    const doc = JSON.parse(saveSimulation(sim));
+    const reseal = (d: Record<string, unknown>) => {
+      const { digest: _x, ...body } = d;
+      void _x;
+      return JSON.stringify({ ...body, digest: fingerprint(body as never) });
+    };
+    const cases: [string, (d: any) => void, RegExp, boolean][] = [
+      ['digest', (d) => (d.state.tMs += 1), /digest mismatch/, false],
+      ['versions', (d) => (d.versions.contentHash = 'x'), /content versions differ/, true],
+      ['options', (d) => (d.options.seedRoot = 'other'), /options/, true],
+      ['ledger', (d) => (d.state.ledger.balances = [['res.gold', { available: -5, reserved: 0 }]]), /ledger does not reconstruct/, true],
+      ['queue', (d) => (d.runtime.events[0].key.t = d.state.tMs - 1), /before the state time/, true],
+      ['seq', (d) => (d.runtime.events[0].key.seq = d.runtime.seq + 5), /above the counter/, true],
+      ['rng', (d) => (d.state.rng.loot = [0, 0, 0, 0]), /RNG state/, true],
+      ['permanent', (d) => (d.state.permanent.counters.goldEarned = -1), /goldEarned/, true],
+    ];
+    for (const [name, edit, msg, resealIt] of cases) {
+      const d = JSON.parse(JSON.stringify(doc));
+      edit(d);
+      expect(() => restoreSimulation(resealIt ? reseal(d) : JSON.stringify(d), opts()), name).toThrow(msg);
+    }
+    // Reserved balances that the jobs do not hold (when a reservation exists).
+    expect(() => restoreSimulation(saveSimulation(sim), opts('POL4-BALANCED2', 'another-seed'))).toThrow(/options/);
+  });
+
+  it('a restored simulation saves back to the same document, except its chained log digest', () => {
+    const sim = new LegionSimulation(opts());
+    sim.run(300_000);
+    const text = saveSimulation(sim);
+    const strip = (t: string) => {
+      const d = JSON.parse(t);
+      delete d.digest;
+      delete d.runtime.logDigest;
+      return JSON.stringify(d);
+    };
+    expect(strip(saveSimulation(restoreSimulation(text, opts())))).toBe(strip(text));
+  });
+});
