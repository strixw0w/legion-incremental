+    expect(overlap.outcome.receipt).toMatchObject({ code: 'BATCH_OVERLAP', unit: 2 });
+    expect(economyView(overlap.account)).toBe(before);
+    const partly = deliver(a, req(5, { kind: 'settleBatch', producer, fromUnit: 3, toUnit: 6 }), ECON, STORE);
+    expect(partly.outcome.receipt).toMatchObject({ code: 'WORK_NOT_RESERVED', unit: 5 });
+    expect(economyView(partly.account)).toBe(before);
+    expect(reservationProblems(partly.account, STORE)).toEqual([]);
+    // Cancelled work is permanently ineligible.
+    a = deliver(a, { type: 'work', atMs: a.t, producer, unit: 3, op: 'release', qty: 1 }, ECON, STORE).account;
+    expect(deliver(a, { type: 'work', atMs: a.t, producer, unit: 3, op: 'complete', qty: 1 }, ECON, STORE).outcome.code).toBe('WORK_INELIGIBLE');
+    expect(deliver(a, req(6, { kind: 'retire', producerKind: 'batch', number: producer }), ECON, STORE).outcome.receipt).toMatchObject({ code: 'RETIRE_OPEN_WORK' });
+  });
+
+  it('a delivery that cannot be represented exactly is refused with the account unchanged (numeric boundary)', () => {
+    const a = give(fresh(), Number.MAX_SAFE_INTEGER - 5);
+    const snapshot = canonicalJson(a as never);
+    expect(() => deliver(a, { type: 'credit', atMs: a.t, stream: 'squad', n: 2, gold: 10 }, ECON, STORE)).toThrow(/NUMERIC_LIMIT/);
+    expect(canonicalJson(a as never)).toBe(snapshot);
+    expect(deliver(a, { type: 'credit', atMs: a.t, stream: 'squad', n: 2, gold: 5 }, ECON, STORE).account.balances['res.gold']?.available).toBe(Number.MAX_SAFE_INTEGER);
+  });
+
+  it('a duplicate encounter credit is refused; out-of-order credits are accepted once each', () => {
+    let a = fresh();
+    for (const n of [1, 3, 2, 5]) a = deliver(a, { type: 'credit', atMs: 0, stream: 'squad', n, gold: 1 }, ECON, STORE).account;
+    expect(deliver(a, { type: 'credit', atMs: 0, stream: 'squad', n: 3, gold: 1 }, ECON, STORE).outcome.code).toBe('CREDIT_REPLAYED');
+    expect(a.ids.credits['squad']).toEqual({ p: 3, runs: [[5, 5]] });
+    expect(a.counters.kills).toBe(4);
