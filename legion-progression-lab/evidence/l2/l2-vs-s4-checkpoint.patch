+/**
+ * L2 validated reconstruction of the synthetic account (planning/L2_CONTRACT.md §6; spec/formulas/l2-replay.md v1 §5).
+ * A checkpoint is canonical JSON with a SHA-256 digest over everything but the digest. Restoring validates the shape,
+ * the digest, the versions and every invariant, refuses with the first problem named (INVALID_CHECKPOINT), and never
+ * repairs anything. The digest detects corruption; it is not keyed and does not prove authenticity (trusted boundary).
+ */
+import { fail } from '../core/errors.ts';
+import { canonicalJson, fingerprint } from '../core/hash/canonicalJson.ts';
+import { BAR, GOLD, L2_FORMULA_VERSION, ORE, reservationProblems, YIELD_DEN, type Account, type Economy } from './account.ts';
+import { compactStore, type CompactIds } from './compactIds.ts';
+import { has, maxOf, rangeProblems, type RangeSet } from './ranges.ts';
+import { streamProblems, type ReceiptPolicy, type RequestStream } from './requests.ts';
+import type { ProducerKind, ProducerState } from './producers.ts';
+
+export const CHECKPOINT_SCHEMA = 'legion.l2.checkpoint.v1';
+
+export interface Checkpoint {
+  readonly schema: typeof CHECKPOINT_SCHEMA;
+  readonly versions: { readonly formula: string; readonly economy: string; readonly receipts: ReceiptPolicy };
+  readonly checkpointId: number;
+  readonly branch: readonly string[];
+  readonly cursor: number;
+  readonly account: Account<CompactIds>;
+  readonly digest: string;
+}
+
+export function makeCheckpoint(a: Account<CompactIds>, econ: Economy, policy: ReceiptPolicy, checkpointId: number, branch: readonly string[]): Checkpoint {
+  const body = { schema: CHECKPOINT_SCHEMA, versions: { formula: L2_FORMULA_VERSION, economy: econ.id, receipts: { ...policy } }, checkpointId, branch: [...branch], cursor: a.t, account: a };
+  return { ...body, digest: fingerprint(body as never) } as Checkpoint;
+}
+
+/** Deterministic canonical serialization (the stored form). */
+export const serializeCheckpoint = (c: Checkpoint): string => canonicalJson(c as never);
+
+const isInt = (v: unknown, min = 0, max = Number.MAX_SAFE_INTEGER): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v >= min && v <= max;
+const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
+const keysAre = (o: Record<string, unknown>, keys: readonly string[]) => Object.keys(o).length === keys.length && keys.every((k) => Object.hasOwn(o, k));
+
+/** Every problem of a decoded checkpoint (empty when it may be restored). Order: shape, digest, versions, invariants. */
+export function checkpointProblems(doc: unknown, econ: Economy, policy: ReceiptPolicy): string[] {
+  const out: string[] = [];
+  if (!isObj(doc) || !keysAre(doc, ['schema', 'versions', 'checkpointId', 'branch', 'cursor', 'account', 'digest'])) return ['checkpoint: not an object with exactly the v1 fields'];
+  if (doc['schema'] !== CHECKPOINT_SCHEMA) out.push(`checkpoint: schema ${String(doc['schema'])} is not ${CHECKPOINT_SCHEMA}`);
+  const { digest, ...body } = doc;
+  let actual = '';
+  try {
+    actual = fingerprint(body as never);
+  } catch (e) {
+    return [`checkpoint: not canonical JSON data (${(e as Error).message})`];
+  }
+  if (digest !== actual) out.push('checkpoint: digest mismatch (corrupted or edited)');
+  const v = doc['versions'];
+  if (!isObj(v) || v['formula'] !== L2_FORMULA_VERSION || v['economy'] !== econ.id) out.push('checkpoint: formula or economy version differs from the running code');
+  if (!isObj(v) || !isObj(v['receipts']) || v['receipts']['maxRecent'] !== policy.maxRecent || v['receipts']['maxAgeMs'] !== policy.maxAgeMs) out.push('checkpoint: receipt policy differs from the running code');
+  if (!isInt(doc['checkpointId'], 1)) out.push('checkpoint: checkpointId is not a positive safe integer');
+  if (!Array.isArray(doc['branch']) || doc['branch'].length === 0 || !doc['branch'].every((b) => typeof b === 'string' && /^[a-z0-9][a-z0-9._-]*$/.test(b))) out.push('checkpoint: branch lineage is not a non-empty list of names');
+  if (out.length > 0) return out;
+  return [...out, ...accountProblems(doc['account'], econ, policy, doc['cursor'])];
+}
+
+function accountProblems(x: unknown, econ: Economy, policy: ReceiptPolicy, cursor: unknown): string[] {
+  const out: string[] = [];
+  const A = ['schema', 'formulaVersion', 'economy', 't', 'balances', 'gatherers', 'smith', 'monumentLevel', 'items', 'counters', 'feats', 'emblems', 'rng', 'ids'];
+  if (!isObj(x) || !keysAre(x, A)) return ['account: not an object with exactly the v1 fields'];
+  const a = x as unknown as Account<CompactIds>;
+  if (a.schema !== 'legion.l2.account.v1' || a.formulaVersion !== L2_FORMULA_VERSION || a.economy !== econ.id) out.push('account: schema, formula or economy differs');
+  if (!isInt(a.t)) out.push('account: time is not a non-negative safe integer');
+  if (cursor !== a.t) out.push(`checkpoint: settlement cursor ${String(cursor)} differs from the account time ${String(a.t)}`);
+  // Balances.
+  if (!isObj(a.balances) || !keysAre(a.balances as Record<string, unknown>, [BAR, GOLD, ORE])) out.push('account: balances must hold exactly the bar, gold and ore resources');
+  else for (const [r, b] of Object.entries(a.balances)) if (!isObj(b) || !keysAre(b, ['available', 'reserved']) || !isInt(b['available']) || !isInt(b['reserved'])) out.push(`account: balance ${r} is not two non-negative safe integers`);
+  // Gatherers.
+  if (!Array.isArray(a.gatherers)) out.push('account: gatherers is not a list');
+  else
+    a.gatherers.forEach((g0, i) => {
+      let g = g0;
+      const w = `gatherer ${i + 1}`;
+      if (!isObj(g) || !keysAre(g as unknown as Record<string, unknown>, ['id', 'level', 'exp', 'rem', 'assigned', 'action'])) return void out.push(`${w}: not an object with exactly the v1 fields`);
+      g = g as unknown as (typeof a.gatherers)[number];
+      if (g.id !== `g${i + 1}`) out.push(`${w}: id ${String(g.id)} is not g${i + 1} (assignment ownership)`);
+      if (!isInt(g.level, 1, econ.maxLevel)) out.push(`${w}: level outside [1, ${econ.maxLevel}]`);
+      if (!isInt(g.exp) || (g.level < econ.maxLevel && g.exp >= econ.expBase * g.level)) out.push(`${w}: EXP ${String(g.exp)} is not below the level-up threshold`);
+      if (!isInt(g.rem, 0, YIELD_DEN - 1)) out.push(`${w}: remainder outside [0, ${YIELD_DEN})`);
+      if (typeof g.assigned !== 'boolean') out.push(`${w}: assigned is not a boolean`);
+      if (g.action !== null) {
+        if (!isObj(g.action) || !isInt(g.action.startMs) || !isInt(g.action.num)) out.push(`${w}: action is malformed`);
+        else if (g.action.startMs > a.t || g.action.startMs + econ.actionMs <= a.t) out.push(`${w}: the action in progress is not open at the settlement cursor`);
+      } else if (g.assigned) out.push(`${w}: assigned but without an action in progress`);
+    });
+  // Smith.
+  const s = a.smith;
+  if (!isObj(s) || !keysAre(s as unknown as Record<string, unknown>, ['job', 'quantity', 'done', 'unit'])) out.push('smith: not an object with exactly the v1 fields');
+  // Monument, items, counters, Feats, emblems, RNG.
+  if (!isInt(a.monumentLevel, 0, econ.monumentMaxLevel)) out.push('account: Monument level outside [0, max]');
+  if (!isObj(a.items)) out.push('account: items is not an object');
+  else {
+    // Canonical JSON orders keys as text; the item numbers must still be exactly 1..n.
+    const n = Object.keys(a.items).length;
+    for (const [k, lvl] of Object.entries(a.items)) {
+      const m = /^item:([1-9][0-9]*)$/.exec(k);
+      if (!m || Number(m[1]) > n || !isInt(lvl)) out.push(`account: item ${k} is not one of item:1 .. item:${n} with a non-negative level`);
+    }
+  }
+  const C = ['ore', 'gold', 'kills', 'bars', 'requests'];
+  if (!isObj(a.counters) || !keysAre(a.counters as unknown as Record<string, unknown>, C) || !C.every((k) => isInt((a.counters as Record<string, unknown>)[k]))) out.push('account: counters are not five non-negative safe integers');
+  if (!Array.isArray(a.feats) || !a.feats.every((f, i) => isInt(f, 0, econ.featTiers.length - 1) && (i === 0 || f > (a.feats[i - 1] as number)))) out.push('account: Feat tiers are not ascending tier indices');
+  else if (isObj(a.counters)) {
+    const due = econ.featTiers.map((t, i) => (a.counters.ore >= t.threshold ? i : -1)).filter((i) => i >= 0);
+    if (JSON.stringify(due) !== JSON.stringify(a.feats)) out.push('account: granted Feat tiers differ from the lifetime ore counter');
+  }
+  if (!isInt(a.emblems) || (isObj(a.counters) && a.emblems > a.counters.kills)) out.push('account: emblems exceed accepted kills');
+  if (!Array.isArray(a.rng) || a.rng.length !== 4 || !a.rng.every((v) => isInt(v, 0, 0xffffffff)) || a.rng.every((v) => v === 0)) out.push('account: RNG state is not four 32-bit words, not all zero');
+  if (out.length > 0) return out;
+  // Identities.
+  out.push(...idsProblems(a.ids, policy));
+  if (out.length > 0) return out;
+  // Cross-checks: the smith and its producer, reservations.
+  const jobs = (a.ids.producers['job'] as ProducerKind | undefined) ?? { allocated: 0, retired: { p: 0, runs: [] }, open: {} };
+  if (s.job !== null) {
+    const p = jobs.open[String(s.job)] as ProducerState | undefined;
+    if (!p) out.push(`smith: job ${s.job} is not an open job producer`);
+    else {
+      if (!isInt(s.quantity, 1) || !isInt(s.done, 0, s.quantity - 1)) out.push('smith: quantity and done are inconsistent');
+      if (s.unit !== null) {
+        if (!isObj(s.unit) || !isInt(s.unit.startMs) || s.unit.startMs > a.t || s.unit.startMs + econ.smithUnitMs <= a.t) out.push('smith: the unit in progress is not open at the settlement cursor');
+        else if (s.unit.unit !== s.done + 1 || !p.reserved.some((r) => r.unit === s.unit?.unit)) out.push('smith: the unit in progress is not the reserved next unit');
+      }
+      const extra = p.reserved.filter((r) => r.unit !== s.unit?.unit);
+      if (extra.length > 0) out.push('smith: its job holds a reserved unit that is not in progress');
+    }
+  } else if (s.unit !== null || s.quantity !== 0 || s.done !== 0) out.push('smith: idle but with a unit or a quantity');
+  for (const [n, p] of Object.entries(jobs.open)) if (Number(n) !== s.job && p.reserved.length > 0) out.push(`job ${n}: reserved units but not the smith's job`);
+  out.push(...reservationProblems(a, compactStore(policy)));
+  return out;
+}
+
+function idsProblems(x: unknown, policy: ReceiptPolicy): string[] {
+  const out: string[] = [];
+  if (!isObj(x) || !keysAre(x, ['requests', 'credits', 'producers'])) return ['ids: not an object with exactly the v1 fields'];
+  const ids = x as unknown as CompactIds;
+  for (const [st, s] of Object.entries(ids.requests)) {
+    const rp = rangeProblems((s as RequestStream).settled, `request stream ${st}`);
+    out.push(...rp);
+    if (rp.length === 0) out.push(...streamProblems(s as RequestStream, policy, `request stream ${st}`));
+  }
+  for (const [st, r] of Object.entries(ids.credits)) out.push(...rangeProblems(r, `credit stream ${st}`));
+  for (const [kind, k] of Object.entries(ids.producers)) {
+    if (kind !== 'job' && kind !== 'batch') out.push(`producers: unknown kind ${kind}`);
+    if (!isInt(k.allocated)) {
+      out.push(`producers ${kind}: allocated is not a safe integer`);
+      continue;
+    }
+    const rr = rangeProblems(k.retired, `producers ${kind} retired`);
+    out.push(...rr);
+    if (rr.length === 0 && maxOf(k.retired) > k.allocated) out.push(`producers ${kind}: a retired number above allocated ${k.allocated}`);
+    for (let n = 1; n <= k.allocated; n += 1) {
+      const open = Object.hasOwn(k.open, String(n));
+      if (rr.length === 0 && has(k.retired, n) === open) out.push(`producers ${kind}: ${n} must be exactly one of open or retired`);
+    }
+    for (const [n, p] of Object.entries(k.open)) out.push(...producerProblems(p, `producer ${kind}:${n}`, Number(n) <= k.allocated));
+  }
+  return out;
+}
+
+function producerProblems(p: ProducerState, what: string, allocated: boolean): string[] {
+  const out: string[] = [];
+  if (!allocated) out.push(`${what}: number above allocated`);
+  for (const [k, r] of [['settled', p.settled], ['released', p.released], ['abandoned', p.abandoned]] as const) out.push(...rangeProblems(r, `${what} ${k}`));
+  if (out.length > 0) return out;
+  const sub = (r: RangeSet, name: string) => {
+    for (const [a, b] of [...(r.p > 0 ? [[1, r.p] as const] : []), ...r.runs]) for (let u = a; u <= Math.min(b, a + 100_000); u += 1) if (!has(p.settled, u)) return void out.push(`${what}: ${name} unit ${u} is not settled`);
+  };
+  sub(p.released, 'released');
+  sub(p.abandoned, 'abandoned');
+  let prev = 0;
+  for (const r of p.reserved) {
+    if (!isInt(r.unit, 1) || r.unit <= prev) out.push(`${what}: reserved units are not ascending positive integers`);
+    if (has(p.settled, r.unit)) out.push(`${what}: unit ${r.unit} is both settled and reserved`);
+    if (!Array.isArray(r.lines) || !r.lines.every((l) => [BAR, GOLD, ORE].includes(l.resourceId) && isInt(l.qty, 1))) out.push(`${what}: unit ${r.unit} lines are malformed`);
+    if (r.unit > p.maxUnit) out.push(`${what}: unit ${r.unit} above its maximum ${p.maxUnit}`);
+    prev = r.unit;
+  }
+  if (!isInt(p.maxUnit) || maxOf(p.settled) > p.maxUnit) out.push(`${what}: maxUnit below a settled unit`);
+  return out;
+}
+
+const deepFreeze = <T>(x: T): T => {
+  if (typeof x === 'object' && x !== null) {
+    for (const v of Object.values(x)) deepFreeze(v);
+    Object.freeze(x);
+  }
+  return x;
+};
+
+/**
+ * Restores a checkpoint after full validation (contract §6). `lineage` is the branch the caller is restoring into:
+ * restoring another branch's checkpoint is refused (BRANCH_MISMATCH, contract §8).
+ */
+export function restoreCheckpoint(text: string, econ: Economy, policy: ReceiptPolicy, lineage: readonly string[]): { account: Account<CompactIds>; checkpointId: number } {
+  let doc: unknown;
+  try {
+    doc = JSON.parse(text);
+  } catch {
+    fail('INVALID_CHECKPOINT', 'checkpoint: not JSON');
+  }
+  const problems = checkpointProblems(doc, econ, policy);
+  if (problems.length > 0) fail('INVALID_CHECKPOINT', problems[0] as string, { problems });
+  const c = doc as Checkpoint;
+  if (canonicalJson(c.branch as never) !== canonicalJson([...lineage] as never)) fail('BRANCH_MISMATCH', `checkpoint of branch ${c.branch.join('/')} restored into ${lineage.join('/')}`);
+  return { account: deepFreeze(c.account), checkpointId: c.checkpointId };
+}
diff --git a/legion-progression-lab/src/l2/compactIds.ts b/legion-progression-lab/src/l2/compactIds.ts
new file mode 100644
index 0000000..e6c183d
--- /dev/null
+++ b/legion-progression-lab/src/l2/compactIds.ts
@@ -0,0 +1,58 @@
+/** The COMPACT (L2) identity store: bounded receipts, range sets and retired ranges (planning/L2_CONTRACT.md §3–§5). */
+import { fail } from '../core/errors.ts';
+import type { IdentityStore, UnitView } from './ids.ts';
+import { allocate, EMPTY_KIND, producerOf, retire, settledAs, unitState, withReserve, withSettled, type ProducerKind, type QtyLine } from './producers.ts';
+import { addOne, EMPTY_RANGE, has, type RangeSet } from './ranges.ts';
+import { classify, EMPTY_STREAM, record, type ReceiptPolicy, type RequestStream } from './requests.ts';
+
+export interface CompactIds {
+  readonly requests: Readonly<Record<string, RequestStream>>;
+  readonly credits: Readonly<Record<string, RangeSet>>;
+  readonly producers: Readonly<Record<string, ProducerKind>>;
+}
+
+const kindOf = (ids: CompactIds, kind: string): ProducerKind => ids.producers[kind] ?? EMPTY_KIND;
+
+export function compactStore(policy: ReceiptPolicy): IdentityStore<CompactIds> {
+  return {
+    name: 'compact',
+    empty: () => Object.freeze({ requests: Object.freeze({}), credits: Object.freeze({}), producers: Object.freeze({}) }),
+    classify: (ids, stream, seq, hash) => classify(ids.requests[stream] ?? EMPTY_STREAM, seq, hash),
+    record: (ids, stream, seq, hash, receipt, atMs, nowMs) => Object.freeze({ ...ids, requests: Object.freeze({ ...ids.requests, [stream]: record(ids.requests[stream] ?? EMPTY_STREAM, seq, hash, receipt, atMs, nowMs, policy) }) }),
+    creditSeen: (ids, stream, n) => has(ids.credits[stream] ?? EMPTY_RANGE, n),
+    creditAdd: (ids, stream, n) => Object.freeze({ ...ids, credits: Object.freeze({ ...ids.credits, [stream]: addOne(ids.credits[stream] ?? EMPTY_RANGE, n) }) }),
+    allocate: (ids, kind) => {
+      const out = allocate(kindOf(ids, kind));
+      return { ids: Object.freeze({ ...ids, producers: Object.freeze({ ...ids.producers, [kind]: out.kind }) }), number: out.number };
+    },
+    producerRefusal: (ids, kind, n) => {
+      const p = producerOf(kindOf(ids, kind), n);
+      return p === 'PRODUCER_RETIRED' || p === 'PRODUCER_UNKNOWN' ? p : null;
+    },
+    unit: (ids, kind, n, u): UnitView => {
+      const p = producerOf(kindOf(ids, kind), n);
+      if (typeof p === 'string') fail('INVALID_STATE', `unit of an unusable producer ${kind}:${n}`);
+      const st = unitState(p, u);
+      if (st === 'settled') return { state: 'settled', how: settledAs(p, u) as 'complete' | 'release' | 'abandon' };
+      return { state: st, lines: p.reserved.find((r) => r.unit === u)?.lines ?? [] };
+    },
+    reserve: (ids, kind, n, u, lines) => withProducer(ids, kind, n, (p) => withReserve(p, u, lines)),
+    settle: (ids, kind, n, u, how) => withProducer(ids, kind, n, (p) => withSettled(p, u, how)),
+    reservedLines: (ids) => {
+      const out: QtyLine[] = [];
+      for (const kind of Object.keys(ids.producers).sort()) for (const n of Object.keys((ids.producers[kind] as ProducerKind).open).sort((a, b) => Number(a) - Number(b))) for (const r of ((ids.producers[kind] as ProducerKind).open[n] as { reserved: readonly { lines: readonly QtyLine[] }[] }).reserved) out.push(...r.lines);
+      return out;
+    },
+    retire: (ids, kind, n) => {
+      const k = retire(kindOf(ids, kind), n);
+      return typeof k === 'string' ? k : Object.freeze({ ...ids, producers: Object.freeze({ ...ids.producers, [kind]: k }) });
+    },
+  };
+}
+
+function withProducer(ids: CompactIds, kind: string, n: number, f: (p: NonNullable<ProducerKind['open'][string]>) => NonNullable<ProducerKind['open'][string]>): CompactIds {
+  const k = kindOf(ids, kind);
+  const p = producerOf(k, n);
+  if (typeof p === 'string') fail('INVALID_STATE', `work on an unusable producer ${kind}:${n} (${p})`);
+  return Object.freeze({ ...ids, producers: Object.freeze({ ...ids.producers, [kind]: Object.freeze({ ...k, open: Object.freeze({ ...k.open, [String(n)]: f(p) }) }) }) });
+}
diff --git a/legion-progression-lab/src/l2/differential.ts b/legion-progression-lab/src/l2/differential.ts
new file mode 100644
index 0000000..e2b1d1f
--- /dev/null
+++ b/legion-progression-lab/src/l2/differential.ts
@@ -0,0 +1,295 @@
+/**
+ * L2 randomized differential against the L1 full-history reference (owner "Independent S4 Review and L2
+ * Authorisation" §11; planning/L2_CONTRACT.md). One generator drives the same deliveries through the synthetic account
+ * with the COMPACT store (L2) and with the FULL store (L1):
+ *  - new requests of every kind, retries (recent and old), conflicting retries, skipped and late (stale) requests,
+ *    out-of-order requests; kill credits with duplicates and out-of-order numbers; work operations on batch producers
+ *    (valid, duplicated and invalid transitions, retired and unknown producers); atomic batch settlements, including
+ *    overlapping ones; retirements; settlements with long time jumps (receipt age eviction);
+ *  - L2 checkpoint save and restore mid-run (the restored account must continue identically), and immutable branches
+ *    (a branch's deliveries must leave the parent unchanged).
+ * After every delivery: the outcome codes and receipts agree, except the two changed old-replay semantics, which are
+ * counted (L2 REPLAY_TOO_OLD where L1 replays the original receipt; L2 REQUEST_EXPIRED where L1 would execute a stale
+ * request, which is then not delivered to L1 either, keeping the two comparable); the economies agree exactly; the L2
+ * reservation invariant holds; the L2 receipt window stays bounded.
+ */
+import { canonicalJson } from '../core/hash/canonicalJson.ts';
+import { deliver, ECONOMY_V1, newAccount, reservationProblems, type Account, type Delivery, type Economy, type Payload } from './account.ts';
+import { makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from './checkpoint.ts';
+import { compactStore, type CompactIds } from './compactIds.ts';
+import { cloneFull, FULL_STORE, fullReceiptCount, type FullIds } from './l1Reference.ts';
+import { payloadHash, type ReceiptPolicy } from './requests.ts';
+import type { WorkOp } from './producers.ts';
+
+/** Deterministic test-case generator (never used by the engine). */
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function seedOf(text: string): number {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i += 1) h = Math.imul(h ^ text.charCodeAt(i), 16777619);
+  return h >>> 0;
+}
+
+/** The economy part of an account (everything but the identity evidence and the request counter). */
+export function economyView(a: Account<unknown>): string {
+  const { ids: _ids, counters, ...rest } = a;
+  void _ids;
+  const { requests: _r, ...c } = counters;
+  void _r;
+  return canonicalJson({ ...rest, counters: c } as never);
+}
+
+export interface DifferentialConfig {
+  readonly seed: string;
+  readonly operations: number;
+  readonly policy: ReceiptPolicy;
+  readonly checkpointEvery: number;
+  readonly branchEvery: number;
+  readonly economy?: Economy;
+}
+
+export interface DifferentialResult {
+  readonly seed: string;
+  readonly operations: number;
+  readonly byType: Record<string, number>;
+  readonly outcomes: Record<string, number>;
+  /** The registered changed old-replay semantics (contract §0): counted, never hidden. */
+  readonly changedSemantics: { readonly replayTooOld: number; readonly replayTooOldConflict: number; readonly requestExpired: number };
+  readonly mismatches: number;
+  readonly firstMismatches: readonly string[];
+  readonly invariantViolations: number;
+  readonly checkpoints: number;
+  readonly restoredIdentically: number;
+  readonly branches: number;
+  readonly branchIsolationBreaks: number;
+  readonly l2MaxRecentPerStream: number;
+  readonly l2MaxRuns: number;
+  readonly l1ReceiptsAtEnd: number;
+  readonly finalSimulatedMs: number;
+}
+
+const STREAMS = ['client.a', 'client.b', 'client.c'] as const;
+
+export function runDifferential(cfg: DifferentialConfig): DifferentialResult {
+  const econ = cfg.economy ?? ECONOMY_V1;
+  const compact = compactStore(cfg.policy);
+  const rnd = mulberry32(seedOf(cfg.seed));
+  const int = (lo: number, hi: number) => lo + Math.floor(rnd() * (hi - lo + 1));
+  const pick = <T>(xs: readonly T[]): T => xs[Math.floor(rnd() * xs.length)] as T;
+  const seedState = [seedOf(`${cfg.seed}:a`) || 1, seedOf(`${cfg.seed}:b`), seedOf(`${cfg.seed}:c`), seedOf(`${cfg.seed}:d`)] as const;
+  let l2: Account<CompactIds> = newAccount(compact, econ, seedState, 2);
+  let l1: Account<FullIds> = newAccount(FULL_STORE, econ, seedState, 2);
+  let t = 0;
+  // Generator memory: what was sent per request stream, skipped sequence numbers, credit numbers, producers.
+  const sent = new Map<string, { seq: number; payload: Payload; atMs: number }[]>(STREAMS.map((s) => [s, []]));
+  const nextSeq = new Map<string, number>(STREAMS.map((s) => [s, 1]));
+  const skipped = new Map<string, number[]>(STREAMS.map((s) => [s, []]));
+  let nextCredit = 1;
+  const creditsHeld: number[] = [];
+  const creditsSent: number[] = [];
+  const batches: { producer: number; nextUnit: number }[] = [];
+  let lastJob = 0;
+  const byType: Record<string, number> = {};
+  const outcomes: Record<string, number> = {};
+  let replayTooOld = 0;
+  let replayTooOldConflict = 0;
+  let requestExpired = 0;
+  let mismatches = 0;
+  const first: string[] = [];
+  let invariantViolations = 0;
+  let checkpoints = 0;
+  let restoredIdentically = 0;
+  let branches = 0;
+  let branchIsolationBreaks = 0;
+  let maxRecent = 0;
+  let maxRuns = 0;
+  const bad = (what: string) => {
+    mismatches += 1;
+    if (first.length < 10) first.push(what);
+  };
+
+  const randomPayload = (): Payload => {
+    const r = rnd();
+    if (r < 0.14) return { kind: 'settle', untilMs: t + int(0, 3_600_000) };
+    if (r < 0.26) return { kind: 'monument', levels: 1 };
+    if (r < 0.32) return { kind: 'recruit' };
+    if (r < 0.40) return { kind: 'craft' };
+    if (r < 0.48) return { kind: 'enhance', item: `item:${int(1, 6)}`, level: int(1, 4) };
+    if (r < 0.58) return { kind: 'createJob', quantity: int(1, 6) };
+    if (r < 0.64) return { kind: 'cancelJob', job: lastJob > 0 && rnd() < 0.8 ? lastJob : int(1, 5) };
+    if (r < 0.74) return { kind: 'openBatch' };
+    if (r < 0.88) {
+      const b = batches.length > 0 ? pick(batches) : { producer: int(1, 3), nextUnit: 3 };
+      const from = int(1, Math.max(1, b.nextUnit));
+      return { kind: 'settleBatch', producer: b.producer, fromUnit: from, toUnit: from + int(0, 3) };
+    }
+    return { kind: 'retire', producerKind: rnd() < 0.7 ? 'batch' : 'job', number: rnd() < 0.8 && batches.length > 0 ? pick(batches).producer : int(1, 6) };
+  };
+
+  for (let op = 0; op < cfg.operations; op += 1) {
+    // Time moves forward: usually seconds, sometimes hours (receipt ages, long settlements).
+    t += rnd() < 0.02 ? int(3_600_000, 30 * 3_600_000) : int(0, 90_000);
+    const r = rnd();
+    let d: Delivery;
+    let type: string;
+    const stream = pick(STREAMS);
+    const list = sent.get(stream) as { seq: number; payload: Payload; atMs: number }[];
+    if (r < 0.40 || list.length === 0) {
+      type = 'request.new';
+      let seq = nextSeq.get(stream) as number;
+      // Sometimes skip a sequence number (a missing message that may arrive much later), or send out of order.
+      if (rnd() < 0.05) {
+        (skipped.get(stream) as number[]).push(seq);
+        seq += 1;
+      }
+      nextSeq.set(stream, seq + 1);
+      const payload = randomPayload();
+      list.push({ seq, payload, atMs: t });
+      if (list.length > 4000) list.splice(0, list.length - 4000);
+      d = { type: 'request', atMs: t, stream, seq, payload };
+    } else if (r < 0.50) {
+      type = 'request.retry';
+      const old = rnd() < 0.5 ? (list[list.length - 1 - int(0, Math.min(20, list.length - 1))] as { seq: number; payload: Payload }) : pick(list);
+      d = { type: 'request', atMs: t, stream, seq: old.seq, payload: old.payload };
+    } else if (r < 0.53) {
+      type = 'request.conflict';
+      const old = pick(list);
+      d = { type: 'request', atMs: t, stream, seq: old.seq, payload: { kind: 'settle', untilMs: t + int(1, 1000) } };
+    } else if (r < 0.555) {
+      type = 'request.late';
+      const sk = skipped.get(stream) as number[];
+      const seq = sk.length > 0 ? (sk.splice(int(0, sk.length - 1), 1)[0] as number) : int(1, nextSeq.get(stream) as number);
+      d = { type: 'request', atMs: t, stream, seq, payload: randomPayload() };
+    } else if (r < 0.72) {
+      // Kill credits: mostly new, some held back and delivered later (out of order), some duplicated.
+      const q = rnd();
+      let n: number;
+      if (q < 0.7) {
+        n = nextCredit;
+        nextCredit += 1;
+        if (rnd() < 0.1) {
+          creditsHeld.push(n);
+          n = nextCredit;
+          nextCredit += 1;
+        }
+        type = 'credit.new';
+      } else if (q < 0.85 && creditsHeld.length > 0) {
+        n = creditsHeld.splice(int(0, creditsHeld.length - 1), 1)[0] as number;
+        type = 'credit.late';
+      } else {
+        n = creditsSent.length > 0 ? pick(creditsSent) : 1;
+        type = 'credit.duplicate';
+      }
+      creditsSent.push(n);
+      if (creditsSent.length > 4000) creditsSent.splice(0, 2000);
+      d = { type: 'credit', atMs: t, stream: rnd() < 0.8 ? 'squad' : 'worker:rec:2', n, gold: int(0, 40) };
+    } else {
+      type = 'work';
+      const b = batches.length > 0 && rnd() < 0.95 ? pick(batches) : { producer: int(1, batches.length + 2), nextUnit: 1 };
+      const op: WorkOp = pick(['reserve', 'reserve', 'reserve', 'complete', 'complete', 'release', 'abandon'] as const);
+      const unit = op === 'reserve' && rnd() < 0.7 ? b.nextUnit : int(1, b.nextUnit + 1);
+      if (op === 'reserve' && unit === b.nextUnit) b.nextUnit += 1;
+      d = { type: 'work', atMs: t, producer: b.producer, unit, op, qty: int(1, 4) };
+    }
+    byType[type] = (byType[type] ?? 0) + 1;
+
+    const o2 = deliver(l2, d, econ, compact);
+    outcomes[o2.outcome.code] = (outcomes[o2.outcome.code] ?? 0) + 1;
+    if (o2.outcome.code === 'REQUEST_EXPIRED' && d.type === 'request') {
+      // Changed semantics: L2 refuses a stale, never-seen request; L1 (no horizon) would execute it. It is therefore not
+      // delivered to L1 (which stays comparable); L1's own classification must be NEW.
+      if (FULL_STORE.classify(l1.ids, d.stream, d.seq, payloadHash(d.payload)).kind === 'NEW') requestExpired += 1;
+      else bad(`op ${op} ${type}: L2 REQUEST_EXPIRED but L1 does not see a new request`);
+      l2 = o2.account;
+    } else {
+      const o1 = deliver(l1, d, econ, FULL_STORE);
+      if (o2.outcome.code === 'REPLAY_TOO_OLD' && o1.outcome.code === 'REPLAY') replayTooOld += 1;
+      // An evicted request retried with another payload: L2 can no longer compare payloads (its receipt is gone).
+      else if (o2.outcome.code === 'REPLAY_TOO_OLD' && o1.outcome.code === 'CONFLICTING_PAYLOAD') replayTooOldConflict += 1;
+      else if (o2.outcome.code !== o1.outcome.code) bad(`op ${op} ${type}: L2 ${o2.outcome.code} vs L1 ${o1.outcome.code}`);
+      else if (canonicalJson(o2.outcome.receipt as never) !== canonicalJson(o1.outcome.receipt as never)) bad(`op ${op} ${type}: receipts differ`);
+      l2 = o2.account;
+      l1 = o1.account;
+    }
+    if (economyView(l2) !== economyView(l1)) {
+      bad(`op ${op} ${type}: economies differ after ${o2.outcome.code}`);
+      break;
+    }
+    // Generator memory from receipts.
+    const rc = o2.outcome.receipt;
+    if (rc && o2.outcome.code === 'APPLIED' && rc['code'] === 'OK') {
+      if (typeof rc['producer'] === 'number') batches.push({ producer: rc['producer'], nextUnit: 1 });
+      if (typeof rc['job'] === 'number') lastJob = rc['job'];
+      if (typeof rc['retired'] === 'string' && rc['retired'].startsWith('batch:')) {
+        const n = Number(rc['retired'].slice(6));
+        const i = batches.findIndex((b) => b.producer === n);
+        if (i >= 0) batches.splice(i, 1);
+      }
+    }
+    if (batches.length > 40) batches.splice(0, batches.length - 40);
+    // Invariants and bounds (L2).
+    if (op % 97 === 0) {
+      const inv = reservationProblems(l2, compact);
+      if (inv.length > 0) {
+        invariantViolations += 1;
+        if (first.length < 10) first.push(`op ${op}: ${inv[0]}`);
+      }
+      for (const s of Object.values(l2.ids.requests)) {
+        maxRecent = Math.max(maxRecent, s.recent.length);
+        maxRuns = Math.max(maxRuns, s.settled.runs.length);
+      }
+      for (const c of Object.values(l2.ids.credits)) maxRuns = Math.max(maxRuns, c.runs.length);
+    }
+    // Checkpoint, restore and continue: identical by construction or a mismatch.
+    if (cfg.checkpointEvery > 0 && op % cfg.checkpointEvery === cfg.checkpointEvery - 1) {
+      checkpoints += 1;
+      const text = serializeCheckpoint(makeCheckpoint(l2, econ, cfg.policy, checkpoints, ['main']));
+      const back = restoreCheckpoint(text, econ, cfg.policy, ['main']).account;
+      if (canonicalJson(back as never) === canonicalJson(l2 as never)) restoredIdentically += 1;
+      else bad(`op ${op}: the restored checkpoint differs`);
+      l2 = back;
+    }
+    // Immutable branch: a few deliveries to a branch copy; the parent must not change.
+    if (cfg.branchEvery > 0 && op % cfg.branchEvery === cfg.branchEvery - 1) {
+      branches += 1;
+      const parent2 = canonicalJson(l2 as never);
+      const parent1 = economyView(l1);
+      let b2 = l2;
+      let b1 = { ...l1, ids: cloneFull(l1.ids) };
+      for (let k = 0; k < 5; k += 1) {
+        const bd: Delivery = { type: 'request', atMs: t + k * 60_000, stream: 'branch', seq: k + 1, payload: randomPayload() };
+        b2 = deliver(b2, bd, econ, compact).account;
+        b1 = deliver(b1, bd, econ, FULL_STORE).account;
+      }
+      if (canonicalJson(l2 as never) !== parent2 || economyView(l1) !== parent1) branchIsolationBreaks += 1;
+      if (economyView(b2) !== economyView(b1)) bad(`op ${op}: branch economies differ`);
+    }
+  }
+  return {
+    seed: cfg.seed,
+    operations: cfg.operations,
+    byType,
+    outcomes,
+    changedSemantics: { replayTooOld, replayTooOldConflict, requestExpired },
+    mismatches,
+    firstMismatches: first,
+    invariantViolations,
+    checkpoints,
+    restoredIdentically,
+    branches,
+    branchIsolationBreaks,
+    l2MaxRecentPerStream: maxRecent,
+    l2MaxRuns: maxRuns,
+    l1ReceiptsAtEnd: fullReceiptCount(l1.ids),
+    finalSimulatedMs: t,
+  };
+}
diff --git a/legion-progression-lab/src/l2/ids.ts b/legion-progression-lab/src/l2/ids.ts
new file mode 100644
index 0000000..6d1e9e4
--- /dev/null
+++ b/legion-progression-lab/src/l2/ids.ts
@@ -0,0 +1,47 @@
+/**
+ * Identity stores (planning/L2_CONTRACT.md §2–§5). The account (src/l2/account.ts) keeps its exactly-once evidence in
+ * an identity store with one interface and two implementations:
+ *  - COMPACT (L2): request streams with bounded receipts and closed horizons, range sets for encounter credits, and
+ *    producers with range-set units and retired ranges (src/l2/requests.ts, ranges.ts, producers.ts);
+ *  - FULL (the L1 reference, src/l2/l1Reference.ts): every receipt kept for ever, plain sorted lists, no horizon.
+ * The differential (src/l2/differential.ts) runs the same deliveries through both.
+ */
+import type { Classification, Receipt } from './requests.ts';
+import type { QtyLine, WorkOp, WorkRefusal } from './producers.ts';
+
+export type UnitView = { readonly state: 'none' | 'reserved'; readonly lines: readonly QtyLine[] } | { readonly state: 'settled'; readonly how: Exclude<WorkOp, 'reserve'> };
+
+export interface IdentityStore<I> {
+  readonly name: 'compact' | 'full';
+  empty(): I;
+  classify(ids: I, stream: string, seq: number, payloadHash: string): Classification;
+  record(ids: I, stream: string, seq: number, payloadHash: string, receipt: Receipt, atMs: number, nowMs: number): I;
+  creditSeen(ids: I, stream: string, n: number): boolean;
+  creditAdd(ids: I, stream: string, n: number): I;
+  allocate(ids: I, kind: string): { ids: I; number: number };
+  /** null when the producer is open; otherwise why it cannot be used. */
+  producerRefusal(ids: I, kind: string, n: number): 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN' | null;
+  unit(ids: I, kind: string, n: number, u: number): UnitView;
+  reserve(ids: I, kind: string, n: number, u: number, lines: readonly QtyLine[]): I;
+  settle(ids: I, kind: string, n: number, u: number, how: Exclude<WorkOp, 'reserve'>): I;
+  /** Every reserved unit of every open producer (for the reserved-balance invariant). */
+  reservedLines(ids: I): readonly QtyLine[];
+  retire(ids: I, kind: string, n: number): I | 'RETIRE_OPEN_WORK' | 'RETIRE_GAP' | 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN';
+}
+
+/** The work transition of spec §3 on a unit view (shared by both stores, so both refuse identically). */
+export function workRefusal(v: UnitView, op: WorkOp): WorkRefusal | null {
+  switch (op) {
+    case 'reserve':
+      return v.state === 'none' ? null : v.state === 'reserved' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'complete':
+    case 'release':
+      if (v.state === 'reserved') return null;
+      if (v.state !== 'settled') return 'WORK_NOT_RESERVED';
+      return v.how === op ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'abandon':
+      if (v.state === 'none') return null;
+      if (v.state !== 'settled') return 'WORK_INELIGIBLE';
+      return v.how === 'abandon' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+  }
+}
diff --git a/legion-progression-lab/src/l2/l1Reference.ts b/legion-progression-lab/src/l2/l1Reference.ts
new file mode 100644
index 0000000..e34cc0c
--- /dev/null
+++ b/legion-progression-lab/src/l2/l1Reference.ts
@@ -0,0 +1,118 @@
+/**
+ * The FULL identity store: the L1 full-history correctness reference for the L2 differential (planning/L2_CONTRACT.md
+ * §0, spec/formulas/l2-replay.md §2 "L1 reference"). Written independently of the range-set code: every receipt is kept
+ * for ever, credits and units are plain sets and maps, there is no closed horizon, and producers are never compacted.
+ * Its only intended differences from L2 are the two changed old-replay semantics.
+ *
+ * For speed over a million operations it is mutable: it is used only by the differential harness, which never relies
+ * on an old L1 value after a later delivery (and clones it with `cloneFull` for branches).
+ */
+import { fail } from '../core/errors.ts';
+import type { IdentityStore, UnitView } from './ids.ts';
+import type { QtyLine } from './producers.ts';
+import type { Receipt } from './requests.ts';
+
+type UnitRec = { state: 'reserved'; lines: readonly QtyLine[] } | { state: 'settled'; how: 'complete' | 'release' | 'abandon' };
+
+export interface FullIds {
+  readonly receipts: Map<string, Map<number, { hash: string; receipt: Receipt }>>;
+  readonly credits: Map<string, Set<number>>;
+  readonly allocated: Map<string, number>;
+  readonly retired: Map<string, Set<number>>;
+  readonly units: Map<string, Map<number, UnitRec>>;
+}
+
+const key = (kind: string, n: number) => `${kind}#${n}`;
+
+export function cloneFull(ids: FullIds): FullIds {
+  return {
+    receipts: new Map([...ids.receipts].map(([k, m]) => [k, new Map(m)])),
+    credits: new Map([...ids.credits].map(([k, s]) => [k, new Set(s)])),
+    allocated: new Map(ids.allocated),
+    retired: new Map([...ids.retired].map(([k, s]) => [k, new Set(s)])),
+    units: new Map([...ids.units].map(([k, m]) => [k, new Map(m)])),
+  };
+}
+
+/** Total receipts kept (for the retention comparison: L1 grows with history). */
+export const fullReceiptCount = (ids: FullIds): number => [...ids.receipts.values()].reduce((a, m) => a + m.size, 0);
+
+export const FULL_STORE: IdentityStore<FullIds> = {
+  name: 'full',
+  empty: () => ({ receipts: new Map(), credits: new Map(), allocated: new Map(), retired: new Map(), units: new Map() }),
+  classify: (ids, stream, seq, hash) => {
+    if (!Number.isSafeInteger(seq) || seq < 1) return { kind: 'INVALID_REQUEST' };
+    const r = ids.receipts.get(stream)?.get(seq);
+    if (!r) return { kind: 'NEW' };
+    return r.hash === hash ? { kind: 'REPLAY', receipt: r.receipt } : { kind: 'CONFLICTING_PAYLOAD' };
+  },
+  record: (ids, stream, seq, hash, receipt) => {
+    let m = ids.receipts.get(stream);
+    if (!m) ids.receipts.set(stream, (m = new Map()));
+    if (m.has(seq)) fail('INVALID_STATE', 'L1: request recorded twice');
+    m.set(seq, { hash, receipt });
+    return ids;
+  },
+  creditSeen: (ids, stream, n) => ids.credits.get(stream)?.has(n) === true,
+  creditAdd: (ids, stream, n) => {
+    let s = ids.credits.get(stream);
+    if (!s) ids.credits.set(stream, (s = new Set()));
+    if (s.has(n)) fail('INVALID_STATE', 'L1: credit added twice');
+    s.add(n);
+    return ids;
+  },
+  allocate: (ids, kind) => {
+    const number = (ids.allocated.get(kind) ?? 0) + 1;
+    ids.allocated.set(kind, number);
+    ids.units.set(key(kind, number), new Map());
+    return { ids, number };
+  },
+  producerRefusal: (ids, kind, n) => {
+    if (!Number.isSafeInteger(n) || n < 1 || n > (ids.allocated.get(kind) ?? 0)) return 'PRODUCER_UNKNOWN';
+    if (ids.retired.get(kind)?.has(n)) return 'PRODUCER_RETIRED';
+    return null;
+  },
+  unit: (ids, kind, n, u): UnitView => {
+    const r = ids.units.get(key(kind, n))?.get(u);
+    if (!r) return { state: 'none', lines: [] };
+    return r.state === 'reserved' ? { state: 'reserved', lines: r.lines } : { state: 'settled', how: r.how };
+  },
+  reserve: (ids, kind, n, u, lines) => {
+    (ids.units.get(key(kind, n)) as Map<number, UnitRec>).set(u, { state: 'reserved', lines: [...lines] });
+    return ids;
+  },
+  settle: (ids, kind, n, u, how) => {
+    (ids.units.get(key(kind, n)) as Map<number, UnitRec>).set(u, { state: 'settled', how });
+    return ids;
+  },
+  reservedLines: (ids) => {
+    const out: QtyLine[] = [];
+    const keys = [...ids.units.keys()].sort((a, b) => {
+      const [ka, na] = a.split('#');
+      const [kb, nb] = b.split('#');
+      return ka !== kb ? ((ka as string) < (kb as string) ? -1 : 1) : Number(na) - Number(nb);
+    });
+    for (const k of keys) {
+      const [kind, n] = k.split('#');
+      if (ids.retired.get(kind as string)?.has(Number(n))) continue;
+      const units = ids.units.get(k) as Map<number, UnitRec>;
+      for (const u of [...units.keys()].sort((a, b) => a - b)) {
+        const r = units.get(u) as UnitRec;
+        if (r.state === 'reserved') out.push(...r.lines);
+      }
+    }
+    return out;
+  },
+  retire: (ids, kind, n) => {
+    const why = FULL_STORE.producerRefusal(ids, kind, n);
+    if (why) return why;
+    const units = ids.units.get(key(kind, n)) ?? new Map<number, UnitRec>();
+    if ([...units.values()].some((r) => r.state === 'reserved')) return 'RETIRE_OPEN_WORK';
+    const settled = [...units.keys()].sort((a, b) => a - b);
+    if (settled.some((u, i) => u !== i + 1)) return 'RETIRE_GAP';
+    let s = ids.retired.get(kind);
+    if (!s) ids.retired.set(kind, (s = new Set()));
+    s.add(n);
+    return ids;
+  },
+};
diff --git a/legion-progression-lab/src/l2/partition.ts b/legion-progression-lab/src/l2/partition.ts
new file mode 100644
index 0000000..3509d5c
--- /dev/null
+++ b/legion-progression-lab/src/l2/partition.ts
@@ -0,0 +1,127 @@
+/**
+ * L2 batch partition conformance (owner "Independent S4 Review and L2 Authorisation" §9A, §11; planning/L2_CONTRACT.md
+ * §1): identical productive intervals give identical results whatever their partition into storage batches. Each case
+ * draws an economy (Feat thresholds, an offline-efficiency window, action length), a schedule of gameplay deliveries
+ * (Monument purchases, recruits, queue creation and cancellation, kill credits) and a horizon; it settles the schedule
+ * once as a single batch and again with random extra settlement points, some followed by a checkpoint save and restore.
+ * The economies must be identical. The owner's worked example is checked exactly (250 ore either way).
+ */
+import { deliver, ECONOMY_V1, newAccount, type Account, type Delivery, type Economy, type Payload } from './account.ts';
+import { makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from './checkpoint.ts';
+import { compactStore, type CompactIds } from './compactIds.ts';
+import { economyView, mulberry32, seedOf } from './differential.ts';
+import { DEFAULT_RECEIPT_POLICY, type ReceiptPolicy } from './requests.ts';
+
+/** The owner's example: 100 ore per hour; a Feat grants +50% production after 100 ore (spec §4). */
+export const OWNER_EXAMPLE: Economy = Object.freeze({ ...ECONOMY_V1, id: 'l2-econ-owner-example', y1Milli: 0, expPerAction: 0, featTiers: Object.freeze([{ threshold: 100, bp: 5000 }]) });
+
+/** Settles `schedule` (deliveries in time order) with settlement points inserted before the deliveries they precede. */
+export function settleWithPoints(econ: Economy, policy: ReceiptPolicy, gatherers: number, schedule: readonly Delivery[], untilMs: number, points: readonly number[], checkpointAt: ReadonlySet<number>): Account<CompactIds> {
+  const store = compactStore(policy);
+  let a = newAccount(store, econ, [1, 2, 3, 4], gatherers);
+  let seq = 0;
+  let cp = 0;
+  const settle = (at: number) => {
+    seq += 1;
+    a = deliver(a, { type: 'request', atMs: at, stream: 'storage', seq, payload: { kind: 'settle', untilMs: at } }, econ, store).account;
+    if (checkpointAt.has(at)) {
+      cp += 1;
+      a = restoreCheckpoint(serializeCheckpoint(makeCheckpoint(a, econ, policy, cp, ['main'])), econ, policy, ['main']).account;
+    }
+  };
+  const pts = [...points].filter((p) => p <= untilMs).sort((x, y) => x - y);
+  let i = 0;
+  for (const d of schedule) {
+    while (i < pts.length && (pts[i] as number) <= d.atMs) settle(pts[i++] as number);
+    a = deliver(a, d, econ, store).account;
+  }
+  while (i < pts.length) settle(pts[i++] as number);
+  settle(untilMs);
+  return a;
+}
+
+export interface PartitionResult {
+  readonly seed: string;
+  readonly cases: number;
+  readonly partitionsChecked: number;
+  readonly withCheckpoints: number;
+  readonly mismatches: number;
+  readonly firstMismatches: readonly string[];
+  readonly ownerExample: { readonly oneBatch: number; readonly twoBatches: number; readonly manyBatches: number };
+  readonly boundaryEvents: { readonly featGrants: number; readonly levelUps: number; readonly windowEdges: number };
+}
+
+export function ownerExample(points: readonly number[]): number {
+  const a = settleWithPoints(OWNER_EXAMPLE, DEFAULT_RECEIPT_POLICY, 1, [], 7_200_000, points, new Set());
+  return a.counters.ore;
+}
+
+export function runPartition(seed: string, cases: number, partitionsPerCase: number): PartitionResult {
+  const rnd = mulberry32(seedOf(seed));
+  const int = (lo: number, hi: number) => lo + Math.floor(rnd() * (hi - lo + 1));
+  let mismatches = 0;
+  let checked = 0;
+  let withCp = 0;
+  const first: string[] = [];
+  let featGrants = 0;
+  let levelUps = 0;
+  let windowEdges = 0;
+  for (let c = 0; c < cases; c += 1) {
+    const horizon = int(1, 72) * 3_600_000;
+    const actionMs = int(5, 60) * 1000;
+    const offlineFrom = int(0, horizon);
+    const econ: Economy = Object.freeze({
+      ...ECONOMY_V1,
+      id: `l2-econ-case-${c}`,
+      actionMs,
+      expBase: int(20, 200),
+      featTiers: Object.freeze([{ threshold: int(5, 200), bp: int(500, 6000) }, { threshold: int(201, 3000), bp: int(500, 4000) }]),
+      efficiency: Object.freeze([{ fromMs: 0, bp: 0 }, { fromMs: offlineFrom, bp: -int(0, 5000) }, { fromMs: offlineFrom + int(1, 12) * 3_600_000, bp: -int(5000, 8000) }]),
+    });
+    windowEdges += 2;
+    const schedule: Delivery[] = [];
+    let n = 0;
+    let credit = 0;
+    for (let k = 0; k < int(0, 25); k += 1) {
+      const at = int(0, horizon);
+      const r = rnd();
+      const payload: Payload | null = r < 0.25 ? { kind: 'monument', levels: 1 } : r < 0.4 ? { kind: 'recruit' } : r < 0.6 ? { kind: 'createJob', quantity: int(1, 20) } : r < 0.7 ? { kind: 'cancelJob', job: int(1, 3) } : null;
+      if (payload) {
+        n += 1;
+        schedule.push({ type: 'request', atMs: at, stream: 'play', seq: n, payload });
+      } else {
+        credit += 1;
+        schedule.push({ type: 'credit', atMs: at, stream: 'squad', n: credit, gold: int(10, 400) });
+      }
+    }
+    schedule.sort((x, y) => x.atMs - y.atMs);
+    const gatherers = int(1, 4);
+    const single = settleWithPoints(econ, DEFAULT_RECEIPT_POLICY, gatherers, schedule, horizon, [], new Set());
+    featGrants += single.feats.length;
+    levelUps += single.gatherers.reduce((s, g) => s + g.level - 1, 0);
+    const ref = economyView(single);
+    for (let p = 0; p < partitionsPerCase; p += 1) {
+      const points = Array.from({ length: int(1, 30) }, () => int(0, horizon));
+      // Points exactly on action ends and on the window edges are the interesting ones.
+      if (rnd() < 0.5) points.push(actionMs * int(1, Math.max(1, Math.floor(horizon / actionMs))), offlineFrom);
+      const cps = new Set(points.filter(() => rnd() < 0.3));
+      if (cps.size > 0) withCp += 1;
+      const other = settleWithPoints(econ, DEFAULT_RECEIPT_POLICY, gatherers, schedule, horizon, points, cps);
+      checked += 1;
+      if (economyView(other) !== ref) {
+        mismatches += 1;
+        if (first.length < 10) first.push(`case ${c} partition ${p}: economies differ (points ${points.slice(0, 5).join(',')})`);
+      }
+    }
+  }
+  return {
+    seed,
+    cases,
+    partitionsChecked: checked,
+    withCheckpoints: withCp,
+    mismatches,
+    firstMismatches: first,
+    ownerExample: { oneBatch: ownerExample([]), twoBatches: ownerExample([3_600_000]), manyBatches: ownerExample([600_000, 1_234_567, 3_599_999, 3_600_000, 3_600_001, 5_000_000]) },
+    boundaryEvents: { featGrants, levelUps, windowEdges },
+  };
+}
diff --git a/legion-progression-lab/src/l2/producers.ts b/legion-progression-lab/src/l2/producers.ts
new file mode 100644
index 0000000..9521195
--- /dev/null
+++ b/legion-progression-lab/src/l2/producers.ts
@@ -0,0 +1,114 @@
+/**
+ * L2 producers and work operations (spec/formulas/l2-replay.md v1 §3; planning/L2_CONTRACT.md §5). Producer numbers
+ * are allocated monotonically per kind and never reused. Each unit moves none -> reserved -> completed | released, or
+ * none -> abandoned; completed, released and abandoned units form the producer's settled range set (bounded by its
+ * gaps), reserved units a finite map with their ledger lines. Retirement drops a producer's tables and adds its number
+ * to the kind's retired range set, so retired history stays bounded. Pure functions on immutable values.
+ */
+import { addOne, EMPTY_RANGE, gaps, has, type RangeSet } from './ranges.ts';
+
+export interface QtyLine {
+  readonly resourceId: string;
+  readonly qty: number;
+}
+
+export interface ProducerState {
+  /** Every settled unit (completed, released or abandoned): the gap check and exactly-once membership. */
+  readonly settled: RangeSet;
+  /** The settled units that were released or abandoned (permanently ineligible); completed = settled minus these. */
+  readonly released: RangeSet;
+  readonly abandoned: RangeSet;
+  /** Units currently reserved, by unit number, with the lines they hold (sorted by unit). */
+  readonly reserved: readonly { readonly unit: number; readonly lines: readonly QtyLine[] }[];
+  /** Highest unit number ever touched (the producer's own allocation high-water mark). */
+  readonly maxUnit: number;
+}
+
+export interface ProducerKind {
+  readonly allocated: number;
+  readonly retired: RangeSet;
+  readonly open: Readonly<Record<string, ProducerState>>;
+}
+
+export type WorkOp = 'reserve' | 'complete' | 'release' | 'abandon';
+export type WorkRefusal = 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN' | 'WORK_REPLAYED' | 'WORK_INELIGIBLE' | 'WORK_NOT_RESERVED' | 'INVALID_REQUEST';
+
+export const EMPTY_KIND: ProducerKind = Object.freeze({ allocated: 0, retired: EMPTY_RANGE, open: Object.freeze({}) });
+export const EMPTY_PRODUCER: ProducerState = Object.freeze({ settled: EMPTY_RANGE, released: EMPTY_RANGE, abandoned: EMPTY_RANGE, reserved: Object.freeze([]), maxUnit: 0 });
+
+/** Allocates the next producer number of a kind (never reused). */
+export function allocate(k: ProducerKind): { kind: ProducerKind; number: number } {
+  const number = k.allocated + 1;
+  if (!Number.isSafeInteger(number)) throw new Error('producer numbers exhausted');
+  return { kind: Object.freeze({ ...k, allocated: number, open: Object.freeze({ ...k.open, [String(number)]: EMPTY_PRODUCER }) }), number };
+}
+
+export function producerOf(k: ProducerKind, n: number): ProducerState | WorkRefusal {
+  if (!Number.isSafeInteger(n) || n < 1 || n > k.allocated) return 'PRODUCER_UNKNOWN';
+  if (has(k.retired, n)) return 'PRODUCER_RETIRED';
+  return k.open[String(n)] ?? 'PRODUCER_UNKNOWN';
+}
+
+export type UnitState = 'none' | 'reserved' | 'settled';
+
+export function unitState(p: ProducerState, u: number): UnitState {
+  if (has(p.settled, u)) return 'settled';
+  return p.reserved.some((r) => r.unit === u) ? 'reserved' : 'none';
+}
+
+/** How a settled unit was settled. */
+export function settledAs(p: ProducerState, u: number): WorkOp {
+  return has(p.released, u) ? 'release' : has(p.abandoned, u) ? 'abandon' : 'complete';
+}
+
+/** The transition of spec §3 for one unit, validated only (the account applies the ledger part). */
+export function checkOp(p: ProducerState, u: number, op: WorkOp): WorkRefusal | null {
+  if (!Number.isSafeInteger(u) || u < 1) return 'INVALID_REQUEST';
+  const st = unitState(p, u);
+  const how = st === 'settled' ? settledAs(p, u) : null;
+  switch (op) {
+    case 'reserve':
+      return st === 'none' ? null : st === 'reserved' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'complete':
+    case 'release':
+      if (st === 'reserved') return null;
+      if (st === 'none') return 'WORK_NOT_RESERVED';
+      return how === op ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+    case 'abandon':
+      if (st === 'none') return null;
+      return how === 'abandon' ? 'WORK_REPLAYED' : 'WORK_INELIGIBLE';
+  }
+}
+
+export function withReserve(p: ProducerState, u: number, lines: readonly QtyLine[]): ProducerState {
+  const reserved = [...p.reserved, Object.freeze({ unit: u, lines: Object.freeze([...lines]) })].sort((a, b) => a.unit - b.unit);
+  return Object.freeze({ ...p, reserved: Object.freeze(reserved), maxUnit: Math.max(p.maxUnit, u) });
+}
+
+/** Settles a unit (complete, release or abandon): it leaves the reserved map and joins the settled range set. */
+export function withSettled(p: ProducerState, u: number, how: Exclude<WorkOp, 'reserve'>): ProducerState {
+  return Object.freeze({
+    settled: addOne(p.settled, u),
+    released: how === 'release' ? addOne(p.released, u) : p.released,
+    abandoned: how === 'abandon' ? addOne(p.abandoned, u) : p.abandoned,
+    reserved: Object.freeze(p.reserved.filter((r) => r.unit !== u)),
+    maxUnit: Math.max(p.maxUnit, u),
+  });
+}
+
+export function reservedLines(p: ProducerState, u: number): readonly QtyLine[] {
+  return p.reserved.find((r) => r.unit === u)?.lines ?? [];
+}
+
+export type RetireRefusal = 'RETIRE_OPEN_WORK' | 'RETIRE_GAP' | 'PRODUCER_RETIRED' | 'PRODUCER_UNKNOWN';
+
+/** Spec §3 retire: no reserved unit and a settled set without gaps; then the number joins the retired set. */
+export function retire(k: ProducerKind, n: number): ProducerKind | RetireRefusal {
+  const p = producerOf(k, n);
+  if (typeof p === 'string') return p === 'PRODUCER_RETIRED' ? 'PRODUCER_RETIRED' : 'PRODUCER_UNKNOWN';
+  if (p.reserved.length > 0) return 'RETIRE_OPEN_WORK';
+  if (gaps(p.settled).length > 0 || p.settled.runs.length > 0) return 'RETIRE_GAP';
+  const open = { ...k.open };
+  delete open[String(n)];
+  return Object.freeze({ allocated: k.allocated, retired: addOne(k.retired, n), open: Object.freeze(open) });
+}
diff --git a/legion-progression-lab/src/l2/ranges.ts b/legion-progression-lab/src/l2/ranges.ts
new file mode 100644
index 0000000..95566ec
--- /dev/null
+++ b/legion-progression-lab/src/l2/ranges.ts
@@ -0,0 +1,124 @@
+/**
+ * L2 range sets (spec/formulas/l2-replay.md v1 §1): a contiguous settled prefix 1..p plus sorted, disjoint,
+ * non-adjacent runs above p + 1. Membership is exact; the size is the number of open gaps, not the history length.
+ * Adding anything already present is refused as a whole (RANGE_OVERLAP): an overlap is never trimmed. Immutable.
+ */
+import { fail } from '../core/errors.ts';
+
+export interface RangeSet {
+  readonly p: number;
+  readonly runs: readonly (readonly [number, number])[];
+}
+
+export const EMPTY_RANGE: RangeSet = Object.freeze({ p: 0, runs: Object.freeze([]) });
+
+const MAX = Number.MAX_SAFE_INTEGER;
+
+function member(x: number, what: string): number {
+  if (!Number.isSafeInteger(x) || x < 1) fail('INVALID_RANGE', `${what} must be a positive safe integer`, { what, x });
+  return x;
+}
+
+export function has(r: RangeSet, x: number): boolean {
+  if (!Number.isSafeInteger(x) || x < 1) return false;
+  if (x <= r.p) return true;
+  // Binary search over the runs.
+  let lo = 0;
+  let hi = r.runs.length - 1;
+  while (lo <= hi) {
+    const mid = (lo + hi) >> 1;
+    const [a, b] = r.runs[mid] as readonly [number, number];
+    if (x < a) hi = mid - 1;
+    else if (x > b) lo = mid + 1;
+    else return true;
+  }
+  return false;
+}
+
+/** True when some member lies in [a, b]. */
+export function intersects(r: RangeSet, a: number, b: number): boolean {
+  if (a <= r.p) return true;
+  for (const [x, y] of r.runs) {
+    if (x > b) return false;
+    if (y >= a) return true;
+  }
+  return false;
+}
+
+/** The normal form of R ∪ [a, b] (spec §1), refused as RANGE_OVERLAP when [a, b] meets R. */
+export function addRun(r: RangeSet, a: number, b: number): RangeSet {
+  member(a, 'range start');
+  member(b, 'range end');
+  if (a > b) fail('INVALID_RANGE', 'a range must have start <= end', { a, b });
+  if (intersects(r, a, b)) fail('RANGE_OVERLAP', `[${a}, ${b}] overlaps settled members`, { a, b });
+  const runs: [number, number][] = [];
+  let inserted = false;
+  for (const [x, y] of r.runs) {
+    if (!inserted && x > b) {
+      runs.push([a, b]);
+      inserted = true;
+    }
+    runs.push([x, y]);
+  }
+  if (!inserted) runs.push([a, b]);
+  // Merge touching runs, then fold a run starting at p + 1 into the prefix.
+  const merged: [number, number][] = [];
+  for (const run of runs) {
+    const last = merged[merged.length - 1];
+    if (last && run[0] === last[1] + 1) last[1] = run[1];
+    else merged.push([run[0], run[1]]);
+  }
+  let p = r.p;
+  while (merged.length > 0 && (merged[0] as [number, number])[0] === p + 1) p = (merged.shift() as [number, number])[1];
+  return Object.freeze({ p, runs: Object.freeze(merged.map((x) => Object.freeze(x) as readonly [number, number])) });
+}
+
+export const addOne = (r: RangeSet, x: number): RangeSet => addRun(r, x, x);
+
+/** Largest member (0 when empty). */
+export function maxOf(r: RangeSet): number {
+  const last = r.runs[r.runs.length - 1];
+  return last ? last[1] : r.p;
+}
+
+/** The maximal non-member intervals below the largest member. */
+export function gaps(r: RangeSet): [number, number][] {
+  const out: [number, number][] = [];
+  let next = r.p + 1;
+  for (const [a, b] of r.runs) {
+    if (a > next) out.push([next, a - 1]);
+    next = b + 1;
+  }
+  return out;
+}
+
+/** Number of members (checked: the count of a prefix plus runs never exceeds 2^53 - 1 members). */
+export function count(r: RangeSet): number {
+  let n = r.p;
+  for (const [a, b] of r.runs) n += b - a + 1;
+  if (!Number.isSafeInteger(n)) fail('NUMERIC_LIMIT', 'range set member count is not safe');
+  return n;
+}
+
+/** Problems of a decoded range set (empty when it is in normal form). Used by checkpoint validation. */
+export function rangeProblems(x: unknown, what: string): string[] {
+  const out: string[] = [];
+  if (typeof x !== 'object' || x === null) return [`${what}: not a range set`];
+  const r = x as { p?: unknown; runs?: unknown };
+  if (typeof r.p !== 'number' || !Number.isSafeInteger(r.p) || r.p < 0) out.push(`${what}: prefix ${String(r.p)} is not a non-negative safe integer`);
+  if (!Array.isArray(r.runs)) return [...out, `${what}: runs is not a list`];
+  let prev = typeof r.p === 'number' ? r.p : 0;
+  for (const run of r.runs as unknown[]) {
+    if (!Array.isArray(run) || run.length !== 2 || !run.every((v) => typeof v === 'number' && Number.isSafeInteger(v) && v >= 1 && v <= MAX)) {
+      out.push(`${what}: run ${JSON.stringify(run)} is not two positive safe integers`);
+      continue;
+    }
+    const [a, b] = run as [number, number];
+    if (a > b) out.push(`${what}: run [${a}, ${b}] has start > end`);
+    if (a <= prev + 1) out.push(`${what}: run [${a}, ${b}] is not above and apart from ${prev} (not in normal form)`);
+    prev = b;
+  }
+  return out;
+}
+
+export const rangeEqual = (a: RangeSet, b: RangeSet): boolean => a.p === b.p && a.runs.length === b.runs.length && a.runs.every((r, i) => r[0] === (b.runs[i] as readonly [number, number])[0] && r[1] === (b.runs[i] as readonly [number, number])[1]);
diff --git a/legion-progression-lab/src/l2/requests.ts b/legion-progression-lab/src/l2/requests.ts
new file mode 100644
index 0000000..cfcd8fb
--- /dev/null
+++ b/legion-progression-lab/src/l2/requests.ts
@@ -0,0 +1,112 @@
+/**
+ * L2 request streams and bounded receipts (spec/formulas/l2-replay.md v1 §2; planning/L2_CONTRACT.md §2–§3).
+ * Exactly-once protection is the stream's settled range set (permanent, compact); receipts are bounded by maxRecent and
+ * maxAgeMs (either limit evicts, oldest sequence first) and each eviction raises the closed horizon. The L1 reference
+ * (src/l2/l1Reference.ts) keeps every receipt and has no horizon. Immutable values; nothing here mutates.
+ */
+import { createHash } from 'node:crypto';
+import { fail } from '../core/errors.ts';
+import { canonicalJson } from '../core/hash/canonicalJson.ts';
+import { addOne, EMPTY_RANGE, has, type RangeSet } from './ranges.ts';
+
+export interface RequestId {
+  readonly stream: string;
+  readonly seq: number;
+}
+
+export type Receipt = Readonly<Record<string, string | number | boolean | null>>;
+
+export interface RecentReceipt {
+  readonly seq: number;
+  readonly payloadHash: string;
+  readonly receipt: Receipt;
+  readonly atMs: number;
+}
+
+export interface RequestStream {
+  readonly settled: RangeSet;
+  readonly closedBelow: number;
+  readonly recent: readonly RecentReceipt[];
+}
+
+export interface ReceiptPolicy {
+  readonly maxRecent: number;
+  readonly maxAgeMs: number;
+}
+
+/** Candidate receipt window (L2 contract §3): 256 receipts or 24 hours per stream, whichever evicts first. */
+export const DEFAULT_RECEIPT_POLICY: ReceiptPolicy = Object.freeze({ maxRecent: 256, maxAgeMs: 24 * 3_600_000 });
+
+export const EMPTY_STREAM: RequestStream = Object.freeze({ settled: EMPTY_RANGE, closedBelow: 0, recent: Object.freeze([]) });
+
+export type Classification =
+  | { readonly kind: 'NEW' }
+  | { readonly kind: 'REPLAY'; readonly receipt: Receipt }
+  | { readonly kind: 'CONFLICTING_PAYLOAD' | 'REPLAY_TOO_OLD' | 'REQUEST_EXPIRED' | 'INVALID_REQUEST' };
+
+export function payloadHash(payload: unknown): string {
+  return createHash('sha256').update(canonicalJson(payload as never), 'utf8').digest('hex');
+}
+
+function findRecent(s: RequestStream, seq: number): RecentReceipt | undefined {
+  let lo = 0;
+  let hi = s.recent.length - 1;
+  while (lo <= hi) {
+    const mid = (lo + hi) >> 1;
+    const r = s.recent[mid] as RecentReceipt;
+    if (seq < r.seq) hi = mid - 1;
+    else if (seq > r.seq) lo = mid + 1;
+    else return r;
+  }
+  return undefined;
+}
+
+/** Spec §2, rules 1–5, in order. */
+export function classify(s: RequestStream, seq: number, hash: string): Classification {
+  if (!Number.isSafeInteger(seq) || seq < 1) return { kind: 'INVALID_REQUEST' };
+  if (has(s.settled, seq)) {
+    const r = findRecent(s, seq);
+    if (r) return r.payloadHash === hash ? { kind: 'REPLAY', receipt: r.receipt } : { kind: 'CONFLICTING_PAYLOAD' };
+    return { kind: 'REPLAY_TOO_OLD' };
+  }
+  if (seq <= s.closedBelow) return { kind: 'REQUEST_EXPIRED' };
+  return { kind: 'NEW' };
+}
+
+/** Spec §2 record: settle `seq`, keep its receipt, then evict by count or age (oldest sequence first). */
+export function assertPolicy(policy: ReceiptPolicy): void {
+  if (!Number.isSafeInteger(policy.maxRecent) || policy.maxRecent < 1) fail('INVALID_NUMBER', 'maxRecent must be a positive safe integer', { maxRecent: policy.maxRecent });
+  if (!Number.isSafeInteger(policy.maxAgeMs) || policy.maxAgeMs < 0) fail('INVALID_NUMBER', 'maxAgeMs must be a non-negative safe integer', { maxAgeMs: policy.maxAgeMs });
+}
+
+export function record(s: RequestStream, seq: number, hash: string, receipt: Receipt, atMs: number, nowMs: number, policy: ReceiptPolicy): RequestStream {
+  assertPolicy(policy);
+  if (classify(s, seq, hash).kind !== 'NEW') fail('INVALID_STATE', 'only a NEW request can be recorded', { seq });
+  const settled = addOne(s.settled, seq);
+  const recent = [...s.recent];
+  let i = recent.length;
+  while (i > 0 && (recent[i - 1] as RecentReceipt).seq > seq) i -= 1;
+  recent.splice(i, 0, Object.freeze({ seq, payloadHash: hash, receipt, atMs }));
+  let closedBelow = s.closedBelow;
+  while (recent.length > 0 && (recent.length > policy.maxRecent || (recent[0] as RecentReceipt).atMs < nowMs - policy.maxAgeMs)) {
+    const ev = recent.shift() as RecentReceipt;
+    closedBelow = Math.max(closedBelow, ev.seq);
+  }
+  return Object.freeze({ settled, closedBelow, recent: Object.freeze(recent) });
+}
+
+/** Problems of a decoded request stream (checkpoint validation, spec §5). */
+export function streamProblems(s: RequestStream, policy: ReceiptPolicy, what: string): string[] {
+  const out: string[] = [];
+  if (!Number.isSafeInteger(s.closedBelow) || s.closedBelow < 0) out.push(`${what}: closedBelow is not a non-negative safe integer`);
+  if (s.recent.length > policy.maxRecent) out.push(`${what}: ${s.recent.length} receipts exceed maxRecent ${policy.maxRecent}`);
+  let prev = 0;
+  for (const r of s.recent) {
+    if (!Number.isSafeInteger(r.seq) || r.seq <= prev) out.push(`${what}: receipts are not in strictly increasing sequence order at ${String(r.seq)}`);
+    if (!has(s.settled, r.seq)) out.push(`${what}: receipt ${r.seq} is not in the settled set`);
+    if (r.seq <= s.closedBelow) out.push(`${what}: receipt ${r.seq} is not above the closed horizon ${s.closedBelow}`);
+    if (!/^[0-9a-f]{64}$/.test(r.payloadHash)) out.push(`${what}: receipt ${r.seq} has no SHA-256 payload hash`);
+    prev = r.seq;
+  }
+  return out;
+}
diff --git a/legion-progression-lab/src/l2/simCheckpoint.ts b/legion-progression-lab/src/l2/simCheckpoint.ts
new file mode 100644
index 0000000..6948c70
--- /dev/null
+++ b/legion-progression-lab/src/l2/simCheckpoint.ts
@@ -0,0 +1,137 @@
+/**
+ * L2 validated save and restore of the actual simulation (planning/L2_CONTRACT.md §6): a LegionSimulation between steps
+ * (its state, pending event queue, sequence counter and run counters) as canonical JSON with a SHA-256 digest. Restore
+ * validates the shape, digest, content versions, options and invariants (the ledger by the L1 reconstruction, the
+ * reservation balance against the jobs, the S4 permanent domain, the queue, the RNG states, assignment ownership) and
+ * never repairs anything. A restored simulation continues exactly as the uninterrupted one: identical state and
+ * identical subsequent event log. Its log digest restarts as a chain from the saved digest (`resume:<digest>`).
+ * Policies are passed in again: the checkpoint holds no policy code (the POL3/POL4 policies keep no hidden state).
+ */
+import { fail } from '../core/errors.ts';
+import { canonicalJson, fingerprint } from '../core/hash/canonicalJson.ts';
+import { balance } from '../core/ledger/ledger.ts';
+import { DEFAULT_LEDGER } from '../core/ledger/implementations.ts';
+import { reconstructPersistentLedger, serializeLedger } from '../core/ledger/persistentLedger.ts';
+import { permanentStateProblems } from '../engine/permanent.ts';
+import { LegionSimulation, type LegionOptions, type SimRuntime } from '../engine/legion.ts';
+import type { IndustryContent } from '../model/industryContent.ts';
+import type { PermanentContent } from '../model/permanentContent.ts';
+import type { PermanentState } from '../model/permanentTypes.ts';
+
+export const SIM_CHECKPOINT_SCHEMA = 'legion.l2.sim-checkpoint.v1';
+
+function versionsOf(content: LegionOptions['content']): Record<string, string | null> {
+  const c = content as unknown as Record<string, unknown>;
+  const v = (k: string) => (typeof c[k] === 'string' ? (c[k] as string) : null);
+  return { contentHash: v('contentHash'), tableHash: v('tableHash'), legionContentHash: v('legionContentHash'), industryContentHash: v('industryContentHash'), permanentContentHash: v('permanentContentHash') };
+}
+
+function optionsOf(o: LegionOptions): Record<string, unknown> {
+  return { seedRoot: o.seedRoot, sessions: o.sessions, legion: o.legion === true, industry: o.industry === true, permanent: o.permanent === true, ledger: o.ledger ?? DEFAULT_LEDGER, diagnostic: o.diagnostic ?? null, queueArm: (o as { queueArm?: string }).queueArm ?? null };
+}
+
+/** Saves a simulation between steps (refused inside a step or after a refused step). */
+export function saveSimulation(sim: LegionSimulation): string {
+  // The persistent (L1) ledger has the validated reconstruction; the reference ledger is the differential control only.
+  if ((sim.options.ledger ?? DEFAULT_LEDGER) !== 'persistent') fail('INVALID_STATE', 'a simulation checkpoint needs the persistent ledger (options.ledger)');
+  const runtime = sim.runtimeSnapshot();
+  const body = {
+    schema: SIM_CHECKPOINT_SCHEMA,
+    versions: versionsOf(sim.content),
+    options: optionsOf(sim.options),
+    state: { ...sim.state, ledger: JSON.parse(serializeLedger(sim.state.ledger)) },
+    runtime,
+  };
+  return canonicalJson({ ...body, digest: fingerprint(body as never) } as never);
+}
+
+const isInt = (v: unknown, min = 0): v is number => typeof v === 'number' && Number.isSafeInteger(v) && v >= min;
+const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
+const rngOk = (r: unknown) => Array.isArray(r) && r.length === 4 && r.every((x) => isInt(x) && x <= 0xffffffff) && !r.every((x) => x === 0);
+
+/** Every problem of a decoded simulation checkpoint for these content and options (empty when it may be restored). */
+export function simCheckpointProblems(doc: unknown, options: LegionOptions): string[] {
+  if (!isObj(doc) || Object.keys(doc).sort().join(',') !== 'digest,options,runtime,schema,state,versions') return ['sim checkpoint: not an object with exactly the v1 fields'];
+  const out: string[] = [];
+  if (doc['schema'] !== SIM_CHECKPOINT_SCHEMA) out.push('sim checkpoint: wrong schema');
+  const { digest, ...body } = doc;
+  try {
+    if (fingerprint(body as never) !== digest) out.push('sim checkpoint: digest mismatch (corrupted or edited)');
+  } catch (e) {
+    return [`sim checkpoint: not canonical JSON data (${(e as Error).message})`];
+  }
+  if (canonicalJson(doc['versions'] as never) !== canonicalJson(versionsOf(options.content) as never)) out.push('sim checkpoint: content versions differ from the running content');
+  if (canonicalJson(doc['options'] as never) !== canonicalJson(optionsOf(options) as never)) out.push('sim checkpoint: options (seed, sessions, switches, ledger, diagnostics) differ');
+  if (out.length > 0) return out;
+  const st = doc['state'] as Record<string, unknown>;
+  const rt = doc['runtime'] as Record<string, unknown>;
+  if (!isObj(st) || !isInt(st['tMs'])) return ['sim checkpoint: state time is not a non-negative safe integer'];
+  if (!isObj(rt) || !isInt(rt['seq']) || !isInt(rt['logCount']) || !Array.isArray(rt['events']) || !isObj(rt['counters']) || !isObj(rt['policyDecisionsAt'])) return ['sim checkpoint: runtime is malformed'];
+  // The ledger, by the L1 validated reconstruction.
+  let ledger: ReturnType<typeof reconstructPersistentLedger> | null = null;
+  try {
+    ledger = reconstructPersistentLedger(st['ledger']);
+  } catch (e) {
+    out.push(`sim checkpoint: the ledger does not reconstruct (${(e as Error).message})`);
+  }
+  // The queue: well-formed keys, unique sequence numbers at most the counter, nothing before the state time.
+  const seen = new Set<number>();
+  for (const e of rt['events'] as unknown[]) {
+    const k = isObj(e) ? (e['key'] as Record<string, unknown>) : null;
+    if (!k || !isInt(k['t']) || !isInt(k['pass']) || !isInt(k['phase']) || typeof k['entityOrder'] !== 'string' || !isInt(k['seq']) || typeof (e as Record<string, unknown>)['kind'] !== 'string') {
+      out.push('sim checkpoint: a queued event is malformed');
+      break;
+    }
+    if ((k['t'] as number) < (st['tMs'] as number)) out.push(`sim checkpoint: a queued event at ${String(k['t'])} lies before the state time`);
+    // The engine increments its counter before numbering an event, so every queued number is at most the counter.
+    if ((k['seq'] as number) > (rt['seq'] as number) || seen.has(k['seq'] as number)) out.push(`sim checkpoint: queued event sequence ${String(k['seq'])} is duplicated or above the counter`);
+    seen.add(k['seq'] as number);
+  }
+  // RNG streams: the account streams and every character's.
+  const rng = st['rng'];
+  if (!isObj(rng) || !Object.values(rng).every(rngOk)) out.push('sim checkpoint: an account RNG state is malformed or all zero');
+  const legion = st['legion'] as { chars?: unknown } | undefined;
+  const chars = Array.isArray(legion?.chars) ? (legion?.chars as Record<string, unknown>[]) : [];
+  const ids = new Set<string>();
+  for (const c of chars) {
+    if (!isObj(c) || typeof c['id'] !== 'string' || ids.has(c['id'])) out.push('sim checkpoint: character identities are missing or duplicated');
+    else ids.add(c['id']);
+    if (isObj(c) && isObj(c['rng']) && !Object.values(c['rng']).every(rngOk)) out.push(`sim checkpoint: character ${String(c['id'])} RNG state is malformed or all zero`);
+  }
+  // Industry: assignment ownership and the reservation balance (reserved bucket = inputs held by jobs, monitor I15).
+  const ind = st['industry'] as { jobs?: { id: string; recipeId: string; reservedUnits: number }[]; work?: Record<string, unknown> } | undefined;
+  const content = options.content as unknown as IndustryContent;
+  if (ind && ledger && content.recipes) {
+    const held = new Map<string, number>();
+    for (const j of ind.jobs ?? []) {
+      const r = content.recipes.get(j.recipeId);
+      if (!r) {
+        out.push(`sim checkpoint: job ${j.id} names an unknown recipe`);
+        continue;
+      }
+      for (const q of r.inputs) held.set(q.resourceId, (held.get(q.resourceId) ?? 0) + q.qty * j.reservedUnits);
+    }
+    if ((options as { queueArm?: string }).queueArm !== 'reserve-all') for (const res of content.resources) if (balance(ledger, res.id, 'reserved') !== (held.get(res.id) ?? 0)) out.push(`sim checkpoint: reserved ${res.id} ${balance(ledger, res.id, 'reserved')} differs from the inputs held by jobs ${held.get(res.id) ?? 0}`);
+    for (const who of Object.keys(ind.work ?? {})) if (!ids.has(who)) out.push(`sim checkpoint: work in progress belongs to an unknown character ${who}`);
+  }
+  // S4: the permanent domain (correction A).
+  if (st['permanent'] && (options.content as PermanentContent).permanent) {
+    for (const p of permanentStateProblems((options.content as PermanentContent).permanent, st['permanent'] as PermanentState)) out.push(`sim checkpoint: ${p}`);
+  }
+  return out;
+}
+
+/** Restores a simulation after full validation; the caller passes the content, options and policy again. */
+export function restoreSimulation(text: string, options: LegionOptions): LegionSimulation {
+  let doc: Record<string, unknown>;
+  try {
+    doc = JSON.parse(text) as Record<string, unknown>;
+  } catch {
+    return fail('INVALID_CHECKPOINT', 'sim checkpoint: not JSON');
+  }
+  const problems = simCheckpointProblems(doc, options);
+  if (problems.length > 0) fail('INVALID_CHECKPOINT', problems[0] as string, { problems });
+  const st = doc['state'] as Record<string, unknown>;
+  const state = { ...st, ledger: reconstructPersistentLedger(st['ledger']) } as unknown as LegionSimulation['state'];
+  return LegionSimulation.restoreRuntime(options, state, doc['runtime'] as unknown as SimRuntime);
+}
diff --git a/legion-progression-lab/src/spec/l2Fixtures.ts b/legion-progression-lab/src/spec/l2Fixtures.ts
new file mode 100644
index 0000000..f441b11
--- /dev/null
+++ b/legion-progression-lab/src/spec/l2Fixtures.ts
@@ -0,0 +1,94 @@
+/**
+ * L2 fixture handlers (spec/fixtures/l2-*.v1.json; spec/formulas/l2-replay.md v1). They call the real L2 functions:
+ * range sets, request streams, producers and work operations, and the chronological settlement of the synthetic
+ * account; for settlement, every listed partition (with a checkpoint save and restore at each point) must give the same
+ * result, which is returned. Pure (no I/O). The independent re-derivation is spec/oracle/l2_oracle.py.
+ */
+import { fail } from '../core/errors.ts';
+import { ECONOMY_V1, BAR, GOLD, ORE, type Delivery, type Economy } from '../l2/account.ts';
+import { settleWithPoints } from '../l2/partition.ts';
+import { allocate, checkOp, EMPTY_KIND, producerOf, retire, withReserve, withSettled, type ProducerKind } from '../l2/producers.ts';
+import { addRun, EMPTY_RANGE, gaps, has, type RangeSet } from '../l2/ranges.ts';
+import { assertPolicy, classify, EMPTY_STREAM, record, type RequestStream } from '../l2/requests.ts';
+
+type Json = Record<string, unknown>;
+
+export function runL2Case(family: string, inp: Json): Json {
+  switch (family) {
+    case 'l2-ranges': {
+      let r: RangeSet = EMPTY_RANGE;
+      for (const [a, b] of inp['adds'] as [number, number][]) r = addRun(r, a, b);
+      return { p: r.p, runs: r.runs.map((x) => [x[0], x[1]]), gaps: gaps(r), member: (inp['queries'] as number[]).map((q) => has(r, q)) };
+    }
+    case 'l2-requests': {
+      const policy = inp['policy'] as { maxRecent: number; maxAgeMs: number };
+      assertPolicy(policy);
+      let s: RequestStream = EMPTY_STREAM;
+      const kinds: string[] = [];
+      for (const st of inp['steps'] as { seq: number; hash: string; atMs: number; nowMs: number }[]) {
+        const c = classify(s, st.seq, st.hash);
+        kinds.push(c.kind);
+        if (c.kind === 'NEW') s = record(s, st.seq, st.hash, { code: 'OK' }, st.atMs, st.nowMs, policy);
+      }
+      return { kinds, closedBelow: s.closedBelow, recent: s.recent.map((r) => r.seq), settled: { p: s.settled.p, runs: s.settled.runs.map((x) => [x[0], x[1]]) } };
+    }
+    case 'l2-work': {
+      let k: ProducerKind = EMPTY_KIND;
+      const allocated = inp['allocated'] as number;
+      if (!Number.isSafeInteger(allocated) || allocated < 0 || allocated > 1000) fail('INVALID_NUMBER', 'allocated must be an integer in [0, 1000] in a fixture');
+      for (let i = 0; i < allocated; i += 1) k = allocate(k).kind;
+      const codes: string[] = [];
+      for (const step of inp['ops'] as { producer: number; unit?: number; op: string }[]) {
+        if (step.op === 'retire') {
+          const r = retire(k, step.producer);
+          if (typeof r === 'string') codes.push(r);
+          else {
+            k = r;
+            codes.push('OK');
+          }
+          continue;
+        }
+        const p = producerOf(k, step.producer);
+        if (typeof p === 'string') {
+          codes.push(p);
+          continue;
+        }
+        const u = step.unit as number;
+        const op = step.op as 'reserve' | 'complete' | 'release' | 'abandon';
+        const why = checkOp(p, u, op);
+        if (why) {
+          codes.push(why);
+          continue;
+        }
+        const next = op === 'reserve' ? withReserve(p, u, []) : withSettled(p, u, op);
+        k = { ...k, open: { ...k.open, [String(step.producer)]: next } };
+        codes.push('OK');
+      }
+      return { codes, retired: (() => { const out: number[] = []; for (let n = 1; n <= k.allocated; n += 1) if (has(k.retired, n)) out.push(n); return out; })() };
+    }
+    case 'l2-settlement': {
+      const econ: Economy = { ...ECONOMY_V1, ...(inp['economy'] as Partial<Economy>), id: 'l2-econ-fixture' };
+      let seq = 0;
+      let credit = 0;
+      const schedule: Delivery[] = (inp['schedule'] as { atMs: number; kind: string; gold?: number; quantity?: number; job?: number }[]).map((d) => {
+        if (d.kind === 'credit') return { type: 'credit', atMs: d.atMs, stream: 'squad', n: (credit += 1), gold: d.gold as number };
+        seq += 1;
+        const payload = d.kind === 'createJob' ? { kind: 'createJob' as const, quantity: d.quantity as number } : d.kind === 'cancelJob' ? { kind: 'cancelJob' as const, job: d.job as number } : d.kind === 'recruit' ? { kind: 'recruit' as const } : { kind: 'monument' as const, levels: 1 as const };
+        return { type: 'request', atMs: d.atMs, stream: 'play', seq, payload };
+      });
+      const policy = { maxRecent: 64, maxAgeMs: 3_600_000 };
+      const results = (inp['partitions'] as number[][]).map((pts) => {
+        const a = settleWithPoints(econ, policy, inp['gatherers'] as number, schedule, inp['untilMs'] as number, pts, new Set(pts));
+        const b = (r: string) => a.balances[r] as { available: number; reserved: number };
+        return { t: a.t, ore: b(ORE).available, oreReserved: b(ORE).reserved, bar: b(BAR).available, gold: b(GOLD).available, lifetimeOre: a.counters.ore, feats: [...a.feats], monument: a.monumentLevel, levels: a.gatherers.map((g) => g.level), remainders: a.gatherers.map((g) => g.rem) };
+      });
+      const first = JSON.stringify(results[0]);
+      results.forEach((r, i) => {
+        if (JSON.stringify(r) !== first) fail('INVALID_STATE', `settlement depends on the partition (partition ${i})`);
+      });
+      return results[0] as unknown as Json;
+    }
+    default:
+      return fail('INVALID_STATE', `unknown L2 family ${family}`);
+  }
+}
diff --git a/legion-progression-lab/test/l2.core.test.ts b/legion-progression-lab/test/l2.core.test.ts
new file mode 100644
index 0000000..e3a0124
--- /dev/null
+++ b/legion-progression-lab/test/l2.core.test.ts
@@ -0,0 +1,295 @@
+/**
+ * L2 core (planning/L2_CONTRACT.md v2.0; spec/formulas/l2-replay.md v1): range sets, request streams and bounded
+ * receipts, work operations and retirement, the synthetic account's request identities and atomic settlement,
+ * validated checkpoints, batch partition invariance and the L1 differential (small runs; the registered runs are in
+ * manifests/l2/).
+ */
+import fc from 'fast-check';
+import { describe, expect, it } from 'vitest';
+import { canonicalJson, fingerprint } from '../src/core/hash/canonicalJson.ts';
+import { deliver, ECONOMY_V1, newAccount, reservationProblems, type Account, type Delivery, type Payload } from '../src/l2/account.ts';
+import { checkpointProblems, makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from '../src/l2/checkpoint.ts';
+import { compactStore, type CompactIds } from '../src/l2/compactIds.ts';
+import { economyView, runDifferential } from '../src/l2/differential.ts';
+import { FULL_STORE } from '../src/l2/l1Reference.ts';
+import { ownerExample, runPartition } from '../src/l2/partition.ts';
+import { allocate, EMPTY_KIND, EMPTY_PRODUCER, checkOp, retire, withReserve, withSettled } from '../src/l2/producers.ts';
+import { addRun, count, EMPTY_RANGE, gaps, has, rangeProblems, type RangeSet } from '../src/l2/ranges.ts';
+import { classify, DEFAULT_RECEIPT_POLICY, EMPTY_STREAM, record, streamProblems, type RequestStream } from '../src/l2/requests.ts';
+
+const POLICY = { maxRecent: 4, maxAgeMs: 10_000 };
+const STORE = compactStore(POLICY);
+const ECON = ECONOMY_V1;
+const fresh = () => newAccount(STORE, ECON, [1, 2, 3, 4], 2);
+const req = (seq: number, payload: Payload, atMs = 0, stream = 'c'): Delivery => ({ type: 'request', atMs, stream, seq, payload });
+
+describe('range sets (spec §1)', () => {
+  it('agree with a plain set for random additions; normal form; overlaps refused whole (property)', () => {
+    fc.assert(
+      fc.property(fc.array(fc.tuple(fc.integer({ min: 1, max: 60 }), fc.integer({ min: 0, max: 4 })), { maxLength: 60 }), (adds) => {
+        let r: RangeSet = EMPTY_RANGE;
+        const naive = new Set<number>();
+        for (const [a, len] of adds) {
+          const b = a + len;
+          const overlap = Array.from({ length: len + 1 }, (_, i) => a + i).some((x) => naive.has(x));
+          if (overlap) {
+            expect(() => addRun(r, a, b)).toThrow(/RANGE_OVERLAP/);
+            continue;
+          }
+          r = addRun(r, a, b);
+          for (let x = a; x <= b; x += 1) naive.add(x);
+          expect(rangeProblems(r, 'r')).toEqual([]);
+        }
+        for (let x = 1; x <= 70; x += 1) expect(has(r, x)).toBe(naive.has(x));
+        expect(count(r)).toBe(naive.size);
+        // The size is the number of gaps (plus at most one run above the last gap), not the history length.
+        expect(r.runs.length).toBe(gaps(r).length);
+      }),
+      { numRuns: 400 },
+    );
+  });
+
+  it('a contiguous history collapses into the prefix; malformed shapes are named', () => {
+    let r: RangeSet = EMPTY_RANGE;
+    for (let x = 1; x <= 10_000; x += 1) r = addRun(r, x, x);
+    expect(r).toEqual({ p: 10_000, runs: [] });
+    expect(rangeProblems({ p: 2, runs: [[3, 4]] }, 'x')[0]).toMatch(/not in normal form/);
+    expect(rangeProblems({ p: 0, runs: [[5, 3]] }, 'x')[0]).toMatch(/start > end/);
+    expect(rangeProblems({ p: -1, runs: [] }, 'x')[0]).toMatch(/prefix/);
+    expect(() => addRun(EMPTY_RANGE, 0, 1)).toThrow(/INVALID_RANGE/);
+  });
+});
+
+describe('request streams and bounded receipts (spec §2)', () => {
+  const h = (x: string) => x.padEnd(64, '0');
+  const rec = (s: RequestStream, seq: number, at: number, now = at) => record(s, seq, h('a'), { code: 'OK', seq }, at, now, POLICY);
+  it('NEW, REPLAY with the original receipt, CONFLICTING_PAYLOAD, REPLAY_TOO_OLD after eviction, REQUEST_EXPIRED below the horizon', () => {
+    let s = EMPTY_STREAM;
+    for (let q = 1; q <= 6; q += 1) s = rec(s, q, q * 100);
+    // maxRecent 4: receipts 3..6 kept; 1 and 2 evicted, horizon 2.
+    expect(s.recent.map((r) => r.seq)).toEqual([3, 4, 5, 6]);
+    expect(s.closedBelow).toBe(2);
+    expect(classify(s, 5, h('a'))).toEqual({ kind: 'REPLAY', receipt: { code: 'OK', seq: 5 } });
+    expect(classify(s, 5, h('b')).kind).toBe('CONFLICTING_PAYLOAD');
+    expect(classify(s, 1, h('a')).kind).toBe('REPLAY_TOO_OLD');
+    expect(classify(s, 7, h('a')).kind).toBe('NEW');
+    expect(classify(s, 0, h('a')).kind).toBe('INVALID_REQUEST');
+    // A skipped number below the horizon is expired; one above it is still new (out-of-order arrival).
+    let t = EMPTY_STREAM;
+    for (const q of [1, 3, 4, 5, 6, 7]) t = rec(t, q, q * 100);
+    expect(t.closedBelow).toBe(3);
+    expect(classify(t, 2, h('a')).kind).toBe('REQUEST_EXPIRED');
+    let u = EMPTY_STREAM;
+    for (const q of [1, 2, 4]) u = rec(u, q, q * 100);
+    expect(classify(u, 3, h('a')).kind).toBe('NEW');
+    expect(streamProblems(s, POLICY, 's')).toEqual([]);
+  });
+
+  it('age evicts too: receipts older than maxAgeMs go first, whichever limit is reached first', () => {
+    let s = EMPTY_STREAM;
+    s = rec(s, 1, 0, 0);
+    s = rec(s, 2, 5000, 5000);
+    s = rec(s, 3, 20_000, 20_000);
+    expect(s.recent.map((r) => r.seq)).toEqual([3]);
+    expect(s.closedBelow).toBe(2);
+    expect(() => rec(s, 3, 21_000)).toThrow(/only a NEW request/);
+  });
+});
+
+describe('work operations and retirement (spec §3)', () => {
+  it('the transition table: replay, ineligible and not-reserved refusals', () => {
+    let p = EMPTY_PRODUCER;
+    expect(checkOp(p, 1, 'complete')).toBe('WORK_NOT_RESERVED');
+    expect(checkOp(p, 1, 'release')).toBe('WORK_NOT_RESERVED');
+    expect(checkOp(p, 1, 'reserve')).toBeNull();
+    p = withReserve(p, 1, [{ resourceId: 'res.ore', qty: 2 }]);
+    expect(checkOp(p, 1, 'reserve')).toBe('WORK_REPLAYED');
+    expect(checkOp(p, 1, 'abandon')).toBe('WORK_INELIGIBLE');
+    p = withSettled(p, 1, 'release');
+    expect(checkOp(p, 1, 'release')).toBe('WORK_REPLAYED');
+    expect(checkOp(p, 1, 'complete')).toBe('WORK_INELIGIBLE');
+    expect(checkOp(p, 1, 'reserve')).toBe('WORK_INELIGIBLE');
+    p = withSettled(p, 2, 'abandon');
+    expect(checkOp(p, 2, 'abandon')).toBe('WORK_REPLAYED');
+    expect(checkOp(p, 2, 'reserve')).toBe('WORK_INELIGIBLE');
+  });
+
+  it('retirement needs no open work and no gap; numbers are never reused; retired history stays bounded', () => {
+    let k = EMPTY_KIND;
+    for (let i = 0; i < 1000; i += 1) {
+      const o = allocate(k);
+      k = o.kind;
+      const r = retire(k, o.number);
+      expect(typeof r).not.toBe('string');
+      k = r as typeof k;
+    }
+    expect(k.retired).toEqual({ p: 1000, runs: [] });
+    expect(Object.keys(k.open)).toEqual([]);
+    const o = allocate(k);
+    expect(o.number).toBe(1001);
+    const withGap = { ...o.kind, open: { ...o.kind.open, '1001': withSettled(EMPTY_PRODUCER, 2, 'complete') } };
+    expect(retire(withGap, 1001)).toBe('RETIRE_GAP');
+    const withOpen = { ...o.kind, open: { ...o.kind.open, '1001': withReserve(EMPTY_PRODUCER, 1, []) } };
+    expect(retire(withOpen, 1001)).toBe('RETIRE_OPEN_WORK');
+    expect(retire(o.kind, 5)).toBe('PRODUCER_RETIRED');
+    expect(retire(o.kind, 1002)).toBe('PRODUCER_UNKNOWN');
+  });
+});
+
+describe('the synthetic account: request identities, atomic settlement (contract §2, §7)', () => {
+  const give = (a: Account<CompactIds>, gold: number, n = 1) => deliver(a, { type: 'credit', atMs: a.t, stream: 'squad', n, gold }, ECON, STORE).account;
+  it('a retried one-level Monument purchase returns its original receipt and never buys the next level', () => {
+    let a = give(fresh(), 1000);
+    const buy = req(1, { kind: 'monument', levels: 1 });
+    const first = deliver(a, buy, ECON, STORE);
+    a = first.account;
+    expect(first.outcome.receipt).toMatchObject({ code: 'OK', level: 1 });
+    const again = deliver(a, buy, ECON, STORE);
+    expect(again.outcome).toEqual({ code: 'REPLAY', receipt: first.outcome.receipt });
+    expect(again.account).toBe(a);
+    expect(again.account.monumentLevel).toBe(1);
+    // A deliberately new purchase uses a new identity.
+    const next = deliver(a, req(2, { kind: 'monument', levels: 1 }), ECON, STORE);
+    expect(next.account.monumentLevel).toBe(2);
+    // Same identity, other payload: refused, nothing changes.
+    const conflict = deliver(next.account, req(2, { kind: 'recruit' }), ECON, STORE);
+    expect(conflict.outcome.code).toBe('CONFLICTING_PAYLOAD');
+    expect(conflict.account).toBe(next.account);
+  });
+
+  it('batch settlement is atomic: overlapping or partly unreserved ranges are refused whole', () => {
+    let a = give(fresh(), 0);
+    a = deliver(a, req(1, { kind: 'settle', untilMs: 3_600_000 }), ECON, STORE).account;
+    const open = deliver(a, req(2, { kind: 'openBatch' }), ECON, STORE);
+    a = open.account;
+    const producer = open.outcome.receipt?.['producer'] as number;
