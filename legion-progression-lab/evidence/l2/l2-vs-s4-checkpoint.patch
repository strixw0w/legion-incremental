index 0000000..354cb2b
--- /dev/null
+++ b/legion-progression-lab/src/cli/l2-perf.ts
@@ -0,0 +1,212 @@
+/**
+ * L2 staged performance workloads (CLI layer: it reads the clock and the process memory) (owner §11; manifests/l2/PREREGISTRATION.md): a synthetic account driven through
+ * day-, week- and month-scale transaction volumes, with the registered budgets enforced while it runs (a stage that
+ * exceeds its time or heap budget is stopped and reported as such). Measured: wall time, throughput, peak heap,
+ * process memory, retained heap of the account after garbage collection (needs --expose-gc), serialized checkpoint
+ * size, replay tail (retained receipts), reconstruction latency, and how the retained size grows with processed history.
+ * The L1 reference's retained receipts are counted alongside for comparison. Simulator measurements only: not Roblox
+ * persistence limits.
+ */
+import { deliver, ECONOMY_V1, newAccount, type Account, type Delivery, type Payload } from '../l2/account.ts';
+import { makeCheckpoint, restoreCheckpoint, serializeCheckpoint } from '../l2/checkpoint.ts';
+import { compactStore, type CompactIds } from '../l2/compactIds.ts';
+import { mulberry32, seedOf } from '../l2/differential.ts';
+import { FULL_STORE, fullReceiptCount, type FullIds } from '../l2/l1Reference.ts';
+import type { ReceiptPolicy } from '../l2/requests.ts';
+
+export interface PerfStage {
+  readonly id: string;
+  readonly days: number;
+  readonly budgetWallMs: number;
+  readonly budgetPeakHeapMb: number;
+}
+
+export interface PerfBudgets {
+  readonly retainedMb: number;
+  readonly reconstructionP95Ms: number;
+  readonly checkpointKb: number;
+}
+
+export interface StageResult {
+  readonly id: string;
+  readonly status: 'COMPLETED' | 'STOPPED_TIME_BUDGET' | 'STOPPED_HEAP_BUDGET';
+  readonly simulatedDays: number;
+  readonly deliveries: number;
+  /** Ore and bars produced by the economy (units, not events). */
+  readonly unitsProduced: number;
+  readonly wallMs: number;
+  readonly deliveriesPerSecond: number;
+  readonly peakHeapMb: number;
+  readonly peakRssMb: number;
+  readonly retainedHeapMb: number | null;
+  /** Amendment 01: the heap held by the account alone, restored from its checkpoint after GC (null without --expose-gc). */
+  readonly accountHeapMb: number | null;
+  /** Amendment 01: finished job producers retired by the client's housekeeping requests. */
+  readonly jobsRetired: number;
+  readonly checkpointBytes: number;
+  readonly replayTailReceipts: number;
+  readonly replayTailBytes: number;
+  readonly rangeRuns: number;
+  readonly reconstructionMs: { readonly n: number; readonly median: number; readonly p95: number; readonly max: number };
+  readonly l1ReceiptsRetained: number | null;
+  readonly growth: readonly { readonly day: number; readonly checkpointBytes: number; readonly replayTailReceipts: number }[];
+  readonly budgets: { readonly retained: boolean | null; readonly reconstruction: boolean; readonly checkpoint: boolean };
+}
+
+const MB = 1024 * 1024;
+const gc = (globalThis as { gc?: () => void }).gc;
+
+/** Per simulated hour: kill credits every 4 s, a request a minute, two work operations a minute, settles each 10 min. */
+function* workload(seed: string, days: number): Generator<Delivery> {
+  const rnd = mulberry32(seedOf(seed));
+  const int = (lo: number, hi: number) => lo + Math.floor(rnd() * (hi - lo + 1));
+  let seq = 0;
+  let credit = 0;
+  let batch = 0;
+  let unit = 0;
+  const end = days * 86_400_000;
+  for (let t = 0; t < end; t += 4000) {
+    credit += 1;
+    yield { type: 'credit', atMs: t, stream: 'squad', n: credit, gold: int(1, 6) };
+    if (t % 60_000 === 0) {
+      seq += 1;
+      const r = rnd();
+      const payload: Payload = r < 0.2 ? { kind: 'monument', levels: 1 } : r < 0.3 ? { kind: 'createJob', quantity: int(1, 10) } : r < 0.35 ? { kind: 'cancelJob', job: int(1, 3) } : r < 0.45 ? { kind: 'openBatch' } : r < 0.6 ? { kind: 'craft' } : { kind: 'settle', untilMs: t };
+      if (payload.kind === 'openBatch') {
+        // A finished batch is retired before the next one opens (every unit was reserved and then settled).
+        // Sequence numbers stay gap-free: the retire takes this minute's number and the open the next one.
+        if (batch > 0) {
+          yield { type: 'request', atMs: t, stream: 'client', seq, payload: { kind: 'retire', producerKind: 'batch', number: batch } };
+          seq += 1;
+        }
+        batch += 1;
+        unit = 0;
+      }
+      yield { type: 'request', atMs: t, stream: 'client', seq, payload };
+    }
+    if (t % 30_000 === 0 && batch > 0) {
+      unit += 1;
+      yield { type: 'work', atMs: t, producer: batch, unit, op: 'reserve', qty: 1 };
+      yield { type: 'work', atMs: t, producer: batch, unit, op: rnd() < 0.9 ? 'complete' : 'release', qty: 1 };
+      // Closes the unit if its reserve was refused (no ore yet); otherwise refused as ineligible. No gap is left.
+      yield { type: 'work', atMs: t, producer: batch, unit, op: 'abandon', qty: 1 };
+    }
+  }
+}
+
+/** Holds the isolated account between the two heap readings (so the collector cannot free it early). */
+let isolated: unknown = null;
+/** Read by nothing but the collector; exported so the reference is a live one. */
+export const isolatedAccount = (): unknown => isolated;
+
+export function runStage(stage: PerfStage, budgets: PerfBudgets, policy: ReceiptPolicy, seed: string, withL1: boolean, retireFinished = false): StageResult {
+  const store = compactStore(policy);
+  const econ = ECONOMY_V1;
+  gc?.();
+  const base = process.memoryUsage().heapUsed;
+  const t0 = performance.now();
+  let a: Account<CompactIds> = newAccount(store, econ, [7, 11, 13, 17], 4);
+  let b: Account<FullIds> | null = withL1 ? newAccount(FULL_STORE, econ, [7, 11, 13, 17], 4) : null;
+  let deliveries = 0;
+  let peakHeap = 0;
+  let peakRss = 0;
+  let status: StageResult['status'] = 'COMPLETED';
+  const growth: { day: number; checkpointBytes: number; replayTailReceipts: number }[] = [];
+  let nextDay = 1;
+  let lastT = 0;
+  let housekeeping = 0;
+  let jobsRetired = 0;
+  const retireFinishedJobs = (t: number) => {
+    // Amendment 01: the client retires every finished job producer (no reserved unit, the smith no longer on it).
+    const jobs = a.ids.producers['job'];
+    if (!jobs) return;
+    for (const [n, p] of Object.entries(jobs.open)) {
+      if (Number(n) === a.smith.job || p.reserved.length > 0) continue;
+      housekeeping += 1;
+      const d: Delivery = { type: 'request', atMs: t, stream: 'housekeeping', seq: housekeeping, payload: { kind: 'retire', producerKind: 'job', number: Number(n) } };
+      const o = deliver(a, d, econ, store);
+      a = o.account;
+      if (b) b = deliver(b, d, econ, FULL_STORE).account;
+      deliveries += 1;
+      if (o.outcome.receipt?.['code'] === 'OK') jobsRetired += 1;
+    }
+  };
+  for (const d of workload(seed, stage.days)) {
+    a = deliver(a, d, econ, store).account;
+    if (b) b = deliver(b, d, econ, FULL_STORE).account;
+    deliveries += 1;
+    lastT = d.atMs;
+    if (retireFinished && d.type === 'request' && d.atMs % 600_000 === 0) retireFinishedJobs(d.atMs);
+    if (deliveries % 5000 === 0) {
+      const m = process.memoryUsage();
+      peakHeap = Math.max(peakHeap, m.heapUsed);
+      peakRss = Math.max(peakRss, m.rss);
+      if (performance.now() - t0 > stage.budgetWallMs) {
+        status = 'STOPPED_TIME_BUDGET';
+        break;
+      }
+      if (m.heapUsed / MB > stage.budgetPeakHeapMb) {
+        status = 'STOPPED_HEAP_BUDGET';
+        break;
+      }
+    }
+    if (d.atMs >= nextDay * 86_400_000) {
+      const text = serializeCheckpoint(makeCheckpoint(a, econ, policy, nextDay, ['main']));
+      growth.push({ day: nextDay, checkpointBytes: Buffer.byteLength(text), replayTailReceipts: Object.values(a.ids.requests).reduce((s, x) => s + x.recent.length, 0) });
+      nextDay += 1;
+    }
+  }
+  const wallMs = performance.now() - t0;
+  const text = serializeCheckpoint(makeCheckpoint(a, econ, policy, 1_000_000, ['main']));
+  const times: number[] = [];
+  for (let i = 0; i < 30; i += 1) {
+    const s = performance.now();
+    restoreCheckpoint(text, econ, policy, ['main']);
+    times.push(performance.now() - s);
+  }
+  times.sort((x, y) => x - y);
+  const l1Receipts = b ? fullReceiptCount(b.ids) : null;
+  b = null;
+  let retained: number | null = null;
+  let accountHeap: number | null = null;
+  if (gc) {
+    gc();
+    gc();
+    retained = Math.max(0, process.memoryUsage().heapUsed - base) / MB;
+    // Amendment 01: the account alone, rebuilt from its checkpoint text after collection.
+    gc();
+    gc();
+    const h0 = process.memoryUsage().heapUsed;
+    isolated = restoreCheckpoint(text, econ, policy, ['main']).account;
+    gc();
+    gc();
+    accountHeap = Math.max(0, process.memoryUsage().heapUsed - h0) / MB;
+    isolated = null;
+  }
+  const tail = Object.values(a.ids.requests).flatMap((x) => x.recent);
+  const runs = [...Object.values(a.ids.requests).map((x) => x.settled.runs.length), ...Object.values(a.ids.credits).map((x) => x.runs.length)].reduce((s, x) => s + x, 0);
+  const res: StageResult = {
+    id: stage.id,
+    status,
+    simulatedDays: lastT / 86_400_000,
+    deliveries,
+    unitsProduced: a.counters.ore + a.counters.bars,
+    wallMs: Math.round(wallMs),
+    deliveriesPerSecond: Math.round((deliveries / wallMs) * 1000),
+    peakHeapMb: Math.round(peakHeap / MB),
+    peakRssMb: Math.round(peakRss / MB),
+    retainedHeapMb: retained === null ? null : Math.round(retained * 100) / 100,
+    accountHeapMb: accountHeap === null ? null : Math.round(accountHeap * 100) / 100,
+    jobsRetired,
+    checkpointBytes: Buffer.byteLength(text),
+    replayTailReceipts: tail.length,
+    replayTailBytes: Buffer.byteLength(JSON.stringify(tail)),
+    rangeRuns: runs,
+    reconstructionMs: { n: times.length, median: Math.round((times[15] as number) * 100) / 100, p95: Math.round((times[28] as number) * 100) / 100, max: Math.round((times[29] as number) * 100) / 100 },
+    l1ReceiptsRetained: l1Receipts,
+    growth,
+    budgets: { retained: retained === null ? null : retained <= budgets.retainedMb, reconstruction: (times[28] as number) <= budgets.reconstructionP95Ms, checkpoint: Buffer.byteLength(text) / 1024 <= budgets.checkpointKb },
+  };
+  void a;
+  return res;
+}
