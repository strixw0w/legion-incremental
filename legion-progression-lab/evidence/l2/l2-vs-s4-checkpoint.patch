+rows, missed = [], 0
+for mid, rel, what, pairs in M:
+    path = os.path.join(lab, *rel.split("/"))
+    original = open(path, "rb").read()
+    text = original.decode("utf-8")
+    for old, _ in pairs:
+        if text.count(old) != 1:
