+/**
+ * L2 experiment runner (manifests/l2/PREREGISTRATION.md). Refuses a manifest that is not pre-registered or changed
+ * after registration, runs it, and writes the result JSON.
+ *   node src/cli/l2-run.ts manifests/l2/<id>.json --out <file.json>
+ *   node --expose-gc src/cli/l2-run.ts manifests/l2/L2-E04-perf.json --out ...      (retained heap needs --expose-gc)
+ */
+import { createHash } from 'node:crypto';
+import { readFileSync, writeFileSync } from 'node:fs';
+import { cpus, platform, release } from 'node:os';
+import { dirname, resolve } from 'node:path';
+import { runDifferential } from '../l2/differential.ts';
+import { runPartition } from '../l2/partition.ts';
+import { runStage, type PerfBudgets, type PerfStage } from './l2-perf.ts';
+import type { ReceiptPolicy } from '../l2/requests.ts';
+import { LAB_ROOT, prettyJson } from './paths.ts';
+
+const args = process.argv.slice(2);
+const manifestRel = args[0];
+const outIdx = args.indexOf('--out');
+if (!manifestRel || outIdx < 0) throw new Error('usage: l2-run.ts <manifest> --out <file>');
+const raw = readFileSync(resolve(LAB_ROOT, manifestRel));
+const sha = createHash('sha256').update(raw).digest('hex');
+const reg = JSON.parse(readFileSync(resolve(LAB_ROOT, dirname(manifestRel), 'preregistration.json'), 'utf8')) as { manifests: { path: string; sha256: string }[]; amendments?: { path: string; sha256: string }[] };
+const entry = [...reg.manifests, ...(reg.amendments ?? [])].find((m) => m.path === manifestRel);
+if (!entry) {
+  console.error(`REFUSED: ${manifestRel} is not pre-registered`);
+  process.exit(2);
+}
+if (entry.sha256 !== sha) {
+  console.error(`REFUSED: ${manifestRel} changed after pre-registration`);
+  process.exit(2);
+}
+const m = JSON.parse(raw.toString('utf8')) as { experimentId: string; kind: 'differential' | 'partition' | 'perf'; seed: string; policy: ReceiptPolicy; operations?: number; checkpointEvery?: number; branchEvery?: number; cases?: number; partitionsPerCase?: number; stages?: PerfStage[]; budgets?: PerfBudgets; withL1?: boolean; retireFinished?: boolean };
+const t0 = Date.now();
+let result: unknown;
+if (m.kind === 'differential') result = runDifferential({ seed: m.seed, operations: m.operations as number, policy: m.policy, checkpointEvery: m.checkpointEvery ?? 0, branchEvery: m.branchEvery ?? 0 });
+else if (m.kind === 'partition') result = runPartition(m.seed, m.cases as number, m.partitionsPerCase as number);
+else {
+  const stages = [];
+  for (const s of m.stages as PerfStage[]) {
+    const r = runStage(s, m.budgets as PerfBudgets, m.policy, `${m.seed}:${s.id}`, m.withL1 === true, m.retireFinished === true);
+    stages.push(r);
+    console.log(`${s.id}: ${r.status}, ${r.deliveries} deliveries in ${r.wallMs} ms; retained ${String(r.retainedHeapMb)} MB; account alone ${String(r.accountHeapMb)} MB; checkpoint ${r.checkpointBytes} B; reconstruction p95 ${r.reconstructionMs.p95} ms; jobs retired ${r.jobsRetired}`);
+    if (r.status !== 'COMPLETED') break;
+  }
+  result = { stages, gcExposed: typeof (globalThis as { gc?: unknown }).gc === 'function' };
+}
+const environment = { experimentId: m.experimentId, manifestSha256: sha, node: process.version, platform: platform(), release: release(), cpus: cpus().length, workers: 0, durationMs: Date.now() - t0, mainRssMb: Math.round(process.memoryUsage().rss / 2 ** 20) };
+writeFileSync(resolve(LAB_ROOT, args[outIdx + 1] as string), prettyJson({ environment, result }));
+console.log(`${m.experimentId}: done in ${environment.durationMs} ms (main RSS ${environment.mainRssMb} MB, no worker threads)`);
