+/**
+ * Command validation (gates.md v1 section 4). Rules are checked in the documented order and the first failure is
+ * returned. Validation never changes state; a rejected command has no effect.
+ */
+import type { CompiledContent } from '../model/content.ts';
+import type { Command, ReasonCode, SimState, Validation } from '../model/types.ts';
+
+const ok: Validation = { ok: true };
+const no = (code: ReasonCode): Validation => ({ ok: false, code });
+
+function common(state: SimState): Validation | null {
+  if (!state.session.open) return no('NOT_IN_SESSION');
+  if (state.hero.status === 'dead') return no('DEAD');
+  if (state.hero.status === 'travelling' || state.hero.status === 'boss') return no('BUSY');
+  return null;
+}
+
+export function validateCommand(state: SimState, content: CompiledContent, cmd: Command): Validation {
+  const hero = state.hero;
+  switch (cmd.type) {
+    case 'SetAutoFarm': {
+      if (!cmd.on) return state.session.open ? ok : no('NOT_IN_SESSION');
+      const c = common(state);
+      if (c) return c;
+      const order = content.zoneOrderById.get(cmd.zoneId);
+      if (order === undefined) return no('ZONE_UNKNOWN');
+      if (order !== hero.zoneOrder) return no('NOT_IN_ZONE');
+      return ok;
+    }
+    case 'Engage': {
+      const c = common(state);
+      if (c) return c;
+      if (hero.status !== 'idle') return no('ALREADY_ENGAGED');
+      return ok;
+    }
+    case 'Travel': {
+      const c = common(state);
+      if (c) return c;
+      const order = content.zoneOrderById.get(cmd.zoneId);
+      if (order === undefined) return no('ZONE_UNKNOWN');
+      if (!(state.zones[order - 1]?.accessUnlocked ?? false)) return no('ZONE_NOT_ACCESSIBLE');
+      if (order === hero.zoneOrder) return no('ALREADY_THERE');
+      if (Math.abs(order - hero.zoneOrder) !== 1) return no('ZONE_NOT_ADJACENT');
+      return ok;
+    }
+    case 'Teleport': {
+      const c = common(state);
+      if (c) return c;
+      const order = content.checkpointZoneOrder.get(cmd.checkpointId);
+      if (order === undefined) return no('CHECKPOINT_UNKNOWN');
+      if (!(state.zones[order - 1]?.checkpointDiscovered ?? false)) return no('CHECKPOINT_UNKNOWN');
+      if (order === hero.zoneOrder) return no('ALREADY_THERE');
+      return ok;
+    }
+    case 'Rest': {
+      const c = common(state);
+      return c ?? ok;
+    }
+    case 'StartBoss': {
+      const c = common(state);
+      if (c) return c;
+      if (!content.gateIds.has(cmd.gateId) || cmd.gateId !== content.boss.gateId) return no('GATE_UNKNOWN');
+      if (!state.boss.opened) return no('GATE_LOCKED');
+      if (state.boss.completed) return no('GATE_ALREADY_COMPLETED');
+      if (hero.zoneOrder !== content.boss.zoneOrder) return no('NOT_IN_ZONE');
+      if (hero.autoFarm) return no('GATE_ACTIVE_ONLY');
+      if (hero.status !== 'idle' && hero.status !== 'resting') return no('ALREADY_ENGAGED');
+      return ok;
+    }
+    case 'EndSession':
+      return state.session.open ? ok : no('NOT_IN_SESSION');
+    default:
+      return no('BUSY');
+  }
+}
diff --git a/legion-progression-lab/src/engine/estimator.ts b/legion-progression-lab/src/engine/estimator.ts
new file mode 100644
index 0000000..b469207
--- /dev/null
+++ b/legion-progression-lab/src/engine/estimator.ts
@@ -0,0 +1,143 @@
+/**
+ * Analytic rate estimator (architecture v1.1 section 4: the third, separate component). It predicts steady-state
+ * farming rates for one zone at one hero level, the way a Command Centre would display them (R07.16). It never
+ * produces "actual" results; reports show estimate and simulation side by side (S1-E02, H-S1-09).
+ *
+ * Model (all candidate, documented in S1_EVIDENCE.md):
+ * - Swings to kill: exact distribution by dynamic programming over remaining enemy HP, with hit chance p_h and crit
+ *   chance p_c (truncated when the surviving probability mass falls below 1e-12).
+ * - TTK for n swings: firstSwingDelay + (n - 1) * interval, where firstSwingDelay = max(0, interval - engageOverhead)
+ *   (the killing swing of the previous fight starts the cooldown; s1-combat-loop.md section 5).
+ * - Attack bound: one kill per (engageOverhead + E[TTK]). Spawn bound: each slot yields at most one kill per
+ *   (respawnMs + engageOverhead + E[TTK]), so slots / (respawn + overhead + E[TTK]).
+ * - Survival: enemy attacks during a fight of n swings land at firstAttackDelay + k * enemyInterval <= TTK_n
+ *   (a simultaneous attack lands). Kills per life = maxHp / E[damage per kill] (renewal approximation, no regen
+ *   while farming). Each death costs respawnDelay + (zoneEntryWalk - engageOverhead) + E[TTK] / 2 (half a lost fight).
+ * - The auto-farm stop rule (D-03) is not modelled; when it would trigger, the zone is flagged "survival".
+ */
+import { damagePerHit, mitigationRatio } from '../core/formulas/combat.ts';
+import type { CompiledContent } from '../model/content.ts';
+import type { DisplayedEstimate } from '../model/types.ts';
+
+const TWO_POW_32 = 4_294_967_296;
+const TAIL = 1e-12;
+const MAX_SWINGS = 100_000;
+
+export interface ZoneEstimate extends DisplayedEstimate {
+  readonly zoneOrder: number;
+  readonly level: number;
+  readonly damageNormal: number;
+  readonly damageCrit: number;
+  readonly enemyDamage: number;
+  readonly expectedSwings: number;
+  /** P(swings to kill = n) for n = 1.. (index n - 1). */
+  readonly swingDistribution: readonly number[];
+  readonly expectedTtkMs: number;
+  readonly attackBoundPerHour: number;
+  readonly spawnBoundPerHour: number;
+  readonly damageTakenPerKill: number;
+  readonly materialsPerHour: Readonly<Record<string, number>>;
+}
+
+export function swingDistribution(enemyHp: number, damageNormal: number, damageCrit: number, pHit: number, pCrit: number): number[] {
+  let alive = new Map<number, number>([[enemyHp, 1]]);
+  const out: number[] = [];
+  for (let n = 1; n <= MAX_SWINGS; n += 1) {
+    const next = new Map<number, number>();
+    let killed = 0;
+    for (const [hp, mass] of alive) {
+      const miss = mass * (1 - pHit);
+      if (miss > 0) next.set(hp, (next.get(hp) ?? 0) + miss);
+      for (const [dmg, p] of [
+        [damageNormal, pHit * (1 - pCrit)],
+        [damageCrit, pHit * pCrit],
+      ] as const) {
+        if (p <= 0) continue;
+        const left = hp - dmg;
+        if (left <= 0) killed += mass * p;
+        else next.set(left, (next.get(left) ?? 0) + mass * p);
+      }
+    }
+    out.push(killed);
+    alive = next;
+    let rest = 0;
+    for (const m of alive.values()) rest += m;
+    if (rest < TAIL) break;
+  }
+  return out;
+}
+
+export function estimateZone(content: CompiledContent, level: number, zoneOrder: number): ZoneEstimate {
+  const zone = content.zones[zoneOrder - 1];
+  if (!zone) throw new Error(`unknown zone order ${zoneOrder}`);
+  const stats = content.heroStats(level);
+  const enemy = zone.enemy;
+  const K = content.combat.mitigationK;
+  const minDamage = content.combat.minDamagePerHit;
+  const mitigation = mitigationRatio(enemy.defence, K);
+  const critMultBp = content.hero.critMultBp;
+  const damageNormal = damagePerHit({ rawMilli: stats.attackRawMilli, crit: false, critMultBp, mitigation, minDamage });
+  const damageCrit = damagePerHit({ rawMilli: stats.attackRawMilli, crit: true, critMultBp, mitigation, minDamage });
+  const enemyDamage = damagePerHit({ rawMilli: enemy.attackMilli, crit: false, critMultBp: 10_000, mitigation: mitigationRatio(stats.defence, K), minDamage });
+  const pHit = zone.heroHitThreshold / TWO_POW_32;
+  const pCrit = Math.min(content.hero.critChanceBp, 10_000) / 10_000;
+
+  const dist = swingDistribution(enemy.hp, damageNormal, damageCrit, pHit, pCrit);
+  const interval = content.hero.attackIntervalMs;
+  const overhead = content.travel.engageOverheadMs;
+  const firstSwingDelay = Math.max(0, interval - overhead);
+  let expectedSwings = 0;
+  let expectedTtk = 0;
+  let expectedEnemyHits = 0;
+  dist.forEach((p, i) => {
+    const n = i + 1;
+    const ttk = firstSwingDelay + (n - 1) * interval;
+    const hits = ttk >= enemy.firstAttackDelayMs ? Math.floor((ttk - enemy.firstAttackDelayMs) / enemy.attackIntervalMs) + 1 : 0;
+    expectedSwings += p * n;
+    expectedTtk += p * ttk;
+    expectedEnemyHits += p * hits;
+  });
+
+  const attackCycle = overhead + expectedTtk;
+  const spawnCycle = (zone.respawnMs + overhead + expectedTtk) / zone.spawnSlots;
+  const attackBoundPerHour = 3_600_000 / attackCycle;
+  const spawnBoundPerHour = 3_600_000 / spawnCycle;
+  const baseMsPerKill = Math.max(attackCycle, spawnCycle);
+
+  const damageTakenPerKill = expectedEnemyHits * enemyDamage;
+  const killsPerLife = damageTakenPerKill > 0 ? stats.maxHp / damageTakenPerKill : null;
+  const downtimePerDeath = content.hero.respawnDelayMs + Math.max(0, content.travel.zoneEntryWalkMs - overhead) + expectedTtk / 2;
+  const msPerKill = baseMsPerKill + (killsPerLife === null ? 0 : downtimePerDeath / killsPerLife);
+  const killsPerHour = 3_600_000 / msPerKill;
+  const deathsPerHour = killsPerLife === null ? 0 : killsPerHour / killsPerLife;
+  const downtimeShare = killsPerLife === null ? 0 : downtimePerDeath / killsPerLife / msPerKill;
+  const deathsPerFiveMin = deathsPerHour / 12;
+
+  let limitingFactor: DisplayedEstimate['limitingFactor'] = spawnCycle > attackCycle ? 'spawn' : 'attack';
+  if (downtimeShare >= 0.1 || deathsPerFiveMin >= content.autoFarm.stopAfterDeaths) limitingFactor = 'survival';
+
+  const materialsPerHour: Record<string, number> = {};
+  for (const d of enemy.drops) materialsPerHour[d.resourceId] = (materialsPerHour[d.resourceId] ?? 0) + (killsPerHour * d.chanceBp * d.qty) / 10_000;
+
+  return {
+    zoneOrder,
+    level,
+    damageNormal,
+    damageCrit,
+    enemyDamage,
+    expectedSwings,
+    swingDistribution: dist,
+    expectedTtkMs: expectedTtk,
+    attackBoundPerHour,
+    spawnBoundPerHour,
+    damageTakenPerKill,
+    killsPerLife,
+    ttkS: expectedTtk / 1000,
+    killsPerHour,
+    expPerHour: killsPerHour * enemy.exp,
+    goldPerHour: killsPerHour * enemy.gold,
+    deathsPerHour,
+    limitingFactor,
+    materialsPerHour,
+  };
+}
