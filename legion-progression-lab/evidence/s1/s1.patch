+/**
+ * Realistic policies (experiment plan section 4; S1-R16 candidate thresholds). They see only the Observation
+ * (architecture 4.1) and import nothing from the engine; a test enforces that.
+ *
+ * POL-STAY       Stays in the current zone until the next zone unlocks, then advances immediately.
+ * POL-FRONTIER   Moves to the next accessible zone once its displayed TTK <= 6 s and its displayed kills per life
+ *                (kills from full HP before death, without resting) >= 10; rests when HP < 30%; otherwise farms
+ *                the current zone. (The survival criterion originally used displayed deaths/h <= 1; it was changed after an
+ *                engineering smoke run and before any experiment was registered: deaths/h assumes no resting,
+ *                which this policy does. Recorded in S1_RESOLUTIONS.md S1-R16.)
+ * POL-BEST-SHOWN Farms the accessible zone with the best displayed EXP/h (ties: current zone, then lower order).
+ * POL-FIXED-<n>  Diagnostic only: farms zone n (used with diagnostic starts, e.g. S1-E02).
+ */
+import type { Command, Observation, Policy, ZoneObservation } from '../model/types.ts';
+
+export const FRONTIER_TTK_S = 6;
+export const FRONTIER_MIN_KILLS_PER_LIFE = 10;
+export const REST_BELOW_HP_FRACTION = 0.3;
+
+function busy(obs: Observation): boolean {
+  const s = obs.hero.status;
+  return !obs.sessionOpen || s === 'travelling' || s === 'dead' || s === 'boss';
+}
+
+function currentZone(obs: Observation): ZoneObservation {
+  return obs.zones.find((z) => z.id === obs.hero.zoneId) as ZoneObservation;
+}
+
+function zoneByOrder(obs: Observation, order: number): ZoneObservation | undefined {
+  return obs.zones.find((z) => z.order === order);
+}
+
+function frontierOrder(obs: Observation): number {
+  return Math.max(...obs.zones.filter((z) => z.accessUnlocked).map((z) => z.order));
+}
+
+/** One adjacent step toward `targetOrder` (Travel is adjacent-only, S1-R13). */
+function stepToward(obs: Observation, targetOrder: number): Command[] {
+  const cur = currentZone(obs).order;
+  if (targetOrder === cur) return [];
+  const next = zoneByOrder(obs, targetOrder > cur ? cur + 1 : cur - 1) as ZoneObservation;
+  return [{ type: 'Travel', zoneId: next.id }];
+}
+
+function farmHere(obs: Observation): Command[] {
+  if (obs.hero.autoFarm) return [];
+  return [{ type: 'SetAutoFarm', on: true, zoneId: obs.hero.zoneId }];
+}
+
+export const POL_STAY: Policy = {
+  id: 'POL-STAY',
+  kind: 'realistic',
+  decide(obs) {
+    if (busy(obs)) return [];
+    const target = frontierOrder(obs);
+    if (target !== currentZone(obs).order) return stepToward(obs, target);
+    return farmHere(obs);
+  },
+};
+
+export const POL_FRONTIER: Policy = {
+  id: 'POL-FRONTIER',
+  kind: 'realistic',
+  decide(obs) {
+    if (busy(obs)) return [];
+    if (obs.hero.status === 'resting') return [];
+    if (obs.hero.hp < REST_BELOW_HP_FRACTION * obs.hero.maxHp) return [{ type: 'Rest' }];
+    const cur = currentZone(obs);
+    const next = zoneByOrder(obs, cur.order + 1);
+    const survives = (e: NonNullable<ZoneObservation['estimate']>): boolean => e.killsPerLife === null || e.killsPerLife >= FRONTIER_MIN_KILLS_PER_LIFE;
+    if (next && next.accessUnlocked && next.estimate && next.estimate.ttkS <= FRONTIER_TTK_S && survives(next.estimate)) {
+      return [{ type: 'Travel', zoneId: next.id }];
+    }
+    return farmHere(obs);
+  },
+};
+
+export const POL_BEST_SHOWN: Policy = {
+  id: 'POL-BEST-SHOWN',
+  kind: 'realistic',
+  decide(obs) {
+    if (busy(obs)) return [];
+    const cur = currentZone(obs);
+    let best = cur;
+    for (const z of obs.zones) {
+      if (!z.accessUnlocked || !z.estimate) continue;
+      // Strictly better only: ties keep the current zone, and zones are visited in order, so other ties keep the lower order.
+      if (z.estimate.expPerHour > (best.estimate ? best.estimate.expPerHour : -1)) best = z;
+    }
+    if (best.order !== cur.order) return stepToward(obs, best.order);
+    return farmHere(obs);
+  },
+};
+
+/** Diagnostic: always farm zone `order` (travelling there first if needed). Not a player model. */
+export function fixedZonePolicy(order: number): Policy {
+  return {
+    id: `POL-FIXED-${order}`,
+    kind: 'realistic',
+    decide(obs) {
+      if (busy(obs)) return [];
+      if (currentZone(obs).order !== order) return stepToward(obs, order);
+      return farmHere(obs);
+    },
+  };
+}
+
+export const REALISTIC_POLICIES: Readonly<Record<string, Policy>> = {
+  'POL-STAY': POL_STAY,
+  'POL-FRONTIER': POL_FRONTIER,
+  'POL-BEST-SHOWN': POL_BEST_SHOWN,
+};
diff --git a/legion-progression-lab/src/spec/s1Fixtures.ts b/legion-progression-lab/src/spec/s1Fixtures.ts
new file mode 100644
index 0000000..f0e3505
--- /dev/null
+++ b/legion-progression-lab/src/spec/s1Fixtures.ts
@@ -0,0 +1,167 @@
+/**
+ * S1 fixture handlers (spec/fixtures/combat-loop.v1.json, gates.v1.json, rewards.v1.json). Pure: each case builds a
+ * small synthetic content pack in memory, so fixtures never depend on the candidate pack's numbers.
+ */
+import { fingerprint } from '../core/hash/canonicalJson.ts';
+import { deriveRngState } from '../core/rng/streamId.ts';
+import { compileContentS1 } from '../model/content.ts';
+import type { Command, LogEntry, Policy, SimState } from '../model/types.ts';
+import { validateCommand } from '../engine/commands.ts';
+import { rollKillReward } from '../engine/rewards.ts';
+import { Simulation } from '../engine/simulation.ts';
+
+type Input = Record<string, unknown>;
+const L = (value: number) => ({ value, label: 'candidate' as const });
+
+function table(): unknown {
+  return {
+    artifact: 'xp-table',
+    artifactVersion: 1,
+    formulaVersion: 1,
+    contentId: 'fixture',
+    label: 'candidate',
+    curve: { family: 'powerGeometric', a: 1_000_000_000, p: 0, g: 1 },
+    rounding: 'roundHalfUp',
+    indexing: 'thresholds[i] = EXP from level i+1 to level i+2',
+    thresholds: [1_000_000_000, 1_000_000_000],
+  };
+}
+
+interface Fighter {
+  readonly hp: number;
+  readonly attackMilli: number;
+  readonly attackIntervalMs: number;
+  readonly firstAttackDelayMs: number;
+  readonly defence: number;
+}
+
+function enemyJson(id: string, e: Fighter) {
+  return { id, name: id, hp: L(e.hp), attackMilli: L(e.attackMilli), attackIntervalMs: L(e.attackIntervalMs), firstAttackDelayMs: L(e.firstAttackDelayMs), defence: L(e.defence), exp: L(1), gold: L(1), drops: [] };
+}
+
+/** A pack with `zoneCount` zones on a line, kill gates of `gateKills`, and a boss in the last zone. */
+function syntheticPack(opts: { hero: Record<string, number>; enemy: Fighter; zoneCount: number; gateKills: number; K: number; minDamage: number; entryWalkMs: number }) {
+  const t = table();
+  const zones = Array.from({ length: opts.zoneCount }, (_, i) => ({
+    id: `zone.f.z${i + 1}`,
+    order: i + 1,
+    name: `Zone ${i + 1}`,
+    enemyId: 'enemy.f.foe',
+    checkpointId: `cp.f.z${i + 1}`,
+    accuracyRequirement: L(0),
+    spawnSlots: L(10),
+    respawnMs: L(6000),
+    ...(i + 1 < opts.zoneCount ? { killGate: { gateId: `gate.f.z${i + 1}`, toZoneId: `zone.f.z${i + 2}`, kills: L(opts.gateKills) } } : {}),
+  }));
+  const h = opts.hero;
+  return {
+    pack: {
+      schemaVersion: 1,
+      contentId: 'fixture',
+      contentVersion: '0.0.1',
+      status: 'candidate',
+      formulaVersions: { numeric: 1, remainder: 2, rng: 1, xp: 2, stats: 2, combat: 2, ledger: 1, canonicalJson: 1, combatLoop: 1, gates: 1 },
+      xp: { curve: { family: 'powerGeometric', a: L(1_000_000_000), p: L(0), g: L(1) }, maxLevelUpsPerAward: L(10), table: { path: 'fixture.json', sha256: fingerprint(t) } },
+      statCategories: [{ id: 'cat.damage.additive', kind: 'additivePool', active: true }],
+      hero: {
+        baseAttackMilli: L(h['attackMilli'] ?? 6000),
+        attackPerLevelMilli: L(0),
+        attackIntervalMs: L(h['attackIntervalMs'] ?? 1200),
+        critChanceBp: L(h['critChanceBp'] ?? 0),
+        critMultBp: L(h['critMultBp'] ?? 15_000),
+        baseMaxHp: L(h['maxHp'] ?? 60),
+        maxHpPerLevel: L(0),
+        baseDefence: L(h['defence'] ?? 0),
+        defencePerLevel: L(0),
+        accuracy: L(10),
+        outOfCombatDelayMs: L(3000),
+        regenPerSecBpOfMaxHp: L(1000),
+        respawnDelayMs: L(5000),
+      },
+      combat: { mitigationK: L(opts.K), minDamagePerHit: L(opts.minDamage), hitCurve: { hAtReqBp: L(9000), floorBp: L(1000), k: L(2) } },
+      resources: [{ id: 'res.gold', kind: 'currency', testOnly: false }],
+      enemies: [enemyJson('enemy.f.foe', opts.enemy), enemyJson('enemy.f.boss', { hp: 100, attackMilli: 1000, attackIntervalMs: 2000, firstAttackDelayMs: 2000, defence: 0 })],
+      zones,
+      boss: { gateId: 'gate.f.boss', zoneId: `zone.f.z${opts.zoneCount}`, enemyId: 'enemy.f.boss', unlockKills: L(opts.gateKills), timerMs: L(120_000), activeOnly: true, prototype: true, note: 'fixture boss' },
+      travel: { adjacentWalkMs: L(20_000), teleportMs: L(3000), zoneEntryWalkMs: L(opts.entryWalkMs), engageOverheadMs: L(1500) },
+      autoFarm: { stopAfterDeaths: L(3), deathWindowMs: L(300_000) },
+    },
+    table: t,
+  };
+}
+
+const ENGAGE_ONCE: Policy = { id: 'FIXTURE-ENGAGE-ONCE', kind: 'realistic', decide: (o) => (o.trigger === 'session-start' ? [{ type: 'Engage' }] : []) };
+
+/** One fight: engage at session start, run until the encounter ends or untilMs (exclusive). */
+export function runCombatLoopCase(input: Input) {
+  const { pack, table: t } = syntheticPack({
+    hero: input['hero'] as Record<string, number>,
+    enemy: input['enemy'] as Fighter,
+    zoneCount: 1,
+    gateKills: 1,
+    K: input['K'] as number,
+    minDamage: input['minDamage'] as number,
+    entryWalkMs: input['entryWalkMs'] as number,
+  });
+  const content = compileContentS1(pack, t);
+  const untilMs = input['untilMs'] as number;
+  const sim = new Simulation({ content, seedRoot: 'fixture', sessions: [{ startMs: 0, endMs: untilMs }], policy: ENGAGE_ONCE, keepLog: 100_000, hashLog: false, diagnostic: { freezeLevel: true } });
+  sim.run(untilMs);
+  const log: LogEntry[] = sim.keptLog;
+  const swings = log.filter((e) => e.kind === 'Swing').map((e) => [e.t, e.detail['damage'] as number]);
+  const enemyHits = log.filter((e) => e.kind === 'EnemyHit').map((e) => [e.t, e.detail['damage'] as number]);
+  const killed = log.find((e) => e.kind === 'EnemyKilled');
+  const died = log.find((e) => e.kind === 'HeroDied');
+  const outcome = killed && died && killed.t === died.t ? 'bothDied' : killed && (!died || killed.t < died.t) ? 'enemyKilled' : died ? 'heroDied' : 'none';
+  const endMs = outcome === 'none' ? null : outcome === 'heroDied' ? (died as LogEntry).t : (killed as LogEntry).t;
+  const lastEnemyHp = log.filter((e) => e.kind === 'Swing').map((e) => e.detail['enemyHp'] as number);
+  const lastHeroHp = log.filter((e) => e.kind === 'EnemyHit').map((e) => e.detail['heroHp'] as number);
+  return {
+    outcome,
+    endMs,
+    swings,
+    enemyHits,
+    enemyHp: lastEnemyHp.length > 0 ? (lastEnemyHp[lastEnemyHp.length - 1] as number) : (input['enemy'] as Fighter).hp,
+    heroHp: lastHeroHp.length > 0 ? (lastHeroHp[lastHeroHp.length - 1] as number) : ((input['hero'] as Record<string, number>)['maxHp'] ?? 60),
+  };
+}
+
+/** Validates one command against a described state (gates.md section 4). */
+export function runGatesCase(input: Input) {
+  const { pack, table: t } = syntheticPack({
+    hero: {},
+    enemy: { hp: 15, attackMilli: 1000, attackIntervalMs: 2000, firstAttackDelayMs: 2000, defence: 0 },
+    zoneCount: 3,
+    gateKills: 10,
+    K: 100,
+    minDamage: 1,
+    entryWalkMs: 8000,
+  });
+  const content = compileContentS1(pack, t);
+  const st = input['state'] as Record<string, unknown>;
+  const sim = new Simulation({ content, seedRoot: 'fixture', sessions: [], policy: ENGAGE_ONCE, hashLog: false });
+  const base = sim.state;
+  const flags = st['zones'] as { access: boolean; visited: boolean; checkpoint: boolean }[];
+  const state: SimState = {
+    ...base,
+    session: { ...base.session, open: st['sessionOpen'] as boolean },
+    hero: { ...base.hero, status: st['heroStatus'] as SimState['hero']['status'], zoneOrder: st['heroZone'] as number, autoFarm: st['autoFarm'] as boolean },
+    zones: base.zones.map((z, i) => ({ ...z, accessUnlocked: flags[i]?.access ?? false, visited: flags[i]?.visited ?? false, checkpointDiscovered: flags[i]?.checkpoint ?? false })),
+    boss: { ...base.boss, opened: st['bossOpened'] as boolean, completed: st['bossCompleted'] as boolean },
+  };
+  const v = validateCommand(state, content, input['command'] as Command);
+  return v.ok ? { ok: true } : { ok: false, code: v.code };
+}
+
+/** Drop rolls for consecutive kills from a stream root (s1-combat-loop.md section 10). */
+export function runRewardsCase(input: Input) {
+  let loot = deriveRngState({ root: input['seedRoot'] as string, purpose: 'loot', entity: 'account', counter: 0 });
+  const enemy = input['enemy'] as { gold: number; drops: { resourceId: string; chanceBp: number; qty: number }[] };
+  const kills: (string | number)[][][] = [];
+  for (let i = 0; i < (input['kills'] as number); i += 1) {
+    const r = rollKillReward(loot, enemy);
+    loot = r.loot;
+    kills.push(r.lines.map((l) => [l.resourceId, l.delta]));
+  }
+  return { kills };
+}
