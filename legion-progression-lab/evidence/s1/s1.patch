+    contentVersion: SemVerSchema,
+    status: z.enum(['candidate', 'approved']),
+    note: z.string().min(1).optional(),
+    formulaVersions: z
+      .object({
+        numeric: z.literal(1),
+        remainder: z.literal(2),
+        rng: z.literal(1),
+        xp: z.literal(2),
+        stats: z.literal(2),
