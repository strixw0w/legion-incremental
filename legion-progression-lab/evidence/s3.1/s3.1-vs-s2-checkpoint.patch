+  const resources = new Set(legion.resources.map((r) => r.id));
+  const tierOrder = new Map(pack.tiers.map((t) => [t.id, t.order]));
+  if (new Set(pack.tiers.map((t) => t.order)).size !== 6) problems.push('tiers: orders 1-6 each once');
