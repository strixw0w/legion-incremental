+    work,
+    heroGather: ind.heroGather,
+    blocked: ind.blocked,
+    crafts: ind.crafts,
+  };
+}
+
+function shortOf(sim: LegionSimulation, lines: readonly QtyLine[]): string | null {
+  for (const l of lines) if (balance(sim.state.ledger, l.resourceId, 'available') < l.qty) return l.resourceId;
