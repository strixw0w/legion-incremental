+      if (best === null && blocked !== null && blocked.blockedBy !== null) {
+        const z = DROPS[blocked.blockedBy] as number;
+        const zone = obs.zones.find((x) => x.order === z);
+        if (zone && zone.accessUnlocked && zone.visited !== false) fixedZone = z;
+      }
