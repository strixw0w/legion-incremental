+    metrics: ['heroDamageShare', 'heroEffectiveShare', 'heroAbilityEffectiveShare', 'heroOverkillShare', 'expTotal', 'legionExpTotal', 'minToL5', 'minToL10', 'zone2FirstVisitMin', 'zone3FirstVisitMin', 'invariantViolations'],
