+      for (const p of PROFESSION_IDS) {
+        let lvl = 1;
+        let left = ind.profExp[ch.id]?.[p] ?? 0;
+        for (const need of this.c.table) {
+          if (left < need) break;
+          left -= need;
+          lvl += 1;
+        }
+        rec[p] = lvl;
+      }
+      profLevels[ch.id] = rec;
+    }
