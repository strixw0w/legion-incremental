      "description": "Zero duration changes nothing (G2)",
      "input": {
        "op": "accrue",
        "rem": 5,
        "num": 3,
        "steps": 0,
        "den": 7
      },
      "expected": {
        "granted": 0,
        "rem": 5
      },
      "derivation": "5 + 0 = 5 < 7"
    },
