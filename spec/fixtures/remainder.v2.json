  "independence": "Expected values derived by hand from spec/formulas/remainder.md v2 (per-hour chain as one exact division of milliRem*3,600,000 + msRem + rate*dMs by 3,600,000,000); re-checked with unbounded Python integers by spec/oracle/exact_oracle.py.",
  "cases": [
    {
      "id": "remainder.accrue.001",
      "kind": "normal",
      "description": "Simple accrual with remainder",
      "input": {
        "op": "accrue",
        "rem": 0,
        "num": 3,
        "steps": 10,
        "den": 7
      },
      "expected": {
        "granted": 4,
        "rem": 2
      },
      "derivation": "0 + 3*10 = 30; 30 = 4*7 + 2"
    },
    {
      "id": "remainder.accrue.zero-steps.001",
