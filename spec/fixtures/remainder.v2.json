      "input": {
        "op": "accrue",
        "rem": 0,
        "num": 67108863,
        "steps": 9007199254740991,
        "den": 67108864
      },
      "expected": {
        "granted": 9007199120523263,
        "rem": 1
      },
      "derivation": "(2^26-1)(2^53-1) = 2^79 - 2^53 - 2^26 + 1; divided by 2^26: 2^53 - 2^27 - 1 remainder 1"
    },
